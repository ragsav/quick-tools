---
import ConverterToolLayout from "../../layouts/ConverterToolLayout.astro";

const faqItems = [
  {
    question: "What is the maximum number supported?",
    answer:
      "This tool can convert numbers up to 999 trillion, and also handles decimals.",
  },
  {
    question: "When would I need to spell out numbers?",
    answer:
      "Common uses include writing checks, legal documents, contracts, and formal writing.",
  },
  {
    question: "Is this tool free?",
    answer:
      "Yes, this tool is completely free and works directly in your browser.",
  },
];

const howItWorks = [
  {
    title: "Chunk Processing",
    content:
      "Numbers are split into 3-digit chunks from right to left (units, thousands, millions, etc.). Each chunk is converted independently.",
  },
  {
    title: "Hundreds Conversion",
    content:
      "Each chunk handles 0-999: ones (1-19), tens (20-90), and hundreds (100-900). Special rules for teens (11-19) prevent awkward constructions.",
  },
  {
    title: "Scale Words",
    content:
      "After converting each chunk, scale words are appended: thousand, million, billion, trillion. Empty chunks are skipped.",
  },
  {
    title: "Decimal Handling",
    content:
      "Decimals are spelled digit by digit after 'point'. So 45.67 becomes 'forty-five point six seven'.",
  },
  {
    title: "Negative Numbers",
    content:
      "Negative numbers are prefixed with 'negative' before converting the absolute value to words.",
  },
];

const useCases = [
  {
    title: "Writing Checks",
    description:
      "Banks require amounts written in words on checks. Convert 1250.00 to 'one thousand two hundred fifty' instantly.",
  },
  {
    title: "Legal Documents",
    description:
      "Contracts often require amounts spelled out to prevent forgery. Ensure accuracy in legal agreements.",
  },
  {
    title: "Formal Invitations",
    description:
      "Wedding invitations and formal event cards may spell out dates and times for elegance.",
  },
  {
    title: "Educational Materials",
    description:
      "Teaching aids for children learning number words. Practice and verify spelling of large numbers.",
  },
  {
    title: "Accessibility",
    description:
      "Create text versions of numbers for screen readers and accessibility-first content.",
  },
  {
    title: "Report Writing",
    description:
      "Style guides often require small numbers (under 10) to be spelled out in professional writing.",
  },
];
---

<ConverterToolLayout
  title="Number to Words Converter - Convert Numbers to Text"
  description="Convert numbers to words in English. Spell out numbers for checks, legal documents, and more. Free online tool."
  canonicalPath="/converters/number-to-words"
  currentTool="Number to Words"
  faqItems={faqItems}
  howItWorks={howItWorks}
  useCases={useCases}
>
  <div class="tool-header">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">
      Number to Words
    </h1>
    <p class="text-slate-500">Convert numbers to written words (English).</p>
  </div>

  <div class="bg-slate-50 border border-slate-200 rounded p-6 mb-8">
    <div class="mb-4">
      <label
        for="number"
        class="block font-medium text-slate-700 mb-1.5 text-sm"
        >Enter Number</label
      >
      <input
        type="text"
        id="number"
        placeholder="e.g., 1234.56"
        class="w-full max-w-md px-4 py-3 text-xl border border-slate-300 rounded bg-white text-slate-800 outline-none font-mono"
        oninput="convert()"
      />
    </div>

    <div class="result-box p-4 bg-white rounded">
      <div class="text-xs text-slate-500 uppercase tracking-wider mb-1">
        In Words
      </div>
      <div class="text-xl font-medium text-slate-900" id="result">—</div>
    </div>

    <div class="mt-4 text-sm text-slate-500">
      <strong>Tip:</strong> Works for whole numbers up to 999 trillion and decimals.
    </div>
  </div>

  <section class="mt-8 pt-6 border-t border-slate-200">
    <h2 class="text-xl font-semibold text-slate-900 mb-4">Examples</h2>
    <div class="grid grid-cols-2 gap-4 text-sm">
      <div class="p-3 bg-white border border-slate-200 rounded">
        <div class="font-mono text-amber-600">123</div>
        <div class="text-slate-600">one hundred twenty-three</div>
      </div>
      <div class="p-3 bg-white border border-slate-200 rounded">
        <div class="font-mono text-amber-600">1000</div>
        <div class="text-slate-600">one thousand</div>
      </div>
      <div class="p-3 bg-white border border-slate-200 rounded">
        <div class="font-mono text-amber-600">45.67</div>
        <div class="text-slate-600">forty-five point six seven</div>
      </div>
      <div class="p-3 bg-white border border-slate-200 rounded">
        <div class="font-mono text-amber-600">1000000</div>
        <div class="text-slate-600">one million</div>
      </div>
    </div>
  </section>

  <script is:inline>
    const ones = [
      "",
      "one",
      "two",
      "three",
      "four",
      "five",
      "six",
      "seven",
      "eight",
      "nine",
      "ten",
      "eleven",
      "twelve",
      "thirteen",
      "fourteen",
      "fifteen",
      "sixteen",
      "seventeen",
      "eighteen",
      "nineteen",
    ];
    const tens = [
      "",
      "",
      "twenty",
      "thirty",
      "forty",
      "fifty",
      "sixty",
      "seventy",
      "eighty",
      "ninety",
    ];
    const scales = ["", "thousand", "million", "billion", "trillion"];

    function convertHundreds(n) {
      if (n === 0) return "";
      if (n < 20) return ones[n];
      if (n < 100) {
        const t = Math.floor(n / 10);
        const o = n % 10;
        return tens[t] + (o ? "-" + ones[o] : "");
      }
      const h = Math.floor(n / 100);
      const rest = n % 100;
      return ones[h] + " hundred" + (rest ? " " + convertHundreds(rest) : "");
    }

    function numberToWords(n) {
      if (n === 0) return "zero";
      if (n < 0) return "negative " + numberToWords(-n);

      let words = [];
      let scaleIndex = 0;

      while (n > 0) {
        const chunk = n % 1000;
        if (chunk > 0) {
          const chunkWords = convertHundreds(chunk);
          if (scales[scaleIndex]) {
            words.unshift(chunkWords + " " + scales[scaleIndex]);
          } else {
            words.unshift(chunkWords);
          }
        }
        n = Math.floor(n / 1000);
        scaleIndex++;
      }

      return words.join(" ");
    }

    function convert() {
      const input = document.getElementById("number").value.trim();

      if (!input) {
        document.getElementById("result").innerText = "—";
        return;
      }

      const num = parseFloat(input.replace(/,/g, ""));
      if (isNaN(num)) {
        document.getElementById("result").innerText =
          "Please enter a valid number";
        return;
      }

      if (Math.abs(num) >= 1e15) {
        document.getElementById("result").innerText =
          "Number too large (max: 999 trillion)";
        return;
      }

      const [intPart, decPart] = input.replace(/,/g, "").split(".");
      let result = numberToWords(Math.abs(parseInt(intPart)));

      if (num < 0) result = "negative " + result;

      if (decPart) {
        const decimalWords = decPart
          .split("")
          .map((d) => ones[parseInt(d)] || "zero")
          .join(" ");
        result += " point " + decimalWords;
      }

      document.getElementById("result").innerText = result;
    }
  </script>
</ConverterToolLayout>
