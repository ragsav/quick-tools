---
import ConverterToolLayout from "../../layouts/ConverterToolLayout.astro";

const faqItems = [
  {
    question: "What categories of units are supported?",
    answer: "Length, weight/mass, temperature, area, volume, and speed.",
  },
  {
    question: "Does this handle temperature conversion correctly?",
    answer:
      "Yes, temperature conversions between Celsius, Fahrenheit, and Kelvin use the correct formulas.",
  },
  {
    question: "Is this tool free?",
    answer:
      "Yes, this tool is completely free and works directly in your browser.",
  },
];

const howItWorks = [
  {
    title: "Base Unit System",
    content:
      "Each category has a base unit (meter, kilogram, liter, etc.). All conversions go through this base unit, enabling any-to-any conversion within a category.",
  },
  {
    title: "Conversion Factors",
    content:
      "Units are defined by their ratio to the base unit. To convert, divide by the source factor (to base), then multiply by the target factor (from base).",
  },
  {
    title: "Temperature Special Case",
    content:
      "Temperature uses formulas, not factors. Celsius is the base: °F = (°C × 9/5) + 32, K = °C + 273.15. Conversions go through Celsius as intermediate.",
  },
  {
    title: "Dynamic Unit Lists",
    content:
      "Selecting a category updates the available units. Each category has its own set of common units appropriate for that measurement type.",
  },
  {
    title: "Precision Handling",
    content:
      "Results are displayed with up to 6 decimal places, with locale-aware number formatting (thousands separators based on your region).",
  },
];

const useCases = [
  {
    title: "Cooking & Recipes",
    description:
      "Convert between cups, tablespoons, milliliters, and grams when following international recipes.",
  },
  {
    title: "Travel & Navigation",
    description:
      "Convert between miles and kilometers, Fahrenheit and Celsius when traveling internationally.",
  },
  {
    title: "Construction & DIY",
    description:
      "Convert feet/inches to meters/centimeters for materials, square footage to square meters for flooring.",
  },
  {
    title: "Fitness & Health",
    description:
      "Convert pounds to kilograms for weights, miles to kilometers for running distances.",
  },
  {
    title: "Science & Engineering",
    description:
      "Quick conversions between metric and imperial units for calculations and specifications.",
  },
  {
    title: "Shopping & Commerce",
    description:
      "Compare prices per unit across different measurement systems (price per ounce vs per gram).",
  },
];
---

<ConverterToolLayout
  title="Unit Converter - Convert Length, Weight, Temperature"
  description="Convert between units of length, weight, temperature, and more. Fast, free online unit converter."
  canonicalPath="/converters/unit-converter"
  currentTool="Unit Converter"
  faqItems={faqItems}
  howItWorks={howItWorks}
  useCases={useCases}
>
  <div class="tool-header">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">
      Unit Converter
    </h1>
    <p class="text-slate-500">Convert between common units of measurement.</p>
  </div>

  <div class="bg-slate-50 border border-slate-200 rounded p-6 mb-8">
    <div class="mb-4">
      <label
        for="category"
        class="block font-medium text-slate-700 mb-1.5 text-sm">Category</label
      >
      <select
        id="category"
        onchange="updateUnits()"
        class="w-full max-w-xs px-4 py-3 border border-slate-300 rounded bg-white text-slate-800 outline-none"
      >
        <option value="length">Length</option>
        <option value="weight">Weight / Mass</option>
        <option value="temperature">Temperature</option>
        <option value="area">Area</option>
        <option value="volume">Volume</option>
        <option value="speed">Speed</option>
      </select>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-end mb-6">
      <div>
        <label
          for="fromValue"
          class="block font-medium text-slate-700 mb-1.5 text-sm">Value</label
        >
        <input
          type="number"
          id="fromValue"
          value="1"
          class="w-full px-4 py-3 border border-slate-300 rounded bg-white text-slate-800 outline-none"
          oninput="convert()"
        />
      </div>
      <div>
        <label
          for="fromUnit"
          class="block font-medium text-slate-700 mb-1.5 text-sm">From</label
        >
        <select
          id="fromUnit"
          class="w-full px-4 py-3 border border-slate-300 rounded bg-white text-slate-800 outline-none"
          onchange="convert()"></select>
      </div>
      <div>
        <label
          for="toUnit"
          class="block font-medium text-slate-700 mb-1.5 text-sm">To</label
        >
        <select
          id="toUnit"
          class="w-full px-4 py-3 border border-slate-300 rounded bg-white text-slate-800 outline-none"
          onchange="convert()"></select>
      </div>
    </div>

    <div class="result-box p-4 bg-white rounded">
      <div class="text-xs text-slate-500 uppercase tracking-wider mb-1">
        Result
      </div>
      <div class="text-3xl font-bold text-amber-600" id="result">—</div>
    </div>
  </div>

  <script is:inline>
    const units = {
      length: {
        meter: 1,
        kilometer: 0.001,
        centimeter: 100,
        millimeter: 1000,
        mile: 0.000621371,
        yard: 1.09361,
        foot: 3.28084,
        inch: 39.3701,
      },
      weight: {
        kilogram: 1,
        gram: 1000,
        milligram: 1000000,
        pound: 2.20462,
        ounce: 35.274,
        ton: 0.001,
      },
      temperature: { celsius: "c", fahrenheit: "f", kelvin: "k" },
      area: {
        "square meter": 1,
        "square kilometer": 0.000001,
        "square foot": 10.7639,
        acre: 0.000247105,
        hectare: 0.0001,
      },
      volume: {
        liter: 1,
        milliliter: 1000,
        "cubic meter": 0.001,
        gallon: 0.264172,
        quart: 1.05669,
        pint: 2.11338,
        cup: 4.22675,
      },
      speed: {
        "meters/second": 1,
        "km/hour": 3.6,
        "miles/hour": 2.23694,
        knot: 1.94384,
      },
    };

    function updateUnits() {
      const cat = document.getElementById("category").value;
      const fromSel = document.getElementById("fromUnit");
      const toSel = document.getElementById("toUnit");
      const unitList = Object.keys(units[cat]);

      fromSel.innerHTML = unitList
        .map((u) => `<option value="${u}">${u}</option>`)
        .join("");
      toSel.innerHTML = unitList
        .map((u) => `<option value="${u}">${u}</option>`)
        .join("");
      toSel.selectedIndex = 1;
      convert();
    }

    function convert() {
      const cat = document.getElementById("category").value;
      const value = parseFloat(document.getElementById("fromValue").value);
      const from = document.getElementById("fromUnit").value;
      const to = document.getElementById("toUnit").value;

      if (isNaN(value)) {
        document.getElementById("result").innerText = "Enter a number";
        return;
      }

      let result;
      if (cat === "temperature") {
        result = convertTemp(value, from, to);
      } else {
        // Convert to base unit then to target
        const toBase = value / units[cat][from];
        result = toBase * units[cat][to];
      }

      document.getElementById("result").innerText =
        `${result.toLocaleString(undefined, { maximumFractionDigits: 6 })} ${to}`;
    }

    function convertTemp(val, from, to) {
      let celsius;
      if (from === "celsius") celsius = val;
      else if (from === "fahrenheit") celsius = ((val - 32) * 5) / 9;
      else celsius = val - 273.15;

      if (to === "celsius") return celsius;
      if (to === "fahrenheit") return (celsius * 9) / 5 + 32;
      return celsius + 273.15;
    }

    updateUnits();
  </script>
</ConverterToolLayout>
