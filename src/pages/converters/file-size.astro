---
import ConverterToolLayout from "../../layouts/ConverterToolLayout.astro";

const faqItems = [
  {
    question: "What is the difference between KB and KiB?",
    answer:
      "This tool uses binary (1024 base). 1 KB = 1024 bytes, which is technically KiB in IEC standard.",
  },
  {
    question: "What units are supported?",
    answer:
      "Bytes, Kilobytes (KB), Megabytes (MB), Gigabytes (GB), Terabytes (TB), and Petabytes (PB).",
  },
  {
    question: "Is this tool free?",
    answer:
      "Yes, this tool is completely free and works directly in your browser.",
  },
];
---

<ConverterToolLayout
  title="File Size Converter - Convert Bytes, KB, MB, GB, TB"
  description="Convert between file size units: bytes, KB, MB, GB, TB, and PB. Free online file size calculator."
  canonicalPath="/converters/file-size"
  currentTool="File Size Converter"
  faqItems={faqItems}
>
  <div class="tool-header">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">
      File Size Converter
    </h1>
    <p class="text-slate-500">Convert between bytes, KB, MB, GB, and more.</p>
  </div>

  <div class="bg-slate-50 border border-slate-200 rounded p-6 mb-8">
    <div class="flex flex-wrap gap-4 items-end mb-6">
      <div class="flex-1 min-w-48">
        <label
          for="value"
          class="block font-medium text-slate-700 mb-1.5 text-sm">Value</label
        >
        <input
          type="number"
          id="value"
          value="1"
          class="w-full px-4 py-3 text-lg border border-slate-300 rounded bg-white text-slate-800 outline-none"
          oninput="convert()"
        />
      </div>
      <div class="flex-1 min-w-48">
        <label
          for="unit"
          class="block font-medium text-slate-700 mb-1.5 text-sm">Unit</label
        >
        <select
          id="unit"
          class="w-full px-4 py-3 border border-slate-300 rounded bg-white text-slate-800 outline-none"
          onchange="convert()"
        >
          <option value="0">Bytes (B)</option>
          <option value="1">Kilobytes (KB)</option>
          <option value="2" selected>Megabytes (MB)</option>
          <option value="3">Gigabytes (GB)</option>
          <option value="4">Terabytes (TB)</option>
          <option value="5">Petabytes (PB)</option>
        </select>
      </div>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
      <div class="p-4 bg-white border border-slate-200 rounded">
        <div class="text-xs text-slate-500 uppercase mb-1">Bytes</div>
        <div class="font-mono text-lg font-bold text-slate-900" id="bytes">
          —
        </div>
      </div>
      <div class="p-4 bg-white border border-slate-200 rounded">
        <div class="text-xs text-slate-500 uppercase mb-1">KB</div>
        <div class="font-mono text-lg font-bold text-slate-900" id="kb">—</div>
      </div>
      <div class="p-4 bg-white border border-slate-200 rounded">
        <div class="text-xs text-slate-500 uppercase mb-1">MB</div>
        <div class="font-mono text-lg font-bold text-slate-900" id="mb">—</div>
      </div>
      <div class="p-4 bg-white border border-slate-200 rounded">
        <div class="text-xs text-slate-500 uppercase mb-1">GB</div>
        <div class="font-mono text-lg font-bold text-slate-900" id="gb">—</div>
      </div>
      <div class="p-4 bg-white border border-slate-200 rounded">
        <div class="text-xs text-slate-500 uppercase mb-1">TB</div>
        <div class="font-mono text-lg font-bold text-slate-900" id="tb">—</div>
      </div>
      <div class="p-4 bg-white border border-slate-200 rounded">
        <div class="text-xs text-slate-500 uppercase mb-1">PB</div>
        <div class="font-mono text-lg font-bold text-slate-900" id="pb">—</div>
      </div>
    </div>

    <div class="mt-4 text-sm text-slate-500">
      <strong>Note:</strong> Using binary (1024) base. 1 KB = 1024 bytes.
    </div>
  </div>

  <script is:inline>
    function convert() {
      const value = parseFloat(document.getElementById("value").value);
      const unitPower = parseInt(document.getElementById("unit").value);

      if (isNaN(value)) return;

      // Convert to bytes first
      const bytes = value * Math.pow(1024, unitPower);

      const format = (n) => {
        if (n >= 1)
          return n.toLocaleString(undefined, { maximumFractionDigits: 2 });
        return n.toPrecision(4);
      };

      document.getElementById("bytes").innerText = format(bytes);
      document.getElementById("kb").innerText = format(bytes / 1024);
      document.getElementById("mb").innerText = format(
        bytes / Math.pow(1024, 2),
      );
      document.getElementById("gb").innerText = format(
        bytes / Math.pow(1024, 3),
      );
      document.getElementById("tb").innerText = format(
        bytes / Math.pow(1024, 4),
      );
      document.getElementById("pb").innerText = format(
        bytes / Math.pow(1024, 5),
      );
    }

    convert();
  </script>
</ConverterToolLayout>
