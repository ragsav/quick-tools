---
import ConverterToolLayout from "../../layouts/ConverterToolLayout.astro";

const faqItems = [
  {
    question: "How does decimal to fraction conversion work?",
    answer:
      "The tool finds the equivalent fraction and automatically simplifies it to the lowest terms.",
  },
  {
    question: "What decimals can be converted?",
    answer:
      "Any terminating decimal can be converted to a fraction. Repeating decimals may be approximated.",
  },
  {
    question: "Is this tool free?",
    answer:
      "Yes, this tool is completely free and works directly in your browser.",
  },
];

const howItWorks = [
  {
    title: "Decimal to Fraction",
    content:
      "The decimal is multiplied by a power of 10 to create a whole numerator. The denominator is the same power of 10. For 0.75: 75/100.",
  },
  {
    title: "Fraction Simplification",
    content:
      "The GCD (Greatest Common Divisor) of numerator and denominator is found using Euclid's algorithm. Both are divided by GCD: 75/100 → 3/4.",
  },
  {
    title: "Fraction to Decimal",
    content:
      "Simple division: numerator ÷ denominator = decimal. JavaScript handles the arithmetic automatically with floating-point precision.",
  },
  {
    title: "Precision Handling",
    content:
      "Results display up to 8 decimal places to capture repeating decimals (1/3 = 0.33333333) while keeping output readable.",
  },
  {
    title: "Division by Zero Protection",
    content:
      "The tool validates that the denominator isn't zero before calculating, preventing mathematical errors.",
  },
];

const useCases = [
  {
    title: "Cooking & Recipes",
    description:
      "Convert 0.25 cups to 1/4 cup or vice versa. Work with measurements in your preferred format.",
  },
  {
    title: "Math Homework",
    description:
      "Check fraction-to-decimal conversions for homework. Verify that 3/8 = 0.375 or simplify 75/100 to 3/4.",
  },
  {
    title: "Construction & Woodworking",
    description:
      "Convert decimal measurements to fractional inches. 0.625 inches = 5/8 inch for standard tape measures.",
  },
  {
    title: "Financial Calculations",
    description:
      "Convert decimal percentages to fractions. 0.125 (12.5%) = 1/8 for ratio and proportion work.",
  },
  {
    title: "Music Theory",
    description:
      "Understand note durations: a quarter note (1/4) equals 0.25 of a whole note. Calculate complex rhythms.",
  },
  {
    title: "Scientific Ratios",
    description:
      "Express proportions and ratios as either decimals or fractions depending on the context and audience.",
  },
];
---

<ConverterToolLayout
  title="Decimal to Fraction Converter - Convert Decimals & Fractions"
  description="Convert decimals to fractions and fractions to decimals. Simplify fractions automatically. Free online tool."
  canonicalPath="/converters/decimal-fraction"
  currentTool="Decimal ↔ Fraction"
  faqItems={faqItems}
  howItWorks={howItWorks}
  useCases={useCases}
>
  <div class="tool-header">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">
      Decimal ↔ Fraction Converter
    </h1>
    <p class="text-slate-500">Convert between decimals and fractions.</p>
  </div>

  <div class="bg-slate-50 border border-slate-200 rounded p-6 mb-8">
    <div class="grid md:grid-cols-2 gap-6">
      <!-- Decimal to Fraction -->
      <div class="p-4 bg-white border border-slate-200 rounded">
        <h3 class="font-medium text-slate-900 mb-4">Decimal → Fraction</h3>
        <input
          type="text"
          id="decimal"
          placeholder="e.g., 0.75"
          class="w-full px-4 py-3 border border-slate-300 rounded bg-white text-slate-800 outline-none mb-3"
          oninput="decToFrac()"
        />
        <div class="text-2xl font-bold text-amber-600" id="fractionResult">
          —
        </div>
      </div>

      <!-- Fraction to Decimal -->
      <div class="p-4 bg-white border border-slate-200 rounded">
        <h3 class="font-medium text-slate-900 mb-4">Fraction → Decimal</h3>
        <div class="flex items-center gap-2 mb-3">
          <input
            type="number"
            id="numerator"
            placeholder="3"
            class="w-20 px-3 py-3 border border-slate-300 rounded text-center outline-none"
            oninput="fracToDec()"
          />
          <span class="text-2xl text-slate-400">/</span>
          <input
            type="number"
            id="denominator"
            placeholder="4"
            class="w-20 px-3 py-3 border border-slate-300 rounded text-center outline-none"
            oninput="fracToDec()"
          />
        </div>
        <div class="text-2xl font-bold text-amber-600" id="decimalResult">
          —
        </div>
      </div>
    </div>
  </div>

  <section class="mt-8 pt-6 border-t border-slate-200">
    <h2 class="text-xl font-semibold text-slate-900 mb-4">
      Common Conversions
    </h2>
    <div class="grid grid-cols-4 sm:grid-cols-6 gap-3 text-sm">
      <div class="p-2 bg-white border border-slate-200 rounded text-center">
        0.5 = 1/2
      </div>
      <div class="p-2 bg-white border border-slate-200 rounded text-center">
        0.25 = 1/4
      </div>
      <div class="p-2 bg-white border border-slate-200 rounded text-center">
        0.75 = 3/4
      </div>
      <div class="p-2 bg-white border border-slate-200 rounded text-center">
        0.33 ≈ 1/3
      </div>
      <div class="p-2 bg-white border border-slate-200 rounded text-center">
        0.125 = 1/8
      </div>
      <div class="p-2 bg-white border border-slate-200 rounded text-center">
        0.2 = 1/5
      </div>
    </div>
  </section>

  <script is:inline>
    function gcd(a, b) {
      a = Math.abs(a);
      b = Math.abs(b);
      while (b) {
        const t = b;
        b = a % b;
        a = t;
      }
      return a;
    }

    function decToFrac() {
      const input = document.getElementById("decimal").value.trim();
      if (!input) {
        document.getElementById("fractionResult").innerText = "—";
        return;
      }

      const decimal = parseFloat(input);
      if (isNaN(decimal)) {
        document.getElementById("fractionResult").innerText = "Invalid number";
        return;
      }

      // Handle whole numbers
      if (Number.isInteger(decimal)) {
        document.getElementById("fractionResult").innerText = `${decimal}/1`;
        return;
      }

      // Convert to fraction
      const decStr = decimal.toString();
      const decimalPlaces = decStr.includes(".")
        ? decStr.split(".")[1].length
        : 0;
      const denominator = Math.pow(10, decimalPlaces);
      const numerator = Math.round(decimal * denominator);

      // Simplify
      const divisor = gcd(numerator, denominator);
      const simpleNum = numerator / divisor;
      const simpleDen = denominator / divisor;

      document.getElementById("fractionResult").innerText =
        `${simpleNum}/${simpleDen}`;
    }

    function fracToDec() {
      const num = parseInt(document.getElementById("numerator").value);
      const den = parseInt(document.getElementById("denominator").value);

      if (isNaN(num) || isNaN(den)) {
        document.getElementById("decimalResult").innerText = "—";
        return;
      }

      if (den === 0) {
        document.getElementById("decimalResult").innerText =
          "Cannot divide by zero";
        return;
      }

      const result = num / den;
      document.getElementById("decimalResult").innerText =
        result.toLocaleString(undefined, { maximumFractionDigits: 8 });
    }
  </script>
</ConverterToolLayout>
