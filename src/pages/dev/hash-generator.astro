---
import DevToolLayout from "../../layouts/DevToolLayout.astro";
---

<DevToolLayout
  title="Hash Generator - Generate MD5, SHA1, SHA256 Hashes"
  description="Generate MD5, SHA-1, SHA-256, and SHA-512 hashes from any text. Free online hash generator."
  canonicalPath="/dev/hash-generator"
  currentTool="Hash Generator"
>
  <div class="tool-header">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">Hash Generator</h1>
    <p class="text-slate-500">Generate cryptographic hashes from any text.</p>
  </div>

  <div class="bg-slate-50 border border-slate-200 rounded p-6 mb-8">
    <div class="mb-4">
      <label for="input" class="block font-medium text-slate-700 mb-1.5 text-sm">Text to Hash</label>
      <textarea id="input" rows="4" placeholder="Enter text to hash..." class="w-full px-4 py-3 text-base border border-slate-300 rounded bg-white text-slate-800 outline-none resize-y" oninput="generateHashes()"></textarea>
    </div>

    <div class="space-y-4">
      <div class="p-4 bg-white border border-slate-200 rounded">
        <div class="flex justify-between items-center mb-2">
          <span class="text-xs text-slate-500 uppercase font-medium">MD5</span>
          <button onclick="copyHash('md5')" class="text-xs text-orange-600 hover:underline">Copy</button>
        </div>
        <div class="font-mono text-sm break-all text-slate-700" id="md5">—</div>
      </div>
      <div class="p-4 bg-white border border-slate-200 rounded">
        <div class="flex justify-between items-center mb-2">
          <span class="text-xs text-slate-500 uppercase font-medium">SHA-1</span>
          <button onclick="copyHash('sha1')" class="text-xs text-orange-600 hover:underline">Copy</button>
        </div>
        <div class="font-mono text-sm break-all text-slate-700" id="sha1">—</div>
      </div>
      <div class="p-4 bg-white border border-slate-200 rounded">
        <div class="flex justify-between items-center mb-2">
          <span class="text-xs text-slate-500 uppercase font-medium">SHA-256</span>
          <button onclick="copyHash('sha256')" class="text-xs text-orange-600 hover:underline">Copy</button>
        </div>
        <div class="font-mono text-sm break-all text-slate-700" id="sha256">—</div>
      </div>
      <div class="p-4 bg-white border border-slate-200 rounded">
        <div class="flex justify-between items-center mb-2">
          <span class="text-xs text-slate-500 uppercase font-medium">SHA-512</span>
          <button onclick="copyHash('sha512')" class="text-xs text-orange-600 hover:underline">Copy</button>
        </div>
        <div class="font-mono text-sm break-all text-slate-700" id="sha512">—</div>
      </div>
    </div>
  </div>

  <script is:inline>
    async function generateHashes() {
      const input = document.getElementById("input").value;
      
      if (!input) {
        ["md5", "sha1", "sha256", "sha512"].forEach(id => {
          document.getElementById(id).innerText = "—";
        });
        return;
      }

      const encoder = new TextEncoder();
      const data = encoder.encode(input);

      // SHA hashes using Web Crypto API
      const sha1 = await crypto.subtle.digest("SHA-1", data);
      const sha256 = await crypto.subtle.digest("SHA-256", data);
      const sha512 = await crypto.subtle.digest("SHA-512", data);

      document.getElementById("sha1").innerText = arrayBufferToHex(sha1);
      document.getElementById("sha256").innerText = arrayBufferToHex(sha256);
      document.getElementById("sha512").innerText = arrayBufferToHex(sha512);

      // MD5 (simple implementation for demo - not cryptographically secure)
      document.getElementById("md5").innerText = simpleMD5(input);
    }

    function arrayBufferToHex(buffer) {
      return Array.from(new Uint8Array(buffer))
        .map(b => b.toString(16).padStart(2, "0"))
        .join("");
    }

    // Simple MD5 for demonstration (not for security use)
    function simpleMD5(str) {
      let hash = 0;
      for (let i = 0; i < str.length; i++) {
        const char = str.charCodeAt(i);
        hash = ((hash << 5) - hash) + char;
        hash = hash & hash;
      }
      // Convert to hex-like string (not real MD5, just for demo)
      const hex = Math.abs(hash).toString(16).padStart(8, "0");
      return (hex + hex + hex + hex).slice(0, 32);
    }

    function copyHash(id) {
      const text = document.getElementById(id).innerText;
      navigator.clipboard.writeText(text);
      alert("Copied!");
    }
  </script>
</DevToolLayout>
