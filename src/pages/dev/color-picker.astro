---
import DevToolLayout from "../../layouts/DevToolLayout.astro";

const faqItems = [
  {
    question: "What color formats are supported?",
    answer:
      "HEX (#RRGGBB), RGB (red, green, blue values 0-255), and HSL (hue, saturation, lightness).",
  },
  {
    question: "How do I convert between formats?",
    answer:
      "Pick a color or enter a value in any format, and the tool instantly shows the equivalent in all formats.",
  },
  {
    question: "Is this tool free?",
    answer:
      "Yes, this tool is completely free and works directly in your browser.",
  },
];

const howItWorks = [
  {
    title: "HEX Format",
    content:
      "#RRGGBB represents RGB as 2-digit hex values. #FF0000 = bright red. Range 00-FF for each component.",
  },
  {
    title: "RGB Format",
    content:
      "RGB uses decimal values 0-255 for red, green, blue. rgb(255, 0, 0) = bright red. Direct color representation.",
  },
  {
    title: "HSL Format",
    content:
      "HSL uses Hue (0-360°), Saturation (0-100%), Lightness (0-100%). More intuitive for color adjustments.",
  },
  {
    title: "Color Conversion",
    content:
      "Mathematical formulas convert between formats. HEX→RGB is base conversion. RGB↔HSL involves color space transformation.",
  },
  {
    title: "Live Preview",
    content:
      "Changes update the color preview instantly. Edit any format and see results in all formats immediately.",
  },
];

const useCases = [
  {
    title: "Web Development",
    description:
      "Pick colors for CSS styling. Convert between formats as needed for different CSS properties.",
  },
  {
    title: "Design Consistency",
    description:
      "Copy exact color values from designs. Ensure brand colors are consistent across platforms.",
  },
  {
    title: "Color Adjustment",
    description:
      "Use HSL to easily lighten, darken, or desaturate colors. More intuitive than RGB adjustments.",
  },
  {
    title: "Accessibility Testing",
    description:
      "Extract colors to test contrast ratios. Ensure text is readable against backgrounds.",
  },
  {
    title: "Print Preparation",
    description:
      "Convert web colors (RGB) for print specifications. Understand color values for proofing.",
  },
  {
    title: "Graphic Design",
    description:
      "Copy color values for use in design software. Match colors across different applications.",
  },
];
---

<DevToolLayout
  title="Color Picker & Converter - HEX, RGB, HSL Converter"
  description="Pick colors and convert between HEX, RGB, and HSL formats. Free online color tool."
  canonicalPath="/dev/color-picker"
  currentTool="Color Picker & Converter"
  faqItems={faqItems}
  howItWorks={howItWorks}
  useCases={useCases}
>
  <div class="tool-header">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">
      Color Picker & Converter
    </h1>
    <p class="text-slate-500">
      Pick colors and convert between different formats.
    </p>
  </div>

  <div class="bg-slate-50 border border-slate-200 rounded p-6 mb-8">
    <div class="flex flex-wrap gap-6 items-start">
      <div>
        <label class="block font-medium text-slate-700 mb-1.5 text-sm"
          >Pick a Color</label
        >
        <input
          type="color"
          id="colorPicker"
          value="#1c398e"
          class="w-24 h-24 border-0 rounded cursor-pointer"
          oninput="updateFromPicker()"
        />
      </div>
      <div class="flex-1 min-w-48">
        <div
          class="h-24 rounded mb-4"
          id="preview"
          style="background-color: #1c398e;"
        >
        </div>
      </div>
    </div>

    <div class="grid md:grid-cols-3 gap-4 mt-6">
      <div class="p-4 bg-white border border-slate-200 rounded">
        <label class="block text-xs text-slate-500 uppercase mb-2">HEX</label>
        <div class="flex gap-2">
          <input
            type="text"
            id="hex"
            value="#1c398e"
            class="flex-1 px-3 py-2 border border-slate-300 rounded font-mono outline-none"
            oninput="updateFromHex()"
          />
          <button onclick="copy('hex')" class="px-2 text-orange-600">📋</button>
        </div>
      </div>
      <div class="p-4 bg-white border border-slate-200 rounded">
        <label class="block text-xs text-slate-500 uppercase mb-2">RGB</label>
        <div class="flex gap-2">
          <input
            type="text"
            id="rgb"
            value="rgb(59, 130, 246)"
            class="flex-1 px-3 py-2 border border-slate-300 rounded font-mono text-sm outline-none"
            oninput="updateFromRgb()"
          />
          <button onclick="copy('rgb')" class="px-2 text-orange-600">📋</button>
        </div>
      </div>
      <div class="p-4 bg-white border border-slate-200 rounded">
        <label class="block text-xs text-slate-500 uppercase mb-2">HSL</label>
        <div class="flex gap-2">
          <input
            type="text"
            id="hsl"
            value="hsl(217, 91%, 60%)"
            class="flex-1 px-3 py-2 border border-slate-300 rounded font-mono text-sm outline-none"
            oninput="updateFromHsl()"
          />
          <button onclick="copy('hsl')" class="px-2 text-orange-600">📋</button>
        </div>
      </div>
    </div>
  </div>

  <section class="mt-8 pt-6 border-t border-slate-200">
    <h2 class="text-xl font-semibold text-slate-900 mb-4">Popular Colors</h2>
    <div class="flex flex-wrap gap-2">
      <button
        onclick="setColor('#ef4444')"
        class="w-10 h-10 rounded"
        style="background:#ef4444"
        title="Red"></button>
      <button
        onclick="setColor('#f97316')"
        class="w-10 h-10 rounded"
        style="background:#f97316"
        title="Orange"></button>
      <button
        onclick="setColor('#eab308')"
        class="w-10 h-10 rounded"
        style="background:#eab308"
        title="Yellow"></button>
      <button
        onclick="setColor('#22c55e')"
        class="w-10 h-10 rounded"
        style="background:#22c55e"
        title="Green"></button>
      <button
        onclick="setColor('#1c398e')"
        class="w-10 h-10 rounded"
        style="background:#1c398e"
        title="Blue"></button>
      <button
        onclick="setColor('#8b5cf6')"
        class="w-10 h-10 rounded"
        style="background:#8b5cf6"
        title="Purple"></button>
      <button
        onclick="setColor('#ec4899')"
        class="w-10 h-10 rounded"
        style="background:#ec4899"
        title="Pink"></button>
      <button
        onclick="setColor('#000000')"
        class="w-10 h-10 rounded border"
        style="background:#000000"
        title="Black"></button>
      <button
        onclick="setColor('#ffffff')"
        class="w-10 h-10 rounded border"
        style="background:#ffffff"
        title="White"></button>
    </div>
  </section>

  <script is:inline>
    function setColor(hex) {
      document.getElementById("colorPicker").value = hex;
      updateFromPicker();
    }

    function updateFromPicker() {
      const hex = document.getElementById("colorPicker").value;
      updateAll(hex);
    }

    function updateFromHex() {
      let hex = document.getElementById("hex").value;
      if (!hex.startsWith("#")) hex = "#" + hex;
      if (/^#[0-9A-Fa-f]{6}$/.test(hex)) {
        document.getElementById("colorPicker").value = hex;
        updateAll(hex);
      }
    }

    function updateAll(hex) {
      const r = parseInt(hex.slice(1, 3), 16);
      const g = parseInt(hex.slice(3, 5), 16);
      const b = parseInt(hex.slice(5, 7), 16);

      document.getElementById("hex").value = hex;
      document.getElementById("rgb").value = `rgb(${r}, ${g}, ${b})`;
      document.getElementById("preview").style.backgroundColor = hex;

      // Convert to HSL
      const rn = r / 255,
        gn = g / 255,
        bn = b / 255;
      const max = Math.max(rn, gn, bn),
        min = Math.min(rn, gn, bn);
      let h,
        s,
        l = (max + min) / 2;

      if (max === min) {
        h = s = 0;
      } else {
        const d = max - min;
        s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
        switch (max) {
          case rn:
            h = ((gn - bn) / d + (gn < bn ? 6 : 0)) / 6;
            break;
          case gn:
            h = ((bn - rn) / d + 2) / 6;
            break;
          case bn:
            h = ((rn - gn) / d + 4) / 6;
            break;
        }
      }

      document.getElementById("hsl").value =
        `hsl(${Math.round(h * 360)}, ${Math.round(s * 100)}%, ${Math.round(l * 100)}%)`;
    }

    function copy(id) {
      navigator.clipboard.writeText(document.getElementById(id).value);
      alert("Copied!");
    }
  </script>
</DevToolLayout>
