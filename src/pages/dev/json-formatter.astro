---
import DevToolLayout from "../../layouts/DevToolLayout.astro";

const faqItems = [
  {
    question: "What can I do with this tool?",
    answer:
      "Format (beautify) JSON for readability, minify JSON to reduce size, and validate JSON syntax.",
  },
  {
    question: "What happens if my JSON is invalid?",
    answer:
      "The tool will show an error message explaining what's wrong with your JSON.",
  },
  {
    question: "Is this tool free?",
    answer:
      "Yes, this tool is completely free and works directly in your browser.",
  },
];

const howItWorks = [
  {
    title: "Parsing",
    content:
      "JSON.parse() attempts to parse input. If successful, the JSON is valid. Errors indicate syntax problems.",
  },
  {
    title: "Beautifying",
    content:
      "JSON.stringify() with 2-space indentation reformats JSON with proper line breaks and indentation.",
  },
  {
    title: "Minifying",
    content:
      "JSON.stringify() without spaces removes all whitespace. Smallest file size for production use.",
  },
  {
    title: "Validation",
    content:
      "Parsing reveals errors: missing quotes, trailing commas, invalid characters. Error message pinpoints the issue.",
  },
  {
    title: "Syntax Highlighting",
    content:
      "Formatted output uses monospace font for code readability. Easy to spot structure at a glance.",
  },
];

const useCases = [
  {
    title: "API Debugging",
    description:
      "Format API responses for readability. Understand nested data structures from REST endpoints.",
  },
  {
    title: "Config File Editing",
    description:
      "Validate package.json, tsconfig.json, or other config files. Find syntax errors before they cause issues.",
  },
  {
    title: "Log Analysis",
    description:
      "Format JSON log entries for debugging. Expand minified log data to readable format.",
  },
  {
    title: "Data Preparation",
    description:
      "Minify JSON before embedding in HTML or sending over network. Reduce payload size.",
  },
  {
    title: "Documentation",
    description:
      "Format JSON examples for documentation. Ensure consistent, readable code samples.",
  },
  {
    title: "Learning JSON",
    description:
      "Understand JSON structure by formatting examples. See how nesting and arrays work visually.",
  },
];
---

<DevToolLayout
  title="JSON Formatter & Validator - Beautify JSON Online"
  description="Format, beautify, and validate JSON data. Minify or prettify JSON with syntax highlighting."
  canonicalPath="/dev/json-formatter"
  currentTool="JSON Formatter"
  faqItems={faqItems}
  howItWorks={howItWorks}
  useCases={useCases}
>
  <div class="tool-header">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">
      JSON Formatter & Validator
    </h1>
    <p class="text-slate-500">Format, beautify, and validate your JSON data.</p>
  </div>

  <div class="bg-slate-50 border border-slate-200 rounded p-6 mb-8">
    <div class="mb-4">
      <label for="input" class="block font-medium text-slate-700 mb-1.5 text-sm"
        >Input JSON</label
      >
      <textarea
        id="input"
        rows="8"
        placeholder='{"name":"John","age":30}'
        class="w-full px-4 py-3 text-sm border border-slate-300 rounded bg-white text-slate-800 outline-none font-mono resize-y"
      ></textarea>
    </div>

    <div class="flex gap-3 mb-4">
      <button
        onclick="format()"
        class="btn-primary px-6 py-2 font-semibold text-white rounded"
        >Format / Beautify</button
      >
      <button
        onclick="minify()"
        class="px-4 py-2 bg-white border border-slate-300 rounded text-sm"
        >Minify</button
      >
      <button
        onclick="validate()"
        class="px-4 py-2 bg-white border border-slate-300 rounded text-sm"
        >Validate Only</button
      >
    </div>

    <div class="mb-4 hidden" id="statusBox">
      <div id="status" class="p-3 rounded text-sm"></div>
    </div>

    <div class="mb-4">
      <label class="block font-medium text-slate-700 mb-1.5 text-sm"
        >Output</label
      >
      <textarea
        id="output"
        rows="10"
        readonly
        class="w-full px-4 py-3 text-sm border border-slate-300 rounded bg-slate-50 text-slate-800 outline-none font-mono resize-y"
      ></textarea>
    </div>

    <button
      onclick="copyResult()"
      class="px-4 py-2 bg-white border border-slate-300 rounded text-sm"
      >📋 Copy</button
    >
  </div>

  <script is:inline>
    function showStatus(msg, isError) {
      const box = document.getElementById("statusBox");
      const status = document.getElementById("status");
      status.innerText = msg;
      status.className = `p-3 rounded text-sm ${isError ? "bg-red-50 text-red-700" : "bg-green-50 text-green-700"}`;
      box.classList.remove("hidden");
    }

    function format() {
      try {
        const input = document.getElementById("input").value;
        const parsed = JSON.parse(input);
        document.getElementById("output").value = JSON.stringify(
          parsed,
          null,
          2,
        );
        showStatus("✅ Valid JSON - Formatted successfully", false);
      } catch (e) {
        showStatus("❌ Invalid JSON: " + e.message, true);
        document.getElementById("output").value = "";
      }
    }

    function minify() {
      try {
        const input = document.getElementById("input").value;
        const parsed = JSON.parse(input);
        document.getElementById("output").value = JSON.stringify(parsed);
        showStatus("✅ Valid JSON - Minified successfully", false);
      } catch (e) {
        showStatus("❌ Invalid JSON: " + e.message, true);
        document.getElementById("output").value = "";
      }
    }

    function validate() {
      try {
        JSON.parse(document.getElementById("input").value);
        showStatus("✅ Valid JSON", false);
      } catch (e) {
        showStatus("❌ Invalid JSON: " + e.message, true);
      }
    }

    function copyResult() {
      document.getElementById("output").select();
      document.execCommand("copy");
      alert("Copied!");
    }
  </script>
</DevToolLayout>
