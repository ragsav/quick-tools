---
import DevToolLayout from "../../layouts/DevToolLayout.astro";

const faqItems = [
  {
    question: "How long should my password be?",
    answer:
      "We recommend at least 12-16 characters with a mix of uppercase, lowercase, numbers, and symbols.",
  },
  {
    question: "Is this password generator secure?",
    answer:
      "Yes, passwords are generated locally in your browser using cryptographically secure random values.",
  },
  {
    question: "Is this tool free?",
    answer:
      "Yes, this tool is completely free and works directly in your browser.",
  },
];

const howItWorks = [
  {
    title: "Cryptographic Randomness",
    content:
      "Uses crypto.getRandomValues() for cryptographically secure random numbers. Not predictable Math.random().",
  },
  {
    title: "Character Set Selection",
    content:
      "Choose from uppercase, lowercase, numbers, symbols. More character types = stronger passwords.",
  },
  {
    title: "Similar Character Exclusion",
    content:
      "Optionally exclude confusing characters (i, l, 1, O, 0) for passwords that must be typed manually.",
  },
  {
    title: "Strength Assessment",
    content:
      "Evaluates length and character variety. 16+ chars with 3+ types = Very Strong. Visual feedback provided.",
  },
  {
    title: "Browser-Only Processing",
    content:
      "Passwords never leave your browser. No server transmission. Completely private generation.",
  },
];

const useCases = [
  {
    title: "New Account Creation",
    description:
      "Generate unique, strong passwords for each new account. Never reuse passwords across sites.",
  },
  {
    title: "Password Manager Seeding",
    description:
      "Generate complex passwords to store in password managers. Let the manager remember them.",
  },
  {
    title: "Wi-Fi Network Security",
    description:
      "Create strong WPA2/WPA3 passwords for home or office networks.",
  },
  {
    title: "Application Secrets",
    description:
      "Generate API keys, database passwords, or encryption keys for development.",
  },
  {
    title: "Compliance Requirements",
    description:
      "Meet password policy requirements: minimum length, complexity, special characters.",
  },
  {
    title: "One-Time Access Codes",
    description:
      "Generate temporary access codes or shared secrets for secure handoffs.",
  },
];
---

<DevToolLayout
  title="Password Generator - Generate Strong Passwords"
  description="Generate secure, random passwords with customizable length and character types. Free online tool."
  canonicalPath="/dev/password-generator"
  currentTool="Password Generator"
  faqItems={faqItems}
  howItWorks={howItWorks}
  useCases={useCases}
>
  <div class="tool-header">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">
      Password Generator
    </h1>
    <p class="text-slate-500">Generate strong, secure passwords instantly.</p>
  </div>

  <div class="bg-slate-50 border border-slate-200 rounded p-6 mb-8">
    <div class="mb-6">
      <div class="flex gap-2 mb-4">
        <input
          type="text"
          id="password"
          readonly
          class="flex-1 px-4 py-4 text-xl font-mono border border-slate-300 rounded bg-white text-slate-800 outline-none"
        />
        <button
          onclick="copy()"
          class="px-4 py-2 bg-white border border-slate-300 rounded hover:border-orange-500"
           title="Copy to clipboard" aria-label="Copy to clipboard">📋</button
        >
        <button
          onclick="generate()"
          class="btn-primary px-6 py-2 font-semibold text-white rounded"
          >🔄 Generate</button
        >
      </div>
      <div class="text-sm" id="strength">—</div>
    </div>

    <div class="space-y-4">
      <div>
        <label class="block font-medium text-slate-700 mb-2 text-sm"
          >Length: <span id="lengthValue">16</span></label
        >
        <input
          type="range"
          id="length"
          min="4"
          max="64"
          value="16"
          class="w-full"
          oninput="updateLength(); generate()"
        />
      </div>

      <div class="grid grid-cols-2 gap-4">
        <label class="flex items-center gap-2 text-sm text-slate-600">
          <input
            type="checkbox"
            id="uppercase"
            checked
            class="w-4 h-4"
            onchange="generate()"
          />
          Uppercase (A-Z)
        </label>
        <label class="flex items-center gap-2 text-sm text-slate-600">
          <input
            type="checkbox"
            id="lowercase"
            checked
            class="w-4 h-4"
            onchange="generate()"
          />
          Lowercase (a-z)
        </label>
        <label class="flex items-center gap-2 text-sm text-slate-600">
          <input
            type="checkbox"
            id="numbers"
            checked
            class="w-4 h-4"
            onchange="generate()"
          />
          Numbers (0-9)
        </label>
        <label class="flex items-center gap-2 text-sm text-slate-600">
          <input
            type="checkbox"
            id="symbols"
            checked
            class="w-4 h-4"
            onchange="generate()"
          />
          Symbols (!@#$...)
        </label>
      </div>

      <label class="flex items-center gap-2 text-sm text-slate-600">
        <input
          type="checkbox"
          id="excludeSimilar"
          class="w-4 h-4"
          onchange="generate()"
        />
        Exclude similar characters (i, l, 1, L, o, 0, O)
      </label>
    </div>
  </div>

  <section class="mt-8 pt-6 border-t border-slate-200">
    <h2 class="text-xl font-semibold text-slate-900 mb-4">Password Tips</h2>
    <ul class="list-disc pl-6 text-slate-600 space-y-1 text-sm">
      <li>Use at least 12-16 characters for strong security</li>
      <li>Include a mix of uppercase, lowercase, numbers, and symbols</li>
      <li>Never reuse passwords across different accounts</li>
      <li>Consider using a password manager</li>
    </ul>
  </section>

  <script is:inline>
    const charSets = {
      uppercase: "ABCDEFGHIJKLMNOPQRSTUVWXYZ",
      lowercase: "abcdefghijklmnopqrstuvwxyz",
      numbers: "0123456789",
      symbols: "!@#$%^&*()_+-=[]{}|;:,.<>?",
    };

    const similar = "il1Lo0O";

    function updateLength() {
      document.getElementById("lengthValue").innerText =
        document.getElementById("length").value;
    }

    function generate() {
      const length = parseInt(document.getElementById("length").value);
      const useUppercase = document.getElementById("uppercase").checked;
      const useLowercase = document.getElementById("lowercase").checked;
      const useNumbers = document.getElementById("numbers").checked;
      const useSymbols = document.getElementById("symbols").checked;
      const excludeSimilar = document.getElementById("excludeSimilar").checked;

      let chars = "";
      if (useUppercase) chars += charSets.uppercase;
      if (useLowercase) chars += charSets.lowercase;
      if (useNumbers) chars += charSets.numbers;
      if (useSymbols) chars += charSets.symbols;

      if (excludeSimilar) {
        chars = chars
          .split("")
          .filter((c) => !similar.includes(c))
          .join("");
      }

      if (!chars) {
        document.getElementById("password").value =
          "Select at least one option";
        return;
      }

      let password = "";
      const array = new Uint32Array(length);
      crypto.getRandomValues(array);

      for (let i = 0; i < length; i++) {
        password += chars[array[i] % chars.length];
      }

      document.getElementById("password").value = password;
      updateStrength(
        password,
        useUppercase,
        useLowercase,
        useNumbers,
        useSymbols,
      );
    }

    function updateStrength(password, upper, lower, nums, syms) {
      const length = password.length;
      const typesUsed = [upper, lower, nums, syms].filter(Boolean).length;

      let strength, color;
      if (length >= 16 && typesUsed >= 3) {
        strength = "💪 Very Strong";
        color = "text-green-600";
      } else if (length >= 12 && typesUsed >= 2) {
        strength = "✅ Strong";
        color = "text-green-500";
      } else if (length >= 8) {
        strength = "⚠️ Moderate";
        color = "text-yellow-600";
      } else {
        strength = "❌ Weak";
        color = "text-red-600";
      }

      const el = document.getElementById("strength");
      el.innerText = strength;
      el.className = `text-sm font-medium ${color}`;
    }

    function copy() {
      const password = document.getElementById("password");
      password.select();
      document.execCommand("copy");
      alert("Password copied!");
    }

    generate();
  </script>
</DevToolLayout>
