---
import DevToolLayout from "../../layouts/DevToolLayout.astro";

const faqItems = [
  {
    question: "What is Lorem Ipsum?",
    answer:
      "Lorem Ipsum is placeholder text used in design and publishing to simulate content before final copy is available.",
  },
  {
    question: "Can I generate specific amounts?",
    answer:
      "Yes, you can specify the number of paragraphs, sentences, or words you need.",
  },
  {
    question: "Is this tool free?",
    answer:
      "Yes, this tool is completely free and works directly in your browser.",
  },
];

const howItWorks = [
  {
    title: "Word Pool",
    content:
      "Uses Latin-like words from the standard Lorem Ipsum corpus. Over 100 words for natural text variation.",
  },
  {
    title: "Paragraph Generation",
    content:
      "Each paragraph contains 4-7 random sentences. Sentences have 8-17 words with proper capitalization.",
  },
  {
    title: "Sentence Generation",
    content:
      "Random words joined with spaces, capitalized first letter, period at end. Natural reading flow.",
  },
  {
    title: "Word Generation",
    content:
      "Simply outputs the requested number of words. Useful for testing exact character limits.",
  },
  {
    title: "Randomization",
    content:
      "Each generation creates unique text. Text varies each time you click Generate.",
  },
];

const useCases = [
  {
    title: "Web Design Mockups",
    description:
      "Fill layouts with placeholder text before real content is ready. Visualize typography and spacing.",
  },
  {
    title: "Print Layout Design",
    description:
      "Fill magazine, brochure, or book layouts with placeholder text. Test column widths and page flow.",
  },
  {
    title: "App Development",
    description:
      "Populate UI components with realistic text lengths. Test how interfaces handle various content sizes.",
  },
  {
    title: "Presentation Design",
    description:
      "Fill slide templates with placeholder text while developing presentation structure.",
  },
  {
    title: "Content Management Testing",
    description:
      "Generate test content for CMS functionality. Test how systems handle various content lengths.",
  },
  {
    title: "Typography Showcase",
    description:
      "Display font samples with neutral text. Focus on letterforms without content distraction.",
  },
];
---

<DevToolLayout
  title="Lorem Ipsum Generator - Generate Placeholder Text"
  description="Generate Lorem Ipsum placeholder text. Choose paragraphs, sentences, or words. Free online tool."
  canonicalPath="/dev/lorem-ipsum"
  currentTool="Lorem Ipsum Generator"
  faqItems={faqItems}
  howItWorks={howItWorks}
  useCases={useCases}
>
  <div class="tool-header">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">
      Lorem Ipsum Generator
    </h1>
    <p class="text-slate-500">
      Generate placeholder text for your designs and mockups.
    </p>
  </div>

  <div class="bg-slate-50 border border-slate-200 rounded p-6 mb-8">
    <div class="flex flex-wrap gap-4 mb-6">
      <div>
        <label
          for="count"
          class="block font-medium text-slate-700 mb-1.5 text-sm">Amount</label
        >
        <input
          type="number"
          id="count"
          value="3"
          min="1"
          max="20"
          class="w-20 px-4 py-3 border border-slate-300 rounded bg-white text-slate-800 outline-none"
        />
      </div>
      <div>
        <label
          for="type"
          class="block font-medium text-slate-700 mb-1.5 text-sm">Type</label
        >
        <select
          id="type"
          class="px-4 py-3 border border-slate-300 rounded bg-white text-slate-800 outline-none"
        >
          <option value="paragraphs">Paragraphs</option>
          <option value="sentences">Sentences</option>
          <option value="words">Words</option>
        </select>
      </div>
      <div class="flex items-end">
        <button
          onclick="generate()"
          class="btn-primary px-6 py-3 font-semibold text-white rounded"
          >Generate</button
        >
      </div>
    </div>

    <div class="mb-4">
      <label class="block font-medium text-slate-700 mb-1.5 text-sm"
        >Generated Text</label
      >
      <textarea
        id="output"
        rows="10"
        readonly
        class="w-full px-4 py-3 text-base border border-slate-300 rounded bg-white text-slate-800 outline-none resize-y"
      ></textarea>
    </div>

    <button
      onclick="copyResult()"
      class="px-4 py-2 bg-white border border-slate-300 rounded text-sm"
      >📋 Copy Text</button
    >
  </div>

  <script is:inline>
    const loremWords = [
      "lorem",
      "ipsum",
      "dolor",
      "sit",
      "amet",
      "consectetur",
      "adipiscing",
      "elit",
      "sed",
      "do",
      "eiusmod",
      "tempor",
      "incididunt",
      "ut",
      "labore",
      "et",
      "dolore",
      "magna",
      "aliqua",
      "enim",
      "ad",
      "minim",
      "veniam",
      "quis",
      "nostrud",
      "exercitation",
      "ullamco",
      "laboris",
      "nisi",
      "aliquip",
      "ex",
      "ea",
      "commodo",
      "consequat",
      "duis",
      "aute",
      "irure",
      "in",
      "reprehenderit",
      "voluptate",
      "velit",
      "esse",
      "cillum",
      "fugiat",
      "nulla",
      "pariatur",
      "excepteur",
      "sint",
      "occaecat",
      "cupidatat",
      "non",
      "proident",
      "sunt",
      "culpa",
      "qui",
      "officia",
      "deserunt",
      "mollit",
      "anim",
      "id",
      "est",
      "laborum",
      "perspiciatis",
      "unde",
      "omnis",
      "iste",
      "natus",
      "error",
      "voluptatem",
      "accusantium",
      "doloremque",
      "laudantium",
      "totam",
      "rem",
      "aperiam",
      "eaque",
      "ipsa",
      "quae",
      "ab",
      "illo",
      "inventore",
      "veritatis",
      "quasi",
      "architecto",
      "beatae",
      "vitae",
      "dicta",
      "explicabo",
      "nemo",
      "ipsam",
      "quia",
      "voluptas",
      "aspernatur",
      "aut",
      "odit",
      "fugit",
      "consequuntur",
      "magni",
      "dolores",
      "eos",
      "ratione",
      "sequi",
      "nesciunt",
    ];

    function getRandomWords(count) {
      return Array.from(
        { length: count },
        () => loremWords[Math.floor(Math.random() * loremWords.length)],
      ).join(" ");
    }

    function getSentence() {
      const wordCount = 8 + Math.floor(Math.random() * 10);
      const sentence = getRandomWords(wordCount);
      return sentence.charAt(0).toUpperCase() + sentence.slice(1) + ".";
    }

    function getParagraph() {
      const sentenceCount = 4 + Math.floor(Math.random() * 4);
      return Array.from({ length: sentenceCount }, getSentence).join(" ");
    }

    function generate() {
      const count = parseInt(document.getElementById("count").value) || 3;
      const type = document.getElementById("type").value;
      let result = "";

      switch (type) {
        case "paragraphs":
          result = Array.from({ length: count }, getParagraph).join("\n\n");
          break;
        case "sentences":
          result = Array.from({ length: count }, getSentence).join(" ");
          break;
        case "words":
          result = getRandomWords(count);
          result = result.charAt(0).toUpperCase() + result.slice(1);
          break;
      }

      document.getElementById("output").value = result;
    }

    function copyResult() {
      document.getElementById("output").select();
      document.execCommand("copy");
      alert("Copied!");
    }

    generate();
  </script>
</DevToolLayout>
