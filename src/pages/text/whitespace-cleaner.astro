---
import TextToolLayout from "../../layouts/TextToolLayout.astro";

const faqItems = [
  {
    question: "What types of whitespace can be cleaned?",
    answer: "Multiple spaces, tabs, leading/trailing spaces, and blank lines.",
  },
  {
    question: "Will it preserve line breaks?",
    answer:
      "Yes, line breaks are preserved unless you enable 'Remove blank lines'.",
  },
  {
    question: "Is this tool free?",
    answer:
      "Yes, this tool is completely free and works directly in your browser.",
  },
];

const howItWorks = [
  {
    title: "Tab Conversion",
    content:
      "Tabs (\\t) are replaced with spaces using a simple regex replacement. This standardizes indentation before further processing.",
  },
  {
    title: "Line Trimming",
    content:
      "Each line is processed with trim() to remove leading and trailing whitespace. This cleans up inconsistent indentation and trailing spaces.",
  },
  {
    title: "Multiple Space Collapse",
    content:
      "Regex / {2,}/g matches two or more consecutive spaces and replaces them with a single space. This normalizes word spacing.",
  },
  {
    title: "Blank Line Removal",
    content:
      "When enabled, lines are filtered to remove those where trim().length === 0. This eliminates both empty lines and whitespace-only lines.",
  },
  {
    title: "Character Statistics",
    content:
      "The tool compares input and output lengths, showing exactly how many characters were removed during cleaning.",
  },
];

const useCases = [
  {
    title: "Code Formatting",
    description:
      "Clean up inconsistent spacing in code. Standardize indentation and remove trailing whitespace that fails linting.",
  },
  {
    title: "Copy-Paste Cleanup",
    description:
      "Clean text copied from PDFs, Word documents, or websites that often includes excessive whitespace.",
  },
  {
    title: "Database Preparation",
    description:
      "Normalize text data before database insertion. Prevent issues with whitespace variations in search and comparison.",
  },
  {
    title: "Email Content Cleaning",
    description:
      "Clean up email content with irregular spacing. Prepare text for professional communication.",
  },
  {
    title: "OCR Post-Processing",
    description:
      "Clean text output from OCR that often has inconsistent spacing due to recognition errors.",
  },
  {
    title: "Configuration File Cleanup",
    description:
      "Standardize spacing in configuration files where whitespace might cause parsing issues.",
  },
];
---

<TextToolLayout
  title="Whitespace Cleaner - Remove Extra Spaces Online"
  description="Clean up whitespace: remove extra spaces, tabs, and leading/trailing spaces. Free online text cleaner."
  canonicalPath="/text/whitespace-cleaner"
  currentTool="Whitespace Cleaner"
  faqItems={faqItems}
  howItWorks={howItWorks}
  useCases={useCases}
>
  <div class="tool-header">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">
      Whitespace Cleaner
    </h1>
    <p class="text-slate-500">
      Remove extra spaces, tabs, and clean up whitespace.
    </p>
  </div>

  <div class="bg-slate-50 border border-slate-200 rounded p-6 mb-8">
    <div class="mb-4">
      <label for="input" class="block font-medium text-slate-700 mb-1.5 text-sm"
        >Input Text</label
      >
      <textarea
        id="input"
        rows="6"
        placeholder="Paste text with extra whitespace..."
        class="w-full px-4 py-3 text-base border border-slate-300 rounded bg-white text-slate-800 outline-none resize-y font-mono"
      ></textarea>
    </div>

    <div class="flex flex-wrap gap-4 mb-4">
      <label class="flex items-center gap-2 text-sm text-slate-600">
        <input type="checkbox" id="multipleSpaces" checked class="w-4 h-4" />
        Multiple spaces → single
      </label>
      <label class="flex items-center gap-2 text-sm text-slate-600">
        <input type="checkbox" id="trimLines" checked class="w-4 h-4" />
        Trim line start/end
      </label>
      <label class="flex items-center gap-2 text-sm text-slate-600">
        <input type="checkbox" id="tabsToSpaces" checked class="w-4 h-4" />
        Tabs → spaces
      </label>
      <label class="flex items-center gap-2 text-sm text-slate-600">
        <input type="checkbox" id="removeBlankLines" class="w-4 h-4" />
        Remove blank lines
      </label>
    </div>

    <button
      onclick="clean()"
      class="btn-primary px-6 py-2 font-semibold text-white rounded"
      >Clean Whitespace</button
    >

    <div class="mt-4">
      <label class="block font-medium text-slate-700 mb-1.5 text-sm"
        >Cleaned Text</label
      >
      <textarea
        id="output"
        rows="6"
        readonly
        class="w-full px-4 py-3 text-base border border-slate-300 rounded bg-white text-slate-800 outline-none resize-y font-mono"
      ></textarea>
    </div>

    <div class="flex gap-3 mt-4">
      <button
        onclick="copyResult()"
        class="px-4 py-2 bg-white border border-slate-300 rounded text-sm hover:border-emerald-500"
        >📋 Copy Result</button
      >
      <span class="text-sm text-slate-500 self-center" id="stats"></span>
    </div>
  </div>

  <script is:inline>
    function clean() {
      let text = document.getElementById("input").value;
      const originalLength = text.length;

      if (document.getElementById("tabsToSpaces").checked) {
        text = text.replace(/\t/g, "  ");
      }

      if (document.getElementById("trimLines").checked) {
        text = text
          .split("\n")
          .map((l) => l.trim())
          .join("\n");
      }

      if (document.getElementById("multipleSpaces").checked) {
        text = text.replace(/ {2,}/g, " ");
      }

      if (document.getElementById("removeBlankLines").checked) {
        text = text
          .split("\n")
          .filter((l) => l.trim().length > 0)
          .join("\n");
      }

      document.getElementById("output").value = text;
      const removed = originalLength - text.length;
      document.getElementById("stats").innerText =
        `Removed ${removed} characters`;
    }

    function copyResult() {
      document.getElementById("output").select();
      document.execCommand("copy");
      alert("Copied!");
    }
  </script>
</TextToolLayout>
