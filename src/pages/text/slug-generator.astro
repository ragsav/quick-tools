---
import TextToolLayout from "../../layouts/TextToolLayout.astro";

const faqItems = [
  {
    question: "What is a URL slug?",
    answer:
      "A slug is the URL-friendly version of a title, using only lowercase letters, numbers, and separators.",
  },
  {
    question: "What separators can I use?",
    answer: "You can choose between dash (-), underscore (_), or no separator.",
  },
  {
    question: "Is this tool free?",
    answer:
      "Yes, this tool is completely free and works directly in your browser.",
  },
];

const howItWorks = [
  {
    title: "Lowercase Conversion",
    content:
      "All text is converted to lowercase since URLs are case-insensitive and lowercase is the convention. This ensures consistency across all links.",
  },
  {
    title: "Diacritic Removal",
    content:
      "Accented characters (é, ñ, ü) are normalized using NFD (Canonical Decomposition) then stripped of combining marks. This converts 'café' to 'cafe' for ASCII compatibility.",
  },
  {
    title: "Special Character Stripping",
    content:
      "Punctuation and special characters (!@#$%^&*) are removed as they're not URL-safe. Only letters, numbers, and spaces remain at this stage.",
  },
  {
    title: "Separator Replacement",
    content:
      "Spaces are replaced with your chosen separator (dash, underscore, or nothing). Multiple consecutive spaces become a single separator to keep slugs clean.",
  },
  {
    title: "Final Cleanup",
    content:
      "Leading/trailing whitespace is trimmed and any consecutive separators are collapsed to single ones. The result is a clean, URL-ready slug.",
  },
];

const useCases = [
  {
    title: "Blog Post URLs",
    description:
      "Convert article titles to SEO-friendly URLs. 'How to Cook Pasta!' becomes 'how-to-cook-pasta' for clean, readable links.",
  },
  {
    title: "E-commerce Product Pages",
    description:
      "Generate product page URLs from product names. Clean slugs improve SEO and user experience for online stores.",
  },
  {
    title: "CMS Content Management",
    description:
      "WordPress, Drupal, and other CMS platforms use slugs for page URLs. Pre-generate slugs for content imports.",
  },
  {
    title: "API Endpoint Design",
    description:
      "Create consistent, readable API endpoints from resource names. Slugs make REST APIs more intuitive.",
  },
  {
    title: "File Naming",
    description:
      "Generate filesystem-safe names for uploads and downloads. Avoid spaces and special characters that cause issues.",
  },
  {
    title: "Social Sharing Links",
    description:
      "Create memorable, shareable links for campaigns. Clean URLs are easier to share and remember.",
  },
];
---

<TextToolLayout
  title="Slug Generator - Create URL Slugs Online"
  description="Generate clean URL slugs from text. Create SEO-friendly URLs for your website. Free online slug generator."
  canonicalPath="/text/slug-generator"
  currentTool="Slug Generator"
  faqItems={faqItems}
  howItWorks={howItWorks}
  useCases={useCases}
>
  <div class="tool-header">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">
      Slug Generator
    </h1>
    <p class="text-slate-500">Create SEO-friendly URL slugs from any text.</p>
  </div>

  <div class="bg-slate-50 border border-slate-200 rounded p-6 mb-8">
    <div class="mb-4">
      <label for="input" class="block font-medium text-slate-700 mb-1.5 text-sm"
        >Enter Title or Text</label
      >
      <input
        type="text"
        id="input"
        placeholder="My Awesome Blog Post Title!"
        class="w-full px-4 py-3 text-base border border-slate-300 rounded bg-white text-slate-800 outline-none"
        oninput="generate()"
      />
    </div>

    <div class="mb-4">
      <label class="block font-medium text-slate-700 mb-1.5 text-sm"
        >Separator</label
      >
      <div class="flex gap-2">
        <button
          onclick="setSep('-')"
          id="sep-dash"
          class="px-4 py-2 border rounded text-sm bg-emerald-50 border-emerald-500 text-emerald-700"
          >Dash (-)</button
        >
        <button
          onclick="setSep('_')"
          id="sep-underscore"
          class="px-4 py-2 border border-slate-200 rounded text-sm"
          >Underscore (_)</button
        >
        <button
          onclick="setSep('')"
          id="sep-none"
          class="px-4 py-2 border border-slate-200 rounded text-sm">None</button
        >
      </div>
    </div>

    <div class="mb-4">
      <label class="block font-medium text-slate-700 mb-1.5 text-sm"
        >Generated Slug</label
      >
      <div class="flex gap-2">
        <input
          type="text"
          id="output"
          readonly
          class="flex-1 px-4 py-3 text-base border border-slate-300 rounded bg-white text-slate-800 font-mono"
        />
        <button
          onclick="copyResult()"
          class="px-4 py-2 bg-white border border-slate-300 rounded text-sm hover:border-emerald-500"
          aria-label="Copy to clipboard"
          title="Copy to clipboard"
          >📋</button
        >
      </div>
    </div>

    <div class="text-sm text-slate-500" id="preview"></div>
  </div>

  <section class="mt-8 pt-6 border-t border-slate-200">
    <h2 class="text-xl font-semibold text-slate-900 mb-4">
      What is a URL Slug?
    </h2>
    <p class="text-slate-600 mb-3">
      A slug is the part of a URL that identifies a specific page in a
      human-readable format.
    </p>
    <p class="text-slate-600">
      Example: <code class="bg-slate-100 px-1 rounded"
        >example.com/blog/<strong>my-awesome-blog-post</strong></code
      >
    </p>
  </section>

  <script is:inline>
    let separator = "-";

    function setSep(sep) {
      separator = sep;
      ["dash", "underscore", "none"].forEach((s) => {
        const btn = document.getElementById("sep-" + s);
        btn.className =
          "px-4 py-2 border rounded text-sm " +
          (btn.id ===
          "sep-" + (sep === "-" ? "dash" : sep === "_" ? "underscore" : "none")
            ? "bg-emerald-50 border-emerald-500 text-emerald-700"
            : "border-slate-200");
      });
      generate();
    }

    function generate() {
      const input = document.getElementById("input").value;

      let slug = input
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "") // Remove diacritics
        .replace(/[^a-z0-9\s-]/g, "") // Remove special chars
        .trim()
        .replace(/\s+/g, separator) // Replace spaces
        .replace(new RegExp(`${separator}+`, "g"), separator); // Remove duplicate separators

      document.getElementById("output").value = slug;
      document.getElementById("preview").innerHTML = slug
        ? `Preview: <code class="bg-slate-100 px-1 rounded">example.com/page/<strong>${slug}</strong></code>`
        : "";
    }

    function copyResult() {
      document.getElementById("output").select();
      document.execCommand("copy");
      alert("Copied!");
    }
  </script>
</TextToolLayout>
