---
import TextToolLayout from "../../layouts/TextToolLayout.astro";

const faqItems = [
  {
    question: "What's the Twitter character limit?",
    answer:
      "Twitter allows 280 characters per tweet. This tool shows you how close you are to that limit.",
  },
  {
    question: "What's the difference between with and without spaces?",
    answer:
      "With spaces includes all characters; without spaces excludes space characters from the count.",
  },
  {
    question: "Is this tool free to use?",
    answer:
      "Yes, this tool is completely free and works directly in your browser.",
  },
];

const howItWorks = [
  {
    title: "Total Character Count",
    content:
      "The string's length property returns the total character count including all letters, numbers, spaces, punctuation, and special characters. This is instant and always accurate.",
  },
  {
    title: "Without Spaces Count",
    content:
      "Space characters are removed using regex /\\s/g which matches all whitespace (spaces, tabs, newlines). The remaining string's length gives character count without spaces.",
  },
  {
    title: "Word Counting",
    content:
      "Words are counted by splitting on whitespace and filtering empty entries. This provides context alongside character counts for understanding text density.",
  },
  {
    title: "Line Counting",
    content:
      "Lines are counted by splitting on newline characters (\\n). This is useful for code, poetry, or any text where line count matters.",
  },
  {
    title: "Limit Visualization",
    content:
      "Progress bars show percentage of common limits (Twitter, SMS, meta descriptions). Colors change from green to red when limits are exceeded.",
  },
];

const useCases = [
  {
    title: "Twitter/X Post Writing",
    description:
      "Craft tweets that fit within the 280-character limit. The visual progress bar shows exactly how much space you have left.",
  },
  {
    title: "SMS Marketing",
    description:
      "Standard SMS messages are 160 characters. Exceeding this splits into multiple messages, increasing costs. Stay within single-message limits.",
  },
  {
    title: "Meta Description Writing",
    description:
      "SEO meta descriptions should be 150-160 characters for optimal display in search results. Track length to avoid truncation.",
  },
  {
    title: "Form Field Validation",
    description:
      "When designing forms with character limits, test your sample content to ensure it fits within database field constraints.",
  },
  {
    title: "Ad Copy Creation",
    description:
      "Digital ads have strict character limits: Google Ads headlines (30 chars), descriptions (90 chars). Craft copy that fits perfectly.",
  },
  {
    title: "Bio & Profile Writing",
    description:
      "Social media bios often have limits (Instagram: 150, LinkedIn: 2600). Write compelling bios that maximize allowed space.",
  },
];
---

<TextToolLayout
  title="Character Counter - Count Characters Online"
  description="Count characters with and without spaces. Check Twitter, SMS, and meta description limits. Free online tool."
  canonicalPath="/text/character-counter"
  currentTool="Character Counter"
  faqItems={faqItems}
  howItWorks={howItWorks}
  useCases={useCases}
>
  <div class="tool-header">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">
      Character Counter
    </h1>
    <p class="text-slate-500">
      Count characters, check limits for Twitter, SMS, and more.
    </p>
  </div>

  <div class="bg-slate-50 border border-slate-200 rounded p-6 mb-8">
    <div class="mb-4">
      <label
        for="textInput"
        class="block font-medium text-slate-700 mb-1.5 text-sm"
        >Enter your text</label
      >
      <textarea
        id="textInput"
        rows="6"
        placeholder="Type or paste text here..."
        class="w-full px-4 py-3 text-base border border-slate-300 rounded bg-white text-slate-800 outline-none resize-y"
        oninput="analyze()"></textarea>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
      <div class="bg-white p-4 rounded border border-slate-200 text-center">
        <div class="text-3xl font-bold text-emerald-600" id="charWithSpaces">
          0
        </div>
        <div class="text-xs text-slate-500">With Spaces</div>
      </div>
      <div class="bg-white p-4 rounded border border-slate-200 text-center">
        <div class="text-3xl font-bold text-emerald-600" id="charWithoutSpaces">
          0
        </div>
        <div class="text-xs text-slate-500">Without Spaces</div>
      </div>
      <div class="bg-white p-4 rounded border border-slate-200 text-center">
        <div class="text-3xl font-bold text-emerald-600" id="wordCount">0</div>
        <div class="text-xs text-slate-500">Words</div>
      </div>
      <div class="bg-white p-4 rounded border border-slate-200 text-center">
        <div class="text-3xl font-bold text-emerald-600" id="lineCount">0</div>
        <div class="text-xs text-slate-500">Lines</div>
      </div>
    </div>

    <h3 class="font-medium text-slate-700 mb-3">Character Limits</h3>
    <div class="space-y-3">
      <div class="flex items-center gap-3">
        <span class="w-32 text-sm text-slate-600">Twitter (280)</span>
        <div class="flex-1 bg-slate-200 rounded-full h-2">
          <div
            id="twitterBar"
            class="h-2 rounded-full bg-emerald-500 transition-all"
            style="width: 0%"
          >
          </div>
        </div>
        <span class="text-sm text-slate-600 w-16 text-right" id="twitterCount"
          >0/280</span
        >
      </div>
      <div class="flex items-center gap-3">
        <span class="w-32 text-sm text-slate-600">SMS (160)</span>
        <div class="flex-1 bg-slate-200 rounded-full h-2">
          <div
            id="smsBar"
            class="h-2 rounded-full bg-emerald-500 transition-all"
            style="width: 0%"
          >
          </div>
        </div>
        <span class="text-sm text-slate-600 w-16 text-right" id="smsCount"
          >0/160</span
        >
      </div>
      <div class="flex items-center gap-3">
        <span class="w-32 text-sm text-slate-600">Meta Desc (160)</span>
        <div class="flex-1 bg-slate-200 rounded-full h-2">
          <div
            id="metaBar"
            class="h-2 rounded-full bg-emerald-500 transition-all"
            style="width: 0%"
          >
          </div>
        </div>
        <span class="text-sm text-slate-600 w-16 text-right" id="metaCount"
          >0/160</span
        >
      </div>
    </div>
  </div>

  <script is:inline>
    function analyze() {
      const text = document.getElementById("textInput").value;

      document.getElementById("charWithSpaces").innerText = text.length;
      document.getElementById("charWithoutSpaces").innerText = text.replace(
        /\s/g,
        "",
      ).length;

      const words = text.trim() ? text.trim().split(/\s+/) : [];
      document.getElementById("wordCount").innerText = words.length;

      const lines = text.split("\n");
      document.getElementById("lineCount").innerText = lines.length;

      // Progress bars
      updateBar("twitter", text.length, 280);
      updateBar("sms", text.length, 160);
      updateBar("meta", text.length, 160);
    }

    function updateBar(name, current, max) {
      const percent = Math.min((current / max) * 100, 100);
      const bar = document.getElementById(name + "Bar");
      const count = document.getElementById(name + "Count");

      bar.style.width = percent + "%";
      bar.className = `h-2 rounded-full transition-all ${current > max ? "bg-red-500" : "bg-emerald-500"}`;
      count.innerText = `${current}/${max}`;
      count.className = `text-sm w-16 text-right ${current > max ? "text-red-600 font-medium" : "text-slate-600"}`;
    }
  </script>
</TextToolLayout>
