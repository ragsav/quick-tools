---
import TextToolLayout from "../../layouts/TextToolLayout.astro";

const faqItems = [
  {
    question: "What counts as an empty line?",
    answer:
      "Lines with no characters. You can also remove lines that contain only whitespace.",
  },
  {
    question: "Can I keep lines that have only spaces?",
    answer:
      "Yes, uncheck 'Remove whitespace-only lines' to keep lines that contain only spaces or tabs.",
  },
  {
    question: "Is this tool free?",
    answer:
      "Yes, this tool is completely free and works directly in your browser.",
  },
];

const howItWorks = [
  {
    title: "Line Separation",
    content:
      "Text is split on newline characters (\\n) to create an array of lines. Each line is then evaluated for emptiness.",
  },
  {
    title: "Empty Line Detection",
    content:
      "A line with length === 0 is truly empty. This catches lines that are just newline characters with no content between them.",
  },
  {
    title: "Whitespace-Only Detection",
    content:
      "When enabled, line.trim().length === 0 catches lines containing only spaces, tabs, or other whitespace characters.",
  },
  {
    title: "Filter Operation",
    content:
      "JavaScript's filter() method creates a new array containing only lines that pass the non-empty check. Original line order is preserved.",
  },
  {
    title: "Statistics Tracking",
    content:
      "The tool counts lines before and after filtering, showing exactly how many empty lines were removed for verification.",
  },
];

const useCases = [
  {
    title: "Code Formatting",
    description:
      "Remove excessive blank lines from code files. Maintain consistent vertical spacing according to style guides.",
  },
  {
    title: "Document Cleanup",
    description:
      "Clean up pasted content from PDFs or web pages that often contains extra line breaks.",
  },
  {
    title: "Data Processing",
    description:
      "Prepare data files by removing blank lines before parsing or importing into databases.",
  },
  {
    title: "Log Compression",
    description:
      "Remove empty lines from log files to reduce file size and improve readability.",
  },
  {
    title: "Markdown Cleanup",
    description:
      "Clean markdown files with excessive blank lines that cause unwanted spacing in rendered output.",
  },
  {
    title: "CSV/Text Preparation",
    description:
      "Remove blank rows from text data before converting to CSV or other structured formats.",
  },
];
---

<TextToolLayout
  title="Remove Empty Lines - Delete Blank Lines Online"
  description="Remove empty and blank lines from text. Clean up your data by removing unnecessary line breaks."
  canonicalPath="/text/remove-empty-lines"
  currentTool="Remove Empty Lines"
  faqItems={faqItems}
  howItWorks={howItWorks}
  useCases={useCases}
>
  <div class="tool-header">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">
      Remove Empty Lines
    </h1>
    <p class="text-slate-500">
      Remove empty, blank, and whitespace-only lines.
    </p>
  </div>

  <div class="bg-slate-50 border border-slate-200 rounded p-6 mb-8">
    <div class="grid md:grid-cols-2 gap-6">
      <div>
        <label
          for="input"
          class="block font-medium text-slate-700 mb-1.5 text-sm"
          >Input Text</label
        >
        <textarea
          id="input"
          rows="10"
          placeholder="Paste text with empty lines..."
          class="w-full px-4 py-3 text-base border border-slate-300 rounded bg-white text-slate-800 outline-none resize-y font-mono text-sm"
        ></textarea>
      </div>
      <div>
        <label class="block font-medium text-slate-700 mb-1.5 text-sm"
          >Output</label
        >
        <textarea
          id="output"
          rows="10"
          readonly
          class="w-full px-4 py-3 text-base border border-slate-300 rounded bg-white text-slate-800 outline-none resize-y font-mono text-sm"
        ></textarea>
      </div>
    </div>

    <div class="flex gap-4 mt-4 items-center">
      <label class="flex items-center gap-2 text-sm text-slate-600">
        <input
          type="checkbox"
          id="removeWhitespaceOnly"
          checked
          class="w-4 h-4"
        />
        Remove whitespace-only lines
      </label>
    </div>

    <div class="flex gap-3 mt-4">
      <button
        onclick="process()"
        class="btn-primary px-6 py-2 font-semibold text-white rounded"
        >Remove Empty Lines</button
      >
      <button
        onclick="copyResult()"
        class="px-4 py-2 bg-white border border-slate-300 rounded text-sm"
        >📋 Copy</button
      >
    </div>

    <div class="mt-4 text-sm text-slate-600" id="stats"></div>
  </div>

  <script is:inline>
    function process() {
      const input = document.getElementById("input").value;
      const removeWhitespaceOnly = document.getElementById(
        "removeWhitespaceOnly",
      ).checked;

      const lines = input.split("\n");
      const originalCount = lines.length;

      const filtered = lines.filter((line) => {
        if (removeWhitespaceOnly) {
          return line.trim().length > 0;
        }
        return line.length > 0;
      });

      document.getElementById("output").value = filtered.join("\n");
      document.getElementById("stats").innerText =
        `${originalCount} lines → ${filtered.length} lines (${originalCount - filtered.length} empty lines removed)`;
    }

    function copyResult() {
      document.getElementById("output").select();
      document.execCommand("copy");
      alert("Copied!");
    }
  </script>
</TextToolLayout>
