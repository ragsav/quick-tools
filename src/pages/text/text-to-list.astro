---
import TextToolLayout from "../../layouts/TextToolLayout.astro";

const faqItems = [
  {
    question: "What list formats can I create?",
    answer:
      "Bullet lists, dash lists, numbered lists, HTML ul/ol, Markdown, and comma-separated values.",
  },
  {
    question: "How do I enter multiple items?",
    answer: "Enter one item per line in the input field.",
  },
  {
    question: "Is this tool free?",
    answer:
      "Yes, this tool is completely free and works directly in your browser.",
  },
];

const howItWorks = [
  {
    title: "Line Splitting",
    content:
      "Input text is split on newlines to create an array of items. Empty lines are filtered out to ensure clean output.",
  },
  {
    title: "Prefix Addition",
    content:
      "Each format adds appropriate prefixes: • for bullets, - for dashes, 1. 2. 3. for numbered lists. The formatting is applied consistently to all items.",
  },
  {
    title: "HTML Generation",
    content:
      "For HTML output, items are wrapped in <li> tags and enclosed in either <ul> (unordered) or <ol> (ordered) container tags with proper indentation.",
  },
  {
    title: "Markdown Format",
    content:
      "Markdown lists use dash prefixes (- item) which render as bullet points. This is compatible with GitHub, documentation tools, and markdown editors.",
  },
  {
    title: "CSV Output",
    content:
      "Comma-separated output joins all items with ', ' creating a single-line format suitable for spreadsheets or data fields.",
  },
];

const useCases = [
  {
    title: "HTML Content Creation",
    description:
      "Quickly generate HTML list markup from plain text items. Perfect for web developers and content editors.",
  },
  {
    title: "Documentation Writing",
    description:
      "Convert notes to proper Markdown lists for README files, wikis, and technical documentation.",
  },
  {
    title: "Presentation Prep",
    description:
      "Format talking points as bullet lists for presentations, meeting agendas, or slide content.",
  },
  {
    title: "Email Formatting",
    description:
      "Convert plain text to formatted lists for cleaner, more scannable email content.",
  },
  {
    title: "Data Field Population",
    description:
      "Generate comma-separated values from lists for populating database fields or form inputs.",
  },
  {
    title: "Shopping & Task Lists",
    description:
      "Format random items into organized checkbox or bullet lists for shopping, chores, or todo items.",
  },
];
---

<TextToolLayout
  title="Text to List Converter - Convert Text to Bullet List"
  description="Convert plain text lines into formatted bullet or numbered lists. Free online list maker."
  canonicalPath="/text/text-to-list"
  currentTool="Text to List"
  faqItems={faqItems}
  howItWorks={howItWorks}
  useCases={useCases}
>
  <div class="tool-header">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">
      Text to List Converter
    </h1>
    <p class="text-slate-500">Convert lines of text into formatted lists.</p>
  </div>

  <div class="bg-slate-50 border border-slate-200 rounded p-6 mb-8">
    <div class="grid md:grid-cols-2 gap-6">
      <div>
        <label
          for="input"
          class="block font-medium text-slate-700 mb-1.5 text-sm"
          >Input (one item per line)</label
        >
        <textarea
          id="input"
          rows="10"
          placeholder="Item 1
Item 2
Item 3"
          class="w-full px-4 py-3 text-base border border-slate-300 rounded bg-white text-slate-800 outline-none resize-y font-mono text-sm"
        ></textarea>
      </div>
      <div>
        <label class="block font-medium text-slate-700 mb-1.5 text-sm"
          >Output</label
        >
        <textarea
          id="output"
          rows="10"
          readonly
          class="w-full px-4 py-3 text-base border border-slate-300 rounded bg-white text-slate-800 outline-none resize-y font-mono text-sm"
        ></textarea>
      </div>
    </div>

    <div class="flex flex-wrap gap-2 mt-4">
      <button
        onclick="convert('bullet')"
        class="px-4 py-2 bg-white border border-slate-200 rounded text-sm hover:border-emerald-500"
        >• Bullet List</button
      >
      <button
        onclick="convert('dash')"
        class="px-4 py-2 bg-white border border-slate-200 rounded text-sm hover:border-emerald-500"
        >- Dash List</button
      >
      <button
        onclick="convert('number')"
        class="px-4 py-2 bg-white border border-slate-200 rounded text-sm hover:border-emerald-500"
        >1. Numbered</button
      >
      <button
        onclick="convert('html-ul')"
        class="px-4 py-2 bg-white border border-slate-200 rounded text-sm hover:border-emerald-500"
        >&lt;ul&gt; HTML</button
      >
      <button
        onclick="convert('html-ol')"
        class="px-4 py-2 bg-white border border-slate-200 rounded text-sm hover:border-emerald-500"
        >&lt;ol&gt; HTML</button
      >
      <button
        onclick="convert('md')"
        class="px-4 py-2 bg-white border border-slate-200 rounded text-sm hover:border-emerald-500"
        >Markdown</button
      >
      <button
        onclick="convert('comma')"
        class="px-4 py-2 bg-white border border-slate-200 rounded text-sm hover:border-emerald-500"
        >Comma Separated</button
      >
    </div>

    <div class="flex gap-3 mt-4">
      <button
        onclick="copyResult()"
        class="px-4 py-2 bg-white border border-slate-300 rounded text-sm"
        >📋 Copy</button
      >
    </div>
  </div>

  <script is:inline>
    function convert(type) {
      const input = document.getElementById("input").value;
      const lines = input.split("\n").filter((l) => l.trim());
      let result = "";

      switch (type) {
        case "bullet":
          result = lines.map((l) => "• " + l).join("\n");
          break;
        case "dash":
          result = lines.map((l) => "- " + l).join("\n");
          break;
        case "number":
          result = lines.map((l, i) => i + 1 + ". " + l).join("\n");
          break;
        case "html-ul":
          result =
            "<ul>\n" +
            lines.map((l) => "  <li>" + l + "</li>").join("\n") +
            "\n</ul>";
          break;
        case "html-ol":
          result =
            "<ol>\n" +
            lines.map((l) => "  <li>" + l + "</li>").join("\n") +
            "\n</ol>";
          break;
        case "md":
          result = lines.map((l) => "- " + l).join("\n");
          break;
        case "comma":
          result = lines.join(", ");
          break;
      }

      document.getElementById("output").value = result;
    }

    function copyResult() {
      document.getElementById("output").select();
      document.execCommand("copy");
      alert("Copied!");
    }
  </script>
</TextToolLayout>
