---
import TextToolLayout from "../../layouts/TextToolLayout.astro";

const faqItems = [
  {
    question: "What is URL encoding?",
    answer:
      "URL encoding converts special characters to a format that can be safely transmitted in URLs, like %20 for spaces.",
  },
  {
    question: "When should I use URL encoding?",
    answer:
      "Use it when passing special characters in URL parameters, query strings, or form data.",
  },
  {
    question: "Is this tool free?",
    answer:
      "Yes, this tool is completely free and works directly in your browser.",
  },
];

const howItWorks = [
  {
    title: "Percent Encoding Standard",
    content:
      "URL encoding (percent-encoding) converts characters to the format %XX where XX is the hexadecimal ASCII value. Space becomes %20, @ becomes %40, etc.",
  },
  {
    title: "Safe Characters",
    content:
      "Letters (A-Z, a-z), digits (0-9), and some punctuation (-_.~) are 'safe' and pass through unchanged. All other characters need encoding for URL safety.",
  },
  {
    title: "encodeURIComponent Function",
    content:
      "JavaScript's encodeURIComponent() encodes everything except A-Z a-z 0-9 - _ . ! ~ * ' ( ). This is stricter than encodeURI() and safe for query parameters.",
  },
  {
    title: "UTF-8 Handling",
    content:
      "Non-ASCII characters (like é, 中, ñ) are first converted to UTF-8 bytes, then each byte is percent-encoded. This ensures international character support.",
  },
  {
    title: "Decoding Process",
    content:
      "decodeURIComponent() reverses the encoding, converting %XX sequences back to original characters. Invalid sequences throw errors that this tool catches gracefully.",
  },
];

const useCases = [
  {
    title: "Query String Parameters",
    description:
      "Encode values containing special characters (&, =, ?) for safe inclusion in URL query strings. Essential for search queries and filters.",
  },
  {
    title: "API Requests",
    description:
      "Encode data before sending to APIs via GET requests. Prevents malformed URLs and ensures proper parameter parsing.",
  },
  {
    title: "Email Links",
    description:
      "Create mailto: links with pre-filled subject and body. Encode spaces and special characters for reliable email client handling.",
  },
  {
    title: "OAuth & Authentication",
    description:
      "OAuth flows require URL-encoded redirect URLs and tokens. Proper encoding prevents authentication failures and security issues.",
  },
  {
    title: "Form Data Debugging",
    description:
      "Decode application/x-www-form-urlencoded data from form submissions. Debug and understand what data your forms are sending.",
  },
  {
    title: "Analytics Tracking",
    description:
      "Encode UTM parameters and campaign tracking values. Ensure spaces and special characters don't break analytics tracking.",
  },
];
---

<TextToolLayout
  title="URL Encoder/Decoder - Encode & Decode URLs Online"
  description="Encode and decode URLs and query strings. Convert special characters to URL-safe format. Free online tool."
  canonicalPath="/text/url-encoder"
  currentTool="URL Encoder/Decoder"
  faqItems={faqItems}
  howItWorks={howItWorks}
  useCases={useCases}
>
  <div class="tool-header">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">
      URL Encoder / Decoder
    </h1>
    <p class="text-slate-500">
      Encode special characters or decode URL-encoded text.
    </p>
  </div>

  <div class="bg-slate-50 border border-slate-200 rounded p-6 mb-8">
    <div class="mb-4">
      <label for="input" class="block font-medium text-slate-700 mb-1.5 text-sm"
        >Input</label
      >
      <textarea
        id="input"
        rows="4"
        placeholder="Enter text or URL to encode/decode..."
        class="w-full px-4 py-3 text-base border border-slate-300 rounded bg-white text-slate-800 outline-none resize-y font-mono text-sm"
      ></textarea>
    </div>

    <div class="flex gap-3 mb-4">
      <button
        onclick="encode()"
        class="btn-primary px-6 py-2 font-semibold text-white rounded"
        >Encode</button
      >
      <button
        onclick="decode()"
        class="px-4 py-2 bg-white border border-emerald-500 text-emerald-600 rounded font-medium"
        >Decode</button
      >
      <button
        onclick="swap()"
        class="px-4 py-2 bg-white border border-slate-300 rounded text-sm"
        >⇅ Swap</button
      >
    </div>

    <div class="mb-4">
      <label class="block font-medium text-slate-700 mb-1.5 text-sm"
        >Output</label
      >
      <textarea
        id="output"
        rows="4"
        readonly
        class="w-full px-4 py-3 text-base border border-slate-300 rounded bg-white text-slate-800 outline-none resize-y font-mono text-sm"
      ></textarea>
    </div>

    <div class="flex gap-3">
      <button
        onclick="copyResult()"
        class="px-4 py-2 bg-white border border-slate-300 rounded text-sm"
        >📋 Copy</button
      >
    </div>
  </div>

  <section class="mt-8 pt-6 border-t border-slate-200">
    <h2 class="text-xl font-semibold text-slate-900 mb-4">
      Common Encoded Characters
    </h2>
    <div class="grid grid-cols-4 sm:grid-cols-6 gap-2 text-sm">
      <div class="p-2 bg-white border border-slate-200 rounded text-center">
        <span class="text-slate-500">space</span> → %20
      </div>
      <div class="p-2 bg-white border border-slate-200 rounded text-center">
        & → %26
      </div>
      <div class="p-2 bg-white border border-slate-200 rounded text-center">
        = → %3D
      </div>
      <div class="p-2 bg-white border border-slate-200 rounded text-center">
        ? → %3F
      </div>
      <div class="p-2 bg-white border border-slate-200 rounded text-center">
        / → %2F
      </div>
      <div class="p-2 bg-white border border-slate-200 rounded text-center">
        @ → %40
      </div>
    </div>
  </section>

  <script is:inline>
    function encode() {
      const input = document.getElementById("input").value;
      try {
        document.getElementById("output").value = encodeURIComponent(input);
      } catch (e) {
        document.getElementById("output").value = "Error encoding text";
      }
    }

    function decode() {
      const input = document.getElementById("input").value;
      try {
        document.getElementById("output").value = decodeURIComponent(input);
      } catch (e) {
        document.getElementById("output").value =
          "Error decoding text (invalid encoding)";
      }
    }

    function swap() {
      const input = document.getElementById("input");
      const output = document.getElementById("output");
      const temp = input.value;
      input.value = output.value;
      output.value = temp;
    }

    function copyResult() {
      document.getElementById("output").select();
      document.execCommand("copy");
      alert("Copied!");
    }
  </script>
</TextToolLayout>
