---
import TextToolLayout from "../../layouts/TextToolLayout.astro";

const faqItems = [
  {
    question: "Does it preserve the original order?",
    answer:
      "Yes, the first occurrence of each line is kept in its original position.",
  },
  {
    question: "Is the comparison case-sensitive?",
    answer:
      "By default yes, but you can disable 'Case sensitive' to treat different cases as duplicates.",
  },
  {
    question: "Is this tool free?",
    answer:
      "Yes, this tool is completely free and works directly in your browser.",
  },
];
---

<TextToolLayout
  title="Remove Duplicate Lines - Delete Repeated Lines Online"
  description="Remove duplicate lines from text while preserving order. Keep only unique lines. Free online tool."
  canonicalPath="/text/remove-duplicates"
  currentTool="Remove Duplicate Lines"
  faqItems={faqItems}
>
  <div class="tool-header">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">
      Remove Duplicate Lines
    </h1>
    <p class="text-slate-500">
      Remove repeated lines and keep only unique entries.
    </p>
  </div>

  <div class="bg-slate-50 border border-slate-200 rounded p-6 mb-8">
    <div class="grid md:grid-cols-2 gap-6">
      <div>
        <label
          for="input"
          class="block font-medium text-slate-700 mb-1.5 text-sm"
          >Input Text</label
        >
        <textarea
          id="input"
          rows="10"
          placeholder="Paste your text with duplicate lines..."
          class="w-full px-4 py-3 text-base border border-slate-300 rounded bg-white text-slate-800 outline-none resize-y font-mono text-sm"
        ></textarea>
      </div>
      <div>
        <label class="block font-medium text-slate-700 mb-1.5 text-sm"
          >Output (Unique Lines)</label
        >
        <textarea
          id="output"
          rows="10"
          readonly
          class="w-full px-4 py-3 text-base border border-slate-300 rounded bg-white text-slate-800 outline-none resize-y font-mono text-sm"
        ></textarea>
      </div>
    </div>

    <div class="flex flex-wrap gap-4 mt-4 items-center">
      <label class="flex items-center gap-2 text-sm text-slate-600">
        <input type="checkbox" id="caseSensitive" checked class="w-4 h-4" />
        Case sensitive
      </label>
      <label class="flex items-center gap-2 text-sm text-slate-600">
        <input type="checkbox" id="trimWhitespace" checked class="w-4 h-4" />
        Trim whitespace
      </label>
    </div>

    <div class="flex gap-3 mt-4">
      <button
        onclick="process()"
        class="btn-primary px-6 py-2 font-semibold text-white rounded"
        >Remove Duplicates</button
      >
      <button
        onclick="copyResult()"
        class="px-4 py-2 bg-white border border-slate-300 rounded text-sm hover:border-emerald-500"
        >📋 Copy</button
      >
    </div>

    <div class="mt-4 text-sm text-slate-600" id="stats"></div>
  </div>

  <script is:inline>
    function process() {
      const input = document.getElementById("input").value;
      const caseSensitive = document.getElementById("caseSensitive").checked;
      const trimWhitespace = document.getElementById("trimWhitespace").checked;

      let lines = input.split("\n");
      const originalCount = lines.length;

      if (trimWhitespace) {
        lines = lines.map((l) => l.trim());
      }

      const seen = new Set();
      const unique = [];

      for (const line of lines) {
        const key = caseSensitive ? line : line.toLowerCase();
        if (!seen.has(key)) {
          seen.add(key);
          unique.push(line);
        }
      }

      document.getElementById("output").value = unique.join("\n");
      document.getElementById("stats").innerText =
        `${originalCount} lines → ${unique.length} unique lines (${originalCount - unique.length} duplicates removed)`;
    }

    function copyResult() {
      const output = document.getElementById("output");
      output.select();
      document.execCommand("copy");
      alert("Copied!");
    }
  </script>
</TextToolLayout>
