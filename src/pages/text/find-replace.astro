---
import TextToolLayout from "../../layouts/TextToolLayout.astro";
---

<TextToolLayout
  title="Find and Replace Text Online"
  description="Find and replace text with support for multiple replacements, regex, and case sensitivity. Free online tool."
  canonicalPath="/text/find-replace"
  currentTool="Find & Replace"
>
  <div class="tool-header">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">Find & Replace</h1>
    <p class="text-slate-500">Find and replace text with advanced options.</p>
  </div>

  <div class="bg-slate-50 border border-slate-200 rounded p-6 mb-8">
    <div class="mb-4">
      <label for="input" class="block font-medium text-slate-700 mb-1.5 text-sm">Text</label>
      <textarea id="input" rows="6" placeholder="Enter your text..." class="w-full px-4 py-3 text-base border border-slate-300 rounded bg-white text-slate-800 outline-none resize-y font-mono text-sm"></textarea>
    </div>

    <div class="grid md:grid-cols-2 gap-4 mb-4">
      <div>
        <label for="find" class="block font-medium text-slate-700 mb-1.5 text-sm">Find</label>
        <input type="text" id="find" placeholder="Text to find..." class="w-full px-4 py-3 text-base border border-slate-300 rounded bg-white text-slate-800 outline-none" />
      </div>
      <div>
        <label for="replace" class="block font-medium text-slate-700 mb-1.5 text-sm">Replace with</label>
        <input type="text" id="replace" placeholder="Replacement text..." class="w-full px-4 py-3 text-base border border-slate-300 rounded bg-white text-slate-800 outline-none" />
      </div>
    </div>

    <div class="flex flex-wrap gap-4 mb-4">
      <label class="flex items-center gap-2 text-sm text-slate-600">
        <input type="checkbox" id="caseSensitive" class="w-4 h-4" />
        Case sensitive
      </label>
      <label class="flex items-center gap-2 text-sm text-slate-600">
        <input type="checkbox" id="wholeWord" class="w-4 h-4" />
        Whole word only
      </label>
      <label class="flex items-center gap-2 text-sm text-slate-600">
        <input type="checkbox" id="useRegex" class="w-4 h-4" />
        Use regex
      </label>
    </div>

    <div class="flex gap-3 mb-4">
      <button onclick="findAndReplace()" class="btn-primary px-6 py-2 font-semibold text-white rounded">Replace All</button>
      <button onclick="highlightMatches()" class="px-4 py-2 bg-white border border-slate-300 rounded text-sm">Highlight Matches</button>
    </div>

    <div class="mb-4">
      <label class="block font-medium text-slate-700 mb-1.5 text-sm">Result</label>
      <textarea id="output" rows="6" readonly class="w-full px-4 py-3 text-base border border-slate-300 rounded bg-white text-slate-800 outline-none resize-y font-mono text-sm"></textarea>
    </div>

    <div class="flex gap-3">
      <button onclick="copyResult()" class="px-4 py-2 bg-white border border-slate-300 rounded text-sm">📋 Copy</button>
      <span class="text-sm text-slate-600 self-center" id="stats"></span>
    </div>
  </div>

  <script is:inline>
    function getRegex() {
      const find = document.getElementById("find").value;
      const caseSensitive = document.getElementById("caseSensitive").checked;
      const wholeWord = document.getElementById("wholeWord").checked;
      const useRegex = document.getElementById("useRegex").checked;
      
      let pattern = useRegex ? find : find.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
      if (wholeWord) pattern = `\\b${pattern}\\b`;
      
      return new RegExp(pattern, caseSensitive ? 'g' : 'gi');
    }

    function findAndReplace() {
      const input = document.getElementById("input").value;
      const replace = document.getElementById("replace").value;
      
      try {
        const regex = getRegex();
        const matches = (input.match(regex) || []).length;
        const result = input.replace(regex, replace);
        
        document.getElementById("output").value = result;
        document.getElementById("stats").innerText = `${matches} replacements made`;
      } catch (e) {
        document.getElementById("stats").innerText = "Invalid regex pattern";
      }
    }

    function highlightMatches() {
      const input = document.getElementById("input").value;
      
      try {
        const regex = getRegex();
        const matches = (input.match(regex) || []).length;
        document.getElementById("stats").innerText = `${matches} matches found`;
      } catch (e) {
        document.getElementById("stats").innerText = "Invalid regex pattern";
      }
    }

    function copyResult() {
      document.getElementById("output").select();
      document.execCommand("copy");
      alert("Copied!");
    }
  </script>
</TextToolLayout>
