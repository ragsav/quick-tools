---
import TextToolLayout from "../../layouts/TextToolLayout.astro";

const faqItems = [
  {
    question: "What case conversions are available?",
    answer:
      "You can convert to UPPERCASE, lowercase, Title Case, Sentence case, camelCase, PascalCase, snake_case, and kebab-case.",
  },
  {
    question: "What is camelCase vs PascalCase?",
    answer:
      "camelCase starts with lowercase (myVariable), while PascalCase starts with uppercase (MyVariable).",
  },
  {
    question: "Is this tool free to use?",
    answer:
      "Yes, this tool is completely free and works directly in your browser.",
  },
];

const howItWorks = [
  {
    title: "UPPERCASE Conversion",
    content:
      "Uses JavaScript's toUpperCase() method to convert every character to its uppercase equivalent. Works with Unicode characters from any language.",
  },
  {
    title: "Title Case Algorithm",
    content:
      "First converts to lowercase, then uses regex /\\b\\w/g to match word boundaries and capitalize the first letter of each word. Handles punctuation and spacing correctly.",
  },
  {
    title: "Sentence Case Logic",
    content:
      "Converts to lowercase, then capitalizes after sentence-ending punctuation (.!?) using regex. Also capitalizes the first character of the text.",
  },
  {
    title: "Programming Case Formats",
    content:
      "camelCase and PascalCase remove spaces and capitalize word boundaries. snake_case replaces spaces with underscores. kebab-case uses hyphens. All remove special characters.",
  },
  {
    title: "Toggle Case Transformation",
    content:
      "Each character is individually checked: if uppercase, convert to lowercase and vice versa. Creates the alternating case effect.",
  },
];

const useCases = [
  {
    title: "Variable Naming in Code",
    description:
      "Convert descriptive text to camelCase, PascalCase, snake_case, or kebab-case for programming. Follow your language's naming conventions automatically.",
  },
  {
    title: "Headline Formatting",
    description:
      "Convert all-caps headlines from documents or PDFs to proper Title Case for professional presentations and reports.",
  },
  {
    title: "CSS Class Names",
    description:
      "Generate kebab-case class names from descriptive text. Standard convention for CSS classes and HTML attributes.",
  },
  {
    title: "Database Column Names",
    description:
      "Convert descriptions to snake_case for SQL database column names. Widely used convention in PostgreSQL, MySQL, and other databases.",
  },
  {
    title: "Email Subject Cleanup",
    description:
      "Fix improperly capitalized email subjects. Convert ALL CAPS to Sentence case for professional communication.",
  },
  {
    title: "File Naming Standards",
    description:
      "Convert titles to consistent file naming formats. Use kebab-case or snake_case for URL-friendly, cross-platform compatible filenames.",
  },
];
---

<TextToolLayout
  title="Case Converter - Change Text Case Online"
  description="Convert text to uppercase, lowercase, title case, sentence case, and more. Free online text case converter."
  canonicalPath="/text/case-converter"
  currentTool="Case Converter"
  faqItems={faqItems}
  howItWorks={howItWorks}
  useCases={useCases}
>
  <div class="tool-header">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">
      Case Converter
    </h1>
    <p class="text-slate-500">
      Transform text between different cases instantly.
    </p>
  </div>

  <div class="bg-slate-50 border border-slate-200 rounded p-6 mb-8">
    <div class="mb-4">
      <label
        for="textInput"
        class="block font-medium text-slate-700 mb-1.5 text-sm"
        >Enter text to convert</label
      >
      <textarea
        id="textInput"
        rows="5"
        placeholder="Type or paste your text here..."
        class="w-full px-4 py-3 text-base border border-slate-300 rounded bg-white text-slate-800 outline-none resize-y"
      ></textarea>
    </div>

    <div class="flex flex-wrap gap-2 mb-6">
      <button
        onclick="convert('upper')"
        class="px-4 py-2 bg-white border border-slate-200 rounded text-sm font-medium hover:border-emerald-500 hover:text-emerald-600 transition-colors"
        >UPPERCASE</button
      >
      <button
        onclick="convert('lower')"
        class="px-4 py-2 bg-white border border-slate-200 rounded text-sm font-medium hover:border-emerald-500 hover:text-emerald-600 transition-colors"
        >lowercase</button
      >
      <button
        onclick="convert('title')"
        class="px-4 py-2 bg-white border border-slate-200 rounded text-sm font-medium hover:border-emerald-500 hover:text-emerald-600 transition-colors"
        >Title Case</button
      >
      <button
        onclick="convert('sentence')"
        class="px-4 py-2 bg-white border border-slate-200 rounded text-sm font-medium hover:border-emerald-500 hover:text-emerald-600 transition-colors"
        >Sentence case</button
      >
      <button
        onclick="convert('toggle')"
        class="px-4 py-2 bg-white border border-slate-200 rounded text-sm font-medium hover:border-emerald-500 hover:text-emerald-600 transition-colors"
        >tOGGLE cASE</button
      >
      <button
        onclick="convert('camel')"
        class="px-4 py-2 bg-white border border-slate-200 rounded text-sm font-medium hover:border-emerald-500 hover:text-emerald-600 transition-colors"
        >camelCase</button
      >
      <button
        onclick="convert('pascal')"
        class="px-4 py-2 bg-white border border-slate-200 rounded text-sm font-medium hover:border-emerald-500 hover:text-emerald-600 transition-colors"
        >PascalCase</button
      >
      <button
        onclick="convert('snake')"
        class="px-4 py-2 bg-white border border-slate-200 rounded text-sm font-medium hover:border-emerald-500 hover:text-emerald-600 transition-colors"
        >snake_case</button
      >
      <button
        onclick="convert('kebab')"
        class="px-4 py-2 bg-white border border-slate-200 rounded text-sm font-medium hover:border-emerald-500 hover:text-emerald-600 transition-colors"
        >kebab-case</button
      >
    </div>

    <div class="mb-4">
      <label class="block font-medium text-slate-700 mb-1.5 text-sm"
        >Result</label
      >
      <textarea
        id="output"
        rows="5"
        readonly
        class="w-full px-4 py-3 text-base border border-slate-300 rounded bg-white text-slate-800 outline-none resize-y"
      ></textarea>
    </div>

    <button
      onclick="copyResult()"
      class="btn-primary px-6 py-2 font-semibold text-white rounded text-sm"
      >📋 Copy Result</button
    >
  </div>

  <script is:inline>
    function convert(type) {
      const input = document.getElementById("textInput").value;
      let result = "";

      switch (type) {
        case "upper":
          result = input.toUpperCase();
          break;
        case "lower":
          result = input.toLowerCase();
          break;
        case "title":
          result = input.toLowerCase().replace(/\b\w/g, (c) => c.toUpperCase());
          break;
        case "sentence":
          result = input
            .toLowerCase()
            .replace(/(^\s*\w|[.!?]\s+\w)/g, (c) => c.toUpperCase());
          break;
        case "toggle":
          result = input
            .split("")
            .map((c) =>
              c === c.toUpperCase() ? c.toLowerCase() : c.toUpperCase(),
            )
            .join("");
          break;
        case "camel":
          result = input
            .toLowerCase()
            .replace(/[^a-zA-Z0-9]+(.)/g, (_, c) => c.toUpperCase());
          break;
        case "pascal":
          result = input
            .toLowerCase()
            .replace(/(?:^|[^a-zA-Z0-9]+)(.)/g, (_, c) => c.toUpperCase());
          break;
        case "snake":
          result = input
            .toLowerCase()
            .replace(/\s+/g, "_")
            .replace(/[^a-zA-Z0-9_]/g, "");
          break;
        case "kebab":
          result = input
            .toLowerCase()
            .replace(/\s+/g, "-")
            .replace(/[^a-zA-Z0-9-]/g, "");
          break;
      }

      document.getElementById("output").value = result;
    }

    function copyResult() {
      const output = document.getElementById("output");
      output.select();
      document.execCommand("copy");
      alert("Copied to clipboard!");
    }
  </script>
</TextToolLayout>
