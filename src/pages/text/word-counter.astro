---
import TextToolLayout from "../../layouts/TextToolLayout.astro";

const faqItems = [
  {
    question: "How does the word counter work?",
    answer:
      "It counts words by splitting your text on whitespace. It also counts characters, sentences, and paragraphs.",
  },
  {
    question: "How is reading time calculated?",
    answer:
      "Reading time is based on an average reading speed of 200 words per minute.",
  },
  {
    question: "Is this tool free to use?",
    answer:
      "Yes, this tool is completely free and works directly in your browser.",
  },
];

const howItWorks = [
  {
    title: "Word Detection",
    content:
      "Words are identified by splitting text on whitespace characters (spaces, tabs, newlines) using regex: /\\s+/. Empty strings are filtered out to ensure accurate counting.",
  },
  {
    title: "Character Counting",
    content:
      "Character count includes all characters: letters, numbers, spaces, punctuation, and special characters. The string's length property gives the total count instantly.",
  },
  {
    title: "Sentence Detection",
    content:
      "Sentences are counted by splitting on terminal punctuation: periods, exclamation points, and question marks. Empty entries are filtered to handle multiple punctuation marks.",
  },
  {
    title: "Paragraph Counting",
    content:
      "Paragraphs are detected by splitting on double newlines (\\n\\n+). This standard paragraph separator identifies distinct blocks of text.",
  },
  {
    title: "Reading Time Estimation",
    content:
      "Reading time uses the standard 200 words-per-minute rate. Speaking time uses 150 WPM. These averages provide reasonable estimates for most content.",
  },
];

const useCases = [
  {
    title: "Essay & Assignment Writing",
    description:
      "Track word count for school essays, college papers, and assignments that have specific word count requirements. Stay within minimum and maximum limits.",
  },
  {
    title: "Blog & Content Writing",
    description:
      "Monitor article length for SEO optimization. Many SEO guidelines recommend 1500-2500 words for in-depth blog posts.",
  },
  {
    title: "Social Media Content",
    description:
      "Prepare content for platforms with character limits while ensuring your message is complete and impactful.",
  },
  {
    title: "Speech Preparation",
    description:
      "Estimate speech duration using the speaking time calculator. A 5-minute speech needs roughly 750 words at average pace.",
  },
  {
    title: "Translation Projects",
    description:
      "Many translation services charge per word. Get accurate word counts before requesting quotes or billing clients.",
  },
  {
    title: "Novel & Book Writing",
    description:
      "Track progress on long-form writing projects. Standard novel length is 70,000-100,000 words. Monitor daily writing goals.",
  },
];
---

<TextToolLayout
  title="Word Counter - Count Words in Text Online"
  description="Count words, sentences, and paragraphs in your text instantly. Free online word counter tool."
  canonicalPath="/text/word-counter"
  currentTool="Word Counter"
  faqItems={faqItems}
  howItWorks={howItWorks}
  useCases={useCases}
>
  <div class="tool-header">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">
      Word Counter
    </h1>
    <p class="text-slate-500">
      Count words, sentences, paragraphs, and estimate reading time.
    </p>
  </div>

  <div class="bg-slate-50 border border-slate-200 rounded p-6 mb-8">
    <div class="mb-4">
      <label
        for="textInput"
        class="block font-medium text-slate-700 mb-1.5 text-sm"
        >Enter or paste your text</label
      >
      <textarea
        id="textInput"
        rows="8"
        placeholder="Type or paste your text here..."
        class="w-full px-4 py-3 text-base border border-slate-300 rounded bg-white text-slate-800 outline-none resize-y"
        oninput="analyze()"></textarea>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
      <div class="bg-white p-4 rounded border border-slate-200 text-center">
        <div class="text-3xl font-bold text-emerald-600" id="wordCount">0</div>
        <div class="text-xs text-slate-500 uppercase">Words</div>
      </div>
      <div class="bg-white p-4 rounded border border-slate-200 text-center">
        <div class="text-3xl font-bold text-emerald-600" id="charCount">0</div>
        <div class="text-xs text-slate-500 uppercase">Characters</div>
      </div>
      <div class="bg-white p-4 rounded border border-slate-200 text-center">
        <div class="text-3xl font-bold text-emerald-600" id="sentenceCount">
          0
        </div>
        <div class="text-xs text-slate-500 uppercase">Sentences</div>
      </div>
      <div class="bg-white p-4 rounded border border-slate-200 text-center">
        <div class="text-3xl font-bold text-emerald-600" id="paragraphCount">
          0
        </div>
        <div class="text-xs text-slate-500 uppercase">Paragraphs</div>
      </div>
    </div>

    <div
      class="mt-4 p-3 bg-white rounded border border-slate-200 flex justify-between text-sm text-slate-600"
    >
      <span>📖 Reading time: <strong id="readTime">0 min</strong></span>
      <span>🎤 Speaking time: <strong id="speakTime">0 min</strong></span>
    </div>
  </div>

  <section class="mt-8 pt-6 border-t border-slate-200">
    <h2 class="text-xl font-semibold text-slate-900 mb-4">Tips</h2>
    <ul class="list-disc pl-6 text-slate-600 space-y-2">
      <li>Average reading speed: ~200 words per minute</li>
      <li>Average speaking speed: ~150 words per minute</li>
      <li>Twitter limit: 280 characters</li>
      <li>Meta description: 150-160 characters recommended</li>
    </ul>
  </section>

  <script is:inline>
    function analyze() {
      const text = document.getElementById("textInput").value;

      // Words
      const words = text.trim()
        ? text
            .trim()
            .split(/\s+/)
            .filter((w) => w.length > 0)
        : [];
      document.getElementById("wordCount").innerText = words.length;

      // Characters
      document.getElementById("charCount").innerText = text.length;

      // Sentences
      const sentences = text.split(/[.!?]+/).filter((s) => s.trim().length > 0);
      document.getElementById("sentenceCount").innerText = sentences.length;

      // Paragraphs
      const paragraphs = text.split(/\n\n+/).filter((p) => p.trim().length > 0);
      document.getElementById("paragraphCount").innerText =
        paragraphs.length || (text.trim() ? 1 : 0);

      // Reading/Speaking time
      const readMins = Math.ceil(words.length / 200);
      const speakMins = Math.ceil(words.length / 150);
      document.getElementById("readTime").innerText = readMins + " min";
      document.getElementById("speakTime").innerText = speakMins + " min";
    }
  </script>
</TextToolLayout>
