---
import StudentToolLayout from "../../layouts/StudentToolLayout.astro";
---

<StudentToolLayout
  title="CGPA Calculator - Calculate Cumulative GPA"
  description="Calculate your Cumulative Grade Point Average (CGPA) from multiple semesters. Free online tool."
  canonicalPath="/student/cgpa-calculator"
  currentTool="CGPA Calculator"
>
  <div class="tool-header">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">CGPA Calculator</h1>
    <p class="text-slate-500">Calculate your Cumulative Grade Point Average across semesters.</p>
  </div>

  <div class="bg-slate-50 border border-slate-200 rounded p-6 mb-8">
    <div id="semesters">
      <div class="semester-row flex gap-4 mb-3 items-center">
        <input type="number" step="0.01" max="10" min="0" placeholder="GPA (e.g., 8.5)" class="flex-1 px-4 py-2 border border-slate-300 rounded outline-none gpa-input" />
        <input type="number" min="1" placeholder="Credits" class="w-24 px-4 py-2 border border-slate-300 rounded outline-none credits-input" />
        <button onclick="this.parentElement.remove(); calculateCGPA()" class="text-red-500 px-2">×</button>
      </div>
    </div>

    <div class="flex gap-3 mb-6">
      <button onclick="addSemester()" class="px-4 py-2 bg-white border border-slate-300 rounded text-sm hover:border-pink-500">+ Add Semester</button>
    </div>

    <button onclick="calculateCGPA()" class="btn-primary px-6 py-3 font-semibold text-white rounded">Calculate CGPA</button>

    <div class="result-box mt-6 p-6 bg-white rounded text-center hidden" id="resultBox">
      <div class="text-xs text-slate-500 uppercase mb-2">Your CGPA</div>
      <div class="text-5xl font-bold text-pink-600" id="cgpaResult">0.00</div>
      <div class="text-sm text-slate-500 mt-2" id="details">—</div>
    </div>
  </div>

  <section class="mt-8 pt-6 border-t border-slate-200">
    <h2 class="text-xl font-semibold text-slate-900 mb-4">How CGPA is Calculated</h2>
    <p class="text-slate-600">CGPA = Σ(GPA × Credits) / Σ(Credits)</p>
    <p class="text-sm text-slate-500 mt-2">Multiply each semester's GPA by its credits, sum them up, and divide by total credits.</p>
  </section>

  <script is:inline>
    function addSemester() {
      const container = document.getElementById("semesters");
      const row = document.createElement("div");
      row.className = "semester-row flex gap-4 mb-3 items-center";
      row.innerHTML = `
        <input type="number" step="0.01" max="10" min="0" placeholder="GPA (e.g., 8.5)" class="flex-1 px-4 py-2 border border-slate-300 rounded outline-none gpa-input" />
        <input type="number" min="1" placeholder="Credits" class="w-24 px-4 py-2 border border-slate-300 rounded outline-none credits-input" />
        <button onclick="this.parentElement.remove(); calculateCGPA()" class="text-red-500 px-2">×</button>
      `;
      container.appendChild(row);
    }

    function calculateCGPA() {
      const gpas = document.querySelectorAll(".gpa-input");
      const credits = document.querySelectorAll(".credits-input");
      
      let totalWeighted = 0;
      let totalCredits = 0;
      let validCount = 0;

      gpas.forEach((gpaInput, i) => {
        const gpa = parseFloat(gpaInput.value);
        const credit = parseFloat(credits[i].value);
        
        if (!isNaN(gpa) && !isNaN(credit) && credit > 0) {
          totalWeighted += gpa * credit;
          totalCredits += credit;
          validCount++;
        }
      });

      const resultBox = document.getElementById("resultBox");
      
      if (totalCredits > 0) {
        const cgpa = totalWeighted / totalCredits;
        document.getElementById("cgpaResult").innerText = cgpa.toFixed(2);
        document.getElementById("details").innerText = `Based on ${validCount} semesters, ${totalCredits} total credits`;
        resultBox.classList.remove("hidden");
      } else {
        document.getElementById("cgpaResult").innerText = "—";
        document.getElementById("details").innerText = "Enter GPA and credits for at least one semester";
        resultBox.classList.remove("hidden");
      }
    }

    // Add initial rows
    addSemester();
    addSemester();
  </script>
</StudentToolLayout>
