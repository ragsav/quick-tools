---
import StudentToolLayout from "../../layouts/StudentToolLayout.astro";

const faqItems = [
  {
    question: "How do I convert GPA to percentage?",
    answer: "For 4.0 scale: (GPA/4)×100. For 10.0 scale (India): GPA × 9.5.",
  },
  {
    question: "Why do different countries use different scales?",
    answer:
      "Different education systems developed their own grading standards. The converter helps translate between them.",
  },
  {
    question: "Is this tool free?",
    answer:
      "Yes, this tool is completely free and works directly in your browser.",
  },
];

const howItWorks = [
  {
    title: "4.0 Scale Conversion",
    content:
      "US standard: Percentage = (GPA ÷ 4) × 100. A 3.5 GPA = 87.5%. This is a linear conversion.",
  },
  {
    title: "10.0 Scale Conversion",
    content:
      "Indian standard: Percentage = GPA × 9.5. An 8.5 CGPA = 80.75%. This is the common Indian university formula.",
  },
  {
    title: "5.0 Scale Conversion",
    content:
      "For 5-point scales: Percentage = (GPA ÷ 5) × 100. A 4.0 on 5.0 scale = 80%.",
  },
  {
    title: "Scale Selection",
    content:
      "Choose the scale your institution uses. The tool validates that your GPA doesn't exceed the maximum for that scale.",
  },
  {
    title: "Approximate Conversions",
    content:
      "These are approximate equivalents. Exact conversion depends on your specific institution's grading policy.",
  },
];

const useCases = [
  {
    title: "International Applications",
    description:
      "Convert your GPA for college or job applications that require percentage format from a different country.",
  },
  {
    title: "Graduate School Applications",
    description:
      "Many grad schools request percentage alongside GPA. Convert for application requirements.",
  },
  {
    title: "Scholarship Applications",
    description:
      "Some scholarships have percentage cutoffs. Convert GPA to check eligibility requirements.",
  },
  {
    title: "Job Applications",
    description:
      "Some employers request academic performance as percentage. Convert for resume or applications.",
  },
  {
    title: "Study Abroad Programs",
    description:
      "Different countries use different scales. Convert when applying to international exchange programs.",
  },
  {
    title: "Credential Evaluation",
    description:
      "When getting foreign credentials evaluated, understanding percent equivalents helps verify accuracy.",
  },
];
---

<StudentToolLayout
  title="GPA to Percentage Converter - Convert GPA to Percent"
  description="Convert GPA to percentage for different grading scales (4.0, 10.0). Free online converter."
  canonicalPath="/student/gpa-to-percentage"
  currentTool="GPA to Percentage"
  faqItems={faqItems}
  howItWorks={howItWorks}
  useCases={useCases}
>
  <div class="tool-header">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">
      GPA to Percentage Converter
    </h1>
    <p class="text-slate-500">
      Convert your GPA to percentage based on different scales.
    </p>
  </div>

  <div class="bg-slate-50 border border-slate-200 rounded p-6 mb-8">
    <div class="grid md:grid-cols-2 gap-4 mb-6">
      <div>
        <label for="gpa" class="block font-medium text-slate-700 mb-1.5 text-sm"
          >Your GPA</label
        >
        <input
          type="number"
          id="gpa"
          step="0.01"
          placeholder="e.g., 3.5"
          class="w-full px-4 py-3 border border-slate-300 rounded bg-white text-slate-800 outline-none"
          oninput="convert()"
        />
      </div>
      <div>
        <label
          for="scale"
          class="block font-medium text-slate-700 mb-1.5 text-sm"
          >GPA Scale</label
        >
        <select
          id="scale"
          class="w-full px-4 py-3 border border-slate-300 rounded bg-white text-slate-800 outline-none"
          onchange="convert()"
        >
          <option value="4">4.0 Scale (US)</option>
          <option value="10">10.0 Scale (India)</option>
          <option value="5">5.0 Scale</option>
        </select>
      </div>
    </div>

    <div class="result-box p-6 bg-white rounded text-center">
      <div class="text-xs text-slate-500 uppercase mb-2">Percentage</div>
      <div class="text-5xl font-bold text-pink-600" id="result">—%</div>
    </div>
  </div>

  <section class="mt-8 pt-6 border-t border-slate-200">
    <h2 class="text-xl font-semibold text-slate-900 mb-4">
      Conversion Formulas
    </h2>
    <div class="grid md:grid-cols-2 gap-4 text-sm">
      <div class="p-4 bg-white border border-slate-200 rounded">
        <div class="font-medium mb-2">4.0 Scale (US)</div>
        <div class="text-slate-600">Percentage = (GPA / 4) × 100</div>
      </div>
      <div class="p-4 bg-white border border-slate-200 rounded">
        <div class="font-medium mb-2">10.0 Scale (India)</div>
        <div class="text-slate-600">
          Percentage = (GPA × 9.5) or (GPA - 0.5) × 10
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    function convert() {
      const gpa = parseFloat(document.getElementById("gpa").value);
      const scale = parseFloat(document.getElementById("scale").value);

      if (isNaN(gpa) || gpa < 0 || gpa > scale) {
        document.getElementById("result").innerText =
          gpa > scale ? `Max is ${scale}` : "—%";
        return;
      }

      let percentage;
      if (scale === 4) {
        percentage = (gpa / 4) * 100;
      } else if (scale === 10) {
        percentage = gpa * 9.5; // Common Indian conversion
      } else {
        percentage = (gpa / scale) * 100;
      }

      document.getElementById("result").innerText = percentage.toFixed(2) + "%";
    }
  </script>
</StudentToolLayout>
