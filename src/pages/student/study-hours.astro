---
import StudentToolLayout from "../../layouts/StudentToolLayout.astro";
---

<StudentToolLayout
  title="Study Hours Calculator - Track Study Time Needed"
  description="Calculate how many hours you need to study based on subjects and exam dates. Study planner."
  canonicalPath="/student/study-hours"
  currentTool="Study Hours Calculator"
>
  <div class="tool-header">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">Study Hours Calculator</h1>
    <p class="text-slate-500">Plan your study schedule based on available time.</p>
  </div>

  <div class="bg-slate-50 border border-slate-200 rounded p-6 mb-8">
    <div class="grid md:grid-cols-2 gap-4 mb-6">
      <div>
        <label for="subjects" class="block font-medium text-slate-700 mb-1.5 text-sm">Number of Subjects</label>
        <input type="number" id="subjects" value="5" min="1" class="w-full px-4 py-3 border border-slate-300 rounded bg-white text-slate-800 outline-none" oninput="calculate()" />
      </div>
      <div>
        <label for="hoursPerSubject" class="block font-medium text-slate-700 mb-1.5 text-sm">Hours Needed per Subject</label>
        <input type="number" id="hoursPerSubject" value="10" min="1" class="w-full px-4 py-3 border border-slate-300 rounded bg-white text-slate-800 outline-none" oninput="calculate()" />
      </div>
      <div>
        <label for="daysLeft" class="block font-medium text-slate-700 mb-1.5 text-sm">Days Until Exam</label>
        <input type="number" id="daysLeft" value="14" min="1" class="w-full px-4 py-3 border border-slate-300 rounded bg-white text-slate-800 outline-none" oninput="calculate()" />
      </div>
      <div>
        <label for="dailyLimit" class="block font-medium text-slate-700 mb-1.5 text-sm">Max Hours per Day</label>
        <input type="number" id="dailyLimit" value="8" min="1" max="16" class="w-full px-4 py-3 border border-slate-300 rounded bg-white text-slate-800 outline-none" oninput="calculate()" />
      </div>
    </div>

    <div class="result-box p-4 bg-white rounded">
      <div class="grid grid-cols-3 gap-4 text-center">
        <div>
          <div class="text-xs text-slate-500 uppercase mb-1">Total Hours</div>
          <div class="text-2xl font-bold text-slate-900" id="totalHours">0</div>
        </div>
        <div>
          <div class="text-xs text-slate-500 uppercase mb-1">Hours per Day</div>
          <div class="text-2xl font-bold text-pink-600" id="hoursPerDay">0</div>
        </div>
        <div>
          <div class="text-xs text-slate-500 uppercase mb-1">Feasibility</div>
          <div class="text-xl font-bold" id="feasibility">—</div>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    function calculate() {
      const subjects = parseInt(document.getElementById("subjects").value) || 0;
      const hoursPerSubject = parseInt(document.getElementById("hoursPerSubject").value) || 0;
      const daysLeft = parseInt(document.getElementById("daysLeft").value) || 1;
      const dailyLimit = parseInt(document.getElementById("dailyLimit").value) || 8;

      const totalHours = subjects * hoursPerSubject;
      const hoursPerDay = totalHours / daysLeft;

      document.getElementById("totalHours").innerText = totalHours;
      document.getElementById("hoursPerDay").innerText = hoursPerDay.toFixed(1);

      const feasibilityEl = document.getElementById("feasibility");
      if (hoursPerDay <= dailyLimit * 0.7) {
        feasibilityEl.innerText = "✅ Easy";
        feasibilityEl.className = "text-xl font-bold text-green-600";
      } else if (hoursPerDay <= dailyLimit) {
        feasibilityEl.innerText = "⚠️ Tight";
        feasibilityEl.className = "text-xl font-bold text-yellow-600";
      } else {
        feasibilityEl.innerText = "❌ Not possible";
        feasibilityEl.className = "text-xl font-bold text-red-600";
      }
    }

    calculate();
  </script>
</StudentToolLayout>
