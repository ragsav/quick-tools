---
import StudentToolLayout from "../../layouts/StudentToolLayout.astro";
---

<StudentToolLayout
  title="Reading Time Estimator - How Long to Read?"
  description="Estimate how long it will take to read a book or document based on word count and reading speed."
  canonicalPath="/student/reading-time"
  currentTool="Reading Time Estimator"
>
  <div class="tool-header">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">Reading Time Estimator</h1>
    <p class="text-slate-500">Estimate how long it takes to read your material.</p>
  </div>

  <div class="bg-slate-50 border border-slate-200 rounded p-6 mb-8">
    <div class="grid md:grid-cols-2 gap-4 mb-6">
      <div>
        <label for="wordCount" class="block font-medium text-slate-700 mb-1.5 text-sm">Word Count</label>
        <input type="number" id="wordCount" placeholder="e.g., 5000" class="w-full px-4 py-3 border border-slate-300 rounded bg-white text-slate-800 outline-none" oninput="calculate()" />
      </div>
      <div>
        <label for="readingSpeed" class="block font-medium text-slate-700 mb-1.5 text-sm">Reading Speed (words/min)</label>
        <select id="readingSpeed" class="w-full px-4 py-3 border border-slate-300 rounded bg-white text-slate-800 outline-none" onchange="calculate()">
          <option value="150">Slow (150 wpm)</option>
          <option value="200" selected>Average (200 wpm)</option>
          <option value="250">Fast (250 wpm)</option>
          <option value="300">Speed Reader (300 wpm)</option>
        </select>
      </div>
    </div>

    <div class="result-box p-6 bg-white rounded text-center">
      <div class="text-xs text-slate-500 uppercase mb-2">Estimated Reading Time</div>
      <div class="text-4xl font-bold text-pink-600" id="result">—</div>
      <div class="text-sm text-slate-500 mt-2" id="pages">—</div>
    </div>
  </div>

  <section class="mt-8 pt-6 border-t border-slate-200">
    <h2 class="text-xl font-semibold text-slate-900 mb-4">Quick Estimates</h2>
    <div class="grid grid-cols-3 gap-4 text-sm text-center">
      <div class="p-3 bg-white border border-slate-200 rounded">
        <div class="font-medium">Average Book</div>
        <div class="text-slate-500">50,000 words ≈ 4 hrs</div>
      </div>
      <div class="p-3 bg-white border border-slate-200 rounded">
        <div class="font-medium">Research Paper</div>
        <div class="text-slate-500">5,000 words ≈ 25 min</div>
      </div>
      <div class="p-3 bg-white border border-slate-200 rounded">
        <div class="font-medium">Blog Post</div>
        <div class="text-slate-500">1,000 words ≈ 5 min</div>
      </div>
    </div>
  </section>

  <script is:inline>
    function calculate() {
      const wordCount = parseInt(document.getElementById("wordCount").value) || 0;
      const speed = parseInt(document.getElementById("readingSpeed").value);
      
      if (wordCount === 0) {
        document.getElementById("result").innerText = "—";
        document.getElementById("pages").innerText = "—";
        return;
      }

      const minutes = wordCount / speed;
      const hours = Math.floor(minutes / 60);
      const mins = Math.round(minutes % 60);
      
      let timeStr;
      if (hours > 0) {
        timeStr = `${hours}h ${mins}m`;
      } else {
        timeStr = `${mins} minutes`;
      }

      document.getElementById("result").innerText = timeStr;
      document.getElementById("pages").innerText = `~${Math.ceil(wordCount / 250)} pages (250 words/page)`;
    }
  </script>
</StudentToolLayout>
