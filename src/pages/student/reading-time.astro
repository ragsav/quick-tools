---
import StudentToolLayout from "../../layouts/StudentToolLayout.astro";

const faqItems = [
  {
    question: "What is the average reading speed?",
    answer:
      "Most adults read at 200-250 words per minute. Speed readers can reach 300+ wpm.",
  },
  {
    question: "How many words per page?",
    answer: "A typical book page has about 250-300 words.",
  },
  {
    question: "Is this tool free?",
    answer:
      "Yes, this tool is completely free and works directly in your browser.",
  },
];

const howItWorks = [
  {
    title: "Time Calculation",
    content:
      "Reading time = Word count ÷ Words per minute. A 5000-word article at 200 wpm takes 25 minutes.",
  },
  {
    title: "Speed Presets",
    content:
      "Slow (150 wpm), Average (200 wpm), Fast (250 wpm), Speed reader (300 wpm). Choose your typical speed.",
  },
  {
    title: "Hour-Minute Formatting",
    content:
      "Results show hours and minutes for longer content. '2h 30m' is clearer than '150 minutes'.",
  },
  {
    title: "Page Estimation",
    content:
      "Approximate page count uses 250 words/page standard. Helps visualize document length.",
  },
  {
    title: "Adjustable Parameters",
    content:
      "Customize reading speed based on content type. Technical content may warrant slower speeds.",
  },
];

const useCases = [
  {
    title: "Study Session Planning",
    description:
      "Estimate time needed for reading assignments. Schedule study sessions appropriately.",
  },
  {
    title: "Book Selection",
    description:
      "Before committing to a book, estimate total reading time. Plan based on your available time.",
  },
  {
    title: "Content Creation",
    description:
      "Blog writers and content creators display 'X min read' for their articles using this calculation.",
  },
  {
    title: "Meeting Preparation",
    description:
      "Estimate time needed to read meeting materials before the meeting starts.",
  },
  {
    title: "Exam Preparation",
    description:
      "Calculate total reading time for course materials. Create realistic study schedules.",
  },
  {
    title: "Research Paper Review",
    description:
      "Estimate time to read journal articles and research papers for literature reviews.",
  },
];
---

<StudentToolLayout
  title="Reading Time Estimator - How Long to Read?"
  description="Estimate how long it will take to read a book or document based on word count and reading speed."
  canonicalPath="/student/reading-time"
  currentTool="Reading Time Estimator"
  faqItems={faqItems}
  howItWorks={howItWorks}
  useCases={useCases}
>
  <div class="tool-header">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">
      Reading Time Estimator
    </h1>
    <p class="text-slate-500">
      Estimate how long it takes to read your material.
    </p>
  </div>

  <div class="bg-slate-50 border border-slate-200 rounded p-6 mb-8">
    <div class="grid md:grid-cols-2 gap-4 mb-6">
      <div>
        <label
          for="wordCount"
          class="block font-medium text-slate-700 mb-1.5 text-sm"
          >Word Count</label
        >
        <input
          type="number"
          id="wordCount"
          placeholder="e.g., 5000"
          class="w-full px-4 py-3 border border-slate-300 rounded bg-white text-slate-800 outline-none"
          oninput="calculate()"
        />
      </div>
      <div>
        <label
          for="readingSpeed"
          class="block font-medium text-slate-700 mb-1.5 text-sm"
          >Reading Speed (words/min)</label
        >
        <select
          id="readingSpeed"
          class="w-full px-4 py-3 border border-slate-300 rounded bg-white text-slate-800 outline-none"
          onchange="calculate()"
        >
          <option value="150">Slow (150 wpm)</option>
          <option value="200" selected>Average (200 wpm)</option>
          <option value="250">Fast (250 wpm)</option>
          <option value="300">Speed Reader (300 wpm)</option>
        </select>
      </div>
    </div>

    <div class="result-box p-6 bg-white rounded text-center">
      <div class="text-xs text-slate-500 uppercase mb-2">
        Estimated Reading Time
      </div>
      <div class="text-4xl font-bold text-pink-600" id="result">—</div>
      <div class="text-sm text-slate-500 mt-2" id="pages">—</div>
    </div>
  </div>

  <section class="mt-8 pt-6 border-t border-slate-200">
    <h2 class="text-xl font-semibold text-slate-900 mb-4">Quick Estimates</h2>
    <div class="grid grid-cols-3 gap-4 text-sm text-center">
      <div class="p-3 bg-white border border-slate-200 rounded">
        <div class="font-medium">Average Book</div>
        <div class="text-slate-500">50,000 words ≈ 4 hrs</div>
      </div>
      <div class="p-3 bg-white border border-slate-200 rounded">
        <div class="font-medium">Research Paper</div>
        <div class="text-slate-500">5,000 words ≈ 25 min</div>
      </div>
      <div class="p-3 bg-white border border-slate-200 rounded">
        <div class="font-medium">Blog Post</div>
        <div class="text-slate-500">1,000 words ≈ 5 min</div>
      </div>
    </div>
  </section>

  <script is:inline>
    function calculate() {
      const wordCount =
        parseInt(document.getElementById("wordCount").value) || 0;
      const speed = parseInt(document.getElementById("readingSpeed").value);

      if (wordCount === 0) {
        document.getElementById("result").innerText = "—";
        document.getElementById("pages").innerText = "—";
        return;
      }

      const minutes = wordCount / speed;
      const hours = Math.floor(minutes / 60);
      const mins = Math.round(minutes % 60);

      let timeStr;
      if (hours > 0) {
        timeStr = `${hours}h ${mins}m`;
      } else {
        timeStr = `${mins} minutes`;
      }

      document.getElementById("result").innerText = timeStr;
      document.getElementById("pages").innerText =
        `~${Math.ceil(wordCount / 250)} pages (250 words/page)`;
    }
  </script>
</StudentToolLayout>
