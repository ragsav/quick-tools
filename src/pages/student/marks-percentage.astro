---
import StudentToolLayout from "../../layouts/StudentToolLayout.astro";

const faqItems = [
  {
    question: "How is percentage calculated?",
    answer: "Percentage = (Marks Obtained ÷ Total Marks) × 100.",
  },
  {
    question: "What are the letter grade ranges?",
    answer:
      "Typically: A+ (90-100%), A (80-89%), B (70-79%), C (60-69%), D (50-59%), F (<50%).",
  },
  {
    question: "Is this tool free?",
    answer:
      "Yes, this tool is completely free and works directly in your browser.",
  },
];
---

<StudentToolLayout
  title="Marks Percentage Calculator - Calculate Your Score"
  description="Calculate percentage from marks obtained and total marks. Free online marks calculator."
  canonicalPath="/student/marks-percentage"
  currentTool="Marks Percentage"
  faqItems={faqItems}
>
  <div class="tool-header">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">
      Marks Percentage Calculator
    </h1>
    <p class="text-slate-500">Calculate your percentage from marks obtained.</p>
  </div>

  <div class="bg-slate-50 border border-slate-200 rounded p-6 mb-8">
    <div class="grid md:grid-cols-2 gap-4 mb-6">
      <div>
        <label
          for="obtained"
          class="block font-medium text-slate-700 mb-1.5 text-sm"
          >Marks Obtained</label
        >
        <input
          type="number"
          id="obtained"
          placeholder="e.g., 425"
          class="w-full px-4 py-3 border border-slate-300 rounded bg-white text-slate-800 outline-none"
          oninput="calculate()"
        />
      </div>
      <div>
        <label
          for="total"
          class="block font-medium text-slate-700 mb-1.5 text-sm"
          >Total Marks</label
        >
        <input
          type="number"
          id="total"
          placeholder="e.g., 500"
          class="w-full px-4 py-3 border border-slate-300 rounded bg-white text-slate-800 outline-none"
          oninput="calculate()"
        />
      </div>
    </div>

    <div class="result-box p-6 bg-white rounded">
      <div class="grid grid-cols-2 gap-6 text-center">
        <div>
          <div class="text-xs text-slate-500 uppercase mb-2">Percentage</div>
          <div class="text-4xl font-bold text-pink-600" id="percentage">—%</div>
        </div>
        <div>
          <div class="text-xs text-slate-500 uppercase mb-2">Grade</div>
          <div class="text-4xl font-bold text-slate-900" id="grade">—</div>
        </div>
      </div>
    </div>
  </div>

  <section class="mt-8 pt-6 border-t border-slate-200">
    <h2 class="text-xl font-semibold text-slate-900 mb-4">
      Common Grading Scale
    </h2>
    <div class="grid grid-cols-5 gap-2 text-sm text-center">
      <div class="p-2 bg-green-100 text-green-800 rounded">90-100%: A+</div>
      <div class="p-2 bg-green-50 text-green-700 rounded">80-89%: A</div>
      <div class="p-2 bg-blue-50 text-blue-700 rounded">70-79%: B</div>
      <div class="p-2 bg-yellow-50 text-yellow-700 rounded">60-69%: C</div>
      <div class="p-2 bg-red-50 text-red-700 rounded">&lt;60%: D/F</div>
    </div>
  </section>

  <script is:inline>
    function calculate() {
      const obtained = parseFloat(document.getElementById("obtained").value);
      const total = parseFloat(document.getElementById("total").value);

      if (isNaN(obtained) || isNaN(total) || total === 0) {
        document.getElementById("percentage").innerText = "—%";
        document.getElementById("grade").innerText = "—";
        return;
      }

      const percentage = (obtained / total) * 100;
      document.getElementById("percentage").innerText =
        percentage.toFixed(2) + "%";

      let grade;
      if (percentage >= 90) grade = "A+";
      else if (percentage >= 80) grade = "A";
      else if (percentage >= 70) grade = "B";
      else if (percentage >= 60) grade = "C";
      else if (percentage >= 50) grade = "D";
      else grade = "F";

      document.getElementById("grade").innerText = grade;
    }
  </script>
</StudentToolLayout>
