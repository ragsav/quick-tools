---
import StudentToolLayout from "../../layouts/StudentToolLayout.astro";

const faqItems = [
  {
    question: "How do I convert percentage to GPA?",
    answer:
      "For 4.0 scale: (Percentage/100)×4. For 10.0 scale (India): Percentage ÷ 9.5.",
  },
  {
    question: "What GPA scales are supported?",
    answer: "4.0 scale (US), 10.0 scale (India), and 5.0 scale.",
  },
  {
    question: "Is this tool free?",
    answer:
      "Yes, this tool is completely free and works directly in your browser.",
  },
];

const howItWorks = [
  {
    title: "4.0 Scale Conversion",
    content:
      "GPA = (Percentage ÷ 100) × 4. An 85% becomes 3.4 on the 4.0 scale.",
  },
  {
    title: "10.0 Scale Conversion",
    content:
      "GPA = Percentage ÷ 9.5. This is the reverse of the common Indian formula. 85% becomes 8.95.",
  },
  {
    title: "5.0 Scale Conversion",
    content:
      "GPA = (Percentage ÷ 100) × 5. An 85% becomes 4.25 on the 5.0 scale.",
  },
  {
    title: "Input Validation",
    content:
      "Percentage must be between 0-100. Values outside this range are flagged as invalid.",
  },
  {
    title: "Precision",
    content:
      "Results are shown to 2 decimal places for accuracy in applications and comparisons.",
  },
];

const useCases = [
  {
    title: "US University Applications",
    description:
      "Convert percentage scores to 4.0 GPA for US college and graduate school applications.",
  },
  {
    title: "Resume Building",
    description:
      "Include GPA on resumes for US employers who expect grades in 4.0 format.",
  },
  {
    title: "Scholarship Applications",
    description:
      "Many international scholarships require GPA. Convert your percentage for eligibility checks.",
  },
  {
    title: "Study Abroad Programs",
    description:
      "Exchange programs often require GPA. Convert percentage marks to apply.",
  },
  {
    title: "Credential Evaluation",
    description:
      "Services like WES require GPA equivalent. Calculate expected conversion before applying.",
  },
  {
    title: "Job Applications",
    description:
      "Some multinational companies request GPA on applications. Convert for consistency.",
  },
];
---

<StudentToolLayout
  title="Percentage to GPA Converter - Convert Percent to GPA"
  description="Convert percentage marks to GPA for different grading scales. Free online converter."
  canonicalPath="/student/percentage-to-gpa"
  currentTool="Percentage to GPA"
  faqItems={faqItems}
  howItWorks={howItWorks}
  useCases={useCases}
>
  <div class="tool-header">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">
      Percentage to GPA Converter
    </h1>
    <p class="text-slate-500">
      Convert your percentage to GPA on different scales.
    </p>
  </div>

  <div class="bg-slate-50 border border-slate-200 rounded p-6 mb-8">
    <div class="grid md:grid-cols-2 gap-4 mb-6">
      <div>
        <label
          for="percentage"
          class="block font-medium text-slate-700 mb-1.5 text-sm"
          >Your Percentage (%)</label
        >
        <input
          type="number"
          id="percentage"
          step="0.1"
          max="100"
          placeholder="e.g., 85"
          class="w-full px-4 py-3 border border-slate-300 rounded bg-white text-slate-800 outline-none"
          oninput="convert()"
        />
      </div>
      <div>
        <label
          for="scale"
          class="block font-medium text-slate-700 mb-1.5 text-sm"
          >Target GPA Scale</label
        >
        <select
          id="scale"
          class="w-full px-4 py-3 border border-slate-300 rounded bg-white text-slate-800 outline-none"
          onchange="convert()"
        >
          <option value="4">4.0 Scale (US)</option>
          <option value="10">10.0 Scale (India)</option>
          <option value="5">5.0 Scale</option>
        </select>
      </div>
    </div>

    <div class="result-box p-6 bg-white rounded text-center">
      <div class="text-xs text-slate-500 uppercase mb-2">GPA</div>
      <div class="text-5xl font-bold text-pink-600" id="result">—</div>
    </div>
  </div>

  <script is:inline>
    function convert() {
      const percentage = parseFloat(
        document.getElementById("percentage").value,
      );
      const scale = parseFloat(document.getElementById("scale").value);

      if (isNaN(percentage) || percentage < 0 || percentage > 100) {
        document.getElementById("result").innerText = "—";
        return;
      }

      let gpa;
      if (scale === 4) {
        gpa = (percentage / 100) * 4;
      } else if (scale === 10) {
        gpa = percentage / 9.5; // Common Indian conversion
      } else {
        gpa = (percentage / 100) * scale;
      }

      document.getElementById("result").innerText = gpa.toFixed(2);
    }
  </script>
</StudentToolLayout>
