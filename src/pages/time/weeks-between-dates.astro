---
import TimeToolLayout from "../../layouts/TimeToolLayout.astro";

const faqItems = [
  {
    question: "How are weeks calculated between dates?",
    answer:
      "The calculator divides the total days between dates by 7 to get complete weeks, plus any remaining days.",
  },
  {
    question: "Does it show partial weeks?",
    answer:
      "Yes, the result shows both complete weeks and remaining days for precise counting.",
  },
  {
    question: "Is this tool free to use?",
    answer:
      "Yes, this tool is completely free and works directly in your browser.",
  },
];

const howItWorks = [
  {
    title: "Date Difference in Milliseconds",
    content:
      "The calculator first computes the absolute difference between the two dates in milliseconds: |endDate - startDate|. Using absolute value ensures a positive result regardless of date order.",
  },
  {
    title: "Convert to Days",
    content:
      "Milliseconds are converted to days by dividing by 86,400,000 (the number of milliseconds in a day: 1000 × 60 × 60 × 24). The result is floored to get complete days.",
  },
  {
    title: "Calculate Complete Weeks",
    content:
      "Total days are divided by 7 to get complete weeks: weeks = Math.floor(days / 7). This gives the number of full 7-day periods between the dates.",
  },
  {
    title: "Calculate Remaining Days",
    content:
      "The modulo operator extracts remaining days: remainingDays = days % 7. This shows how many extra days beyond complete weeks, ranging from 0 to 6.",
  },
  {
    title: "Result Presentation",
    content:
      "Results are displayed as both complete weeks and the full breakdown (X weeks and Y days), plus the total day count for reference. This provides multiple perspectives on the duration.",
  },
];

const useCases = [
  {
    title: "Pregnancy Tracking",
    description:
      "Medical professionals and expecting parents track pregnancy progress in weeks. Calculate weeks since conception or weeks until due date.",
  },
  {
    title: "Sprint & Agile Planning",
    description:
      "Development teams often work in 1-2 week sprints. Calculate how many sprints fit between project start and deadline dates.",
  },
  {
    title: "Fitness Program Duration",
    description:
      "Workout and diet programs are often designed in weekly cycles. Determine how many weeks your fitness program will run.",
  },
  {
    title: "Rental & Lease Calculations",
    description:
      "Some rentals (vacation homes, equipment) are priced weekly. Calculate total weeks for accurate billing.",
  },
  {
    title: "Academic Term Planning",
    description:
      "Semester and term lengths are often measured in weeks. Calculate teaching weeks for curriculum planning.",
  },
  {
    title: "Recovery & Treatment Duration",
    description:
      "Medical treatments and recovery periods are frequently measured in weeks. Track progress through rehabilitation programs.",
  },
];
---

<TimeToolLayout
  title="Weeks Between Dates Calculator - Count Weeks"
  description="Calculate the number of weeks between two dates instantly. Free online week counter tool."
  canonicalPath="/time/weeks-between-dates"
  currentTool="Weeks Between Dates"
  faqItems={faqItems}
  howItWorks={howItWorks}
  useCases={useCases}
>
  <div class="tool-header">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">
      Weeks Between Dates
    </h1>
    <p class="text-slate-500">
      Calculate the number of weeks between any two dates.
    </p>
  </div>

  <div class="bg-slate-50 border border-slate-200 rounded p-6 mb-8">
    <div class="flex flex-wrap gap-6 mb-6">
      <div class="flex-1 min-w-48">
        <label
          for="startDate"
          class="block font-medium text-slate-700 mb-1.5 text-sm"
          >Start Date</label
        >
        <input
          type="date"
          id="startDate"
          class="w-full px-4 py-3 text-base border border-slate-300 rounded bg-white text-slate-800 outline-none"
        />
      </div>
      <div class="flex-1 min-w-48">
        <label
          for="endDate"
          class="block font-medium text-slate-700 mb-1.5 text-sm"
          >End Date</label
        >
        <input
          type="date"
          id="endDate"
          class="w-full px-4 py-3 text-base border border-slate-300 rounded bg-white text-slate-800 outline-none"
        />
      </div>
    </div>

    <button
      class="btn-primary px-6 py-3 font-semibold text-white rounded"
      onclick="calculate()">Calculate Weeks</button
    >

    <div class="result-box mt-6 p-4 bg-white rounded hidden" id="resultBox">
      <div class="text-xs text-slate-500 uppercase tracking-wider mb-1">
        Result
      </div>
      <div class="text-3xl font-bold text-slate-900" id="result">—</div>
      <div class="text-sm text-slate-500 mt-2" id="details"></div>
    </div>
  </div>

  <script is:inline>
    function calculate() {
      const start = new Date(document.getElementById("startDate").value);
      const end = new Date(document.getElementById("endDate").value);
      const resultBox = document.getElementById("resultBox");

      if (isNaN(start.getTime()) || isNaN(end.getTime())) {
        document.getElementById("result").innerText =
          "Please select both dates";
        resultBox.classList.remove("hidden");
        return;
      }

      const diffMs = Math.abs(end - start);
      const days = Math.floor(diffMs / (1000 * 60 * 60 * 24));
      const weeks = Math.floor(days / 7);
      const remainingDays = days % 7;

      document.getElementById("result").innerText = `${weeks} weeks`;
      document.getElementById("details").innerText =
        `${days} total days (${weeks} weeks and ${remainingDays} days)`;
      resultBox.classList.remove("hidden");
    }
  </script>
</TimeToolLayout>
