---
import TimeToolLayout from "../../layouts/TimeToolLayout.astro";
---

<TimeToolLayout
  title="Time & Date Tools - Free Online Date Calculators"
  description="Free online time and date calculators. Calculate date differences, business days, age, time zones, and more."
  canonicalPath="/time"
  currentTool=""
>
  <div class="tool-header">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">🕒 Time & Date Tools</h1>
    <p class="text-slate-500">Calculate dates, time zones, countdowns, and more.</p>
  </div>

  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4 mt-6">
    <a href="/time/date-difference-calculator" class="tool-card block p-5 bg-slate-50 border border-slate-200 rounded-lg hover:bg-white hover:border-blue-400 hover:shadow-md transition-all">
      <h3 class="font-semibold text-slate-900 mb-1">Date Difference Calculator</h3>
      <p class="text-sm text-slate-500">Calculate days, weeks, months between two dates</p>
    </a>

    <a href="/time/working-days-calculator" class="tool-card block p-5 bg-slate-50 border border-slate-200 rounded-lg hover:bg-white hover:border-blue-400 hover:shadow-md transition-all">
      <h3 class="font-semibold text-slate-900 mb-1">Working Days Calculator</h3>
      <p class="text-sm text-slate-500">Count weekdays between dates</p>
    </a>

    <a href="/time/business-days-calculator" class="tool-card block p-5 bg-slate-50 border border-slate-200 rounded-lg hover:bg-white hover:border-blue-400 hover:shadow-md transition-all">
      <h3 class="font-semibold text-slate-900 mb-1">Business Days Calculator</h3>
      <p class="text-sm text-slate-500">Exclude weekends and holidays</p>
    </a>

    <a href="/time/age-calculator" class="tool-card block p-5 bg-slate-50 border border-slate-200 rounded-lg hover:bg-white hover:border-blue-400 hover:shadow-md transition-all">
      <h3 class="font-semibold text-slate-900 mb-1">Age Calculator</h3>
      <p class="text-sm text-slate-500">Calculate exact age from birthdate</p>
    </a>

    <a href="/time/countdown-calculator" class="tool-card block p-5 bg-slate-50 border border-slate-200 rounded-lg hover:bg-white hover:border-blue-400 hover:shadow-md transition-all">
      <h3 class="font-semibold text-slate-900 mb-1">Countdown Calculator</h3>
      <p class="text-sm text-slate-500">Live countdown to any date</p>
    </a>

    <a href="/time/timezone-converter" class="tool-card block p-5 bg-slate-50 border border-slate-200 rounded-lg hover:bg-white hover:border-blue-400 hover:shadow-md transition-all">
      <h3 class="font-semibold text-slate-900 mb-1">Time Zone Converter</h3>
      <p class="text-sm text-slate-500">Convert time between zones</p>
    </a>

    <a href="/time/timezone-overlap" class="tool-card block p-5 bg-slate-50 border border-slate-200 rounded-lg hover:bg-white hover:border-blue-400 hover:shadow-md transition-all">
      <h3 class="font-semibold text-slate-900 mb-1">Time Zone Overlap</h3>
      <p class="text-sm text-slate-500">Find overlapping work hours</p>
    </a>

    <a href="/time/weeks-between-dates" class="tool-card block p-5 bg-slate-50 border border-slate-200 rounded-lg hover:bg-white hover:border-blue-400 hover:shadow-md transition-all">
      <h3 class="font-semibold text-slate-900 mb-1">Weeks Between Dates</h3>
      <p class="text-sm text-slate-500">Calculate weeks between two dates</p>
    </a>

    <a href="/time/months-between-dates" class="tool-card block p-5 bg-slate-50 border border-slate-200 rounded-lg hover:bg-white hover:border-blue-400 hover:shadow-md transition-all">
      <h3 class="font-semibold text-slate-900 mb-1">Months Between Dates</h3>
      <p class="text-sm text-slate-500">Calculate months between two dates</p>
    </a>

    <a href="/time/leap-year-checker" class="tool-card block p-5 bg-slate-50 border border-slate-200 rounded-lg hover:bg-white hover:border-blue-400 hover:shadow-md transition-all">
      <h3 class="font-semibold text-slate-900 mb-1">Leap Year Checker</h3>
      <p class="text-sm text-slate-500">Check if a year is a leap year</p>
    </a>

    <a href="/time/day-of-week" class="tool-card block p-5 bg-slate-50 border border-slate-200 rounded-lg hover:bg-white hover:border-blue-400 hover:shadow-md transition-all">
      <h3 class="font-semibold text-slate-900 mb-1">Day of Week</h3>
      <p class="text-sm text-slate-500">Find what day any date falls on</p>
    </a>

    <a href="/time/date-add-subtract" class="tool-card block p-5 bg-slate-50 border border-slate-200 rounded-lg hover:bg-white hover:border-blue-400 hover:shadow-md transition-all">
      <h3 class="font-semibold text-slate-900 mb-1">Date Add/Subtract</h3>
      <p class="text-sm text-slate-500">Add or subtract days from a date</p>
    </a>

    <a href="/time/iso-date-converter" class="tool-card block p-5 bg-slate-50 border border-slate-200 rounded-lg hover:bg-white hover:border-blue-400 hover:shadow-md transition-all">
      <h3 class="font-semibold text-slate-900 mb-1">ISO Date Converter</h3>
      <p class="text-sm text-slate-500">Convert to/from ISO 8601 format</p>
    </a>
  </div>
</TimeToolLayout>
