---
import TimeToolLayout from "../../layouts/TimeToolLayout.astro";

const faqItems = [
  {
    question: "How do I know if a year is a leap year?",
    answer:
      "A year is a leap year if it's divisible by 4, except for years divisible by 100 (unless also divisible by 400).",
  },
  {
    question: "Why do we have leap years?",
    answer:
      "Leap years compensate for the fact that Earth's orbit around the sun takes approximately 365.25 days.",
  },
  {
    question: "When is the next leap year?",
    answer:
      "The tool shows upcoming leap years. Leap years occur every 4 years (2024, 2028, 2032, etc.).",
  },
];

const howItWorks = [
  {
    title: "Divisibility by 4 Check",
    content:
      "The first rule of the Gregorian calendar is that a year must be evenly divisible by 4 to be a leap year. This is checked using the modulo operator: year % 4 === 0. Most years that pass this test are leap years.",
  },
  {
    title: "Century Year Exception",
    content:
      "Years divisible by 100 are NOT leap years, even if divisible by 4. This exception exists because 365.25 days per year slightly overcompensates. For example, 1900 was not a leap year despite being divisible by 4.",
  },
  {
    title: "400-Year Override",
    content:
      "Years divisible by 400 ARE leap years, overriding the century exception. This fine-tunes the calendar to match Earth's actual 365.2422-day orbit. For example, 2000 was a leap year because it's divisible by 400.",
  },
  {
    title: "Combined Rule Application",
    content:
      "The complete formula is: (year % 4 === 0 && year % 100 !== 0) || (year % 400 === 0). This single expression implements all three rules, returning true for leap years and false otherwise.",
  },
  {
    title: "Calendar Accuracy",
    content:
      "This system keeps the Gregorian calendar synchronized with the solar year to within one day per 3,236 years. Without leap years, seasons would gradually shift through the calendar over centuries.",
  },
];

const useCases = [
  {
    title: "Birthday on February 29",
    description:
      "People born on February 29 ('leaplings') need to know when their actual birthday occurs. In non-leap years, they celebrate on February 28 or March 1.",
  },
  {
    title: "Financial Calendar Planning",
    description:
      "Accountants and financial planners need to account for the extra day in leap years when calculating daily rates, interest accrual, and annual budgets.",
  },
  {
    title: "Software Development",
    description:
      "Developers building date-handling systems must correctly implement leap year logic. Bugs in leap year calculation have caused notable system failures.",
  },
  {
    title: "Historical Date Research",
    description:
      "Historians and genealogists need to correctly count days in historical periods, accounting for leap years in both Gregorian and Julian calendars.",
  },
  {
    title: "Educational Purposes",
    description:
      "Students learning about calendars and astronomy can understand why we have leap years and practice the mathematical rules behind them.",
  },
  {
    title: "Event Planning",
    description:
      "Knowing upcoming leap years helps with long-term event planning, especially for recurring annual events that may be affected by the extra February day.",
  },
];
---

<TimeToolLayout
  title="Leap Year Checker - Is It a Leap Year?"
  description="Check if any year is a leap year. Learn the leap year rules and find leap years. Free online tool."
  canonicalPath="/time/leap-year-checker"
  currentTool="Leap Year Checker"
  faqItems={faqItems}
  howItWorks={howItWorks}
  useCases={useCases}
>
  <div class="tool-header">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">
      Leap Year Checker
    </h1>
    <p class="text-slate-500">
      Check whether a year is a leap year and find upcoming leap years.
    </p>
  </div>

  <div class="bg-slate-50 border border-slate-200 rounded p-6 mb-8">
    <div class="mb-6">
      <label for="year" class="block font-medium text-slate-700 mb-1.5 text-sm"
        >Enter Year</label
      >
      <input
        type="number"
        id="year"
        placeholder="e.g., 2024"
        min="1"
        max="9999"
        class="w-full max-w-xs px-4 py-3 text-base border border-slate-300 rounded bg-white text-slate-800 outline-none"
      />
    </div>

    <button
      class="btn-primary px-6 py-3 font-semibold text-white rounded"
      onclick="check()">Check Year</button
    >

    <div class="result-box mt-6 p-4 bg-white rounded hidden" id="resultBox">
      <div class="text-3xl font-bold" id="result">—</div>
      <div class="text-sm text-slate-500 mt-2" id="explanation"></div>
    </div>

    <div class="mt-6 pt-6 border-t border-slate-200">
      <h3 class="font-medium text-slate-700 mb-3">Upcoming Leap Years</h3>
      <div class="flex flex-wrap gap-2" id="upcomingYears"></div>
    </div>
  </div>

  <section class="mt-8 pt-6 border-t border-slate-200">
    <h2 class="text-xl font-semibold text-slate-900 mb-4">Leap Year Rules</h2>
    <ul class="list-disc pl-6 text-slate-600 space-y-2">
      <li>A year is a leap year if it's <strong>divisible by 4</strong></li>
      <li>
        BUT if it's divisible by 100, it's <strong>NOT</strong> a leap year
      </li>
      <li>
        UNLESS it's also divisible by 400, then it <strong>IS</strong> a leap year
      </li>
    </ul>
    <p class="text-slate-600 mt-3">
      Example: 2000 was a leap year (divisible by 400), but 1900 was not
      (divisible by 100 but not 400).
    </p>
  </section>

  <script is:inline>
    function isLeapYear(year) {
      return (year % 4 === 0 && year % 100 !== 0) || year % 400 === 0;
    }

    // Show upcoming leap years
    const currentYear = new Date().getFullYear();
    const upcoming = [];
    for (let y = currentYear; upcoming.length < 8; y++) {
      if (isLeapYear(y)) upcoming.push(y);
    }
    document.getElementById("upcomingYears").innerHTML = upcoming
      .map(
        (y) =>
          `<span class="px-3 py-1 bg-blue-100 text-blue-700 rounded text-sm font-medium">${y}</span>`,
      )
      .join("");

    document.getElementById("year").value = currentYear;

    function check() {
      const year = parseInt(document.getElementById("year").value);
      const resultBox = document.getElementById("resultBox");

      if (isNaN(year) || year < 1) {
        document.getElementById("result").innerText =
          "Please enter a valid year";
        document.getElementById("result").className =
          "text-3xl font-bold text-slate-900";
        resultBox.classList.remove("hidden");
        return;
      }

      const isLeap = isLeapYear(year);

      document.getElementById("result").innerText = isLeap
        ? `✅ ${year} IS a leap year`
        : `❌ ${year} is NOT a leap year`;
      document.getElementById("result").className = isLeap
        ? "text-2xl font-bold text-green-600"
        : "text-2xl font-bold text-red-600";

      let explanation = "";
      if (year % 400 === 0) {
        explanation = "Divisible by 400, so it's a leap year";
      } else if (year % 100 === 0) {
        explanation = "Divisible by 100 but not 400, so NOT a leap year";
      } else if (year % 4 === 0) {
        explanation = "Divisible by 4 (and not by 100), so it's a leap year";
      } else {
        explanation = "Not divisible by 4, so NOT a leap year";
      }

      document.getElementById("explanation").innerText = explanation;
      resultBox.classList.remove("hidden");
    }
  </script>
</TimeToolLayout>
