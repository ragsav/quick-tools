---
import TimeToolLayout from "../../layouts/TimeToolLayout.astro";

const faqItems = [
  {
    question: "How are months calculated between dates?",
    answer:
      "The calculator counts complete months between dates, adjusting for the day of month to give accurate results.",
  },
  {
    question: "Does this account for different month lengths?",
    answer:
      "Yes, the calculator handles months with 28, 29, 30, and 31 days correctly.",
  },
  {
    question: "Is this tool free to use?",
    answer:
      "Yes, this tool is completely free and works directly in your browser.",
  },
];

const howItWorks = [
  {
    title: "Year-Month Difference",
    content:
      "First, calculate the difference in months at the year/month level: (endYear - startYear) × 12 + (endMonth - startMonth). This gives a baseline count ignoring day-of-month.",
  },
  {
    title: "Day Adjustment",
    content:
      "If the end day is less than the start day, a full month hasn't passed yet, so we subtract one from the total. For example, Jan 31 to Feb 15 isn't a full month.",
  },
  {
    title: "Year Conversion",
    content:
      "The total months can be expressed as years and remaining months: years = Math.floor(months / 12), remainingMonths = months % 12. This provides a more intuitive breakdown for longer periods.",
  },
  {
    title: "Variable Month Handling",
    content:
      "The algorithm correctly handles months of different lengths. Moving from the 31st to a month with fewer days doesn't throw off the calculation due to the day-adjustment logic.",
  },
  {
    title: "Absolute Value Handling",
    content:
      "The calculation works regardless of which date is earlier, though typically the result represents months from the earlier date to the later date.",
  },
];

const useCases = [
  {
    title: "Loan Term Calculations",
    description:
      "Mortgages, auto loans, and personal loans are specified in months. Calculate remaining months on a loan or convert years to monthly payments.",
  },
  {
    title: "Subscription Billing",
    description:
      "Calculate how many months a subscription has been active for billing reconciliation, or determine months until renewal.",
  },
  {
    title: "Employment Tenure",
    description:
      "Human resources often track employment length in months for probation periods, benefits eligibility, and years-of-service calculations.",
  },
  {
    title: "Lease Duration",
    description:
      "Rental agreements are typically measured in months. Calculate remaining months on a lease or prorate rent for partial months.",
  },
  {
    title: "Project Duration",
    description:
      "Long-term projects are often measured in months. Calculate project length for planning, budgeting, and timeline presentations.",
  },
  {
    title: "Child Development Tracking",
    description:
      "Pediatricians track infant and toddler development in months. Calculate a baby's age in months for milestone tracking and medical visits.",
  },
];
---

<TimeToolLayout
  title="Months Between Dates Calculator - Count Months"
  description="Calculate the number of months between two dates accurately. Free online month counter."
  canonicalPath="/time/months-between-dates"
  currentTool="Months Between Dates"
  faqItems={faqItems}
  howItWorks={howItWorks}
  useCases={useCases}
>
  <div class="tool-header">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">
      Months Between Dates
    </h1>
    <p class="text-slate-500">Calculate exact months between any two dates.</p>
  </div>

  <div class="bg-slate-50 border border-slate-200 rounded p-6 mb-8">
    <div class="flex flex-wrap gap-6 mb-6">
      <div class="flex-1 min-w-48">
        <label
          for="startDate"
          class="block font-medium text-slate-700 mb-1.5 text-sm"
          >Start Date</label
        >
        <input
          type="date"
          id="startDate"
          class="w-full px-4 py-3 text-base border border-slate-300 rounded bg-white text-slate-800 outline-none"
        />
      </div>
      <div class="flex-1 min-w-48">
        <label
          for="endDate"
          class="block font-medium text-slate-700 mb-1.5 text-sm"
          >End Date</label
        >
        <input
          type="date"
          id="endDate"
          class="w-full px-4 py-3 text-base border border-slate-300 rounded bg-white text-slate-800 outline-none"
        />
      </div>
    </div>

    <button
      class="btn-primary px-6 py-3 font-semibold text-white rounded"
      onclick="calculate()">Calculate Months</button
    >

    <div class="result-box mt-6 p-4 bg-white rounded hidden" id="resultBox">
      <div class="text-xs text-slate-500 uppercase tracking-wider mb-1">
        Result
      </div>
      <div class="text-3xl font-bold text-slate-900" id="result">—</div>
      <div class="text-sm text-slate-500 mt-2" id="details"></div>
    </div>
  </div>

  <script is:inline>
    function calculate() {
      const start = new Date(document.getElementById("startDate").value);
      const end = new Date(document.getElementById("endDate").value);
      const resultBox = document.getElementById("resultBox");

      if (isNaN(start.getTime()) || isNaN(end.getTime())) {
        document.getElementById("result").innerText =
          "Please select both dates";
        resultBox.classList.remove("hidden");
        return;
      }

      let months = (end.getFullYear() - start.getFullYear()) * 12;
      months += end.getMonth() - start.getMonth();

      // Adjust for day of month
      if (end.getDate() < start.getDate()) months--;

      const years = Math.floor(months / 12);
      const remainingMonths = months % 12;

      document.getElementById("result").innerText = `${months} months`;
      document.getElementById("details").innerText =
        years > 0
          ? `${years} years and ${remainingMonths} months`
          : `Approximately ${months} months`;
      resultBox.classList.remove("hidden");
    }
  </script>
</TimeToolLayout>
