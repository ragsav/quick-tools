---
import TimeToolLayout from "../../layouts/TimeToolLayout.astro";

const faqItems = [
  {
    question: "Can I find the day of week for any date?",
    answer: "Yes, this calculator works for any past or future date.",
  },
  {
    question: "What calendar system does this use?",
    answer:
      "This tool uses the Gregorian calendar, the standard calendar in most countries.",
  },
  {
    question: "Is this tool free to use?",
    answer:
      "Yes, this tool is completely free and works directly in your browser.",
  },
];

const howItWorks = [
  {
    title: "Date Object Creation",
    content:
      "Your selected date is parsed into a JavaScript Date object, which internally represents the date as milliseconds since January 1, 1970. This enables consistent day-of-week calculation across any date range.",
  },
  {
    title: "Day Index Retrieval",
    content:
      "The getDay() method returns the day of the week as a number from 0 (Sunday) to 6 (Saturday). This follows a zero-indexed pattern where the week starts on Sunday, which is standard in JavaScript.",
  },
  {
    title: "Day Name Mapping",
    content:
      "The numeric index is used to look up the full day name from an array: ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday']. This converts the number to human-readable text.",
  },
  {
    title: "Calendar Algorithm",
    content:
      "Behind the scenes, JavaScript uses algorithms that account for the Gregorian calendar reform of 1582, leap years, and varying month lengths to accurately determine the weekday for any date.",
  },
  {
    title: "Locale-Aware Formatting",
    content:
      "The full date is formatted using toLocaleDateString() with options for displaying the complete weekday and date, adapting to your browser's locale settings for proper formatting.",
  },
];

const useCases = [
  {
    title: "Historical Event Research",
    description:
      "Discover what day of the week historical events occurred. Find out if July 4, 1776 or November 11, 1918 was a weekend or weekday.",
  },
  {
    title: "Birthday Day Discovery",
    description:
      "Find out what day of the week you were born, or discover the weekday of upcoming birthdays for planning celebrations.",
  },
  {
    title: "Event Scheduling",
    description:
      "When planning future events, verify that your chosen date falls on the desired day of the week before sending invitations.",
  },
  {
    title: "Work Schedule Planning",
    description:
      "Determine if specific dates fall on weekdays or weekends for work scheduling, deadline planning, and time-off requests.",
  },
  {
    title: "Religious Observance",
    description:
      "Verify dates for religious holidays and observances that occur on specific days of the week, like Easter Sunday or Good Friday.",
  },
  {
    title: "Superstition Checking",
    description:
      "Check if dates fall on traditionally 'unlucky' days like Friday the 13th, or find 'lucky' days for important events.",
  },
];
---

<TimeToolLayout
  title="Day of Week Calculator - What Day Was/Will It Be?"
  description="Find what day of the week any date falls on. Works for past and future dates. Free online tool."
  canonicalPath="/time/day-of-week"
  currentTool="Day of Week Calculator"
  faqItems={faqItems}
  howItWorks={howItWorks}
  useCases={useCases}
>
  <div class="tool-header">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">
      Day of Week Calculator
    </h1>
    <p class="text-slate-500">
      Find out what day of the week any date is or was.
    </p>
  </div>

  <div class="bg-slate-50 border border-slate-200 rounded p-6 mb-8">
    <div class="mb-6">
      <label for="date" class="block font-medium text-slate-700 mb-1.5 text-sm"
        >Select Date</label
      >
      <input
        type="date"
        id="date"
        class="w-full max-w-xs px-4 py-3 text-base border border-slate-300 rounded bg-white text-slate-800 outline-none"
      />
    </div>

    <button
      class="btn-primary px-6 py-3 font-semibold text-white rounded"
      onclick="calculate()">Find Day</button
    >

    <div class="result-box mt-6 p-6 bg-white rounded hidden" id="resultBox">
      <div class="text-center">
        <div class="text-5xl mb-3" id="emoji">📅</div>
        <div class="text-3xl font-bold text-blue-600" id="dayName">—</div>
        <div class="text-slate-500 mt-2" id="fullDate">—</div>
      </div>
    </div>
  </div>

  <section class="mt-8 pt-6 border-t border-slate-200">
    <h2 class="text-xl font-semibold text-slate-900 mb-4">Quick Dates</h2>
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
      <button
        onclick="setDate(0)"
        class="p-3 bg-white border border-slate-200 rounded text-sm hover:border-blue-500"
        >Today</button
      >
      <button
        onclick="setDate(1)"
        class="p-3 bg-white border border-slate-200 rounded text-sm hover:border-blue-500"
        >Tomorrow</button
      >
      <button
        onclick="setDate(7)"
        class="p-3 bg-white border border-slate-200 rounded text-sm hover:border-blue-500"
        >Next Week</button
      >
      <button
        onclick="setDate(30)"
        class="p-3 bg-white border border-slate-200 rounded text-sm hover:border-blue-500"
        >Next Month</button
      >
    </div>
  </section>

  <script is:inline>
    const dayNames = [
      "Sunday",
      "Monday",
      "Tuesday",
      "Wednesday",
      "Thursday",
      "Friday",
      "Saturday",
    ];
    const dayEmojis = ["☀️", "🌙", "🔥", "💧", "⚡", "💚", "🪐"];

    function setDate(daysFromNow) {
      const date = new Date();
      date.setDate(date.getDate() + daysFromNow);
      document.getElementById("date").valueAsDate = date;
      calculate();
    }

    function calculate() {
      const dateInput = document.getElementById("date");
      const date = new Date(dateInput.value);
      const resultBox = document.getElementById("resultBox");

      if (isNaN(date.getTime())) {
        document.getElementById("dayName").innerText = "Please select a date";
        resultBox.classList.remove("hidden");
        return;
      }

      const dayIndex = date.getDay();
      const dayName = dayNames[dayIndex];
      const emoji = dayEmojis[dayIndex];

      const options = {
        weekday: "long",
        year: "numeric",
        month: "long",
        day: "numeric",
      };
      const fullDate = date.toLocaleDateString("en-US", options);

      document.getElementById("emoji").innerText = emoji;
      document.getElementById("dayName").innerText = dayName;
      document.getElementById("fullDate").innerText = fullDate;
      resultBox.classList.remove("hidden");
    }

    // Set today as default
    document.getElementById("date").valueAsDate = new Date();
  </script>
</TimeToolLayout>
