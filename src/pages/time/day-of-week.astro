---
import TimeToolLayout from "../../layouts/TimeToolLayout.astro";
---

<TimeToolLayout
  title="Day of Week Calculator - What Day Was/Will It Be?"
  description="Find what day of the week any date falls on. Works for past and future dates. Free online tool."
  canonicalPath="/time/day-of-week"
  currentTool="Day of Week Calculator"
>
  <div class="tool-header">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">Day of Week Calculator</h1>
    <p class="text-slate-500">Find out what day of the week any date is or was.</p>
  </div>

  <div class="bg-slate-50 border border-slate-200 rounded p-6 mb-8">
    <div class="mb-6">
      <label for="date" class="block font-medium text-slate-700 mb-1.5 text-sm">Select Date</label>
      <input type="date" id="date" class="w-full max-w-xs px-4 py-3 text-base border border-slate-300 rounded bg-white text-slate-800 outline-none" />
    </div>

    <button class="btn-primary px-6 py-3 font-semibold text-white rounded" onclick="calculate()">Find Day</button>

    <div class="result-box mt-6 p-6 bg-white rounded hidden" id="resultBox">
      <div class="text-center">
        <div class="text-5xl mb-3" id="emoji">📅</div>
        <div class="text-3xl font-bold text-blue-600" id="dayName">—</div>
        <div class="text-slate-500 mt-2" id="fullDate">—</div>
      </div>
    </div>
  </div>

  <section class="mt-8 pt-6 border-t border-slate-200">
    <h2 class="text-xl font-semibold text-slate-900 mb-4">Quick Dates</h2>
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
      <button onclick="setDate(0)" class="p-3 bg-white border border-slate-200 rounded text-sm hover:border-blue-500">Today</button>
      <button onclick="setDate(1)" class="p-3 bg-white border border-slate-200 rounded text-sm hover:border-blue-500">Tomorrow</button>
      <button onclick="setDate(7)" class="p-3 bg-white border border-slate-200 rounded text-sm hover:border-blue-500">Next Week</button>
      <button onclick="setDate(30)" class="p-3 bg-white border border-slate-200 rounded text-sm hover:border-blue-500">Next Month</button>
    </div>
  </section>

  <script is:inline>
    const dayNames = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
    const dayEmojis = ["☀️", "🌙", "🔥", "💧", "⚡", "💚", "🪐"];

    function setDate(daysFromNow) {
      const date = new Date();
      date.setDate(date.getDate() + daysFromNow);
      document.getElementById("date").valueAsDate = date;
      calculate();
    }

    function calculate() {
      const dateInput = document.getElementById("date");
      const date = new Date(dateInput.value);
      const resultBox = document.getElementById("resultBox");

      if (isNaN(date.getTime())) {
        document.getElementById("dayName").innerText = "Please select a date";
        resultBox.classList.remove("hidden");
        return;
      }

      const dayIndex = date.getDay();
      const dayName = dayNames[dayIndex];
      const emoji = dayEmojis[dayIndex];

      const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
      const fullDate = date.toLocaleDateString('en-US', options);

      document.getElementById("emoji").innerText = emoji;
      document.getElementById("dayName").innerText = dayName;
      document.getElementById("fullDate").innerText = fullDate;
      resultBox.classList.remove("hidden");
    }

    // Set today as default
    document.getElementById("date").valueAsDate = new Date();
  </script>
</TimeToolLayout>
