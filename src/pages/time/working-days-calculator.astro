---
import TimeToolLayout from "../../layouts/TimeToolLayout.astro";

const faqItems = [
  {
    question: "Does this calculator include holidays?",
    answer:
      "No, this calculator only excludes weekends. For holiday exclusion, use our Business Days Calculator.",
  },
  {
    question: "Are both dates included in the count?",
    answer:
      "The start date is included, but the end date is excluded (like counting days until a deadline).",
  },
  {
    question: "Can I include Saturdays as working days?",
    answer:
      "Yes, there's an option to include Saturdays if your work week includes them.",
  },
];

const howItWorks = [
  {
    title: "Date Range Iteration",
    content:
      "The calculator iterates through each day from the start date to the end date (exclusive). For each day, it determines whether that day qualifies as a working day based on the day of the week.",
  },
  {
    title: "Weekend Detection",
    content:
      "Using JavaScript's getDay() method, each date's day of week is checked. Sunday returns 0, Saturday returns 6. By default, both are excluded from the count. When 'Include Saturdays' is enabled, only Sundays are excluded.",
  },
  {
    title: "Working Day Counting",
    content:
      "The algorithm uses a simple counter that increments only when a day passes the weekend check. This brute-force approach is accurate for any date range and handles month boundaries and year transitions correctly.",
  },
  {
    title: "Percentage Calculation",
    content:
      "The total calendar days are also tracked, allowing the calculator to show what percentage of the period consists of working days. A typical 5-day work week yields approximately 71% working days.",
  },
  {
    title: "Leap Year Handling",
    content:
      "Since the algorithm iterates day-by-day using actual Date objects, leap years are automatically handled. February 29 is correctly counted as a working day if it falls on a weekday.",
  },
];

const useCases = [
  {
    title: "Project Deadline Estimation",
    description:
      "Convert calendar deadlines to working days for realistic project planning. Know exactly how many productive days you have until a milestone or deliverable.",
  },
  {
    title: "PTO & Leave Calculation",
    description:
      "Calculate how many working days a vacation or leave request covers. Essential for HR departments and employees planning time off.",
  },
  {
    title: "Contractor Billing",
    description:
      "Determine billable working days in a contract period for accurate invoicing. Important for freelancers and consulting firms billing by the day.",
  },
  {
    title: "Shipping & Delivery Estimates",
    description:
      "Calculate realistic delivery windows that account for weekends. Convert '5-7 business days' into actual calendar delivery dates.",
  },
  {
    title: "Academic Calendar Planning",
    description:
      "Count teaching days between semester dates, excluding weekends. Useful for curriculum planning and scheduling coursework.",
  },
  {
    title: "Legal Deadline Compliance",
    description:
      "Many legal deadlines specify business days. Calculate exact due dates for court filings, response periods, or regulatory compliance.",
  },
];
---

<TimeToolLayout
  title="Working Days Calculator - Count Business Days Between Dates"
  description="Calculate the number of working days (excluding weekends) between two dates. Free online business day counter."
  canonicalPath="/time/working-days-calculator"
  currentTool="Working Days Calculator"
  faqItems={faqItems}
  howItWorks={howItWorks}
  useCases={useCases}
>
  <div class="tool-header">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">
      Working Days Calculator
    </h1>
    <p class="text-slate-500">
      Count the number of working days (Monday–Friday) between two dates,
      excluding weekends.
    </p>
  </div>

  <div class="bg-slate-50 border border-slate-200 rounded p-6 mb-8">
    <div class="flex flex-wrap gap-6 mb-6">
      <div class="flex-1 min-w-48">
        <label
          for="startDate"
          class="block font-medium text-slate-700 mb-1.5 text-sm"
          >Start Date</label
        >
        <input
          type="date"
          id="startDate"
          class="w-full px-4 py-3 text-base border border-slate-300 rounded bg-white text-slate-800 outline-none"
        />
      </div>
      <div class="flex-1 min-w-48">
        <label
          for="endDate"
          class="block font-medium text-slate-700 mb-1.5 text-sm"
          >End Date</label
        >
        <input
          type="date"
          id="endDate"
          class="w-full px-4 py-3 text-base border border-slate-300 rounded bg-white text-slate-800 outline-none"
        />
      </div>
    </div>

    <div class="mb-4">
      <label class="flex items-center gap-2 text-sm text-slate-600">
        <input type="checkbox" id="includeSaturday" class="w-4 h-4" />
        Include Saturdays as working days
      </label>
    </div>

    <button
      class="btn-primary inline-flex items-center justify-center px-6 py-3 text-base font-semibold text-white rounded cursor-pointer"
      onclick="calculate()"
    >
      Calculate Working Days
    </button>

    <div class="result-box mt-6 p-4 bg-white rounded hidden" id="resultBox">
      <div class="text-xs text-slate-500 uppercase tracking-wider mb-1">
        Working Days
      </div>
      <div class="text-3xl font-bold text-slate-900" id="result">—</div>
      <div class="text-sm text-slate-500 mt-2" id="breakdown"></div>
    </div>
  </div>

  <section class="mt-8 pt-6 border-t border-slate-200">
    <h2 class="text-xl font-semibold text-slate-900 mb-4">How It Works</h2>
    <p class="text-slate-600 mb-3">
      This calculator counts only weekdays (Monday through Friday) between your
      selected dates. Weekends (Saturday and Sunday) are automatically excluded
      unless you check the "Include Saturdays" option.
    </p>
    <ul class="list-disc pl-6 text-slate-600 space-y-2">
      <li>Select your start and end dates</li>
      <li>Optionally include Saturdays</li>
      <li>Get the count of working days instantly</li>
    </ul>
  </section>

  <section class="mt-8 pt-6 border-t border-slate-200">
    <h2 class="text-xl font-semibold text-slate-900 mb-4">FAQ</h2>
    <h3 class="text-base font-semibold text-slate-700 mt-4 mb-2">
      Does this include holidays?
    </h3>
    <p class="text-slate-600">
      No, this calculator only excludes weekends. For holiday exclusion, use our
      Business Days Calculator.
    </p>
    <h3 class="text-base font-semibold text-slate-700 mt-4 mb-2">
      Are both dates included?
    </h3>
    <p class="text-slate-600">
      The start date is included, but the end date is excluded (like counting
      days until a deadline).
    </p>
  </section>

  <script is:inline>
    function calculate() {
      const startInput = document.getElementById("startDate");
      const endInput = document.getElementById("endDate");
      const includeSat = document.getElementById("includeSaturday").checked;
      const resultEl = document.getElementById("result");
      const breakdownEl = document.getElementById("breakdown");
      const resultBox = document.getElementById("resultBox");

      const start = new Date(startInput.value);
      const end = new Date(endInput.value);

      if (isNaN(start.getTime()) || isNaN(end.getTime())) {
        resultEl.innerText = "Please select both dates";
        breakdownEl.innerText = "";
        resultBox.classList.remove("hidden");
        return;
      }

      let count = 0;
      let totalDays = 0;
      let current = new Date(start);

      while (current < end) {
        totalDays++;
        const day = current.getDay();
        if (day !== 0 && (day !== 6 || includeSat)) {
          count++;
        }
        current.setDate(current.getDate() + 1);
      }

      resultEl.innerText = count + " working days";
      breakdownEl.innerText = `Out of ${totalDays} total days (${totalDays - count} weekend days excluded)`;
      resultBox.classList.remove("hidden");
    }
  </script>
</TimeToolLayout>
