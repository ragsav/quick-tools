---
import TimeToolLayout from "../../layouts/TimeToolLayout.astro";

const faqItems = [
  {
    question: "What time units can I add or subtract?",
    answer:
      "You can add or subtract days, weeks, months, or years from any date.",
  },
  {
    question: "Does this account for month length variations?",
    answer:
      "Yes, the calculator handles varying month lengths and leap years automatically.",
  },
  {
    question: "Is this tool free to use?",
    answer:
      "Yes, this tool is completely free and works directly in your browser.",
  },
];

const howItWorks = [
  {
    title: "Date Input & Parsing",
    content:
      "The calculator accepts your starting date and parses it into a JavaScript Date object. This represents the date as milliseconds since January 1, 1970 (Unix epoch), allowing for precise mathematical operations across different calendar systems and time zones.",
  },
  {
    title: "Time Unit Selection",
    content:
      "When you select a time unit (days, weeks, months, or years), the calculator determines the appropriate mathematical operation. Days are added directly, weeks are converted to 7-day increments, while months and years require special handling due to their variable lengths.",
  },
  {
    title: "Calendar-Aware Calculation",
    content:
      "For months and years, the calculator uses calendar-aware arithmetic rather than simple day counting. When adding 1 month to January 31, it correctly rolls to February 28 (or 29 in leap years). This follows the ISO 8601 standard for date arithmetic, ensuring accurate results even at month boundaries.",
  },
  {
    title: "Leap Year Handling",
    content:
      "The calculator automatically accounts for leap years using the Gregorian calendar rules: a year is a leap year if divisible by 4, except for years divisible by 100 unless also divisible by 400. This ensures accurate calculations when crossing February 29 boundaries.",
  },
  {
    title: "Result Formatting",
    content:
      "The calculated date is formatted into a human-readable string showing the full date with the day of the week. This uses locale-aware formatting to display dates in your preferred format while maintaining consistency.",
  },
];

const useCases = [
  {
    title: "Project Deadline Planning",
    description:
      "Calculate exact deadlines by adding specific durations to project start dates. For example, add 6 weeks to today's date to determine a sprint completion date, or add 3 months for quarterly milestone planning.",
  },
  {
    title: "Contract & Subscription Renewals",
    description:
      "Determine when contracts, licenses, or subscriptions expire by adding the contract duration to the start date. Essential for managing software licenses, lease agreements, and service contracts.",
  },
  {
    title: "Medical & Health Scheduling",
    description:
      "Calculate follow-up appointment dates, medication refill schedules, or vaccination due dates. Add specific intervals to last visit dates for accurate healthcare planning.",
  },
  {
    title: "Financial Planning",
    description:
      "Determine loan maturity dates, investment term end dates, or payment due dates. Add months or years to loan origination dates for accurate financial forecasting.",
  },
  {
    title: "Academic Planning",
    description:
      "Calculate semester end dates, assignment deadlines, or graduation timelines. Add weeks or months to term start dates for effective academic scheduling.",
  },
  {
    title: "Event & Travel Planning",
    description:
      "Plan events by calculating dates relative to a reference point. Determine RSVP deadlines (2 weeks before event), booking windows (6 months ahead), or countdown milestones.",
  },
];
---

<TimeToolLayout
  title="Date Add/Subtract Calculator - Add Days, Weeks, Months"
  description="Add or subtract days, weeks, months, or years from any date. Free online date calculator."
  canonicalPath="/time/date-add-subtract"
  currentTool="Date Add/Subtract"
  faqItems={faqItems}
  howItWorks={howItWorks}
  useCases={useCases}
>
  <div class="tool-header">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">
      Date Add/Subtract Calculator
    </h1>
    <p class="text-slate-500">Add or subtract time periods from any date.</p>
  </div>

  <div class="bg-slate-50 border border-slate-200 rounded p-6 mb-8">
    <div class="mb-6">
      <label
        for="startDate"
        class="block font-medium text-slate-700 mb-1.5 text-sm"
        >Start Date</label
      >
      <input
        type="date"
        id="startDate"
        class="w-full max-w-xs px-4 py-3 text-base border border-slate-300 rounded bg-white text-slate-800 outline-none"
      />
    </div>

    <div class="flex flex-wrap gap-4 mb-6">
      <div>
        <label
          for="operation"
          class="block font-medium text-slate-700 mb-1.5 text-sm"
          >Operation</label
        >
        <select
          id="operation"
          class="px-4 py-3 border border-slate-300 rounded bg-white text-slate-800 outline-none"
        >
          <option value="add">Add (+)</option>
          <option value="subtract">Subtract (−)</option>
        </select>
      </div>
      <div>
        <label
          for="amount"
          class="block font-medium text-slate-700 mb-1.5 text-sm">Amount</label
        >
        <input
          type="number"
          id="amount"
          value="1"
          min="1"
          class="w-24 px-4 py-3 border border-slate-300 rounded bg-white text-slate-800 outline-none"
        />
      </div>
      <div>
        <label
          for="unit"
          class="block font-medium text-slate-700 mb-1.5 text-sm">Unit</label
        >
        <select
          id="unit"
          class="px-4 py-3 border border-slate-300 rounded bg-white text-slate-800 outline-none"
        >
          <option value="days">Days</option>
          <option value="weeks">Weeks</option>
          <option value="months">Months</option>
          <option value="years">Years</option>
        </select>
      </div>
    </div>

    <button
      class="btn-primary px-6 py-3 font-semibold text-white rounded"
      onclick="calculate()">Calculate</button
    >

    <div class="result-box mt-6 p-4 bg-white rounded hidden" id="resultBox">
      <div class="text-xs text-slate-500 uppercase tracking-wider mb-1">
        Result Date
      </div>
      <div class="text-3xl font-bold text-blue-600" id="result">—</div>
      <div class="text-sm text-slate-500 mt-2" id="dayName">—</div>
    </div>
  </div>

  <section class="mt-8 pt-6 border-t border-slate-200">
    <h2 class="text-xl font-semibold text-slate-900 mb-4">Quick Add</h2>
    <div class="flex flex-wrap gap-2">
      <button
        onclick="quickCalc(7, 'days')"
        class="px-4 py-2 bg-white border border-slate-200 rounded text-sm hover:border-blue-500"
        >+1 Week</button
      >
      <button
        onclick="quickCalc(14, 'days')"
        class="px-4 py-2 bg-white border border-slate-200 rounded text-sm hover:border-blue-500"
        >+2 Weeks</button
      >
      <button
        onclick="quickCalc(1, 'months')"
        class="px-4 py-2 bg-white border border-slate-200 rounded text-sm hover:border-blue-500"
        >+1 Month</button
      >
      <button
        onclick="quickCalc(3, 'months')"
        class="px-4 py-2 bg-white border border-slate-200 rounded text-sm hover:border-blue-500"
        >+3 Months</button
      >
      <button
        onclick="quickCalc(6, 'months')"
        class="px-4 py-2 bg-white border border-slate-200 rounded text-sm hover:border-blue-500"
        >+6 Months</button
      >
      <button
        onclick="quickCalc(1, 'years')"
        class="px-4 py-2 bg-white border border-slate-200 rounded text-sm hover:border-blue-500"
        >+1 Year</button
      >
    </div>
  </section>

  <script is:inline>
    document.getElementById("startDate").valueAsDate = new Date();

    function quickCalc(amount, unit) {
      document.getElementById("amount").value = amount;
      document.getElementById("unit").value = unit;
      document.getElementById("operation").value = "add";
      calculate();
    }

    function calculate() {
      const startDate = new Date(document.getElementById("startDate").value);
      const operation = document.getElementById("operation").value;
      const amount = parseInt(document.getElementById("amount").value);
      const unit = document.getElementById("unit").value;
      const resultBox = document.getElementById("resultBox");

      if (isNaN(startDate.getTime()) || isNaN(amount)) {
        document.getElementById("result").innerText =
          "Please fill in all fields";
        resultBox.classList.remove("hidden");
        return;
      }

      const result = new Date(startDate);
      const multiplier = operation === "add" ? 1 : -1;

      switch (unit) {
        case "days":
          result.setDate(result.getDate() + amount * multiplier);
          break;
        case "weeks":
          result.setDate(result.getDate() + amount * 7 * multiplier);
          break;
        case "months":
          result.setMonth(result.getMonth() + amount * multiplier);
          break;
        case "years":
          result.setFullYear(result.getFullYear() + amount * multiplier);
          break;
      }

      const options = {
        weekday: "long",
        year: "numeric",
        month: "long",
        day: "numeric",
      };
      document.getElementById("result").innerText = result.toLocaleDateString(
        "en-US",
        options,
      );

      const dayNames = [
        "Sunday",
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday",
      ];
      document.getElementById("dayName").innerText =
        `That's a ${dayNames[result.getDay()]}`;
      resultBox.classList.remove("hidden");
    }
  </script>
</TimeToolLayout>
