---
import TimeToolLayout from "../../layouts/TimeToolLayout.astro";
---

<TimeToolLayout
  title="Date Add/Subtract Calculator - Add Days, Weeks, Months"
  description="Add or subtract days, weeks, months, or years from any date. Free online date calculator."
  canonicalPath="/time/date-add-subtract"
  currentTool="Date Add/Subtract"
>
  <div class="tool-header">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">Date Add/Subtract Calculator</h1>
    <p class="text-slate-500">Add or subtract time periods from any date.</p>
  </div>

  <div class="bg-slate-50 border border-slate-200 rounded p-6 mb-8">
    <div class="mb-6">
      <label for="startDate" class="block font-medium text-slate-700 mb-1.5 text-sm">Start Date</label>
      <input type="date" id="startDate" class="w-full max-w-xs px-4 py-3 text-base border border-slate-300 rounded bg-white text-slate-800 outline-none" />
    </div>

    <div class="flex flex-wrap gap-4 mb-6">
      <div>
        <label for="operation" class="block font-medium text-slate-700 mb-1.5 text-sm">Operation</label>
        <select id="operation" class="px-4 py-3 border border-slate-300 rounded bg-white text-slate-800 outline-none">
          <option value="add">Add (+)</option>
          <option value="subtract">Subtract (−)</option>
        </select>
      </div>
      <div>
        <label for="amount" class="block font-medium text-slate-700 mb-1.5 text-sm">Amount</label>
        <input type="number" id="amount" value="1" min="1" class="w-24 px-4 py-3 border border-slate-300 rounded bg-white text-slate-800 outline-none" />
      </div>
      <div>
        <label for="unit" class="block font-medium text-slate-700 mb-1.5 text-sm">Unit</label>
        <select id="unit" class="px-4 py-3 border border-slate-300 rounded bg-white text-slate-800 outline-none">
          <option value="days">Days</option>
          <option value="weeks">Weeks</option>
          <option value="months">Months</option>
          <option value="years">Years</option>
        </select>
      </div>
    </div>

    <button class="btn-primary px-6 py-3 font-semibold text-white rounded" onclick="calculate()">Calculate</button>

    <div class="result-box mt-6 p-4 bg-white rounded hidden" id="resultBox">
      <div class="text-xs text-slate-500 uppercase tracking-wider mb-1">Result Date</div>
      <div class="text-3xl font-bold text-blue-600" id="result">—</div>
      <div class="text-sm text-slate-500 mt-2" id="dayName">—</div>
    </div>
  </div>

  <section class="mt-8 pt-6 border-t border-slate-200">
    <h2 class="text-xl font-semibold text-slate-900 mb-4">Quick Add</h2>
    <div class="flex flex-wrap gap-2">
      <button onclick="quickCalc(7, 'days')" class="px-4 py-2 bg-white border border-slate-200 rounded text-sm hover:border-blue-500">+1 Week</button>
      <button onclick="quickCalc(14, 'days')" class="px-4 py-2 bg-white border border-slate-200 rounded text-sm hover:border-blue-500">+2 Weeks</button>
      <button onclick="quickCalc(1, 'months')" class="px-4 py-2 bg-white border border-slate-200 rounded text-sm hover:border-blue-500">+1 Month</button>
      <button onclick="quickCalc(3, 'months')" class="px-4 py-2 bg-white border border-slate-200 rounded text-sm hover:border-blue-500">+3 Months</button>
      <button onclick="quickCalc(6, 'months')" class="px-4 py-2 bg-white border border-slate-200 rounded text-sm hover:border-blue-500">+6 Months</button>
      <button onclick="quickCalc(1, 'years')" class="px-4 py-2 bg-white border border-slate-200 rounded text-sm hover:border-blue-500">+1 Year</button>
    </div>
  </section>

  <script is:inline>
    document.getElementById("startDate").valueAsDate = new Date();

    function quickCalc(amount, unit) {
      document.getElementById("amount").value = amount;
      document.getElementById("unit").value = unit;
      document.getElementById("operation").value = "add";
      calculate();
    }

    function calculate() {
      const startDate = new Date(document.getElementById("startDate").value);
      const operation = document.getElementById("operation").value;
      const amount = parseInt(document.getElementById("amount").value);
      const unit = document.getElementById("unit").value;
      const resultBox = document.getElementById("resultBox");

      if (isNaN(startDate.getTime()) || isNaN(amount)) {
        document.getElementById("result").innerText = "Please fill in all fields";
        resultBox.classList.remove("hidden");
        return;
      }

      const result = new Date(startDate);
      const multiplier = operation === "add" ? 1 : -1;

      switch (unit) {
        case "days":
          result.setDate(result.getDate() + (amount * multiplier));
          break;
        case "weeks":
          result.setDate(result.getDate() + (amount * 7 * multiplier));
          break;
        case "months":
          result.setMonth(result.getMonth() + (amount * multiplier));
          break;
        case "years":
          result.setFullYear(result.getFullYear() + (amount * multiplier));
          break;
      }

      const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
      document.getElementById("result").innerText = result.toLocaleDateString('en-US', options);
      
      const dayNames = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
      document.getElementById("dayName").innerText = `That's a ${dayNames[result.getDay()]}`;
      resultBox.classList.remove("hidden");
    }
  </script>
</TimeToolLayout>
