---
import TimeToolLayout from "../../layouts/TimeToolLayout.astro";

const faqItems = [
  {
    question: "How do I find overlapping meeting times?",
    answer:
      "Select multiple time zones and set your preferred working hours. The tool highlights hours when all participants would be available.",
  },
  {
    question: "How many time zones can I compare?",
    answer:
      "You can add as many time zones as needed to find the best meeting time for your team.",
  },
  {
    question: "Is this tool free to use?",
    answer:
      "Yes, this tool is completely free and works directly in your browser.",
  },
];

const howItWorks = [
  {
    title: "Working Hours Definition",
    content:
      "You define your preferred working hours (e.g., 9 AM to 5 PM). These hours represent when participants are available for meetings, typically standard business hours in their local time.",
  },
  {
    title: "Multi-Zone Selection",
    content:
      "Add multiple time zones representing your team members' locations. Each zone is defined by its UTC offset (e.g., EST = UTC-5, IST = UTC+5:30).",
  },
  {
    title: "Hour Grid Generation",
    content:
      "For each timezone, the tool generates a 24-hour grid showing which hours fall within working hours. This visual representation makes it easy to spot patterns at a glance.",
  },
  {
    title: "Overlap Detection",
    content:
      "The algorithm compares all selected timezones hour-by-hour. An hour is marked as 'overlap' only if it falls within working hours for ALL selected zones simultaneously.",
  },
  {
    title: "Best Time Identification",
    content:
      "The tool identifies and highlights the optimal meeting window—the consecutive hours where everyone is available. It also calculates the total overlap duration.",
  },
];

const useCases = [
  {
    title: "Global Team Standups",
    description:
      "Find the best time for daily standups with team members across multiple continents. Ensure no one has to join at extremely inconvenient hours.",
  },
  {
    title: "Client Meeting Scheduling",
    description:
      "When scheduling calls with international clients, find mutually convenient times that respect both parties' business hours.",
  },
  {
    title: "Remote Interview Coordination",
    description:
      "Coordinate interview panels across time zones. Ensure interviewers and candidates are all available during reasonable hours.",
  },
  {
    title: "Webinar & Event Planning",
    description:
      "Plan live events and webinars to maximize attendance across target regions. Find times that work for your primary audience zones.",
  },
  {
    title: "Cross-Office Collaboration",
    description:
      "Multinational companies can identify core collaboration hours when offices in different regions are all staffed.",
  },
  {
    title: "Remote Pair Programming",
    description:
      "Schedule pair programming sessions with remote partners. Maximize productive overlap for real-time collaboration.",
  },
];
---

<TimeToolLayout
  title="Time Zone Overlap Planner - Find Meeting Times Across Zones"
  description="Find the best meeting times across multiple time zones. Plan calls with teams worldwide. Free timezone overlap tool."
  canonicalPath="/time/timezone-overlap"
  currentTool="Time Zone Overlap Planner"
  faqItems={faqItems}
  howItWorks={howItWorks}
  useCases={useCases}
>
  <div class="tool-header">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">
      Time Zone Overlap Planner
    </h1>
    <p class="text-slate-500">
      Find overlapping working hours across multiple time zones.
    </p>
  </div>

  <div class="bg-slate-50 border border-slate-200 rounded p-6 mb-8">
    <div class="mb-6">
      <label class="block font-medium text-slate-700 mb-2 text-sm"
        >Select Time Zones (click to add)</label
      >
      <div class="flex flex-wrap gap-2 mb-4" id="selectedZones"></div>
      <select
        id="zoneSelector"
        class="w-full max-w-xs px-4 py-3 border border-slate-300 rounded bg-white text-slate-800 outline-none"
        onchange="addZone()"
      >
        <option value="">+ Add time zone...</option>
      </select>
    </div>

    <div class="mb-6">
      <label class="block font-medium text-slate-700 mb-2 text-sm"
        >Working Hours</label
      >
      <div class="flex gap-4 items-center">
        <input
          type="time"
          id="workStart"
          value="09:00"
          class="px-3 py-2 border border-slate-300 rounded bg-white outline-none"
        />
        <span class="text-slate-500">to</span>
        <input
          type="time"
          id="workEnd"
          value="17:00"
          class="px-3 py-2 border border-slate-300 rounded bg-white outline-none"
        />
      </div>
    </div>

    <button
      class="btn-primary px-6 py-3 font-semibold text-white rounded"
      onclick="calculate()">Find Overlap</button
    >

    <div class="mt-6 hidden" id="resultBox">
      <h3 class="font-medium text-slate-900 mb-4">
        Time Comparison (24-hour format)
      </h3>
      <div class="overflow-x-auto">
        <div id="timeGrid" class="min-w-[600px]"></div>
      </div>
      <div
        class="mt-4 p-4 bg-green-50 border border-green-200 rounded hidden"
        id="overlapResult"
      >
      </div>
    </div>
  </div>

  <script is:inline>
    const timezones = [
      { name: "New York (EST)", offset: -5 },
      { name: "Chicago (CST)", offset: -6 },
      { name: "Los Angeles (PST)", offset: -8 },
      { name: "London (GMT)", offset: 0 },
      { name: "Paris (CET)", offset: 1 },
      { name: "Dubai (GST)", offset: 4 },
      { name: "Mumbai (IST)", offset: 5.5 },
      { name: "Singapore (SGT)", offset: 8 },
      { name: "Tokyo (JST)", offset: 9 },
      { name: "Sydney (AEST)", offset: 10 },
    ];

    const selectedZones = [];

    // Populate selector
    const selector = document.getElementById("zoneSelector");
    let optionsHtml = "";
    timezones.forEach((tz, i) => {
      optionsHtml += `<option value="${i}">${tz.name}</option>`;
    });
    selector.innerHTML += optionsHtml;

    function addZone() {
      const idx = parseInt(selector.value);
      if (isNaN(idx)) return;

      const tz = timezones[idx];
      if (selectedZones.find((z) => z.name === tz.name)) return;

      selectedZones.push(tz);
      renderSelected();
      selector.value = "";
    }

    function removeZone(name) {
      const idx = selectedZones.findIndex((z) => z.name === name);
      if (idx > -1) selectedZones.splice(idx, 1);
      renderSelected();
    }

    function renderSelected() {
      const container = document.getElementById("selectedZones");
      container.innerHTML = selectedZones
        .map(
          (tz) => `
        <span class="inline-flex items-center gap-1 px-3 py-1 bg-blue-100 text-blue-700 rounded text-sm">
          ${tz.name}
          <button onclick="removeZone('${tz.name}')" class="ml-1 text-blue-500 hover:text-blue-700">×</button>
        </span>
      `,
        )
        .join("");
    }

    function calculate() {
      if (selectedZones.length < 2) {
        alert("Please select at least 2 time zones");
        return;
      }

      const workStart = parseInt(
        document.getElementById("workStart").value.split(":")[0],
      );
      const workEnd = parseInt(
        document.getElementById("workEnd").value.split(":")[0],
      );
      const resultBox = document.getElementById("resultBox");
      const timeGrid = document.getElementById("timeGrid");

      // Create time grid
      let html = '<div class="grid gap-1">';

      // Header row
      html +=
        '<div class="flex"><div class="w-32 shrink-0 font-medium text-slate-700 text-sm p-2">Time Zone</div>';
      for (let h = 0; h < 24; h++) {
        html += `<div class="w-8 text-center text-xs text-slate-500 p-1">${h.toString().padStart(2, "0")}</div>`;
      }
      html += "</div>";

      // Timezone rows
      const baseOffset = selectedZones[0].offset;
      const overlapHours = new Array(24).fill(true);

      selectedZones.forEach((tz) => {
        html += `<div class="flex"><div class="w-32 shrink-0 text-sm p-2 truncate">${tz.name}</div>`;

        for (let h = 0; h < 24; h++) {
          // Convert to this timezone's local hour
          const localHour = (h + tz.offset - baseOffset + 24) % 24;
          const isWorking = localHour >= workStart && localHour < workEnd;

          if (!isWorking) overlapHours[h] = false;

          const bgColor = isWorking ? "bg-green-400" : "bg-slate-200";
          html += `<div class="w-8 h-6 ${bgColor} rounded-sm" title="${tz.name}: ${localHour}:00"></div>`;
        }
        html += "</div>";
      });

      html += "</div>";
      timeGrid.innerHTML = html;

      // Find overlap
      const overlapStart = overlapHours.findIndex((v) => v);
      const overlapEnd = overlapHours.lastIndexOf(true);

      const overlapResult = document.getElementById("overlapResult");
      if (overlapStart > -1 && overlapEnd >= overlapStart) {
        const refTz = selectedZones[0];
        overlapResult.innerHTML = `
          <div class="font-medium text-green-800">✅ Overlap found!</div>
          <div class="text-green-700 mt-1">
            ${overlapStart}:00 - ${overlapEnd + 1}:00 (${refTz.name} time) = ${overlapEnd - overlapStart + 1} hours overlap
          </div>
        `;
        overlapResult.classList.remove("hidden");
      } else {
        overlapResult.innerHTML = `<div class="font-medium text-red-800">❌ No overlapping working hours found</div>`;
        overlapResult.classList.remove("hidden");
      }

      resultBox.classList.remove("hidden");
    }

    // Add default zones
    selectedZones.push(timezones[0], timezones[3]);
    renderSelected();
  </script>
</TimeToolLayout>
