---
import TimeToolLayout from "../../layouts/TimeToolLayout.astro";

/**
 * Date Difference Calculator
 *
 * Calculates the number of days, weeks, and months between two dates.
 */

// FAQ data for structured data schema
const faqItems = [
    {
        question: "How does this date difference calculator work?",
        answer: "It calculates the number of days between two selected dates using the standard calendar difference. The result also shows approximate weeks and months.",
    },
    {
        question: "Is this tool free to use?",
        answer: "Yes, this tool is completely free and works directly in your browser.",
    },
    {
        question: "Does this calculator save my data?",
        answer: "No, all calculations happen locally in your browser. Your data never leaves your device.",
    },
    {
        question: "Does it account for leap years?",
        answer: "Yes, the calculator automatically handles leap years when computing the difference.",
    },
];
---

<TimeToolLayout
    title="Date Difference Calculator (Days Between Dates)"
    description="Calculate the difference between two dates in days, weeks, and months instantly. Free and fast online tool."
    canonicalPath="/time/date-difference-calculator"
    currentTool="Date Difference Calculator"
    faqItems={faqItems}
>
    <!-- TOOL HEADER -->
    <div class="tool-header">
        <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">
            Date Difference Calculator
        </h1>
        <p class="text-slate-500">
            Calculate the number of days, weeks, or months between two dates
            instantly. No login required — 100% free.
        </p>
    </div>

    <!-- CALCULATOR -->
    <div class="bg-slate-50 border border-slate-200 rounded p-6 mb-8">
        <div class="flex flex-wrap gap-6 mb-6">
            <div class="flex-1 min-w-48">
                <label
                    for="startDate"
                    class="block font-medium text-slate-700 mb-1.5 text-sm"
                    >Start Date</label
                >
                <input
                    type="date"
                    id="startDate"
                    class="w-full px-4 py-3 text-base border border-slate-300 rounded bg-white text-slate-800 transition-all outline-none"
                />
            </div>

            <div class="flex-1 min-w-48">
                <label
                    for="endDate"
                    class="block font-medium text-slate-700 mb-1.5 text-sm"
                    >End Date</label
                >
                <input
                    type="date"
                    id="endDate"
                    class="w-full px-4 py-3 text-base border border-slate-300 rounded bg-white text-slate-800 transition-all outline-none"
                />
            </div>
        </div>

        <button
            class="btn-primary inline-flex items-center justify-center px-6 py-3 text-base font-semibold text-white rounded cursor-pointer transition-all hover:-translate-y-0.5 active:translate-y-0"
            onclick="calculate()"
        >
            Calculate Difference
        </button>

        <div class="result-box mt-6 p-4 bg-white rounded hidden" id="resultBox">
            <div class="text-xs text-slate-500 uppercase tracking-wider mb-1">
                Result
            </div>
            <div class="text-2xl font-bold text-slate-900" id="result">—</div>
            <div id="resultDetails"></div>
        </div>
    </div>

    <!-- EXAMPLE -->
    <section class="mt-8 pt-6 border-t border-slate-200">
        <h2 class="text-xl font-semibold text-slate-900 mb-4">Example</h2>
        <p class="text-slate-600">
            If the start date is <strong>January 1, 2024</strong> and the end date
            is <strong>January 10, 2024</strong>, the result will be <strong
                >9 days</strong
            >.
        </p>
    </section>

    <!-- HOW IT WORKS -->
    <section class="mt-8 pt-6 border-t border-slate-200">
        <h2 class="text-xl font-semibold text-slate-900 mb-4">How It Works</h2>
        <p class="text-slate-600 mb-3">
            This calculator computes the exact difference between two dates
            using a simple formula:
        </p>
        <ul class="list-disc pl-6 text-slate-600 space-y-2">
            <li>Select your start date and end date</li>
            <li>Click "Calculate Difference"</li>
            <li>Get instant results in days, weeks, and months</li>
        </ul>
        <p class="text-slate-600 mt-3">
            The calculation happens entirely in your browser — your data is
            never sent to any server.
        </p>
    </section>

    <!-- FAQ -->
    <section class="mt-8 pt-6 border-t border-slate-200">
        <h2 class="text-xl font-semibold text-slate-900 mb-4">
            Frequently Asked Questions
        </h2>

        <h3 class="text-base font-semibold text-slate-700 mt-4 mb-2">
            How does this date difference calculator work?
        </h3>
        <p class="text-slate-600">
            It calculates the number of days between two selected dates using
            the standard calendar difference. The result also shows approximate
            weeks and months.
        </p>

        <h3 class="text-base font-semibold text-slate-700 mt-4 mb-2">
            Is this tool free to use?
        </h3>
        <p class="text-slate-600">
            Yes, this tool is completely free and works directly in your
            browser.
        </p>

        <h3 class="text-base font-semibold text-slate-700 mt-4 mb-2">
            Does this calculator save my data?
        </h3>
        <p class="text-slate-600">
            No, all calculations happen locally in your browser. Your data never
            leaves your device.
        </p>

        <h3 class="text-base font-semibold text-slate-700 mt-4 mb-2">
            Does it account for leap years?
        </h3>
        <p class="text-slate-600">
            Yes, the calculator automatically handles leap years when computing
            the difference.
        </p>
    </section>

    <!-- SCRIPT -->
    <script is:inline>
        function calculate() {
            const startInput = document.getElementById("startDate");
            const endInput = document.getElementById("endDate");
            const resultEl = document.getElementById("result");
            const detailsEl = document.getElementById("resultDetails");
            const resultBox = document.getElementById("resultBox");

            if (
                !startInput ||
                !endInput ||
                !resultEl ||
                !detailsEl ||
                !resultBox
            )
                return;

            const start = new Date(startInput.value);
            const end = new Date(endInput.value);

            if (isNaN(start.getTime()) || isNaN(end.getTime())) {
                resultEl.innerText = "Please select both dates";
                detailsEl.innerText = "";
                resultBox.classList.remove("hidden");
                return;
            }

            const diffMs = Math.abs(end.getTime() - start.getTime());
            const days = Math.floor(diffMs / (1000 * 60 * 60 * 24));
            const weeks = Math.floor(days / 7);
            const months = Math.floor(days / 30.44);

            resultEl.innerText = `${days} days`;
            detailsEl.innerHTML = `<span class="text-slate-500 text-sm">≈ ${weeks} weeks or ≈ ${months} months</span>`;
            resultBox.classList.remove("hidden");
        }
    </script>
</TimeToolLayout>
