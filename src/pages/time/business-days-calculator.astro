---
import TimeToolLayout from "../../layouts/TimeToolLayout.astro";

const faqItems = [
  {
    question:
      "What's the difference between Business Days and Working Days calculators?",
    answer:
      "Business Days Calculator lets you exclude specific holidays, while Working Days only excludes weekends.",
  },
  {
    question: "How do I add holidays to exclude?",
    answer:
      "Enter holiday dates in YYYY-MM-DD format, separated by commas (e.g., 2024-12-25, 2024-01-01).",
  },
  {
    question: "Does this tool save my data?",
    answer:
      "No, all calculations happen locally in your browser. Your data never leaves your device.",
  },
];

const howItWorks = [
  {
    title: "Date Range Processing",
    content:
      "The calculator takes your start and end dates and prepares to iterate through each day in the range. The start date is included in the count, while the end date is typically excluded (like counting days until a deadline).",
  },
  {
    title: "Holiday Parsing",
    content:
      "Holiday dates entered as comma-separated values (YYYY-MM-DD format) are parsed and stored in a lookup set. Each date string is normalized to ensure consistent comparison with dates in the range.",
  },
  {
    title: "Day-by-Day Analysis",
    content:
      "For each day in the range, three checks occur: (1) Is it Saturday or Sunday? (2) Is it in the holidays list? (3) If neither, it's counted as a business day. This ensures accurate exclusion of both weekends and custom holidays.",
  },
  {
    title: "Categorized Counting",
    content:
      "The algorithm maintains separate counters: business days, weekend days, and holidays excluded. This breakdown helps you understand exactly how the total was calculated and verify accuracy.",
  },
  {
    title: "Edge Case Handling",
    content:
      "The calculator handles various edge cases: holidays falling on weekends (counted only once), partial weeks, leap years, and year boundaries. All dates are processed using native Date objects for accuracy.",
  },
];

const useCases = [
  {
    title: "Contract SLA Calculations",
    description:
      "Calculate business days for service level agreements that specify response times in business days. Exclude company-specific holidays for accurate SLA compliance.",
  },
  {
    title: "Payroll Processing",
    description:
      "Determine pay periods accounting for weekends and holidays. Essential for calculating daily rates, overtime periods, or prorated salaries.",
  },
  {
    title: "Legal Filing Deadlines",
    description:
      "Many court systems and government agencies specify deadlines in business days. Calculate exact due dates accounting for court holidays and weekends.",
  },
  {
    title: "International Business Coordination",
    description:
      "When working across countries, account for different national holidays. Calculate realistic timelines that respect each region's non-working days.",
  },
  {
    title: "Manufacturing Lead Times",
    description:
      "Calculate production schedules accounting for factory closures, maintenance days, and holidays. Essential for accurate delivery date promises.",
  },
  {
    title: "Bank Processing Times",
    description:
      "Determine when ACH transfers, wire transfers, or check clearances will complete. Banking follows business days with additional holidays like Columbus Day.",
  },
];
---

<TimeToolLayout
  title="Business Days Calculator - Exclude Weekends & Holidays"
  description="Calculate business days between two dates, excluding weekends and common holidays. Free online tool."
  canonicalPath="/time/business-days-calculator"
  currentTool="Business Days Calculator"
  faqItems={faqItems}
  howItWorks={howItWorks}
  useCases={useCases}
>
  <div class="tool-header">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">
      Business Days Calculator
    </h1>
    <p class="text-slate-500">
      Count business days between dates, excluding weekends and optionally
      holidays.
    </p>
  </div>

  <div class="bg-slate-50 border border-slate-200 rounded p-6 mb-8">
    <div class="flex flex-wrap gap-6 mb-6">
      <div class="flex-1 min-w-48">
        <label
          for="startDate"
          class="block font-medium text-slate-700 mb-1.5 text-sm"
          >Start Date</label
        >
        <input
          type="date"
          id="startDate"
          class="w-full px-4 py-3 text-base border border-slate-300 rounded bg-white text-slate-800 outline-none"
        />
      </div>
      <div class="flex-1 min-w-48">
        <label
          for="endDate"
          class="block font-medium text-slate-700 mb-1.5 text-sm"
          >End Date</label
        >
        <input
          type="date"
          id="endDate"
          class="w-full px-4 py-3 text-base border border-slate-300 rounded bg-white text-slate-800 outline-none"
        />
      </div>
    </div>

    <div class="mb-4">
      <label class="block font-medium text-slate-700 mb-2 text-sm"
        >Exclude Holidays (comma-separated dates)</label
      >
      <input
        type="text"
        id="holidays"
        placeholder="e.g., 2024-12-25, 2024-01-01"
        class="w-full px-4 py-3 text-base border border-slate-300 rounded bg-white text-slate-800 outline-none"
      />
      <p class="text-xs text-slate-400 mt-1">Format: YYYY-MM-DD</p>
    </div>

    <button
      class="btn-primary inline-flex items-center justify-center px-6 py-3 text-base font-semibold text-white rounded cursor-pointer"
      onclick="calculate()"
    >
      Calculate Business Days
    </button>

    <div class="result-box mt-6 p-4 bg-white rounded hidden" id="resultBox">
      <div class="text-xs text-slate-500 uppercase tracking-wider mb-1">
        Business Days
      </div>
      <div class="text-3xl font-bold text-slate-900" id="result">—</div>
      <div class="text-sm text-slate-500 mt-2" id="breakdown"></div>
    </div>
  </div>

  <section class="mt-8 pt-6 border-t border-slate-200">
    <h2 class="text-xl font-semibold text-slate-900 mb-4">How to Use</h2>
    <ul class="list-disc pl-6 text-slate-600 space-y-2">
      <li>Select start and end dates</li>
      <li>Add any holidays to exclude (optional)</li>
      <li>Weekends are automatically excluded</li>
      <li>Get accurate business day count</li>
    </ul>
  </section>

  <section class="mt-8 pt-6 border-t border-slate-200">
    <h2 class="text-xl font-semibold text-slate-900 mb-4">FAQ</h2>
    <h3 class="text-base font-semibold text-slate-700 mt-4 mb-2">
      What's the difference vs Working Days?
    </h3>
    <p class="text-slate-600">
      Business Days Calculator lets you exclude specific holidays, while Working
      Days only excludes weekends.
    </p>
  </section>

  <script is:inline>
    function calculate() {
      const startInput = document.getElementById("startDate");
      const endInput = document.getElementById("endDate");
      const holidaysInput = document.getElementById("holidays").value;
      const resultEl = document.getElementById("result");
      const breakdownEl = document.getElementById("breakdown");
      const resultBox = document.getElementById("resultBox");

      const start = new Date(startInput.value);
      const end = new Date(endInput.value);

      if (isNaN(start.getTime()) || isNaN(end.getTime())) {
        resultEl.innerText = "Please select both dates";
        breakdownEl.innerText = "";
        resultBox.classList.remove("hidden");
        return;
      }

      const holidays = holidaysInput
        .split(",")
        .map((d) => d.trim())
        .filter((d) => d)
        .map((d) => new Date(d).toDateString());

      let businessDays = 0;
      let weekendDays = 0;
      let holidayCount = 0;
      let current = new Date(start);

      while (current < end) {
        const day = current.getDay();
        const dateStr = current.toDateString();

        if (day === 0 || day === 6) {
          weekendDays++;
        } else if (holidays.includes(dateStr)) {
          holidayCount++;
        } else {
          businessDays++;
        }
        current.setDate(current.getDate() + 1);
      }

      resultEl.innerText = businessDays + " business days";
      breakdownEl.innerText = `${weekendDays} weekend days + ${holidayCount} holidays excluded`;
      resultBox.classList.remove("hidden");
    }
  </script>
</TimeToolLayout>
