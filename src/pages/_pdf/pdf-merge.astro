---
import PDFToolLayout from "../../layouts/PDFToolLayout.astro";

const faqItems = [
  {
    question: "How many PDFs can I merge?",
    answer: "You can merge as many PDFs as your browser can handle. Typically 10-20 PDFs work smoothly.",
  },
  {
    question: "Will the quality be affected?",
    answer: "No, merging PDFs preserves the original quality of all documents.",
  },
  {
    question: "Can I reorder the pages before merging?",
    answer: "Yes! You can drag and drop pages to reorder them, or delete individual pages before merging.",
  },
];
---

<PDFToolLayout
  title="PDF Merge - Combine PDF Files Online"
  description="Merge multiple PDF files into one document. Preview pages, reorder, and delete before merging. Free online tool - works in your browser."
  canonicalPath="/pdf/pdf-merge"
  currentTool="PDF Merge"
  faqItems={faqItems}
>
  <div class="tool-header">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">
      PDF Merge
    </h1>
    <p class="text-slate-500">
      Combine multiple PDF files. Preview, reorder, and delete pages before merging.
    </p>
  </div>

  <div class="bg-slate-50 border border-slate-200 rounded p-6 mb-6">
    <!-- Upload Area -->
    <div
      id="dropZone"
      class="border-2 border-dashed border-slate-300 rounded p-8 text-center cursor-pointer hover:border-blue-500 transition-colors mb-6"
    >
      <div class="text-4xl mb-2">📄</div>
      <p class="text-slate-600 mb-2">Drag & drop PDF files here or click to select</p>
      <p class="text-sm text-slate-400">Select multiple PDFs to merge</p>
      <input type="file" id="fileInput" accept=".pdf,application/pdf" multiple class="hidden" />
    </div>

    <!-- Page Preview Grid -->
    <div id="previewSection" class="hidden">
      <div class="flex items-center justify-between mb-4">
        <h3 class="font-medium text-slate-700">Pages Preview <span id="pageCount" class="text-sm text-slate-500"></span></h3>
        <div class="flex gap-2">
          <button id="addMoreBtn" class="px-3 py-1.5 text-sm bg-slate-100 text-slate-700 rounded hover:bg-slate-200">
            ➕ Add More PDFs
          </button>
        </div>
      </div>
      
      <p class="text-sm text-slate-500 mb-4">💡 Drag pages to reorder. Click ✕ to remove a page.</p>
      
      <div id="pageGrid" class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-6 gap-3 mb-6"></div>

      <!-- Action Buttons -->
      <div class="flex flex-wrap gap-3">
        <button
          id="mergeBtn"
          class="btn-primary px-6 py-2 font-semibold text-white rounded text-sm"
        >
          🔗 Merge All Pages
        </button>
        <button
          id="clearBtn"
          class="px-6 py-2 font-semibold bg-red-100 text-red-700 rounded text-sm hover:bg-red-200 transition-colors"
        >
          🗑️ Clear All
        </button>
      </div>
    </div>

    <!-- Progress -->
    <div id="progress" class="hidden mt-4">
      <div class="w-full bg-slate-200 rounded-full h-2">
        <div id="progressBar" class="bg-blue-600 h-2 rounded-full transition-all" style="width: 0%"></div>
      </div>
      <p id="progressText" class="text-sm text-slate-600 mt-2">Processing...</p>
    </div>
  </div>

  <!-- Load PDF.js legacy build -->
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/pdf-lib@1.17.1/dist/pdf-lib.min.js"></script>

  <script is:inline>
    // Wait for libraries to load
    document.addEventListener('DOMContentLoaded', function() {
      const pdfjsLib = window.pdfjsLib;
      pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
      
      const PDFLib = window.PDFLib;

      const dropZone = document.getElementById('dropZone');
      const fileInput = document.getElementById('fileInput');
      const previewSection = document.getElementById('previewSection');
      const pageGrid = document.getElementById('pageGrid');
      const pageCount = document.getElementById('pageCount');
      const mergeBtn = document.getElementById('mergeBtn');
      const addMoreBtn = document.getElementById('addMoreBtn');
      const clearBtn = document.getElementById('clearBtn');
      const progress = document.getElementById('progress');
      const progressBar = document.getElementById('progressBar');
      const progressText = document.getElementById('progressText');

      // Store page data
      let pages = []; // { thumbnail, pdfData, pageIndex, fileName }
      let draggedItem = null;

      function updatePageCount() {
        pageCount.textContent = `(${pages.length} pages)`;
      }

      async function renderPageThumbnail(pdfDoc, pageNum, scale) {
        scale = scale || 0.3;
        const page = await pdfDoc.getPage(pageNum);
        const viewport = page.getViewport({ scale: scale });
        
        const canvas = document.createElement('canvas');
        canvas.width = viewport.width;
        canvas.height = viewport.height;
        
        const ctx = canvas.getContext('2d');
        ctx.fillStyle = '#FFFFFF';
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        
        await page.render({ canvasContext: ctx, viewport: viewport }).promise;
        return canvas.toDataURL('image/jpeg', 0.7);
      }

      function renderPageGrid() {
        pageGrid.innerHTML = '';
        const fragment = document.createDocumentFragment();
        
        pages.forEach(function(page, index) {
          const div = document.createElement('div');
          div.className = 'relative group bg-white border border-slate-200 rounded overflow-hidden cursor-move';
          div.draggable = true;
          div.dataset.index = index;
          
          div.innerHTML = 
            '<img src="' + page.thumbnail + '" class="w-full aspect-[3/4] object-contain bg-slate-50" alt="Page ' + (index + 1) + '" />' +
            '<div class="absolute top-1 left-1 bg-black/60 text-white text-xs px-1.5 py-0.5 rounded">' + (index + 1) + '</div>' +
            '<button class="delete-btn absolute top-1 right-1 bg-red-500 text-white text-xs w-5 h-5 rounded-full opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center" data-index="' + index + '">✕</button>' +
            '<div class="text-xs text-slate-500 p-1 truncate text-center">' + page.fileName + '</div>';
          
          // Drag events
          div.addEventListener('dragstart', function(e) {
            draggedItem = div;
            div.classList.add('opacity-50');
            e.dataTransfer.effectAllowed = 'move';
          });
          
          div.addEventListener('dragend', function() {
            div.classList.remove('opacity-50');
            draggedItem = null;
          });
          
          div.addEventListener('dragover', function(e) {
            e.preventDefault();
            e.dataTransfer.dropEffect = 'move';
            div.classList.add('ring-2', 'ring-blue-500');
          });
          
          div.addEventListener('dragleave', function() {
            div.classList.remove('ring-2', 'ring-blue-500');
          });
          
          div.addEventListener('drop', function(e) {
            e.preventDefault();
            div.classList.remove('ring-2', 'ring-blue-500');
            
            if (draggedItem && draggedItem !== div) {
              const fromIndex = parseInt(draggedItem.dataset.index);
              const toIndex = parseInt(div.dataset.index);
              
              // Reorder pages array
              const movedPage = pages.splice(fromIndex, 1)[0];
              pages.splice(toIndex, 0, movedPage);
              
              renderPageGrid();
            }
          });
          
          fragment.appendChild(div);
        });
        
        pageGrid.appendChild(fragment);

        // Add delete handlers
        document.querySelectorAll('.delete-btn').forEach(function(btn) {
          btn.addEventListener('click', function(e) {
            e.stopPropagation();
            const index = parseInt(e.target.dataset.index);
            pages.splice(index, 1);
            renderPageGrid();
            updatePageCount();
            
            if (pages.length === 0) {
              previewSection.classList.add('hidden');
              dropZone.classList.remove('hidden');
            }
          });
        });
        
        updatePageCount();
      }

      async function handleFiles(files) {
        progress.classList.remove('hidden');
        progressText.textContent = 'Loading PDFs...';
        
        const fileArray = Array.from(files).filter(function(f) { return f.type === 'application/pdf'; });
        
        for (let i = 0; i < fileArray.length; i++) {
          const file = fileArray[i];
          progressBar.style.width = ((i + 1) / fileArray.length * 50) + '%';
          progressText.textContent = 'Loading ' + file.name + '...';
          
          try {
            const arrayBuffer = await file.arrayBuffer();
            // Store a copy as Uint8Array before PDF.js detaches the buffer
            const pdfBytes = new Uint8Array(arrayBuffer);
            const pdfDoc = await pdfjsLib.getDocument({ data: pdfBytes.slice() }).promise;
            
            for (let pageNum = 1; pageNum <= pdfDoc.numPages; pageNum++) {
              progressText.textContent = 'Rendering ' + file.name + ' - Page ' + pageNum + '/' + pdfDoc.numPages + '...';
              
              const thumbnail = await renderPageThumbnail(pdfDoc, pageNum);
              pages.push({
                thumbnail: thumbnail,
                pdfData: pdfBytes,
                pageIndex: pageNum - 1,
                fileName: file.name
              });
            }
          } catch (error) {
            console.error('Error loading ' + file.name + ':', error);
          }
        }
        
        progress.classList.add('hidden');
        progressBar.style.width = '0%';
        
        if (pages.length > 0) {
          dropZone.classList.add('hidden');
          previewSection.classList.remove('hidden');
          renderPageGrid();
        }
      }

      async function mergePDFs() {
        if (pages.length === 0) return;
        
        progress.classList.remove('hidden');
        mergeBtn.disabled = true;
        
        try {
          const mergedPdf = await PDFLib.PDFDocument.create();
          
          // Group pages by source PDF
          const pdfCache = new Map();
          
          for (let i = 0; i < pages.length; i++) {
            progressBar.style.width = ((i + 1) / pages.length * 100) + '%';
            progressText.textContent = 'Adding page ' + (i + 1) + ' of ' + pages.length + '...';
            
            const page = pages[i];
            const key = page.pdfData;
            
            let srcDoc;
            if (pdfCache.has(key)) {
              srcDoc = pdfCache.get(key);
            } else {
              srcDoc = await PDFLib.PDFDocument.load(page.pdfData);
              pdfCache.set(key, srcDoc);
            }
            
            const copiedPages = await mergedPdf.copyPages(srcDoc, [page.pageIndex]);
            mergedPdf.addPage(copiedPages[0]);
          }
          
          progressText.textContent = 'Generating merged PDF...';
          const mergedBytes = await mergedPdf.save();
          
          const blob = new Blob([mergedBytes], { type: 'application/pdf' });
          const link = document.createElement('a');
          link.href = URL.createObjectURL(blob);
          link.download = 'merged.pdf';
          link.click();
        } catch (error) {
          alert('Error merging PDFs: ' + error.message);
        }
        
        progress.classList.add('hidden');
        mergeBtn.disabled = false;
        progressBar.style.width = '0%';
      }

      // Event listeners
      dropZone.addEventListener('click', function() { fileInput.click(); });
      dropZone.addEventListener('dragover', function(e) {
        e.preventDefault();
        dropZone.classList.add('border-blue-500', 'bg-blue-50');
      });
      dropZone.addEventListener('dragleave', function() {
        dropZone.classList.remove('border-blue-500', 'bg-blue-50');
      });
      dropZone.addEventListener('drop', function(e) {
        e.preventDefault();
        dropZone.classList.remove('border-blue-500', 'bg-blue-50');
        handleFiles(e.dataTransfer.files);
      });

      fileInput.addEventListener('change', function(e) {
        handleFiles(e.target.files);
        e.target.value = ''; // Reset to allow same file
      });
      
      addMoreBtn.addEventListener('click', function() { fileInput.click(); });
      
      clearBtn.addEventListener('click', function() {
        pages = [];
        previewSection.classList.add('hidden');
        dropZone.classList.remove('hidden');
      });
      
      mergeBtn.addEventListener('click', mergePDFs);
    });
  </script>

  <style is:global>
    .drag-over {
      transform: scale(1.02);
    }
  </style>
</PDFToolLayout>
