---
import ImageToolLayout from "../../layouts/ImageToolLayout.astro";

const faqItems = [
  {
    question: "What is Base64?",
    answer: "Base64 is a text encoding scheme used to represent binary data (like images) as ASCII text.",
  },
  {
    question: "What formats are supported?",
    answer: "Any image format the Base64 encodes - PNG, JPEG, GIF, WebP, SVG, and more.",
  },
];
---

<ImageToolLayout
  title="Base64 to Image - Decode Base64 to Image"
  description="Convert Base64 string to image. Decode and download as PNG, JPG, or other formats. Free online tool."
  canonicalPath="/image/base64-to-image"
  currentTool="Base64 to Image"
  faqItems={faqItems}
>
  <div class="tool-header">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">Base64 to Image</h1>
    <p class="text-slate-500">Decode Base64 string and download as an image file.</p>
  </div>

  <div class="bg-slate-50 border border-slate-200 rounded p-6 mb-6">
    <div class="mb-4">
      <label class="block text-sm font-medium text-slate-700 mb-2">Paste Base64 String</label>
      <textarea
        id="base64Input"
        class="w-full h-40 px-3 py-2 border border-slate-300 rounded bg-white text-sm font-mono resize-y"
        placeholder="Paste your Base64 string here... (data:image/png;base64,... or just the base64 data)"
      ></textarea>
    </div>

    <button id="decodeBtn" class="btn-primary px-6 py-2 font-semibold text-white rounded text-sm mb-6">🖼️ Decode</button>

    <div id="result" class="hidden">
      <h3 class="font-medium text-slate-700 mb-2">Decoded Image</h3>
      <div class="bg-white border border-slate-200 rounded p-4 mb-4 checkered-bg">
        <img id="preview" class="max-w-full max-h-96 object-contain mx-auto" alt="Decoded" />
      </div>
      <p id="imageInfo" class="text-sm text-slate-500 mb-4"></p>
      <div class="flex gap-3">
        <button id="downloadBtn" class="px-6 py-2 font-semibold bg-green-600 text-white rounded text-sm hover:bg-green-700">⬇️ Download</button>
        <button id="clearBtn" class="px-6 py-2 font-semibold bg-slate-200 text-slate-700 rounded text-sm hover:bg-slate-300">🗑️ Clear</button>
      </div>
    </div>

    <p id="error" class="text-red-500 text-sm hidden"></p>
  </div>

  <style>
    .checkered-bg {
      background-image: linear-gradient(45deg, #e2e8f0 25%, transparent 25%),
        linear-gradient(-45deg, #e2e8f0 25%, transparent 25%),
        linear-gradient(45deg, transparent 75%, #e2e8f0 75%),
        linear-gradient(-45deg, transparent 75%, #e2e8f0 75%);
      background-size: 16px 16px;
      background-position: 0 0, 0 8px, 8px -8px, -8px 0px;
    }
  </style>

  <script is:inline>
    const base64Input = document.getElementById('base64Input');
    const decodeBtn = document.getElementById('decodeBtn');
    const result = document.getElementById('result');
    const preview = document.getElementById('preview');
    const imageInfo = document.getElementById('imageInfo');
    const downloadBtn = document.getElementById('downloadBtn');
    const clearBtn = document.getElementById('clearBtn');
    const error = document.getElementById('error');

    let imageDataUrl = null;

    function decode() {
      error.classList.add('hidden');
      result.classList.add('hidden');

      let input = base64Input.value.trim();
      if (!input) { error.textContent = 'Please enter a Base64 string.'; error.classList.remove('hidden'); return; }

      // Add data URL prefix if missing
      if (!input.startsWith('data:')) {
        input = 'data:image/png;base64,' + input;
      }

      const img = new Image();
      img.onload = () => {
        imageDataUrl = input;
        preview.src = input;
        imageInfo.textContent = `${img.width} × ${img.height} pixels`;
        result.classList.remove('hidden');
      };
      img.onerror = () => {
        error.textContent = 'Invalid Base64 string or unsupported image format.';
        error.classList.remove('hidden');
      };
      img.src = input;
    }

    decodeBtn.addEventListener('click', decode);

    downloadBtn.addEventListener('click', () => {
      if (!imageDataUrl) return;
      const match = imageDataUrl.match(/data:image\/(\w+);/);
      const ext = match ? match[1] : 'png';
      const link = document.createElement('a');
      link.href = imageDataUrl;
      link.download = `decoded-image.${ext}`;
      link.click();
    });

    clearBtn.addEventListener('click', () => {
      base64Input.value = '';
      result.classList.add('hidden');
      imageDataUrl = null;
    });
  </script>
</ImageToolLayout>
