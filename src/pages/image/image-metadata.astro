---
import ImageToolLayout from "../../layouts/ImageToolLayout.astro";

const faqItems = [
  {
    question: "What metadata can I view?",
    answer: "EXIF data including camera model, date taken, GPS coordinates, exposure settings, and more.",
  },
  {
    question: "Which formats support metadata?",
    answer: "JPEG and TIFF files commonly contain EXIF data. PNG and WebP have limited metadata support.",
  },
];
---

<ImageToolLayout
  title="Image Metadata Viewer - Free Online EXIF Reader"
  description="View image EXIF metadata online. See camera info, date, GPS coordinates, and settings. No upload required."
  canonicalPath="/image/image-metadata"
  currentTool="Image Metadata"
  faqItems={faqItems}
>
  <div class="tool-header">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">Image Metadata Viewer</h1>
    <p class="text-slate-500">View EXIF and other metadata from your images.</p>
  </div>

  <div class="bg-slate-50 border border-slate-200 rounded p-6 mb-6">
    <div id="dropZone" class="border-2 border-dashed border-slate-300 rounded p-8 text-center cursor-pointer hover:border-blue-500 transition-colors mb-6">
      <div class="text-4xl mb-2">📋</div>
      <p class="text-slate-600 mb-2">Drag & drop image here or click to select</p>
      <input type="file" id="fileInput" accept="image/*" class="hidden" />
    </div>

    <div id="controls" class="hidden">
      <div class="grid md:grid-cols-3 gap-6 mb-6">
        <div>
          <h3 class="font-medium text-slate-700 mb-2">Image Preview</h3>
          <div class="bg-white border border-slate-200 rounded p-2">
            <img id="preview" class="max-w-full max-h-48 object-contain mx-auto" alt="Preview" />
          </div>
        </div>
        <div class="md:col-span-2">
          <h3 class="font-medium text-slate-700 mb-2">Basic Info</h3>
          <div id="basicInfo" class="bg-white border border-slate-200 rounded p-4 text-sm space-y-1"></div>
        </div>
      </div>

      <div class="mb-6">
        <h3 class="font-medium text-slate-700 mb-2">EXIF Data</h3>
        <div id="exifData" class="bg-white border border-slate-200 rounded overflow-hidden">
          <table class="w-full text-sm">
            <tbody id="exifTable"></tbody>
          </table>
        </div>
        <p id="noExif" class="text-sm text-slate-500 mt-2 hidden">No EXIF data found in this image.</p>
      </div>

      <button id="resetBtn" class="px-6 py-2 font-semibold bg-slate-200 text-slate-700 rounded text-sm hover:bg-slate-300">🗑️ Clear</button>
    </div>
  </div>

  <script type="module">
    import EXIF from 'https://cdn.jsdelivr.net/npm/exif-js@2.3.0/+esm';

    const dropZone = document.getElementById('dropZone');
    const fileInput = document.getElementById('fileInput');
    const controls = document.getElementById('controls');
    const preview = document.getElementById('preview');
    const basicInfo = document.getElementById('basicInfo');
    const exifTable = document.getElementById('exifTable');
    const noExif = document.getElementById('noExif');
    const resetBtn = document.getElementById('resetBtn');


    function escapeHtml(unsafe) {
      if (unsafe == null) return '';
      return String(unsafe)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }

    function formatSize(bytes) {
      if (bytes < 1024) return bytes + ' B';
      if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
      return (bytes / (1024 * 1024)).toFixed(2) + ' MB';
    }

    function handleFile(file) {
      if (!file || !file.type.startsWith('image/')) return;
      
      const reader = new FileReader();
      reader.onload = (e) => {
        preview.src = e.target.result;
        
        const img = new Image();
        img.onload = () => {
          basicInfo.innerHTML = `
            <div><strong>Filename:</strong> ${escapeHtml(file.name)}</div>
            <div><strong>Type:</strong> ${escapeHtml(file.type)}</div>
            <div><strong>Size:</strong> ${formatSize(file.size)}</div>
            <div><strong>Dimensions:</strong> ${img.width} × ${img.height}</div>
            <div><strong>Last Modified:</strong> ${new Date(file.lastModified).toLocaleString()}</div>
          `;

          EXIF.getData(img, function() {
            const tags = EXIF.getAllTags(this);
            exifTable.innerHTML = '';
            
            const importantTags = ['Make', 'Model', 'DateTime', 'DateTimeOriginal', 'ExposureTime', 'FNumber', 'ISOSpeedRatings', 'FocalLength', 'GPSLatitude', 'GPSLongitude', 'ImageWidth', 'ImageHeight', 'Software'];
            
            let hasData = false;
            importantTags.forEach(tag => {
              if (tags[tag]) {
                hasData = true;
                const row = document.createElement('tr');
                row.className = 'border-b border-slate-100';
                row.innerHTML = `<td class="py-2 px-4 font-medium text-slate-700">${escapeHtml(tag)}</td><td class="py-2 px-4 text-slate-600">${escapeHtml(tags[tag])}</td>`;
                exifTable.appendChild(row);
              }
            });

            // Add remaining tags
            Object.keys(tags).filter(t => !importantTags.includes(t) && typeof tags[t] !== 'object').slice(0, 20).forEach(tag => {
              hasData = true;
              const row = document.createElement('tr');
              row.className = 'border-b border-slate-100';
              row.innerHTML = `<td class="py-2 px-4 font-medium text-slate-700">${escapeHtml(tag)}</td><td class="py-2 px-4 text-slate-600">${escapeHtml(tags[tag])}</td>`;
              exifTable.appendChild(row);
            });

            noExif.classList.toggle('hidden', hasData);
            document.getElementById('exifData').classList.toggle('hidden', !hasData);
          });
        };
        img.src = e.target.result;
      };
      reader.readAsDataURL(file);

      controls.classList.remove('hidden');
      dropZone.classList.add('hidden');
    }

    dropZone.addEventListener('click', () => fileInput.click());
    dropZone.addEventListener('dragover', (e) => e.preventDefault());
    dropZone.addEventListener('drop', (e) => { e.preventDefault(); handleFile(e.dataTransfer.files[0]); });
    fileInput.addEventListener('change', (e) => handleFile(e.target.files[0]));

    resetBtn.addEventListener('click', () => {
      controls.classList.add('hidden');
      dropZone.classList.remove('hidden');
      fileInput.value = '';
    });
  </script>
</ImageToolLayout>
