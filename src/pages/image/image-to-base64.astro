---
import ImageToolLayout from "../../layouts/ImageToolLayout.astro";

const faqItems = [
  {
    question: "Why convert image to Base64?",
    answer: "Base64 allows embedding images directly in HTML, CSS, or JSON without separate file requests.",
  },
  {
    question: "What output formats are available?",
    answer: "You can encode as PNG, JPEG, or WebP, and get the raw Base64 or full data URL.",
  },
];
---

<ImageToolLayout
  title="Image to Base64 - Encode Image as Base64"
  description="Convert images to Base64 string. Get data URI for embedding in HTML/CSS. Free online tool."
  canonicalPath="/image/image-to-base64"
  currentTool="Image to Base64"
  faqItems={faqItems}
>
  <div class="tool-header">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">Image to Base64</h1>
    <p class="text-slate-500">Encode images as Base64 strings for embedding in code.</p>
  </div>

  <div class="bg-slate-50 border border-slate-200 rounded p-6 mb-6">
    <div id="dropZone" class="border-2 border-dashed border-slate-300 rounded p-8 text-center cursor-pointer hover:border-blue-500 transition-colors mb-6">
      <div class="text-4xl mb-2">🔤</div>
      <p class="text-slate-600 mb-2">Drag & drop image here or click to select</p>
      <input type="file" id="fileInput" accept="image/*" class="hidden" />
    </div>

    <div id="controls" class="hidden">
      <div class="grid md:grid-cols-2 gap-6 mb-6">
        <div>
          <h3 class="font-medium text-slate-700 mb-2">Image Preview</h3>
          <div class="bg-white border border-slate-200 rounded p-2">
            <img id="preview" class="max-w-full max-h-48 object-contain mx-auto" alt="Preview" />
          </div>
          <p id="imageInfo" class="text-sm text-slate-500 mt-2"></p>
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Output Format</label>
          <select id="format" class="w-full px-3 py-2 border border-slate-300 rounded bg-white text-sm mb-4">
            <option value="image/png">PNG</option>
            <option value="image/jpeg">JPEG</option>
            <option value="image/webp">WebP</option>
          </select>
          <label class="flex items-center gap-2 text-sm text-slate-700 mb-2">
            <input type="checkbox" id="includePrefix" checked class="rounded" />
            Include data URL prefix
          </label>
          <p class="text-xs text-slate-500">Check this to get <code>data:image/...;base64,</code> prefix</p>
        </div>
      </div>

      <div class="mb-4">
        <label class="block text-sm font-medium text-slate-700 mb-2">Base64 Output</label>
        <textarea id="output" class="w-full h-32 px-3 py-2 border border-slate-300 rounded bg-white text-sm font-mono resize-y" readonly></textarea>
        <p id="outputInfo" class="text-sm text-slate-500 mt-1"></p>
      </div>

      <div class="flex gap-3">
        <button id="copyBtn" class="btn-primary px-6 py-2 font-semibold text-white rounded text-sm">📋 Copy</button>
        <button id="resetBtn" class="px-6 py-2 font-semibold bg-slate-200 text-slate-700 rounded text-sm hover:bg-slate-300">🗑️ Clear</button>
      </div>
    </div>
  </div>

  <div id="toast" class="fixed bottom-4 right-4 bg-slate-800 text-white px-4 py-2 rounded shadow-lg hidden text-sm">Copied!</div>

  <script is:inline>
    const dropZone = document.getElementById('dropZone');
    const fileInput = document.getElementById('fileInput');
    const controls = document.getElementById('controls');
    const preview = document.getElementById('preview');
    const imageInfo = document.getElementById('imageInfo');
    const formatSelect = document.getElementById('format');
    const includePrefix = document.getElementById('includePrefix');
    const output = document.getElementById('output');
    const outputInfo = document.getElementById('outputInfo');
    const copyBtn = document.getElementById('copyBtn');
    const resetBtn = document.getElementById('resetBtn');
    const toast = document.getElementById('toast');

    let originalImage = null;

    function formatSize(bytes) {
      if (bytes < 1024) return bytes + ' B';
      if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
      return (bytes / (1024 * 1024)).toFixed(2) + ' MB';
    }

    function handleFile(file) {
      if (!file || !file.type.startsWith('image/')) return;

      const reader = new FileReader();
      reader.onload = (e) => {
        const img = new Image();
        img.onload = () => {
          originalImage = img;
          preview.src = e.target.result;
          imageInfo.textContent = `${img.width} × ${img.height} • ${formatSize(file.size)}`;
          controls.classList.remove('hidden');
          dropZone.classList.add('hidden');
          encode();
        };
        img.src = e.target.result;
      };
      reader.readAsDataURL(file);
    }

    function encode() {
      if (!originalImage) return;
      const canvas = document.createElement('canvas');
      canvas.width = originalImage.width;
      canvas.height = originalImage.height;
      const ctx = canvas.getContext('2d');
      ctx.drawImage(originalImage, 0, 0);
      
      const dataUrl = canvas.toDataURL(formatSelect.value, 0.92);
      const base64 = includePrefix.checked ? dataUrl : dataUrl.split(',')[1];
      
      output.value = base64;
      outputInfo.textContent = `${formatSize(base64.length)} (${base64.length.toLocaleString()} characters)`;
    }

    formatSelect.addEventListener('change', encode);
    includePrefix.addEventListener('change', encode);

    copyBtn.addEventListener('click', () => {
      navigator.clipboard.writeText(output.value);
      toast.classList.remove('hidden');
      setTimeout(() => toast.classList.add('hidden'), 2000);
    });

    dropZone.addEventListener('click', () => fileInput.click());
    dropZone.addEventListener('dragover', (e) => e.preventDefault());
    dropZone.addEventListener('drop', (e) => { e.preventDefault(); handleFile(e.dataTransfer.files[0]); });
    fileInput.addEventListener('change', (e) => handleFile(e.target.files[0]));
    resetBtn.addEventListener('click', () => { controls.classList.add('hidden'); dropZone.classList.remove('hidden'); fileInput.value = ''; });
  </script>
</ImageToolLayout>
