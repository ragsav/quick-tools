---
import ImageToolLayout from "../../layouts/ImageToolLayout.astro";

const faqItems = [
  {
    question: "What filters are available?",
    answer: "Brightness, contrast, saturation, grayscale, sepia, blur, invert colors, and more.",
  },
  {
    question: "Can I combine multiple filters?",
    answer: "Yes! All filters can be combined and adjusted together before downloading.",
  },
];

const howItWorks = [
  {
    title: "Select Options",
    content: "Upload your file or enter the required input.",
  },
  {
    title: "Process Data",
    content: "The tool processes your data securely in the browser.",
  },
  {
    title: "Get Results",
    content: "Download or copy the generated output instantly.",
  },
];

const useCases = [
  {
    title: "General Usage",
    description: "Use the Image Filters to quickly process data without installing software.",
  },
  {
    title: "Professional Work",
    description: "Streamline your daily workflow with our secure, browser-based tool.",
  },
];
---

<ImageToolLayout
  useCases={useCases}
  howItWorks={howItWorks}
  title="Image Filters - Free Online Tool"
  description="Apply filters to images online. Brightness, contrast, grayscale, blur, sepia and more. No upload required."
  canonicalPath="/image/image-filters"
  currentTool="Image Filters"
  faqItems={faqItems}
>
  <div class="tool-header">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">Image Filters</h1>
    <p class="text-slate-500">Apply various filters and adjustments to your images.</p>
  </div>

  <div class="bg-slate-50 border border-slate-200 rounded p-6 mb-6">
    <div id="dropZone" class="border-2 border-dashed border-slate-300 rounded p-8 text-center cursor-pointer hover:border-blue-500 transition-colors mb-6">
      <div class="text-4xl mb-2">🎨</div>
      <p class="text-slate-600 mb-2">Drag & drop image here or click to select</p>
      <input type="file" id="fileInput" accept="image/*" class="hidden" />
    </div>

    <div id="controls" class="hidden">
      <div class="grid md:grid-cols-2 gap-6 mb-6">
        <div>
          <h3 class="font-medium text-slate-700 mb-2">Preview</h3>
          <div class="bg-white border border-slate-200 rounded p-2">
            <canvas id="canvas" class="max-w-full block mx-auto"></canvas>
          </div>
        </div>
        <div>
          <h3 class="font-medium text-slate-700 mb-2">Adjustments</h3>
          <div class="space-y-4">
            <div>
              <label class="flex justify-between text-sm text-slate-700 mb-1">
                <span>Brightness</span><span id="brightnessVal">100%</span>
              </label>
              <input type="range" id="brightness" min="0" max="200" value="100" class="w-full" />
            </div>
            <div>
              <label class="flex justify-between text-sm text-slate-700 mb-1">
                <span>Contrast</span><span id="contrastVal">100%</span>
              </label>
              <input type="range" id="contrast" min="0" max="200" value="100" class="w-full" />
            </div>
            <div>
              <label class="flex justify-between text-sm text-slate-700 mb-1">
                <span>Saturation</span><span id="saturationVal">100%</span>
              </label>
              <input type="range" id="saturation" min="0" max="200" value="100" class="w-full" />
            </div>
            <div>
              <label class="flex justify-between text-sm text-slate-700 mb-1">
                <span>Blur</span><span id="blurVal">0px</span>
              </label>
              <input type="range" id="blur" min="0" max="20" value="0" class="w-full" />
            </div>
            <div>
              <label class="flex justify-between text-sm text-slate-700 mb-1">
                <span>Grayscale</span><span id="grayscaleVal">0%</span>
              </label>
              <input type="range" id="grayscale" min="0" max="100" value="0" class="w-full" />
            </div>
            <div>
              <label class="flex justify-between text-sm text-slate-700 mb-1">
                <span>Sepia</span><span id="sepiaVal">0%</span>
              </label>
              <input type="range" id="sepia" min="0" max="100" value="0" class="w-full" />
            </div>
            <div>
              <label class="flex justify-between text-sm text-slate-700 mb-1">
                <span>Invert</span><span id="invertVal">0%</span>
              </label>
              <input type="range" id="invert" min="0" max="100" value="0" class="w-full" />
            </div>
          </div>
        </div>
      </div>

      <div class="flex flex-wrap gap-3">
        <button id="resetFilters" class="px-4 py-2 font-semibold bg-amber-100 text-amber-700 rounded text-sm hover:bg-amber-200">↩ Reset Filters</button>
        <button id="downloadBtn" class="px-6 py-2 font-semibold bg-green-600 text-white rounded text-sm hover:bg-green-700">⬇️ Download</button>
        <button id="resetBtn" class="px-6 py-2 font-semibold bg-slate-200 text-slate-700 rounded text-sm hover:bg-slate-300">🗑️ Clear</button>
      </div>
    </div>
  </div>

  <script is:inline>
    const dropZone = document.getElementById('dropZone');
    const fileInput = document.getElementById('fileInput');
    const controls = document.getElementById('controls');
    const canvas = document.getElementById('canvas');
    const ctx = canvas.getContext('2d');
    const downloadBtn = document.getElementById('downloadBtn');
    const resetBtn = document.getElementById('resetBtn');

    let originalImage = null, originalFile = null;
    const filters = { brightness: 100, contrast: 100, saturation: 100, blur: 0, grayscale: 0, sepia: 0, invert: 0 };

    function handleFile(file) {
      if (!file || !file.type.startsWith('image/')) return;
      originalFile = file;
      const reader = new FileReader();
      reader.onload = (e) => {
        const img = new Image();
        img.onload = () => {
          originalImage = img;
          canvas.width = Math.min(img.width, 800);
          canvas.height = img.height * (canvas.width / img.width);
          controls.classList.remove('hidden');
          dropZone.classList.add('hidden');
          applyFilters();
        };
        img.src = e.target.result;
      };
      reader.readAsDataURL(file);
    }

    function applyFilters() {
      if (!originalImage) return;
      ctx.filter = `brightness(${filters.brightness}%) contrast(${filters.contrast}%) saturate(${filters.saturation}%) blur(${filters.blur}px) grayscale(${filters.grayscale}%) sepia(${filters.sepia}%) invert(${filters.invert}%)`;
      ctx.drawImage(originalImage, 0, 0, canvas.width, canvas.height);
    }

    Object.keys(filters).forEach(key => {
      const slider = document.getElementById(key);
      const label = document.getElementById(key + 'Val');
      slider.addEventListener('input', () => {
        filters[key] = parseInt(slider.value);
        label.textContent = filters[key] + (key === 'blur' ? 'px' : '%');
        applyFilters();
      });
    });

    document.getElementById('resetFilters').addEventListener('click', () => {
      Object.keys(filters).forEach(key => {
        filters[key] = key === 'blur' ? 0 : (key === 'brightness' || key === 'contrast' || key === 'saturation' ? 100 : 0);
        document.getElementById(key).value = filters[key];
        document.getElementById(key + 'Val').textContent = filters[key] + (key === 'blur' ? 'px' : '%');
      });
      applyFilters();
    });

    dropZone.addEventListener('click', () => fileInput.click());
    dropZone.addEventListener('dragover', (e) => { e.preventDefault(); });
    dropZone.addEventListener('drop', (e) => { e.preventDefault(); handleFile(e.dataTransfer.files[0]); });
    fileInput.addEventListener('change', (e) => handleFile(e.target.files[0]));

    downloadBtn.addEventListener('click', () => {
      // Re-render at full resolution
      const fullCanvas = document.createElement('canvas');
      fullCanvas.width = originalImage.width;
      fullCanvas.height = originalImage.height;
      const fullCtx = fullCanvas.getContext('2d');
      fullCtx.filter = `brightness(${filters.brightness}%) contrast(${filters.contrast}%) saturate(${filters.saturation}%) blur(${filters.blur}px) grayscale(${filters.grayscale}%) sepia(${filters.sepia}%) invert(${filters.invert}%)`;
      fullCtx.drawImage(originalImage, 0, 0);
      fullCanvas.toBlob((blob) => {
        const link = document.createElement('a');
        link.href = URL.createObjectURL(blob);
        link.download = 'filtered-image.png';
        link.click();
      }, 'image/png');
    });

    resetBtn.addEventListener('click', () => {
      originalImage = null; originalFile = null;
      controls.classList.add('hidden'); dropZone.classList.remove('hidden');
      fileInput.value = '';
    });
  </script>
</ImageToolLayout>
