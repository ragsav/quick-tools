---
import ImageToolLayout from "../../layouts/ImageToolLayout.astro";

const faqItems = [
  {
    question: "What image tools are available?",
    answer: "We offer Image Compress/Resize and Image to PDF conversion tools.",
  },
  {
    question: "Are my images uploaded to a server?",
    answer: "No! All processing happens directly in your browser. Your files never leave your device.",
  },
];
---

<ImageToolLayout
  title="Image Tools - Free Online Image Utilities"
  description="Free browser-based image tools. Compress, resize, and convert images to PDF. No uploads - everything runs locally."
  canonicalPath="/image/"
  faqItems={faqItems}
>
  <div class="tool-header">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">
      🖼️ Image Tools
    </h1>
    <p class="text-slate-500">
      Compress, resize, and convert images directly in your browser.
    </p>
  </div>

  <div class="grid gap-4">
    <a
      href="/image/image-compress"
      class="block p-6 bg-slate-50 border border-slate-200 rounded hover:border-blue-500 hover:shadow-md transition-all group"
    >
      <div class="flex justify-between items-center">
        <div>
          <h2 class="text-lg font-semibold text-slate-900 mb-1">Image Compress & Resize</h2>
          <p class="text-sm text-slate-500">Reduce file size and dimensions while maintaining quality</p>
        </div>
        <span class="text-slate-400 group-hover:text-blue-500 group-hover:translate-x-1 transition-all text-xl">→</span>
      </div>
    </a>

    <a
      href="/image/image-to-pdf"
      class="block p-6 bg-slate-50 border border-slate-200 rounded hover:border-blue-500 hover:shadow-md transition-all group"
    >
      <div class="flex justify-between items-center">
        <div>
          <h2 class="text-lg font-semibold text-slate-900 mb-1">Image to PDF</h2>
          <p class="text-sm text-slate-500">Convert multiple images into a single PDF document</p>
        </div>
        <span class="text-slate-400 group-hover:text-blue-500 group-hover:translate-x-1 transition-all text-xl">→</span>
      </div>
    </a>
  </div>
</ImageToolLayout>
