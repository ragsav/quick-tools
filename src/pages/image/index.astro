---
import { CONSTANT } from "../../constants";
import { Image } from "astro:assets";
import logo from "../../assets/favicon.svg";
import "../../styles/global.css";

const seo = {
  title: "Image Tools - Free Online Image Converters & Editors",
  description: "Free online image tools. Convert formats, resize, crop, rotate, apply filters, and more. All processing happens in your browser.",
  canonical: `${CONSTANT.CANONICAL_URL}/image/`,
};

const tools = [
  // Format Converters
  { name: "Image Compress", url: "/image/image-compress", desc: "Compress and reduce image file size", category: "compress" },
  { name: "PNG to JPG", url: "/image/png-to-jpg", desc: "Convert PNG images to JPEG format", category: "convert" },
  { name: "JPG to PNG", url: "/image/jpg-to-png", desc: "Convert JPEG images to PNG format", category: "convert" },
  { name: "Image to WebP", url: "/image/image-to-webp", desc: "Convert any image to WebP format", category: "convert" },
  { name: "WebP to PNG", url: "/image/webp-to-png", desc: "Convert WebP images to PNG", category: "convert" },
  { name: "SVG to PNG", url: "/image/svg-to-png", desc: "Rasterize SVG to PNG at any size", category: "convert" },
  { name: "HEIC to JPG", url: "/image/heic-to-jpg", desc: "Convert iPhone HEIC photos to JPG", category: "convert" },
  { name: "GIF to PNG", url: "/image/gif-to-png", desc: "Extract first frame of GIF as PNG", category: "convert" },
  { name: "BMP to PNG", url: "/image/bmp-to-png", desc: "Convert BMP images to PNG", category: "convert" },
  { name: "Image to ICO", url: "/image/image-to-ico", desc: "Create favicon ICO from any image", category: "convert" },
  { name: "Image to PDF", url: "/image/image-to-pdf", desc: "Combine images into a PDF document", category: "convert" },
  // Editing Tools
  { name: "Image Resize", url: "/image/image-resize", desc: "Resize images to specific dimensions", category: "edit" },
  { name: "Image Crop", url: "/image/image-crop", desc: "Crop images with visual selection", category: "edit" },
  { name: "Image Rotate", url: "/image/image-rotate", desc: "Rotate and flip images", category: "edit" },
  // Enhancement & Utilities
  { name: "Image Filters", url: "/image/image-filters", desc: "Apply brightness, contrast, blur, and more", category: "enhance" },
  { name: "Image Metadata", url: "/image/image-metadata", desc: "View EXIF and image metadata", category: "utility" },
  { name: "Color Extractor", url: "/image/color-extractor", desc: "Extract dominant colors from images", category: "utility" },
  { name: "Base64 to Image", url: "/image/base64-to-image", desc: "Decode Base64 string to image", category: "utility" },
  { name: "Image to Base64", url: "/image/image-to-base64", desc: "Encode image as Base64 string", category: "utility" },
];

const categories = [
  { id: "convert", name: "Format Converters", icon: "🔄" },
  { id: "compress", name: "Compression", icon: "📦" },
  { id: "edit", name: "Editing", icon: "✂️" },
  { id: "enhance", name: "Enhancement", icon: "🎨" },
  { id: "utility", name: "Utilities", icon: "🛠️" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={seo.canonical} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="robots" content="index, follow" />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={seo.canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>

  <body class="font-['Inter',system-ui,sans-serif] bg-slate-50 text-slate-800 min-h-screen leading-relaxed">
    <header class="bg-blue-900 text-white p-4">
      <div class="max-w-6xl mx-auto flex items-center justify-between flex-wrap gap-2">
        <a href="/" class="flex items-center gap-2 no-underline text-white font-bold text-xl">
          <Image src={logo} alt="Quick Tools Logo" class="w-8 h-8 lg:w-9 lg:h-9" />
          <span>Quick Tools</span>
        </a>
        <nav class="text-sm">
          <a href="/" class="text-slate-300 hover:text-white">Home</a>
          <span class="mx-2 text-slate-500">/</span>
          <span class="text-white">Image Tools</span>
        </nav>
      </div>
    </header>

    <main class="max-w-6xl mx-auto p-4 py-8">
      <section class="mb-8">
        <div class="flex items-center gap-3 mb-4">
          <span class="text-4xl">🖼️</span>
          <div>
            <h1 class="text-3xl font-bold text-slate-900">Image Tools</h1>
            <p class="text-slate-500">Convert, edit, and enhance images directly in your browser</p>
          </div>
        </div>
        <p class="text-sm text-slate-500 bg-green-50 border border-green-200 rounded px-4 py-2 inline-block">
          🔒 All processing happens locally - your images never leave your device
        </p>
      </section>

      {categories.map(cat => {
        const catTools = tools.filter(t => t.category === cat.id);
        if (catTools.length === 0) return null;
        return (
          <section class="mb-8">
            <h2 class="text-xl font-semibold text-slate-800 mb-4 flex items-center gap-2">
              <span>{cat.icon}</span> {cat.name}
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
              {catTools.map(tool => (
                <a
                  href={tool.url}
                  class="block bg-white border border-slate-200 rounded p-4 hover:shadow-lg hover:-translate-y-0.5 transition-all no-underline"
                >
                  <h3 class="text-lg font-semibold text-slate-900 mb-1">{tool.name}</h3>
                  <p class="text-sm text-slate-500">{tool.desc}</p>
                </a>
              ))}
            </div>
          </section>
        );
      })}
    </main>

    <footer class="bg-slate-100 border-t border-slate-200 p-6 mt-12 text-center text-sm text-slate-500">
      <p>© {new Date().getFullYear()} Quick Tools. All tools are free and run in your browser.</p>
    </footer>
  </body>
</html>
