---
import ImageToolLayout from "../../layouts/ImageToolLayout.astro";

const faqItems = [
  {
    question: "What is an ICO file?",
    answer: "ICO is the icon format used for Windows applications and website favicons. It can contain multiple sizes in one file.",
  },
  {
    question: "What sizes are included?",
    answer: "This tool generates icons at 16x16, 32x32, 48x48, and optionally 64x64 or 256x256 pixels.",
  },
  {
    question: "Can I use this for my website favicon?",
    answer: "Yes! The generated ICO file is perfectly suited for use as a website favicon.",
  },
];

const howItWorks = [
  {
    title: "Select Options",
    content: "Upload your file or enter the required input.",
  },
  {
    title: "Process Data",
    content: "The tool processes your data securely in the browser.",
  },
  {
    title: "Get Results",
    content: "Download or copy the generated output instantly.",
  },
];

const useCases = [
  {
    title: "General Usage",
    description: "Use the Image to ICO Converter to quickly process data without installing software.",
  },
  {
    title: "Professional Work",
    description: "Streamline your daily workflow with our secure, browser-based tool.",
  },
];
---

<ImageToolLayout
  useCases={useCases}
  howItWorks={howItWorks}
  title="Image to ICO Converter - Create Favicons Online"
  description="Convert any image to ICO format for favicons and Windows icons. Free online tool - no upload required."
  canonicalPath="/image/image-to-ico"
  currentTool="Image to ICO"
  faqItems={faqItems}
>
  <div class="tool-header">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">
      Image to ICO Converter
    </h1>
    <p class="text-slate-500">
      Create ICO favicon files from any image format.
    </p>
  </div>

  <div class="bg-slate-50 border border-slate-200 rounded p-6 mb-6">
    <div
      id="dropZone"
      class="border-2 border-dashed border-slate-300 rounded p-8 text-center cursor-pointer hover:border-blue-500 transition-colors mb-6"
    >
      <div class="text-4xl mb-2">⭐</div>
      <p class="text-slate-600 mb-2">Drag & drop image here or click to select</p>
      <p class="text-sm text-slate-400">Supports PNG, JPG, WebP, GIF</p>
      <input type="file" id="fileInput" accept="image/*" class="hidden" />
    </div>

    <div id="controls" class="hidden">
      <div class="grid md:grid-cols-2 gap-6 mb-6">
        <div>
          <h3 class="font-medium text-slate-700 mb-2">Original Image</h3>
          <div class="bg-white border border-slate-200 rounded p-2 aspect-video flex items-center justify-center overflow-hidden checkered-bg">
            <img id="originalPreview" class="max-w-full max-h-full object-contain" alt="Original" />
          </div>
          <p id="originalInfo" class="text-sm text-slate-500 mt-2"></p>
        </div>

        <div>
          <h3 class="font-medium text-slate-700 mb-2">Icon Previews</h3>
          <div class="bg-white border border-slate-200 rounded p-4">
            <div id="iconPreviews" class="flex items-end gap-4 flex-wrap"></div>
          </div>
        </div>
      </div>

      <div class="mb-6">
        <label class="block text-sm font-medium text-slate-700 mb-2">Include Sizes</label>
        <div class="flex flex-wrap gap-4">
          <label class="flex items-center gap-2 text-sm text-slate-700">
            <input type="checkbox" class="size-check rounded" value="16" checked disabled />
            16×16
          </label>
          <label class="flex items-center gap-2 text-sm text-slate-700">
            <input type="checkbox" class="size-check rounded" value="32" checked disabled />
            32×32
          </label>
          <label class="flex items-center gap-2 text-sm text-slate-700">
            <input type="checkbox" class="size-check rounded" value="48" checked />
            48×48
          </label>
          <label class="flex items-center gap-2 text-sm text-slate-700">
            <input type="checkbox" class="size-check rounded" value="64" checked />
            64×64
          </label>
          <label class="flex items-center gap-2 text-sm text-slate-700">
            <input type="checkbox" class="size-check rounded" value="128" />
            128×128
          </label>
          <label class="flex items-center gap-2 text-sm text-slate-700">
            <input type="checkbox" class="size-check rounded" value="256" />
            256×256
          </label>
        </div>
      </div>

      <div class="flex flex-wrap gap-3">
        <button
          id="convertBtn"
          class="btn-primary px-6 py-2 font-semibold text-white rounded text-sm"
        >
          🔄 Generate ICO
        </button>
        <button
          id="downloadBtn"
          class="px-6 py-2 font-semibold bg-green-600 text-white rounded text-sm hover:bg-green-700 transition-colors hidden"
        >
          ⬇️ Download ICO
        </button>
        <button
          id="resetBtn"
          class="px-6 py-2 font-semibold bg-slate-200 text-slate-700 rounded text-sm hover:bg-slate-300 transition-colors"
        >
          🗑️ Reset
        </button>
      </div>
    </div>
  </div>

  <style>
    .checkered-bg {
      background-image: linear-gradient(45deg, #e2e8f0 25%, transparent 25%),
        linear-gradient(-45deg, #e2e8f0 25%, transparent 25%),
        linear-gradient(45deg, transparent 75%, #e2e8f0 75%),
        linear-gradient(-45deg, transparent 75%, #e2e8f0 75%);
      background-size: 16px 16px;
      background-position: 0 0, 0 8px, 8px -8px, -8px 0px;
    }
  </style>

  <script is:inline>
    const dropZone = document.getElementById('dropZone');
    const fileInput = document.getElementById('fileInput');
    const controls = document.getElementById('controls');
    const originalPreview = document.getElementById('originalPreview');
    const iconPreviews = document.getElementById('iconPreviews');
    const originalInfo = document.getElementById('originalInfo');
    const convertBtn = document.getElementById('convertBtn');
    const downloadBtn = document.getElementById('downloadBtn');
    const resetBtn = document.getElementById('resetBtn');

    let originalImage = null;
    let originalFile = null;
    let icoBlob = null;

    function formatSize(bytes) {
      if (bytes < 1024) return bytes + ' B';
      if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
      return (bytes / (1024 * 1024)).toFixed(2) + ' MB';
    }

    function handleFile(file) {
      if (!file || !file.type.startsWith('image/')) {
        alert('Please select an image file.');
        return;
      }

      originalFile = file;
      const reader = new FileReader();

      reader.onload = (e) => {
        const img = new Image();
        img.onload = () => {
          originalImage = img;
          originalPreview.src = e.target.result;
          originalInfo.textContent = `${img.width} × ${img.height} • ${formatSize(file.size)}`;
          controls.classList.remove('hidden');
          dropZone.classList.add('hidden');
          generatePreviews();
        };
        img.src = e.target.result;
      };

      reader.readAsDataURL(file);
    }

    function getSelectedSizes() {
      return Array.from(document.querySelectorAll('.size-check:checked')).map(cb => parseInt(cb.value));
    }

    function generatePreviews() {
      if (!originalImage) return;

      iconPreviews.innerHTML = '';
      const sizes = getSelectedSizes();

      sizes.forEach(size => {
        const canvas = document.createElement('canvas');
        canvas.width = size;
        canvas.height = size;
        const ctx = canvas.getContext('2d');
        ctx.drawImage(originalImage, 0, 0, size, size);

        const preview = document.createElement('div');
        preview.className = 'text-center';
        preview.innerHTML = `
          <div class="border border-slate-200 rounded p-1 inline-block bg-white checkered-bg">
            <img src="${canvas.toDataURL('image/png')}" width="${size}" height="${size}" class="block" />
          </div>
          <p class="text-xs text-slate-500 mt-1">${size}×${size}</p>
        `;
        iconPreviews.appendChild(preview);
      });
    }

    function generateICO() {
      if (!originalImage) return;

      const sizes = getSelectedSizes();
      const images = [];

      sizes.forEach(size => {
        const canvas = document.createElement('canvas');
        canvas.width = size;
        canvas.height = size;
        const ctx = canvas.getContext('2d');
        ctx.drawImage(originalImage, 0, 0, size, size);
        images.push({ size, canvas });
      });

      // Create ICO file structure
      const iconDir = createICO(images);
      icoBlob = new Blob([iconDir], { type: 'image/x-icon' });

      downloadBtn.classList.remove('hidden');
    }

    function createICO(images) {
      // ICO Header: 6 bytes
      // ICONDIRENTRY: 16 bytes per image
      // Image data follows

      const headerSize = 6;
      const entrySize = 16;
      const imageDataArray = [];

      // Convert each canvas to PNG data
      images.forEach(({ size, canvas }) => {
        const dataUrl = canvas.toDataURL('image/png');
        const base64 = dataUrl.split(',')[1];
        const binary = atob(base64);
        const bytes = new Uint8Array(binary.length);
        for (let i = 0; i < binary.length; i++) {
          bytes[i] = binary.charCodeAt(i);
        }
        imageDataArray.push({ size, data: bytes });
      });

      // Calculate total size
      const totalSize = headerSize + (entrySize * images.length) +
        imageDataArray.reduce((sum, img) => sum + img.data.length, 0);

      const buffer = new ArrayBuffer(totalSize);
      const view = new DataView(buffer);

      // ICO Header
      view.setUint16(0, 0, true);           // Reserved
      view.setUint16(2, 1, true);           // Type (1 = ICO)
      view.setUint16(4, images.length, true); // Number of images

      // Calculate data offsets
      let dataOffset = headerSize + (entrySize * images.length);

      // Write ICONDIRENTRY for each image
      images.forEach((img, i) => {
        const entryOffset = headerSize + (i * entrySize);
        const imgData = imageDataArray[i];

        view.setUint8(entryOffset + 0, img.size < 256 ? img.size : 0);  // Width
        view.setUint8(entryOffset + 1, img.size < 256 ? img.size : 0);  // Height
        view.setUint8(entryOffset + 2, 0);                               // Colors
        view.setUint8(entryOffset + 3, 0);                               // Reserved
        view.setUint16(entryOffset + 4, 1, true);                        // Color planes
        view.setUint16(entryOffset + 6, 32, true);                       // Bits per pixel
        view.setUint32(entryOffset + 8, imgData.data.length, true);     // Size of image data
        view.setUint32(entryOffset + 12, dataOffset, true);             // Offset to image data

        // Copy image data
        const uint8View = new Uint8Array(buffer);
        uint8View.set(imgData.data, dataOffset);

        dataOffset += imgData.data.length;
      });

      return buffer;
    }

    document.querySelectorAll('.size-check').forEach(cb => {
      cb.addEventListener('change', generatePreviews);
    });

    dropZone.addEventListener('click', () => fileInput.click());
    dropZone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropZone.classList.add('border-blue-500', 'bg-blue-50');
    });
    dropZone.addEventListener('dragleave', () => {
      dropZone.classList.remove('border-blue-500', 'bg-blue-50');
    });
    dropZone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropZone.classList.remove('border-blue-500', 'bg-blue-50');
      handleFile(e.dataTransfer.files[0]);
    });
    fileInput.addEventListener('change', (e) => handleFile(e.target.files[0]));
    convertBtn.addEventListener('click', generateICO);

    downloadBtn.addEventListener('click', () => {
      if (!icoBlob) return;
      const link = document.createElement('a');
      link.href = URL.createObjectURL(icoBlob);
      link.download = 'favicon.ico';
      link.click();
    });

    resetBtn.addEventListener('click', () => {
      originalImage = null;
      originalFile = null;
      icoBlob = null;
      controls.classList.add('hidden');
      dropZone.classList.remove('hidden');
      fileInput.value = '';
      downloadBtn.classList.add('hidden');
    });
  </script>
</ImageToolLayout>
