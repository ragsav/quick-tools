// Count tools
const totalTools = toolClusters.reduce((sum, c) => sum + c.tools.length, 0);

// Flatten for JSON-LD
const allLiveTools = toolClusters.flatMap((c) =>
	c.tools.filter((t) => t.status === "live"),
);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<title>{seo.title}</title>
		<meta name="description" content={seo.description} />
		<link rel="canonical" href={seo.canonical} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		<!-- SEO -->
		<meta name="robots" content="index, follow" />
		<meta
			name="keywords"
			content="online tools, free calculators, date calculator, text tools, unit converter, salary calculator, student tools, developer utilities"
		/>

		<!-- Open Graph -->
		<meta property="og:title" content={seo.title} />
		<meta property="og:description" content={seo.description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={seo.canonical} />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={seo.title} />
		<meta name="twitter:description" content={seo.description} />

		<!-- JSON-LD -->
		<script
			type="application/ld+json"
			set:html={JSON.stringify({
				"@context": "https://schema.org",
				"@type": "WebSite",
				name: "Quick Tools",
				url: seo.canonical,
				description: seo.description,
				potentialAction: {
					"@type": "SearchAction",
					target: `${seo.canonical}/search?q={search_term_string}`,
					"query-input": "required name=search_term_string",
				},
			})}
		/>

		<script
			type="application/ld+json"
			set:html={JSON.stringify({
				"@context": "https://schema.org",
				"@type": "ItemList",
				name: "Free Online Tools",
				numberOfItems: allLiveTools.length,
				itemListElement: allLiveTools.map((tool, i) => ({
					"@type": "ListItem",
					position: i + 1,
					name: tool.name,
					url: `${seo.canonical}${tool.url}`,
				})),
			})}
		/>

		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
	</head>

	<body
		class="font-['Inter',system-ui,sans-serif] bg-slate-50 text-slate-800 min-h-screen leading-relaxed"
	>
		<!-- HEADER -->
		<header class="bg-blue-900 text-white p-4">
			<div
				class="max-w-6xl mx-auto flex items-center justify-between flex-wrap gap-2"
			>
				<a
					href="/"
					class="flex items-center gap-2 no-underline text-white font-bold text-xl"
				>
					<Image
						src={logo}
						alt="Quick Tools Logo"
						class="w-8 h-8 lg:w-9 lg:h-9"
					/>
					<span>Quick Tools</span>
				</a>
				<p class="text-slate-400 text-sm">
					Free online utilities — no login, no ads, just tools
				</p>
			</div>
		</header>

		<main class="max-w-6xl mx-auto p-4 py-8">
			<!-- HERO SECTION -->
			<section
				class="bg-blue-900 rounded p-8 sm:p-12 mb-12 text-white text-center"
			>
				<h1 class="text-3xl sm:text-4xl font-bold mb-4">
					Your Everyday <span class="bg-white/20 px-2 py-0.5 rounded"
						>Toolkit</span
					>
				</h1>
				<p class="text-lg opacity-95 max-w-xl mx-auto mb-8">
					{totalTools}+ free calculators and utilities for dates,
					text, numbers, and more. All tools run in your browser —
					fast, private, and completely free.
				</p>
				<div class="flex justify-center gap-8 sm:gap-12 flex-wrap">
					<div class="flex flex-col">
						<span class="text-3xl sm:text-4xl font-bold"
							>{toolClusters.length}</span
						>
						<span
							class="text-sm opacity-80 uppercase tracking-wider"
							>Categories</span
						>
					</div>
					<div class="flex flex-col">
						<span class="text-3xl sm:text-4xl font-bold"
							>{totalTools}+</span
						>
						<span
							class="text-sm opacity-80 uppercase tracking-wider"
							>Tools</span
						>
					</div>
					<div class="flex flex-col">
						<span class="text-3xl sm:text-4xl font-bold">100%</span>
						<span
							class="text-sm opacity-80 uppercase tracking-wider"
							>Free</span
						>
					</div>
				</div>
			</section>

			<!-- TOOL CLUSTERS -->
			<section class="mb-12">
				<h2
					class="text-2xl font-bold text-slate-900 mb-6 pb-2 border-b border-slate-200"
				>
					Browse Tools by Category
				</h2>

				<div
					class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
				>
					{
						toolClusters.map((cluster) => (
							<div
								class="bg-white rounded border border-slate-200 shadow-sm p-6 hover:shadow-lg hover:-translate-y-0.5 transition-all"
								style={`--cluster-color: ${cluster.color}`}
							>
								<div
									class="flex items-start gap-4 mb-4 pb-4 border-b-2"
									style={`border-color: ${cluster.color}`}
								>
									<span class="text-3xl">{cluster.icon}</span>
									<div>
										<h3 class="text-lg font-semibold text-slate-900">
											{cluster.name}
										</h3>
										<p class="text-sm text-slate-500">
											{cluster.description}
										</p>
									</div>
								</div>

								<ul class="space-y-2">
									{cluster.tools.map((tool) => (
										<li>
											{tool.status === "live" ? (
												<a
													href={tool.url}
													class="tool-link flex justify-between items-center px-3 py-2 bg-slate-50 rounded no-underline text-slate-700 text-sm hover:bg-slate-200 transition-all group"
												>
													<span>{tool.name}</span>
													<span class="group-hover:translate-x-1 transition-transform">
														→
													</span>
												</a>
											) : (
												<span class="flex justify-between items-center px-3 py-2 bg-slate-50 rounded text-slate-400 text-sm cursor-default">
													<span>{tool.name}</span>
													<span class="text-[10px] bg-slate-100 text-slate-500 px-1.5 py-0.5 rounded uppercase font-semibold tracking-wide">
														Soon
													</span>
												</span>
											)}
										</li>
									))}
								</ul>
							</div>
						))
					}
				</div>
			</section>

			<!-- WHY SECTION -->
			<section class="mb-12">
				<h2
					class="text-2xl font-bold text-slate-900 mb-6 pb-2 border-b border-slate-200"
				>
					Why Quick Tools?
				</h2>
				<div
					class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6"
				>
					<div
						class="bg-white rounded border border-slate-200 p-6 text-center"
					>
						<span class="text-3xl mb-3 block">🚀</span>
						<h3 class="font-semibold text-slate-900 mb-2">
							Lightning Fast
						</h3>
						<p class="text-sm text-slate-500">
							No bloated frameworks. Tools load instantly and work
							offline.
						</p>
					</div>
					<div
						class="bg-white rounded border border-slate-200 p-6 text-center"
					>
						<span class="text-3xl mb-3 block">🔒</span>
						<h3 class="font-semibold text-slate-900 mb-2">
							Privacy First
						</h3>
						<p class="text-sm text-slate-500">
							All calculations happen in your browser. Your data
							never leaves your device.
						</p>
					</div>
					<div
						class="bg-white rounded border border-slate-200 p-6 text-center"
					>
						<span class="text-3xl mb-3 block">💯</span>
						<h3 class="font-semibold text-slate-900 mb-2">
							100% Free
						</h3>
						<p class="text-sm text-slate-500">
							No premium tiers, no paywalls. Every tool is
							completely free to use.
						</p>
					</div>
					<div
						class="bg-white rounded border border-slate-200 p-6 text-center"
					>
						<span class="text-3xl mb-3 block">📱</span>
						<h3 class="font-semibold text-slate-900 mb-2">
							Works Everywhere
						</h3>
						<p class="text-sm text-slate-500">
							Desktop, tablet, or phone — tools work perfectly on
							any device.
						</p>
					</div>
				</div>
			</section>

			<!-- POPULAR TOOLS -->
			<section class="mb-12">
				<h2
					class="text-2xl font-bold text-slate-900 mb-6 pb-2 border-b border-slate-200"
				>
					Popular Tools
				</h2>
				<div class="flex flex-wrap gap-3">
					{
						allLiveTools.length > 0 ? (
							allLiveTools.map((tool) => (
								<a
									href={tool.url}
									class="inline-flex items-center gap-2 bg-white border border-slate-200 px-5 py-3 rounded no-underline text-slate-700 font-medium hover:border-blue-500 hover:text-blue-500 hover:shadow-md transition-all group"
								>
									<span>{tool.name}</span>
									<span class="group-hover:translate-x-1 transition-transform">
										→
									</span>
								</a>
							))
						) : (
							<p class="text-slate-500 italic">
								More tools coming soon! Check back regularly for
								updates.
							</p>
						)
					}
				</div>
			</section>
		</main>

		<!-- FOOTER -->
		<footer class="bg-slate-800 text-slate-400 p-8 mt-auto">
			<div
				class="max-w-6xl mx-auto flex flex-col items-center gap-4 text-center"
			>
				<div
					class="text-xl font-semibold text-white flex items-center gap-2"
				>
					<Image src={logo} alt="Quick Tools Logo" class="w-6 h-6" />
					<span>Quick Tools</span>
				</div>
				<p class="text-sm">
					© 2024–{new Date().getFullYear()} Quick Tools. Free tools for
					everyone.
				</p>
				<div class="flex gap-6">
					<a
						href="/about"
						class="text-slate-400 no-underline text-sm hover:text-white transition-colors"
						>About</a
					>
					<a
						href="/privacy"
						class="text-slate-400 no-underline text-sm hover:text-white transition-colors"
						>Privacy</a
					>
					<a
						href="https://github.com"
						target="_blank"
						rel="noopener"
						class="text-slate-400 no-underline text-sm hover:text-white transition-colors"
						>GitHub</a
					>
				</div>
			</div>
		</footer>

		<!-- Custom styles for hover effects that need CSS variables -->
		<style is:global>
			.cluster-card a:hover {
				background-color: var(--cluster-color, #1c398e);
			}
		</style>
	</body>
</html>
