		<!-- Theme toggle script -->
		<script is:inline>
			function toggleTheme() {
				const html = document.documentElement;
				const isDark = html.classList.toggle("dark");
				localStorage.setItem("theme", isDark ? "dark" : "light");
			}

			// Category dropdown
			function toggleCategoryDropdown() {
				const menu = document.getElementById('category-menu');
				const arrow = document.getElementById('dropdown-arrow');
				const isOpen = !menu.classList.contains('hidden');
				menu.classList.toggle('hidden');
				arrow.style.transform = isOpen ? '' : 'rotate(180deg)';
			}

			// Close dropdown when clicking outside
			document.addEventListener('click', (e) => {
				const dropdown = document.getElementById('category-dropdown');
				if (dropdown && !dropdown.contains(e.target)) {
					document.getElementById('category-menu')?.classList.add('hidden');
					const arrow = document.getElementById('dropdown-arrow');
					if (arrow) arrow.style.transform = '';
				}
			});

			// Search functionality
			const allTools = [
				// This will be populated from the toolClusters data
			];
		</script>

		<!-- Pass data to client-side scripts -->
		<script is:inline define:vars={{ toolClusters, allLiveTools }}>
			// Store data globally for access by other scripts
			window.__TOOL_DATA__ = { toolClusters, allLiveTools };
		</script>

		<!-- Search and expand functionality -->
		<script is:inline>
			// Get data from global store
			const { toolClusters, allLiveTools } = window.__TOOL_DATA__ || { toolClusters: [], allLiveTools: [] };

			// Build search index from all tools
			const searchIndex = [];
			toolClusters.forEach(cluster => {
				cluster.tools.forEach(tool => {
					if (tool.status === 'live') {
						searchIndex.push({
							name: tool.name,
							url: tool.url,
							category: cluster.name,
							icon: cluster.icon,
							searchTerms: (tool.name + ' ' + cluster.name).toLowerCase()
						});
					}
				});
			});

			// Make functions global so onclick handlers can access them
			window.handleSearch = function(query) {
				const resultsContainer = document.getElementById('search-results');
				const clearBtn = document.getElementById('clear-search');
				
				if (!query.trim()) {
					resultsContainer.classList.add('hidden');
					clearBtn.classList.add('hidden');
					return;
				}

				clearBtn.classList.remove('hidden');
				const searchTerms = query.toLowerCase().split(' ').filter(t => t);
				
				const matches = searchIndex.filter(tool => {
					return searchTerms.every(term => tool.searchTerms.includes(term));
				}).slice(0, 8);

				if (matches.length === 0) {
					resultsContainer.innerHTML = `
						<div class="px-4 py-6 text-center text-slate-500 dark:text-slate-400">
							<svg class="w-12 h-12 mx-auto mb-2 text-slate-300 dark:text-slate-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
							</svg>
							<p class="font-medium">No tools found</p>
							<p class="text-sm">Try different keywords</p>
						</div>
					`;
				} else {
					resultsContainer.innerHTML = matches.map(tool => `
						<a href="${tool.url}" class="flex items-center gap-3 px-4 py-3 hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors border-b border-slate-100 dark:border-slate-700 last:border-0">
							<span class="text-xl">${tool.icon}</span>
							<div class="flex-1 min-w-0">
								<div class="font-medium text-slate-800 dark:text-slate-100 truncate">${tool.name}</div>
								<div class="text-xs text-slate-500 dark:text-slate-400">${tool.category}</div>
							</div>
							<svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
							</svg>
						</a>
					`).join('');
				}

				resultsContainer.classList.remove('hidden');
			};

			window.clearSearch = function() {
				const input = document.getElementById('search-input');
				const resultsContainer = document.getElementById('search-results');
				const clearBtn = document.getElementById('clear-search');
				
				input.value = '';
				resultsContainer.classList.add('hidden');
				clearBtn.classList.add('hidden');
				input.focus();
			};

			// Popular tools toggle
			let popularExpanded = false;
			window.togglePopularTools = function() {
				const hidden = document.getElementById('popular-tools-hidden');
				const text = document.getElementById('popular-toggle-text');
				const icon = document.getElementById('popular-toggle-icon');
				
				popularExpanded = !popularExpanded;
				hidden.classList.toggle('hidden');
				icon.style.transform = popularExpanded ? 'rotate(180deg)' : '';
				text.textContent = popularExpanded ? 'Show less' : `Show ${allLiveTools.length - 18} more tools`;
			};

			// Cluster tools toggle
			const clusterStates = {};
			window.toggleClusterTools = function(clusterId) {
				const moreContainer = document.getElementById(`cluster-${clusterId}-more`);
				const btn = document.getElementById(`cluster-${clusterId}-btn`);
				if (!moreContainer || !btn) return;

				clusterStates[clusterId] = !clusterStates[clusterId];
				const isExpanded = clusterStates[clusterId];
				
				moreContainer.classList.toggle('hidden');
				const btnText = btn.querySelector('.btn-text');
				const btnIcon = btn.querySelector('.btn-icon');
				
				if (btnText) {
					const cluster = toolClusters.find(c => c.id === clusterId);
					btnText.textContent = isExpanded ? 'Show less' : `Show ${cluster.tools.length - 6} more`;
				}
				if (btnIcon) {
					btnIcon.style.transform = isExpanded ? 'rotate(180deg)' : '';
				}
			};

			// Close search results when clicking outside
			document.addEventListener('click', (e) => {
				const searchInput = document.getElementById('search-input');
				const searchResults = document.getElementById('search-results');
				if (searchInput && searchResults && !searchInput.contains(e.target) && !searchResults.contains(e.target)) {
					searchResults.classList.add('hidden');
				}
			});

			// Keyboard navigation for search
			document.getElementById('search-input')?.addEventListener('keydown', (e) => {
				if (e.key === 'Escape') {
					window.clearSearch();
				}
			});
		</script>
	</body>
</html>
