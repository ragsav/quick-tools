---
import JSONToolLayout from "../../layouts/JSONToolLayout.astro";

const faqItems = [
  { question: "What is JSONLines format?", answer: "JSONLines (JSONL/NDJSON) has one JSON object per line, separated by newlines." },
  { question: "What output is generated?", answer: "A standard JSON array containing all the parsed objects." },
  { question: "Are invalid lines handled?", answer: "Invalid JSON lines are skipped with a warning message." },
];

const howItWorks = [
  { title: "Paste JSONLines", content: "Enter data with one JSON object per line." },
  { title: "Parse", content: "Each line is parsed as a separate JSON object." },
  { title: "Convert", content: "All objects are combined into a JSON array." },
  { title: "Copy", content: "Copy the JSON array output." },
];

const useCases = [
  { title: "Log Processing", description: "Convert log files to JSON array for analysis." },
  { title: "Data Import", description: "Convert streaming data to standard JSON." },
  { title: "API Response", description: "Transform NDJSON to regular JSON array." },
  { title: "Big Data", description: "Convert Spark/Hadoop output to JSON." },
];
---

<JSONToolLayout
  title="JSONLines to JSON Converter - NDJSON"
  description="Convert JSONLines (NDJSON) to JSON array online. Parse newline-delimited JSON."
  canonicalPath="/json/jsonlines-to-json"
  currentTool="JSONLines to JSON"
  faqItems={faqItems}
  howItWorks={howItWorks}
  useCases={useCases}
>
  <div class="tool-header">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">JSONLines to JSON Converter</h1>
    <p class="text-slate-500">Convert JSONLines (NDJSON) to JSON array</p>
  </div>

  <div class="bg-slate-50 border border-slate-200 rounded p-6 mb-8">
    <div class="mb-4">
      <label class="block font-medium text-slate-700 mb-1.5 text-sm">JSONLines Input (one JSON per line)</label>
      <div id="inputEditor" class="border border-slate-300 rounded" style="height: 220px;"></div>
    </div>

    <div class="flex flex-wrap gap-3 mb-4">
      <button id="convertBtn" class="btn-primary px-6 py-2 font-semibold text-white rounded">Convert to JSON</button>
      <button id="clearBtn" class="px-4 py-2 bg-white border border-slate-300 rounded text-sm hover:bg-slate-50">Clear</button>
      <button id="sampleBtn" class="px-4 py-2 bg-white border border-slate-300 rounded text-sm hover:bg-slate-50">Load Sample</button>
    </div>

    <div id="statusBox" class="mb-4 hidden">
      <div id="status" class="p-3 rounded text-sm"></div>
    </div>

    <div class="mb-4">
      <label class="block font-medium text-slate-700 mb-1.5 text-sm">JSON Output</label>
      <div id="outputEditor" class="border border-slate-300 rounded" style="height: 280px;"></div>
    </div>

    <button id="copyBtn" class="px-4 py-2 bg-white border border-slate-300 rounded text-sm hover:bg-slate-50">📋 Copy Output</button>
  </div>

  <script is:inline>
    const loadMonaco = () => {
      return new Promise((resolve) => {
        if (window.monaco) { resolve(window.monaco); return; }
        const script = document.createElement('script');
        script.src = 'https://cdn.jsdelivr.net/npm/monaco-editor@0.45.0/min/vs/loader.js';
        script.onload = () => {
          require.config({ paths: { vs: 'https://cdn.jsdelivr.net/npm/monaco-editor@0.45.0/min/vs' } });
          require(['vs/editor/editor.main'], () => resolve(window.monaco));
        };
        document.head.appendChild(script);
      });
    };

    let inputEditor, outputEditor;

    loadMonaco().then((monaco) => {
      const editorOptions = {
        theme: 'vs',
        minimap: { enabled: false },
        fontSize: 13,
        lineNumbers: 'on',
        scrollBeyondLastLine: false,
        automaticLayout: true,
        tabSize: 2,
      };

      inputEditor = monaco.editor.create(document.getElementById('inputEditor'), {
        ...editorOptions,
        value: '',
        language: 'json',
      });

      outputEditor = monaco.editor.create(document.getElementById('outputEditor'), {
        ...editorOptions,
        value: '',
        language: 'json',
        readOnly: true,
      });
    });

    function showStatus(msg, isError) {
      const box = document.getElementById('statusBox');
      const status = document.getElementById('status');
      status.innerText = msg;
      status.className = `p-3 rounded text-sm ${isError ? 'bg-red-50 text-red-700' : 'bg-green-50 text-green-700'}`;
      box.classList.remove('hidden');
    }

    document.getElementById('convertBtn').addEventListener('click', () => {
      const input = inputEditor.getValue().trim();
      if (!input) {
        showStatus('❌ Please enter JSONLines data', true);
        return;
      }

      try {
        const lines = input.split('\n').filter(line => line.trim());
        const result = [];
        const errors = [];
        
        lines.forEach((line, idx) => {
          try {
            result.push(JSON.parse(line));
          } catch (e) {
            errors.push(idx + 1);
          }
        });
        
        if (result.length === 0) {
          throw new Error('No valid JSON objects found');
        }
        
        outputEditor.setValue(JSON.stringify(result, null, 2));
        
        if (errors.length > 0) {
          showStatus(`⚠️ Converted ${result.length} items (${errors.length} invalid lines skipped: ${errors.slice(0, 5).join(', ')}${errors.length > 5 ? '...' : ''})`, false);
        } else {
          showStatus(`✅ Converted ${result.length} items to JSON array`, false);
        }
      } catch (e) {
        showStatus('❌ Error: ' + e.message, true);
        outputEditor.setValue('');
      }
    });

    document.getElementById('clearBtn').addEventListener('click', () => {
      inputEditor.setValue('');
      outputEditor.setValue('');
      document.getElementById('statusBox').classList.add('hidden');
    });

    document.getElementById('sampleBtn').addEventListener('click', () => {
      inputEditor.setValue(`{"id": 1, "name": "John Doe", "email": "john@example.com"}
{"id": 2, "name": "Jane Smith", "email": "jane@example.com"}
{"id": 3, "name": "Bob Johnson", "email": "bob@example.com"}`);
    });

    document.getElementById('copyBtn').addEventListener('click', () => {
      const output = outputEditor.getValue();
      if (output) {
        navigator.clipboard.writeText(output);
        showStatus('✅ Copied to clipboard!', false);
      }
    });
  </script>
</JSONToolLayout>
