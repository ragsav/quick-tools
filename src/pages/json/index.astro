---
import { CONSTANT } from "../../constants";
import { Image } from "astro:assets";
import logo from "../../assets/favicon.svg";
import "../../styles/global.css";

const seo = {
  title: "JSON Tools - Free Online JSON Converters & Utilities",
  description: "Free online JSON tools. Convert CSV, Excel, XML, YAML to JSON and vice versa. Format, minify, and validate JSON data.",
  canonical: `${CONSTANT.CANONICAL_URL}/json/`,
};

const tools = [
  { name: "JSON Formatter", url: "/json/json-formatter", desc: "Format and beautify JSON with proper indentation" },
  { name: "JSON Minifier", url: "/json/json-minifier", desc: "Minify JSON by removing all whitespace" },
  { name: "JSON Validator", url: "/json/json-validator", desc: "Validate JSON syntax with detailed error messages" },
  { name: "CSV to JSON", url: "/json/csv-to-json", desc: "Convert CSV data to JSON array" },
  { name: "Excel to JSON", url: "/json/excel-to-json", desc: "Convert Excel spreadsheets to JSON" },
  { name: "HTML to JSON", url: "/json/html-to-json", desc: "Convert HTML tables to JSON" },
  { name: "SQL to JSON", url: "/json/sql-to-json", desc: "Convert SQL INSERT statements to JSON" },
  { name: "XML to JSON", url: "/json/xml-to-json", desc: "Convert XML data to JSON" },
  { name: "YAML to JSON", url: "/json/yaml-to-json", desc: "Convert YAML to JSON" },
  { name: "Markdown to JSON", url: "/json/markdown-to-json", desc: "Convert Markdown tables to JSON" },
  { name: "JSON to CSV", url: "/json/json-to-csv", desc: "Convert JSON array to CSV" },
  { name: "JSON to Excel", url: "/json/json-to-excel", desc: "Convert JSON to Excel spreadsheet" },
  { name: "JSON to XML", url: "/json/json-to-xml", desc: "Convert JSON data to XML" },
  { name: "JSON to YAML", url: "/json/json-to-yaml", desc: "Convert JSON to YAML" },
  { name: "JSON to SQL", url: "/json/json-to-sql", desc: "Generate SQL INSERT statements from JSON" },
  { name: "JSON to HTML Table", url: "/json/json-to-html", desc: "Convert JSON to HTML table" },
  { name: "JSON to Markdown", url: "/json/json-to-markdown", desc: "Convert JSON to Markdown table" },
  { name: "JSON to TypeScript", url: "/json/json-to-typescript", desc: "Generate TypeScript interfaces from JSON" },
  { name: "JSON to PHP Array", url: "/json/json-to-php", desc: "Convert JSON to PHP array syntax" },
  { name: "JSON to JSONLines", url: "/json/json-to-jsonlines", desc: "Convert JSON array to JSONLines format" },
  { name: "JSONLines to JSON", url: "/json/jsonlines-to-json", desc: "Convert JSONLines to JSON array" },
  { name: "JSON to Table", url: "/json/json-to-table", desc: "View JSON data in an interactive table" },
  { name: "Table to JSON", url: "/json/table-to-json", desc: "Create JSON from an interactive table editor" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={seo.canonical} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="robots" content="index, follow" />
    
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={seo.canonical} />
    
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>

  <body class="font-['Inter',system-ui,sans-serif] bg-slate-50 text-slate-800 min-h-screen leading-relaxed">
    <header class="bg-blue-900 text-white p-4">
      <div class="max-w-6xl mx-auto flex items-center justify-between flex-wrap gap-2">
        <a href="/" class="flex items-center gap-2 no-underline text-white font-bold text-xl">
          <Image src={logo} alt="Quick Tools Logo" class="w-8 h-8 lg:w-9 lg:h-9" />
          <span>Quick Tools</span>
        </a>
        <nav class="text-sm">
          <a href="/" class="text-slate-300 hover:text-white">Home</a>
          <span class="mx-2 text-slate-500">/</span>
          <span class="text-white">JSON Tools</span>
        </nav>
      </div>
    </header>

    <main class="max-w-6xl mx-auto p-4 py-8">
      <section class="mb-8">
        <div class="flex items-center gap-3 mb-4">
          <span class="text-4xl">📋</span>
          <div>
            <h1 class="text-3xl font-bold text-slate-900">JSON Tools</h1>
            <p class="text-slate-500">Convert, format, and transform JSON data</p>
          </div>
        </div>
      </section>

      <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {tools.map((tool) => (
          <a
            href={tool.url}
            class="block bg-white border border-slate-200 rounded p-4 hover:shadow-lg hover:-translate-y-0.5 transition-all no-underline"
          >
            <h2 class="text-lg font-semibold text-slate-900 mb-1">{tool.name}</h2>
            <p class="text-sm text-slate-500">{tool.desc}</p>
          </a>
        ))}
      </section>
    </main>

    <footer class="bg-slate-100 border-t border-slate-200 p-6 mt-12 text-center text-sm text-slate-500">
      <p>© {new Date().getFullYear()} Quick Tools. All tools are free and run in your browser.</p>
    </footer>
  </body>
</html>
