---
import JSONToolLayout from "../../layouts/JSONToolLayout.astro";

const faqItems = [
  { question: "What YAML features are supported?", answer: "Most YAML features including nested objects, arrays, and multiline strings." },
  { question: "Are YAML anchors supported?", answer: "Yes, the js-yaml library supports anchors, aliases, and most YAML 1.2 features." },
  { question: "Is my data processed securely?", answer: "Yes, all conversion happens in your browser. No data is sent to any server." },
];

const howItWorks = [
  { title: "Paste YAML", content: "Enter or paste your YAML data in the input editor." },
  { title: "Parse", content: "The js-yaml library parses the YAML structure." },
  { title: "Convert", content: "YAML data is converted to equivalent JSON." },
  { title: "Copy", content: "Copy the JSON output for use in your application." },
];

const useCases = [
  { title: "Config Conversion", description: "Convert YAML config files to JSON format." },
  { title: "Docker/K8s", description: "Transform Docker Compose or Kubernetes YAML to JSON." },
  { title: "CI/CD Pipelines", description: "Convert GitHub Actions or GitLab CI YAML to JSON." },
  { title: "API Testing", description: "Convert OpenAPI YAML specs to JSON." },
];
---

<JSONToolLayout
  title="YAML to JSON Converter - Convert YAML Online"
  description="Convert YAML data to JSON format online. Parse YAML with nested objects and arrays."
  canonicalPath="/json/yaml-to-json"
  currentTool="YAML to JSON"
  faqItems={faqItems}
  howItWorks={howItWorks}
  useCases={useCases}
>
  <div class="tool-header">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">YAML to JSON Converter</h1>
    <p class="text-slate-500">Convert YAML data to JSON format</p>
  </div>

  <div class="bg-slate-50 border border-slate-200 rounded p-6 mb-8">
    <div class="mb-4">
      <label class="block font-medium text-slate-700 mb-1.5 text-sm">YAML Input</label>
      <div id="inputEditor" class="border border-slate-300 rounded" style="height: 220px;"></div>
    </div>

    <div class="flex flex-wrap gap-3 mb-4">
      <button id="convertBtn" class="btn-primary px-6 py-2 font-semibold text-white rounded">Convert to JSON</button>
      <button id="clearBtn" class="px-4 py-2 bg-white border border-slate-300 rounded text-sm hover:bg-slate-50">Clear</button>
      <button id="sampleBtn" class="px-4 py-2 bg-white border border-slate-300 rounded text-sm hover:bg-slate-50">Load Sample</button>
    </div>

    <div id="statusBox" class="mb-4 hidden">
      <div id="status" class="p-3 rounded text-sm"></div>
    </div>

    <div class="mb-4">
      <label class="block font-medium text-slate-700 mb-1.5 text-sm">JSON Output</label>
      <div id="outputEditor" class="border border-slate-300 rounded" style="height: 280px;"></div>
    </div>

    <button id="copyBtn" class="px-4 py-2 bg-white border border-slate-300 rounded text-sm hover:bg-slate-50">📋 Copy Output</button>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/js-yaml@4.1.0/dist/js-yaml.min.js"></script>
  <script is:inline>
    const loadMonaco = () => {
      return new Promise((resolve) => {
        if (window.monaco) { resolve(window.monaco); return; }
        const script = document.createElement('script');
        script.src = 'https://cdn.jsdelivr.net/npm/monaco-editor@0.45.0/min/vs/loader.js';
        script.onload = () => {
          require.config({ paths: { vs: 'https://cdn.jsdelivr.net/npm/monaco-editor@0.45.0/min/vs' } });
          require(['vs/editor/editor.main'], () => resolve(window.monaco));
        };
        document.head.appendChild(script);
      });
    };

    let inputEditor, outputEditor;

    loadMonaco().then((monaco) => {
      const editorOptions = {
        theme: 'vs',
        minimap: { enabled: false },
        fontSize: 13,
        lineNumbers: 'on',
        scrollBeyondLastLine: false,
        automaticLayout: true,
        tabSize: 2,
      };

      inputEditor = monaco.editor.create(document.getElementById('inputEditor'), {
        ...editorOptions,
        value: '',
        language: 'yaml',
      });

      outputEditor = monaco.editor.create(document.getElementById('outputEditor'), {
        ...editorOptions,
        value: '',
        language: 'json',
        readOnly: true,
      });
    });

    function showStatus(msg, isError) {
      const box = document.getElementById('statusBox');
      const status = document.getElementById('status');
      status.innerText = msg;
      status.className = `p-3 rounded text-sm ${isError ? 'bg-red-50 text-red-700' : 'bg-green-50 text-green-700'}`;
      box.classList.remove('hidden');
    }

    document.getElementById('convertBtn').addEventListener('click', () => {
      const input = inputEditor.getValue().trim();
      if (!input) {
        showStatus('❌ Please enter YAML data', true);
        return;
      }

      try {
        const result = jsyaml.load(input);
        outputEditor.setValue(JSON.stringify(result, null, 2));
        showStatus('✅ Converted successfully', false);
      } catch (e) {
        showStatus('❌ Error: ' + e.message, true);
        outputEditor.setValue('');
      }
    });

    document.getElementById('clearBtn').addEventListener('click', () => {
      inputEditor.setValue('');
      outputEditor.setValue('');
      document.getElementById('statusBox').classList.add('hidden');
    });

    document.getElementById('sampleBtn').addEventListener('click', () => {
      inputEditor.setValue(`# Sample YAML configuration
name: My Application
version: 1.0.0
database:
  host: localhost
  port: 5432
  name: mydb
features:
  - authentication
  - logging
  - caching
settings:
  debug: true
  maxConnections: 100
  timeout: 30s`);
    });

    document.getElementById('copyBtn').addEventListener('click', () => {
      const output = outputEditor.getValue();
      if (output) {
        navigator.clipboard.writeText(output);
        showStatus('✅ Copied to clipboard!', false);
      }
    });
  </script>
</JSONToolLayout>
