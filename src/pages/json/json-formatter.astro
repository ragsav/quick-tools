---
import JSONToolLayout from "../../layouts/JSONToolLayout.astro";

const faqItems = [
  { question: "What can I do with this tool?", answer: "Format (beautify) JSON for readability with proper indentation and syntax highlighting." },
  { question: "What happens if my JSON is invalid?", answer: "The editor will show red squiggles under errors and the status will show what's wrong." },
  { question: "Is this tool free?", answer: "Yes, completely free and works directly in your browser with no data sent to any server." },
];

const howItWorks = [
  { title: "Paste JSON", content: "Enter or paste your JSON data in the input editor." },
  { title: "Auto-validation", content: "Monaco Editor validates JSON in real-time and highlights errors." },
  { title: "Format", content: "Click Format to beautify with proper indentation (2 spaces)." },
  { title: "Copy Output", content: "Copy the formatted JSON for use elsewhere." },
];

const useCases = [
  { title: "API Debugging", description: "Format minified API responses for easier reading and debugging." },
  { title: "Config Files", description: "Beautify package.json, tsconfig.json, and other config files." },
  { title: "Log Analysis", description: "Format JSON log entries for debugging and analysis." },
  { title: "Documentation", description: "Format JSON examples for documentation with consistent styling." },
];
---

<JSONToolLayout
  title="JSON Formatter - Beautify JSON Online"
  description="Format and beautify JSON data with syntax highlighting. Free online JSON formatter with Monaco Editor."
  canonicalPath="/json/json-formatter"
  currentTool="JSON Formatter"
  faqItems={faqItems}
  howItWorks={howItWorks}
  useCases={useCases}
>
  <div class="tool-header">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">JSON Formatter</h1>
    <p class="text-slate-500">Format and beautify JSON with syntax highlighting</p>
  </div>

  <div class="bg-slate-50 border border-slate-200 rounded p-6 mb-8">
    <div class="mb-4">
      <label class="block font-medium text-slate-700 mb-1.5 text-sm">Input JSON</label>
      <div id="inputEditor" class="border border-slate-300 rounded" style="height: 250px;"></div>
    </div>

    <div class="flex flex-wrap gap-3 mb-4">
      <button id="formatBtn" class="btn-primary px-6 py-2 font-semibold text-white rounded">Format / Beautify</button>
      <button id="clearBtn" class="px-4 py-2 bg-white border border-slate-300 rounded text-sm hover:bg-slate-50">Clear</button>
    </div>

    <div id="statusBox" class="mb-4 hidden">
      <div id="status" class="p-3 rounded text-sm"></div>
    </div>

    <div class="mb-4">
      <label class="block font-medium text-slate-700 mb-1.5 text-sm">Output</label>
      <div id="outputEditor" class="border border-slate-300 rounded" style="height: 300px;"></div>
    </div>

    <button id="copyBtn" class="px-4 py-2 bg-white border border-slate-300 rounded text-sm hover:bg-slate-50">📋 Copy Output</button>
  </div>

  <script is:inline>
    // Monaco Editor loader
    const loadMonaco = () => {
      return new Promise((resolve) => {
        if (window.monaco) {
          resolve(window.monaco);
          return;
        }
        const script = document.createElement('script');
        script.src = 'https://cdn.jsdelivr.net/npm/monaco-editor@0.45.0/min/vs/loader.js';
        script.onload = () => {
          require.config({ paths: { vs: 'https://cdn.jsdelivr.net/npm/monaco-editor@0.45.0/min/vs' } });
          require(['vs/editor/editor.main'], () => resolve(window.monaco));
        };
        document.head.appendChild(script);
      });
    };

    let inputEditor, outputEditor;

    loadMonaco().then((monaco) => {
      const editorOptions = {
        theme: 'vs',
        minimap: { enabled: false },
        fontSize: 13,
        lineNumbers: 'on',
        scrollBeyondLastLine: false,
        automaticLayout: true,
        tabSize: 2,
      };

      inputEditor = monaco.editor.create(document.getElementById('inputEditor'), {
        ...editorOptions,
        value: '{"name":"John","age":30,"city":"New York"}',
        language: 'json',
      });

      outputEditor = monaco.editor.create(document.getElementById('outputEditor'), {
        ...editorOptions,
        value: '',
        language: 'json',
        readOnly: true,
      });
    });

    function showStatus(msg, isError) {
      const box = document.getElementById('statusBox');
      const status = document.getElementById('status');
      status.innerText = msg;
      status.className = `p-3 rounded text-sm ${isError ? 'bg-red-50 text-red-700' : 'bg-green-50 text-green-700'}`;
      box.classList.remove('hidden');
    }

    document.getElementById('formatBtn').addEventListener('click', () => {
      try {
        const input = inputEditor.getValue();
        const parsed = JSON.parse(input);
        const formatted = JSON.stringify(parsed, null, 2);
        outputEditor.setValue(formatted);
        showStatus('✅ Valid JSON - Formatted successfully', false);
      } catch (e) {
        showStatus('❌ Invalid JSON: ' + e.message, true);
        outputEditor.setValue('');
      }
    });

    document.getElementById('clearBtn').addEventListener('click', () => {
      inputEditor.setValue('');
      outputEditor.setValue('');
      document.getElementById('statusBox').classList.add('hidden');
    });

    document.getElementById('copyBtn').addEventListener('click', () => {
      const output = outputEditor.getValue();
      if (output) {
        navigator.clipboard.writeText(output);
        showStatus('✅ Copied to clipboard!', false);
      }
    });
  </script>
</JSONToolLayout>
