---
import JSONToolLayout from "../../layouts/JSONToolLayout.astro";

const faqItems = [
  { question: "What XML structure is generated?", answer: "Each JSON object becomes an XML element with child elements for properties." },
  { question: "How are arrays handled?", answer: "Array items become repeated elements with the property name as the tag." },
  { question: "Is the output well-formed XML?", answer: "Yes, the output includes XML declaration and proper encoding." },
];

const howItWorks = [
  { title: "Paste JSON", content: "Enter or paste your JSON data in the input editor." },
  { title: "Configure", content: "Set the root element name for your XML." },
  { title: "Convert", content: "Click Convert to transform JSON to XML." },
  { title: "Copy/Download", content: "Copy or download the XML output." },
];

const useCases = [
  { title: "API Integration", description: "Convert JSON responses for XML-based systems." },
  { title: "Data Exchange", description: "Transform JSON data for SOAP services." },
  { title: "Config Generation", description: "Generate XML config from JSON definitions." },
  { title: "Legacy Systems", description: "Prepare JSON data for XML-only systems." },
];
---

<JSONToolLayout
  title="JSON to XML Converter - Convert JSON Online"
  description="Convert JSON data to XML format online. Generate well-formed XML from JSON objects and arrays."
  canonicalPath="/json/json-to-xml"
  currentTool="JSON to XML"
  faqItems={faqItems}
  howItWorks={howItWorks}
  useCases={useCases}
>
  <div class="tool-header">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">JSON to XML Converter</h1>
    <p class="text-slate-500">Convert JSON data to XML format</p>
  </div>

  <div class="bg-slate-50 border border-slate-200 rounded p-6 mb-8">
    <div class="mb-4">
      <label class="block font-medium text-slate-700 mb-1.5 text-sm">JSON Input</label>
      <div id="inputEditor" class="border border-slate-300 rounded" style="height: 220px;"></div>
    </div>

    <div class="mb-4">
      <label class="block text-sm text-slate-600 mb-1">Root Element Name</label>
      <input type="text" id="rootName" value="root" class="px-3 py-2 border border-slate-300 rounded bg-white text-sm w-48" />
    </div>

    <div class="flex flex-wrap gap-3 mb-4">
      <button id="convertBtn" class="btn-primary px-6 py-2 font-semibold text-white rounded">Convert to XML</button>
      <button id="clearBtn" class="px-4 py-2 bg-white border border-slate-300 rounded text-sm hover:bg-slate-50">Clear</button>
      <button id="sampleBtn" class="px-4 py-2 bg-white border border-slate-300 rounded text-sm hover:bg-slate-50">Load Sample</button>
    </div>

    <div id="statusBox" class="mb-4 hidden">
      <div id="status" class="p-3 rounded text-sm"></div>
    </div>

    <div class="mb-4">
      <label class="block font-medium text-slate-700 mb-1.5 text-sm">XML Output</label>
      <div id="outputEditor" class="border border-slate-300 rounded" style="height: 280px;"></div>
    </div>

    <button id="copyBtn" class="px-4 py-2 bg-white border border-slate-300 rounded text-sm hover:bg-slate-50">📋 Copy Output</button>
  </div>

  <script is:inline>
    const loadMonaco = () => {
      return new Promise((resolve) => {
        if (window.monaco) { resolve(window.monaco); return; }
        const script = document.createElement('script');
        script.src = 'https://cdn.jsdelivr.net/npm/monaco-editor@0.45.0/min/vs/loader.js';
        script.onload = () => {
          require.config({ paths: { vs: 'https://cdn.jsdelivr.net/npm/monaco-editor@0.45.0/min/vs' } });
          require(['vs/editor/editor.main'], () => resolve(window.monaco));
        };
        document.head.appendChild(script);
      });
    };

    let inputEditor, outputEditor;

    loadMonaco().then((monaco) => {
      const editorOptions = {
        theme: 'vs',
        minimap: { enabled: false },
        fontSize: 13,
        lineNumbers: 'on',
        scrollBeyondLastLine: false,
        automaticLayout: true,
        tabSize: 2,
      };

      inputEditor = monaco.editor.create(document.getElementById('inputEditor'), {
        ...editorOptions,
        value: '',
        language: 'json',
      });

      outputEditor = monaco.editor.create(document.getElementById('outputEditor'), {
        ...editorOptions,
        value: '',
        language: 'xml',
        readOnly: true,
      });
    });

    function showStatus(msg, isError) {
      const box = document.getElementById('statusBox');
      const status = document.getElementById('status');
      status.innerText = msg;
      status.className = `p-3 rounded text-sm ${isError ? 'bg-red-50 text-red-700' : 'bg-green-50 text-green-700'}`;
      box.classList.remove('hidden');
    }

    function escapeXml(str) {
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&apos;');
    }

    function jsonToXml(obj, tagName, indent = '') {
      let xml = '';
      
      if (Array.isArray(obj)) {
        obj.forEach(item => {
          xml += jsonToXml(item, tagName, indent);
        });
      } else if (typeof obj === 'object' && obj !== null) {
        xml += `${indent}<${tagName}>\n`;
        for (const [key, value] of Object.entries(obj)) {
          const safeKey = key.replace(/[^a-zA-Z0-9_-]/g, '_');
          xml += jsonToXml(value, safeKey, indent + '  ');
        }
        xml += `${indent}</${tagName}>\n`;
      } else if (obj === null) {
        xml += `${indent}<${tagName}/>\n`;
      } else {
        xml += `${indent}<${tagName}>${escapeXml(obj)}</${tagName}>\n`;
      }
      
      return xml;
    }

    document.getElementById('convertBtn').addEventListener('click', () => {
      const input = inputEditor.getValue().trim();
      if (!input) {
        showStatus('❌ Please enter JSON data', true);
        return;
      }

      try {
        const data = JSON.parse(input);
        const rootName = document.getElementById('rootName').value.trim() || 'root';
        const safeRootName = rootName.replace(/[^a-zA-Z0-9_-]/g, '_');
        
        let xml = '<?xml version="1.0" encoding="UTF-8"?>\n';
        xml += jsonToXml(data, safeRootName);
        
        outputEditor.setValue(xml);
        showStatus('✅ Converted successfully', false);
      } catch (e) {
        showStatus('❌ Error: ' + e.message, true);
        outputEditor.setValue('');
      }
    });

    document.getElementById('clearBtn').addEventListener('click', () => {
      inputEditor.setValue('');
      outputEditor.setValue('');
      document.getElementById('statusBox').classList.add('hidden');
    });

    document.getElementById('sampleBtn').addEventListener('click', () => {
      inputEditor.setValue(`{
  "users": [
    {"name": "John Doe", "age": 30, "city": "New York"},
    {"name": "Jane Smith", "age": 25, "city": "Los Angeles"}
  ],
  "metadata": {
    "total": 2,
    "generated": "2024-01-01"
  }
}`);
      document.getElementById('rootName').value = 'data';
    });

    document.getElementById('copyBtn').addEventListener('click', () => {
      const output = outputEditor.getValue();
      if (output) {
        navigator.clipboard.writeText(output);
        showStatus('✅ Copied to clipboard!', false);
      }
    });
  </script>
</JSONToolLayout>
