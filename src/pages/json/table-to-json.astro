---
import JSONToolLayout from "../../layouts/JSONToolLayout.astro";

const faqItems = [
  { question: "What file formats are supported?", answer: "Excel (.xlsx, .xls) and CSV files. You can also paste tab-separated or comma-separated data." },
  { question: "How are headers detected?", answer: "The first row is used as column names (keys) in the JSON output." },
  { question: "Is my file uploaded to a server?", answer: "No, all processing happens in your browser. Your data never leaves your device." },
];

const howItWorks = [
  { title: "Upload or Paste", content: "Upload an Excel/CSV file or paste table data directly." },
  { title: "Preview", content: "See the parsed table data before conversion." },
  { title: "Convert", content: "Click Convert to transform the table to JSON." },
  { title: "Copy/Download", content: "Copy the JSON or download as a file." },
];

const useCases = [
  { title: "Data Migration", description: "Convert spreadsheet data to JSON for APIs or databases." },
  { title: "Configuration", description: "Convert Excel configs to JSON format." },
  { title: "Quick Convert", description: "Paste any table data and get JSON instantly." },
  { title: "Data Processing", description: "Transform tabular data for JavaScript applications." },
];
---

<JSONToolLayout
  title="Table to JSON Converter - Excel & CSV to JSON"
  description="Convert Excel spreadsheets, CSV files, or pasted table data to JSON. Upload files or paste directly."
  canonicalPath="/json/table-to-json"
  currentTool="Table to JSON"
  faqItems={faqItems}
  howItWorks={howItWorks}
  useCases={useCases}
>
  <div class="tool-header">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">Table to JSON Converter</h1>
    <p class="text-slate-500">Convert Excel, CSV, or pasted table data to JSON</p>
  </div>

  <div class="bg-slate-50 border border-slate-200 rounded p-6 mb-8">
    <!-- Input Method Tabs -->
    <div class="flex border-b border-slate-200 mb-4">
      <button id="tabUpload" class="px-4 py-2 text-sm font-medium border-b-2 border-blue-600 text-blue-600">📁 Upload File</button>
      <button id="tabPaste" class="px-4 py-2 text-sm font-medium border-b-2 border-transparent text-slate-500 hover:text-slate-700">📋 Paste Data</button>
    </div>

    <!-- Upload Section -->
    <div id="uploadSection" class="mb-4">
      <label class="block font-medium text-slate-700 mb-1.5 text-sm">Upload Excel or CSV File</label>
      <input type="file" id="fileInput" accept=".xlsx,.xls,.csv" class="block w-full text-sm text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100" />
    </div>

    <!-- Paste Section -->
    <div id="pasteSection" class="mb-4 hidden">
      <label class="block font-medium text-slate-700 mb-1.5 text-sm">Paste Table Data (CSV, TSV, or Excel copy)</label>
      <textarea id="pasteInput" rows="8" placeholder="Paste your table data here...&#10;&#10;Example:&#10;name,age,city&#10;John,30,New York&#10;Jane,25,Los Angeles" class="w-full px-4 py-3 text-sm border border-slate-300 rounded bg-white text-slate-800 outline-none font-mono resize-y"></textarea>
      <div class="flex gap-4 mt-2">
        <label class="flex items-center gap-2 text-sm text-slate-600">
          <input type="radio" name="delimiter" value="auto" checked class="w-4 h-4" /> Auto-detect
        </label>
        <label class="flex items-center gap-2 text-sm text-slate-600">
          <input type="radio" name="delimiter" value="," class="w-4 h-4" /> Comma
        </label>
        <label class="flex items-center gap-2 text-sm text-slate-600">
          <input type="radio" name="delimiter" value="\t" class="w-4 h-4" /> Tab
        </label>
        <label class="flex items-center gap-2 text-sm text-slate-600">
          <input type="radio" name="delimiter" value=";" class="w-4 h-4" /> Semicolon
        </label>
      </div>
    </div>

    <div class="flex items-center gap-2 mb-4">
      <input type="checkbox" id="hasHeader" checked class="w-4 h-4" />
      <label for="hasHeader" class="text-sm text-slate-600">First row is header</label>
    </div>

    <div class="flex flex-wrap gap-3 mb-4">
      <button id="convertBtn" class="btn-primary px-6 py-2 font-semibold text-white rounded">Convert to JSON</button>
      <button id="clearBtn" class="px-4 py-2 bg-white border border-slate-300 rounded text-sm hover:bg-slate-50">Clear</button>
    </div>

    <div id="statusBox" class="mb-4 hidden">
      <div id="status" class="p-3 rounded text-sm"></div>
    </div>

    <!-- Preview Table -->
    <div id="previewContainer" class="mb-4 hidden">
      <div class="flex justify-between items-center mb-1.5">
        <label class="block font-medium text-slate-700 text-sm">Preview</label>
        <span id="previewInfo" class="text-xs text-slate-500"></span>
      </div>
      <div class="overflow-x-auto border border-slate-300 rounded bg-white max-h-48 overflow-y-auto">
        <table id="previewTable" class="min-w-full text-sm"></table>
      </div>
    </div>

    <div class="mb-4">
      <label class="block font-medium text-slate-700 mb-1.5 text-sm">JSON Output</label>
      <div id="outputEditor" class="border border-slate-300 rounded" style="height: 280px;"></div>
    </div>

    <div class="flex gap-3">
      <button id="copyBtn" class="px-4 py-2 bg-white border border-slate-300 rounded text-sm hover:bg-slate-50">📋 Copy</button>
      <button id="downloadBtn" class="px-4 py-2 bg-white border border-slate-300 rounded text-sm hover:bg-slate-50">⬇️ Download JSON</button>
    </div>
  </div>

  <style>
    #previewTable th, #previewTable td {
      padding: 6px 10px;
      border-bottom: 1px solid #e2e8f0;
      text-align: left;
      white-space: nowrap;
    }
    #previewTable th {
      background: #f1f5f9;
      font-weight: 600;
    }
    #previewTable tr:hover {
      background: #f8fafc;
    }
  </style>

  <script src="https://cdn.sheetjs.com/xlsx-0.20.1/package/dist/xlsx.full.min.js"></script>
  <script is:inline>
    const loadMonaco = () => {
      return new Promise((resolve) => {
        if (window.monaco) { resolve(window.monaco); return; }
        const script = document.createElement('script');
        script.src = 'https://cdn.jsdelivr.net/npm/monaco-editor@0.45.0/min/vs/loader.js';
        script.onload = () => {
          require.config({ paths: { vs: 'https://cdn.jsdelivr.net/npm/monaco-editor@0.45.0/min/vs' } });
          require(['vs/editor/editor.main'], () => resolve(window.monaco));
        };
        document.head.appendChild(script);
      });
    };

    let outputEditor;
    let parsedData = null;
    let headers = [];

    loadMonaco().then((monaco) => {
      outputEditor = monaco.editor.create(document.getElementById('outputEditor'), {
        theme: 'vs',
        minimap: { enabled: false },
        fontSize: 13,
        lineNumbers: 'on',
        scrollBeyondLastLine: false,
        automaticLayout: true,
        tabSize: 2,
        value: '',
        language: 'json',
        readOnly: true,
      });
    });

    // Tab switching
    document.getElementById('tabUpload').addEventListener('click', () => {
      document.getElementById('tabUpload').classList.add('border-blue-600', 'text-blue-600');
      document.getElementById('tabUpload').classList.remove('border-transparent', 'text-slate-500');
      document.getElementById('tabPaste').classList.remove('border-blue-600', 'text-blue-600');
      document.getElementById('tabPaste').classList.add('border-transparent', 'text-slate-500');
      document.getElementById('uploadSection').classList.remove('hidden');
      document.getElementById('pasteSection').classList.add('hidden');
    });

    document.getElementById('tabPaste').addEventListener('click', () => {
      document.getElementById('tabPaste').classList.add('border-blue-600', 'text-blue-600');
      document.getElementById('tabPaste').classList.remove('border-transparent', 'text-slate-500');
      document.getElementById('tabUpload').classList.remove('border-blue-600', 'text-blue-600');
      document.getElementById('tabUpload').classList.add('border-transparent', 'text-slate-500');
      document.getElementById('pasteSection').classList.remove('hidden');
      document.getElementById('uploadSection').classList.add('hidden');
    });

    function showStatus(msg, isError) {
      const box = document.getElementById('statusBox');
      const status = document.getElementById('status');
      status.innerText = msg;
      status.className = `p-3 rounded text-sm ${isError ? 'bg-red-50 text-red-700' : 'bg-green-50 text-green-700'}`;
      box.classList.remove('hidden');
    }

    function escapeHtml(str) {
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function detectDelimiter(text) {
      const firstLine = text.split('\n')[0];
      const tabCount = (firstLine.match(/\t/g) || []).length;
      const commaCount = (firstLine.match(/,/g) || []).length;
      const semicolonCount = (firstLine.match(/;/g) || []).length;
      
      if (tabCount > commaCount && tabCount > semicolonCount) return '\t';
      if (semicolonCount > commaCount) return ';';
      return ',';
    }

    function parseCSV(text, delimiter) {
      const lines = text.trim().split('\n');
      const result = [];
      
      for (const line of lines) {
        if (!line.trim()) continue;
        const row = [];
        let cell = '';
        let inQuotes = false;
        
        for (let i = 0; i < line.length; i++) {
          const char = line[i];
          if (char === '"') {
            if (inQuotes && line[i + 1] === '"') {
              cell += '"';
              i++;
            } else {
              inQuotes = !inQuotes;
            }
          } else if (char === delimiter && !inQuotes) {
            row.push(cell.trim());
            cell = '';
          } else {
            cell += char;
          }
        }
        row.push(cell.trim());
        result.push(row);
      }
      return result;
    }

    function showPreview(rows) {
      if (rows.length === 0) return;
      
      const previewRows = rows.slice(0, 6);
      let html = '<thead><tr>';
      previewRows[0].forEach((cell, i) => {
        html += `<th>${escapeHtml(cell || `Column ${i+1}`)}</th>`;
      });
      html += '</tr></thead><tbody>';
      
      for (let i = 1; i < previewRows.length; i++) {
        html += '<tr>';
        previewRows[i].forEach(cell => {
          html += `<td>${escapeHtml(cell)}</td>`;
        });
        html += '</tr>';
      }
      
      if (rows.length > 6) {
        html += `<tr><td colspan="${previewRows[0].length}" style="text-align:center;color:#64748b;">... and ${rows.length - 6} more rows</td></tr>`;
      }
      html += '</tbody>';
      
      document.getElementById('previewTable').innerHTML = html;
      document.getElementById('previewInfo').textContent = `${rows.length - 1} rows, ${rows[0].length} columns`;
      document.getElementById('previewContainer').classList.remove('hidden');
    }

    function convertToJSON(rows, hasHeader) {
      if (rows.length === 0) throw new Error('No data to convert');
      
      if (hasHeader && rows.length > 1) {
        headers = rows[0];
        return rows.slice(1).map(row => {
          const obj = {};
          headers.forEach((h, i) => {
            let val = row[i] !== undefined ? row[i] : '';
            // Try to parse numbers and booleans
            if (val !== '' && !isNaN(val)) val = Number(val);
            else if (val.toLowerCase() === 'true') val = true;
            else if (val.toLowerCase() === 'false') val = false;
            obj[h || `column${i+1}`] = val;
          });
          return obj;
        });
      } else {
        return rows;
      }
    }

    // File upload handler
    document.getElementById('fileInput').addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (!file) return;

      const isCSV = file.name.toLowerCase().endsWith('.csv');
      
      if (isCSV) {
        const reader = new FileReader();
        reader.onload = (evt) => {
          try {
            const text = evt.target.result;
            parsedData = parseCSV(text, detectDelimiter(text));
            showPreview(parsedData);
            showStatus(`✅ Loaded: ${file.name} (${parsedData.length - 1} rows)`, false);
          } catch (err) {
            showStatus('❌ Error reading file: ' + err.message, true);
          }
        };
        reader.readAsText(file);
      } else {
        const reader = new FileReader();
        reader.onload = (evt) => {
          try {
            const workbook = XLSX.read(evt.target.result, { type: 'binary' });
            const sheetName = workbook.SheetNames[0];
            const sheet = workbook.Sheets[sheetName];
            parsedData = XLSX.utils.sheet_to_json(sheet, { header: 1 });
            showPreview(parsedData);
            showStatus(`✅ Loaded: ${file.name} (${parsedData.length - 1} rows)`, false);
          } catch (err) {
            showStatus('❌ Error reading file: ' + err.message, true);
          }
        };
        reader.readAsBinaryString(file);
      }
    });

    document.getElementById('convertBtn').addEventListener('click', () => {
      const isPasteMode = !document.getElementById('pasteSection').classList.contains('hidden');
      
      if (isPasteMode) {
        const text = document.getElementById('pasteInput').value.trim();
        if (!text) {
          showStatus('❌ Please paste some data', true);
          return;
        }
        
        let delimiter = document.querySelector('input[name="delimiter"]:checked').value;
        if (delimiter === 'auto') {
          delimiter = detectDelimiter(text);
        } else if (delimiter === '\\t') {
          delimiter = '\t';
        }
        
        parsedData = parseCSV(text, delimiter);
        showPreview(parsedData);
      }
      
      if (!parsedData || parsedData.length === 0) {
        showStatus('❌ No data loaded. Upload a file or paste data.', true);
        return;
      }

      try {
        const hasHeader = document.getElementById('hasHeader').checked;
        const json = convertToJSON(parsedData, hasHeader);
        outputEditor.setValue(JSON.stringify(json, null, 2));
        showStatus(`✅ Converted ${json.length} records to JSON`, false);
      } catch (e) {
        showStatus('❌ Error: ' + e.message, true);
      }
    });

    document.getElementById('clearBtn').addEventListener('click', () => {
      document.getElementById('fileInput').value = '';
      document.getElementById('pasteInput').value = '';
      document.getElementById('previewContainer').classList.add('hidden');
      document.getElementById('statusBox').classList.add('hidden');
      outputEditor.setValue('');
      parsedData = null;
    });

    document.getElementById('copyBtn').addEventListener('click', () => {
      const output = outputEditor.getValue();
      if (output) {
        navigator.clipboard.writeText(output);
        showStatus('✅ Copied to clipboard!', false);
      }
    });

    document.getElementById('downloadBtn').addEventListener('click', () => {
      const output = outputEditor.getValue();
      if (output) {
        const blob = new Blob([output], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'data.json';
        a.click();
        URL.revokeObjectURL(url);
      }
    });
  </script>
</JSONToolLayout>
