---
import JSONToolLayout from "../../layouts/JSONToolLayout.astro";

const faqItems = [
  { question: "What table styles are available?", answer: "Plain HTML table, with Bootstrap classes, or with inline styles." },
  { question: "Are nested objects supported?", answer: "Nested objects are displayed as JSON strings in the table cells." },
  { question: "Can I customize the table?", answer: "Yes, you can add CSS classes and choose to include or exclude headers." },
];

const howItWorks = [
  { title: "Paste JSON", content: "Enter a JSON array of objects." },
  { title: "Configure", content: "Choose table style and header options." },
  { title: "Convert", content: "Click Convert to generate HTML table." },
  { title: "Copy", content: "Copy the HTML for use in your web page." },
];

const useCases = [
  { title: "Reports", description: "Generate HTML tables for web reports." },
  { title: "Documentation", description: "Create data tables for documentation." },
  { title: "Emails", description: "Generate HTML tables for email content." },
  { title: "Dashboards", description: "Display JSON data in admin dashboards." },
];
---

<JSONToolLayout
  title="JSON to HTML Table Converter - Generate Tables"
  description="Convert JSON array to HTML table online. Generate styled HTML tables from JSON data."
  canonicalPath="/json/json-to-html"
  currentTool="JSON to HTML Table"
  faqItems={faqItems}
  howItWorks={howItWorks}
  useCases={useCases}
>
  <div class="tool-header">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">JSON to HTML Table Converter</h1>
    <p class="text-slate-500">Generate HTML tables from JSON data</p>
  </div>

  <div class="bg-slate-50 border border-slate-200 rounded p-6 mb-8">
    <div class="mb-4">
      <label class="block font-medium text-slate-700 mb-1.5 text-sm">JSON Input (array of objects)</label>
      <div id="inputEditor" class="border border-slate-300 rounded" style="height: 180px;"></div>
    </div>

    <div class="flex flex-wrap gap-4 mb-4 items-center">
      <div>
        <label class="block text-sm text-slate-600 mb-1">Style</label>
        <select id="tableStyle" class="px-3 py-2 border border-slate-300 rounded bg-white text-sm">
          <option value="plain">Plain HTML</option>
          <option value="styled">With Inline Styles</option>
          <option value="bootstrap">Bootstrap Classes</option>
        </select>
      </div>
      <div class="flex items-center gap-2">
        <input type="checkbox" id="includeHeader" checked class="w-4 h-4" />
        <label for="includeHeader" class="text-sm text-slate-600">Include header row</label>
      </div>
    </div>

    <div class="flex flex-wrap gap-3 mb-4">
      <button id="convertBtn" class="btn-primary px-6 py-2 font-semibold text-white rounded">Convert to HTML</button>
      <button id="clearBtn" class="px-4 py-2 bg-white border border-slate-300 rounded text-sm hover:bg-slate-50">Clear</button>
      <button id="sampleBtn" class="px-4 py-2 bg-white border border-slate-300 rounded text-sm hover:bg-slate-50">Load Sample</button>
    </div>

    <div id="statusBox" class="mb-4 hidden">
      <div id="status" class="p-3 rounded text-sm"></div>
    </div>

    <div class="mb-4">
      <label class="block font-medium text-slate-700 mb-1.5 text-sm">HTML Output</label>
      <div id="outputEditor" class="border border-slate-300 rounded" style="height: 200px;"></div>
    </div>

    <div class="mb-4">
      <label class="block font-medium text-slate-700 mb-1.5 text-sm">Preview</label>
      <div id="preview" class="border border-slate-300 rounded bg-white p-4 overflow-x-auto"></div>
    </div>

    <button id="copyBtn" class="px-4 py-2 bg-white border border-slate-300 rounded text-sm hover:bg-slate-50">📋 Copy HTML</button>
  </div>

  <script is:inline>
    const loadMonaco = () => {
      return new Promise((resolve) => {
        if (window.monaco) { resolve(window.monaco); return; }
        const script = document.createElement('script');
        script.src = 'https://cdn.jsdelivr.net/npm/monaco-editor@0.45.0/min/vs/loader.js';
        script.onload = () => {
          require.config({ paths: { vs: 'https://cdn.jsdelivr.net/npm/monaco-editor@0.45.0/min/vs' } });
          require(['vs/editor/editor.main'], () => resolve(window.monaco));
        };
        document.head.appendChild(script);
      });
    };

    let inputEditor, outputEditor;

    loadMonaco().then((monaco) => {
      const editorOptions = {
        theme: 'vs',
        minimap: { enabled: false },
        fontSize: 13,
        lineNumbers: 'on',
        scrollBeyondLastLine: false,
        automaticLayout: true,
        tabSize: 2,
      };

      inputEditor = monaco.editor.create(document.getElementById('inputEditor'), {
        ...editorOptions,
        value: '',
        language: 'json',
      });

      outputEditor = monaco.editor.create(document.getElementById('outputEditor'), {
        ...editorOptions,
        value: '',
        language: 'html',
        readOnly: true,
      });
    });

    function showStatus(msg, isError) {
      const box = document.getElementById('statusBox');
      const status = document.getElementById('status');
      status.innerText = msg;
      status.className = `p-3 rounded text-sm ${isError ? 'bg-red-50 text-red-700' : 'bg-green-50 text-green-700'}`;
      box.classList.remove('hidden');
    }

    function escapeHtml(str) {
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function jsonToHtmlTable(data, style, includeHeader) {
      if (!Array.isArray(data) || data.length === 0) {
        throw new Error('Input must be a non-empty array of objects');
      }

      const keys = [...new Set(data.flatMap(obj => Object.keys(obj)))];
      let html = '';

      // Table styles
      const styles = {
        plain: { table: '', th: '', td: '' },
        styled: {
          table: ' style="border-collapse: collapse; width: 100%;"',
          th: ' style="border: 1px solid #ddd; padding: 8px; background-color: #f4f4f4; text-align: left;"',
          td: ' style="border: 1px solid #ddd; padding: 8px;"'
        },
        bootstrap: { table: ' class="table table-striped table-bordered"', th: '', td: '' }
      };

      const s = styles[style] || styles.plain;

      html += `<table${s.table}>\n`;

      if (includeHeader) {
        html += '  <thead>\n    <tr>\n';
        keys.forEach(k => html += `      <th${s.th}>${escapeHtml(k)}</th>\n`);
        html += '    </tr>\n  </thead>\n';
      }

      html += '  <tbody>\n';
      data.forEach(row => {
        html += '    <tr>\n';
        keys.forEach(k => {
          const val = row[k] !== undefined ? (typeof row[k] === 'object' ? JSON.stringify(row[k]) : row[k]) : '';
          html += `      <td${s.td}>${escapeHtml(val)}</td>\n`;
        });
        html += '    </tr>\n';
      });
      html += '  </tbody>\n</table>';

      return html;
    }

    document.getElementById('convertBtn').addEventListener('click', () => {
      const input = inputEditor.getValue().trim();
      if (!input) {
        showStatus('❌ Please enter JSON data', true);
        return;
      }

      try {
        const data = JSON.parse(input);
        const style = document.getElementById('tableStyle').value;
        const includeHeader = document.getElementById('includeHeader').checked;
        
        const html = jsonToHtmlTable(data, style, includeHeader);
        outputEditor.setValue(html);
        
        // Show preview with styled version
        const previewHtml = jsonToHtmlTable(data, 'styled', includeHeader);
        document.getElementById('preview').innerHTML = previewHtml;
        
        showStatus(`✅ Generated table with ${data.length} rows`, false);
      } catch (e) {
        showStatus('❌ Error: ' + e.message, true);
        outputEditor.setValue('');
        document.getElementById('preview').innerHTML = '';
      }
    });

    document.getElementById('clearBtn').addEventListener('click', () => {
      inputEditor.setValue('');
      outputEditor.setValue('');
      document.getElementById('preview').innerHTML = '';
      document.getElementById('statusBox').classList.add('hidden');
    });

    document.getElementById('sampleBtn').addEventListener('click', () => {
      inputEditor.setValue(`[
  {"name": "John Doe", "age": 30, "city": "New York"},
  {"name": "Jane Smith", "age": 25, "city": "Los Angeles"},
  {"name": "Bob Johnson", "age": 35, "city": "Chicago"}
]`);
    });

    document.getElementById('copyBtn').addEventListener('click', () => {
      const output = outputEditor.getValue();
      if (output) {
        navigator.clipboard.writeText(output);
        showStatus('✅ Copied to clipboard!', false);
      }
    });
  </script>
</JSONToolLayout>
