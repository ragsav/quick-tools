---
import JSONToolLayout from "../../layouts/JSONToolLayout.astro";

const faqItems = [
  { question: "What XML structure is supported?", answer: "Any well-formed XML is supported. Nested elements become nested objects." },
  { question: "How are attributes handled?", answer: "Attributes are converted to properties prefixed with '@' (e.g., @id)." },
  { question: "How is text content handled?", answer: "Text content is stored in a '#text' property when mixed with elements." },
];

const howItWorks = [
  { title: "Paste XML", content: "Enter or paste your XML data in the input editor." },
  { title: "Parse", content: "The tool parses the XML structure using the browser's DOM parser." },
  { title: "Convert", content: "Elements become objects, attributes become properties." },
  { title: "Copy", content: "Copy the JSON output for use in your application." },
];

const useCases = [
  { title: "API Integration", description: "Convert XML API responses to JSON for modern apps." },
  { title: "Config Migration", description: "Transform XML config files to JSON format." },
  { title: "Data Processing", description: "Parse XML data for JavaScript manipulation." },
  { title: "Legacy Systems", description: "Bridge XML-based systems with JSON APIs." },
];
---

<JSONToolLayout
  title="XML to JSON Converter - Convert XML Online"
  description="Convert XML data to JSON format online. Parse XML elements and attributes to JSON objects."
  canonicalPath="/json/xml-to-json"
  currentTool="XML to JSON"
  faqItems={faqItems}
  howItWorks={howItWorks}
  useCases={useCases}
>
  <div class="tool-header">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">XML to JSON Converter</h1>
    <p class="text-slate-500">Convert XML data to JSON format</p>
  </div>

  <div class="bg-slate-50 border border-slate-200 rounded p-6 mb-8">
    <div class="mb-4">
      <label class="block font-medium text-slate-700 mb-1.5 text-sm">XML Input</label>
      <div id="inputEditor" class="border border-slate-300 rounded" style="height: 220px;"></div>
    </div>

    <div class="flex flex-wrap gap-3 mb-4">
      <button id="convertBtn" class="btn-primary px-6 py-2 font-semibold text-white rounded">Convert to JSON</button>
      <button id="clearBtn" class="px-4 py-2 bg-white border border-slate-300 rounded text-sm hover:bg-slate-50">Clear</button>
      <button id="sampleBtn" class="px-4 py-2 bg-white border border-slate-300 rounded text-sm hover:bg-slate-50">Load Sample</button>
    </div>

    <div id="statusBox" class="mb-4 hidden">
      <div id="status" class="p-3 rounded text-sm"></div>
    </div>

    <div class="mb-4">
      <label class="block font-medium text-slate-700 mb-1.5 text-sm">JSON Output</label>
      <div id="outputEditor" class="border border-slate-300 rounded" style="height: 280px;"></div>
    </div>

    <button id="copyBtn" class="px-4 py-2 bg-white border border-slate-300 rounded text-sm hover:bg-slate-50">📋 Copy Output</button>
  </div>

  <script is:inline>
    const loadMonaco = () => {
      return new Promise((resolve) => {
        if (window.monaco) { resolve(window.monaco); return; }
        const script = document.createElement('script');
        script.src = 'https://cdn.jsdelivr.net/npm/monaco-editor@0.45.0/min/vs/loader.js';
        script.onload = () => {
          require.config({ paths: { vs: 'https://cdn.jsdelivr.net/npm/monaco-editor@0.45.0/min/vs' } });
          require(['vs/editor/editor.main'], () => resolve(window.monaco));
        };
        document.head.appendChild(script);
      });
    };

    let inputEditor, outputEditor;

    loadMonaco().then((monaco) => {
      const editorOptions = {
        theme: 'vs',
        minimap: { enabled: false },
        fontSize: 13,
        lineNumbers: 'on',
        scrollBeyondLastLine: false,
        automaticLayout: true,
        tabSize: 2,
      };

      inputEditor = monaco.editor.create(document.getElementById('inputEditor'), {
        ...editorOptions,
        value: '',
        language: 'xml',
      });

      outputEditor = monaco.editor.create(document.getElementById('outputEditor'), {
        ...editorOptions,
        value: '',
        language: 'json',
        readOnly: true,
      });
    });

    function showStatus(msg, isError) {
      const box = document.getElementById('statusBox');
      const status = document.getElementById('status');
      status.innerText = msg;
      status.className = `p-3 rounded text-sm ${isError ? 'bg-red-50 text-red-700' : 'bg-green-50 text-green-700'}`;
      box.classList.remove('hidden');
    }

    function xmlToJson(xml) {
      const parser = new DOMParser();
      const doc = parser.parseFromString(xml, 'text/xml');
      
      const errorNode = doc.querySelector('parsererror');
      if (errorNode) {
        throw new Error('Invalid XML: ' + errorNode.textContent.split('\n')[0]);
      }

      function appendNodeValue(obj, key, value) {
        if (!obj[key]) {
          obj[key] = value;
          return;
        }
        if (!Array.isArray(obj[key])) {
          obj[key] = [obj[key]];
        }
        obj[key].push(value);
      }

      function parseNode(node) {
        const obj = {};

        // Handle attributes
        if (node.attributes && node.attributes.length > 0) {
          for (const attr of node.attributes) {
            obj['@' + attr.name] = attr.value;
          }
        }

        // Handle child nodes
        const children = node.childNodes;
        let hasElements = false;
        let textContent = '';

        for (const child of children) {
          if (child.nodeType === Node.ELEMENT_NODE) {
            hasElements = true;
            const childName = child.nodeName;
            const childValue = parseNode(child);

            appendNodeValue(obj, childName, childValue);
          } else if (child.nodeType === Node.TEXT_NODE) {
            const text = child.textContent.trim();
            if (text) textContent += text;
          }
        }

        // Handle text content
        if (textContent) {
          if (hasElements || Object.keys(obj).length > 0) {
            obj['#text'] = textContent;
          } else {
            // Simple element with just text
            const val = textContent;
            if (!isNaN(val) && val !== '') return Number(val);
            if (val === 'true') return true;
            if (val === 'false') return false;
            return val;
          }
        }

        return Object.keys(obj).length === 0 ? null : obj;
      }

      const result = {};
      result[doc.documentElement.nodeName] = parseNode(doc.documentElement);
      return result;
    }

    document.getElementById('convertBtn').addEventListener('click', () => {
      const input = inputEditor.getValue().trim();
      if (!input) {
        showStatus('❌ Please enter XML data', true);
        return;
      }

      try {
        const result = xmlToJson(input);
        outputEditor.setValue(JSON.stringify(result, null, 2));
        showStatus('✅ Converted successfully', false);
      } catch (e) {
        showStatus('❌ Error: ' + e.message, true);
        outputEditor.setValue('');
      }
    });

    document.getElementById('clearBtn').addEventListener('click', () => {
      inputEditor.setValue('');
      outputEditor.setValue('');
      document.getElementById('statusBox').classList.add('hidden');
    });

    document.getElementById('sampleBtn').addEventListener('click', () => {
      inputEditor.setValue(`<?xml version="1.0" encoding="UTF-8"?>
<users>
  <user id="1">
    <name>John Doe</name>
    <age>30</age>
    <city>New York</city>
    <active>true</active>
  </user>
  <user id="2">
    <name>Jane Smith</name>
    <age>25</age>
    <city>Los Angeles</city>
    <active>true</active>
  </user>
</users>`);
    });

    document.getElementById('copyBtn').addEventListener('click', () => {
      const output = outputEditor.getValue();
      if (output) {
        navigator.clipboard.writeText(output);
        showStatus('✅ Copied to clipboard!', false);
      }
    });
  </script>
</JSONToolLayout>
