---
import JSONToolLayout from "../../layouts/JSONToolLayout.astro";

const faqItems = [
  { question: "What is JSONLines format?", answer: "JSONLines (JSONL/NDJSON) is a format where each line is a valid JSON object, separated by newlines." },
  { question: "Why use JSONLines?", answer: "It's ideal for streaming data, log files, and processing large datasets line by line." },
  { question: "What input is required?", answer: "A JSON array of objects. Each object becomes one line in the output." },
];

const howItWorks = [
  { title: "Paste JSON", content: "Enter a JSON array of objects." },
  { title: "Convert", content: "Click Convert to transform to JSONLines." },
  { title: "Output", content: "Each array item becomes a separate line." },
  { title: "Copy", content: "Copy the JSONLines output." },
];

const useCases = [
  { title: "Log Files", description: "Create log files with one JSON object per line." },
  { title: "Streaming", description: "Prepare data for streaming processing." },
  { title: "Big Data", description: "Convert for Hadoop, Spark, or similar tools." },
  { title: "APIs", description: "Generate streaming API response format." },
];
---

<JSONToolLayout
  title="JSON to JSONLines Converter - NDJSON"
  description="Convert JSON array to JSONLines (NDJSON) format online. One JSON object per line."
  canonicalPath="/json/json-to-jsonlines"
  currentTool="JSON to JSONLines"
  faqItems={faqItems}
  howItWorks={howItWorks}
  useCases={useCases}
>
  <div class="tool-header">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">JSON to JSONLines Converter</h1>
    <p class="text-slate-500">Convert JSON array to JSONLines (NDJSON) format</p>
  </div>

  <div class="bg-slate-50 border border-slate-200 rounded p-6 mb-8">
    <div class="mb-4">
      <label class="block font-medium text-slate-700 mb-1.5 text-sm">JSON Input (array)</label>
      <div id="inputEditor" class="border border-slate-300 rounded" style="height: 220px;"></div>
    </div>

    <div class="flex flex-wrap gap-3 mb-4">
      <button id="convertBtn" class="btn-primary px-6 py-2 font-semibold text-white rounded">Convert to JSONLines</button>
      <button id="clearBtn" class="px-4 py-2 bg-white border border-slate-300 rounded text-sm hover:bg-slate-50">Clear</button>
      <button id="sampleBtn" class="px-4 py-2 bg-white border border-slate-300 rounded text-sm hover:bg-slate-50">Load Sample</button>
    </div>

    <div id="statusBox" class="mb-4 hidden">
      <div id="status" class="p-3 rounded text-sm"></div>
    </div>

    <div class="mb-4">
      <label class="block font-medium text-slate-700 mb-1.5 text-sm">JSONLines Output</label>
      <div id="outputEditor" class="border border-slate-300 rounded" style="height: 250px;"></div>
    </div>

    <div class="flex gap-3">
      <button id="copyBtn" class="px-4 py-2 bg-white border border-slate-300 rounded text-sm hover:bg-slate-50">📋 Copy</button>
      <button id="downloadBtn" class="px-4 py-2 bg-white border border-slate-300 rounded text-sm hover:bg-slate-50">⬇️ Download .jsonl</button>
    </div>
  </div>

  <script is:inline>
    const loadMonaco = () => {
      return new Promise((resolve) => {
        if (window.monaco) { resolve(window.monaco); return; }
        const script = document.createElement('script');
        script.src = 'https://cdn.jsdelivr.net/npm/monaco-editor@0.45.0/min/vs/loader.js';
        script.onload = () => {
          require.config({ paths: { vs: 'https://cdn.jsdelivr.net/npm/monaco-editor@0.45.0/min/vs' } });
          require(['vs/editor/editor.main'], () => resolve(window.monaco));
        };
        document.head.appendChild(script);
      });
    };

    let inputEditor, outputEditor;

    loadMonaco().then((monaco) => {
      const editorOptions = {
        theme: 'vs',
        minimap: { enabled: false },
        fontSize: 13,
        lineNumbers: 'on',
        scrollBeyondLastLine: false,
        automaticLayout: true,
        tabSize: 2,
      };

      inputEditor = monaco.editor.create(document.getElementById('inputEditor'), {
        ...editorOptions,
        value: '',
        language: 'json',
      });

      outputEditor = monaco.editor.create(document.getElementById('outputEditor'), {
        ...editorOptions,
        value: '',
        language: 'json',
        readOnly: true,
      });
    });

    function showStatus(msg, isError) {
      const box = document.getElementById('statusBox');
      const status = document.getElementById('status');
      status.innerText = msg;
      status.className = `p-3 rounded text-sm ${isError ? 'bg-red-50 text-red-700' : 'bg-green-50 text-green-700'}`;
      box.classList.remove('hidden');
    }

    document.getElementById('convertBtn').addEventListener('click', () => {
      const input = inputEditor.getValue().trim();
      if (!input) {
        showStatus('❌ Please enter JSON data', true);
        return;
      }

      try {
        const data = JSON.parse(input);
        if (!Array.isArray(data)) {
          throw new Error('Input must be a JSON array');
        }
        
        const jsonl = data.map(item => JSON.stringify(item)).join('\n');
        outputEditor.setValue(jsonl);
        showStatus(`✅ Converted ${data.length} items to JSONLines`, false);
      } catch (e) {
        showStatus('❌ Error: ' + e.message, true);
        outputEditor.setValue('');
      }
    });

    document.getElementById('clearBtn').addEventListener('click', () => {
      inputEditor.setValue('');
      outputEditor.setValue('');
      document.getElementById('statusBox').classList.add('hidden');
    });

    document.getElementById('sampleBtn').addEventListener('click', () => {
      inputEditor.setValue(`[
  {"id": 1, "name": "John Doe", "email": "john@example.com"},
  {"id": 2, "name": "Jane Smith", "email": "jane@example.com"},
  {"id": 3, "name": "Bob Johnson", "email": "bob@example.com"}
]`);
    });

    document.getElementById('copyBtn').addEventListener('click', () => {
      const output = outputEditor.getValue();
      if (output) {
        navigator.clipboard.writeText(output);
        showStatus('✅ Copied to clipboard!', false);
      }
    });

    document.getElementById('downloadBtn').addEventListener('click', () => {
      const output = outputEditor.getValue();
      if (output) {
        const blob = new Blob([output], { type: 'application/x-ndjson' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'data.jsonl';
        a.click();
        URL.revokeObjectURL(url);
      }
    });
  </script>
</JSONToolLayout>
