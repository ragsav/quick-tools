---
import JSONToolLayout from "../../layouts/JSONToolLayout.astro";

const faqItems = [
  { question: "What Excel format is generated?", answer: "Modern .xlsx format compatible with Excel, Google Sheets, and LibreOffice." },
  { question: "How are nested objects handled?", answer: "Nested objects are converted to JSON strings in the cell." },
  { question: "Is there a file size limit?", answer: "Processing happens in your browser, so very large files may be slow." },
];

const howItWorks = [
  { title: "Paste JSON", content: "Enter or paste your JSON array in the input editor." },
  { title: "Preview", content: "See how many rows and columns will be generated." },
  { title: "Convert", content: "Click Convert to generate the Excel file." },
  { title: "Download", content: "Download the .xlsx file to your computer." },
];

const useCases = [
  { title: "Data Reporting", description: "Export JSON data to Excel for business analysis." },
  { title: "Data Sharing", description: "Share API data with non-technical users in spreadsheet format." },
  { title: "Backup", description: "Create Excel backups of JSON data sources." },
  { title: "Import Prep", description: "Prepare JSON data for systems that only accept Excel." },
];
---

<JSONToolLayout
  title="JSON to Excel Converter - Export JSON to XLSX"
  description="Convert JSON array to Excel spreadsheet (.xlsx). Download Excel file from JSON data online."
  canonicalPath="/json/json-to-excel"
  currentTool="JSON to Excel"
  faqItems={faqItems}
  howItWorks={howItWorks}
  useCases={useCases}
>
  <div class="tool-header">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">JSON to Excel Converter</h1>
    <p class="text-slate-500">Convert JSON array to Excel spreadsheet (.xlsx)</p>
  </div>

  <div class="bg-slate-50 border border-slate-200 rounded p-6 mb-8">
    <div class="mb-4">
      <label class="block font-medium text-slate-700 mb-1.5 text-sm">JSON Input (array of objects)</label>
      <div id="inputEditor" class="border border-slate-300 rounded" style="height: 300px;"></div>
    </div>

    <div class="flex items-center gap-2 mb-4">
      <input type="checkbox" id="includeHeader" checked class="w-4 h-4" />
      <label for="includeHeader" class="text-sm text-slate-600">Include header row</label>
    </div>

    <div class="flex flex-wrap gap-3 mb-4">
      <button id="convertBtn" class="btn-primary px-6 py-2 font-semibold text-white rounded">Convert & Download Excel</button>
      <button id="clearBtn" class="px-4 py-2 bg-white border border-slate-300 rounded text-sm hover:bg-slate-50">Clear</button>
      <button id="sampleBtn" class="px-4 py-2 bg-white border border-slate-300 rounded text-sm hover:bg-slate-50">Load Sample</button>
    </div>

    <div id="statusBox" class="mb-4 hidden">
      <div id="status" class="p-3 rounded text-sm"></div>
    </div>

    <div id="preview" class="hidden">
      <label class="block font-medium text-slate-700 mb-1.5 text-sm">Preview</label>
      <div class="overflow-x-auto border border-slate-300 rounded bg-white">
        <table id="previewTable" class="min-w-full text-sm">
        </table>
      </div>
    </div>
  </div>

  <script src="https://cdn.sheetjs.com/xlsx-0.20.1/package/dist/xlsx.full.min.js"></script>
  <script is:inline>
    const loadMonaco = () => {
      return new Promise((resolve) => {
        if (window.monaco) { resolve(window.monaco); return; }
        const script = document.createElement('script');
        script.src = 'https://cdn.jsdelivr.net/npm/monaco-editor@0.45.0/min/vs/loader.js';
        script.onload = () => {
          require.config({ paths: { vs: 'https://cdn.jsdelivr.net/npm/monaco-editor@0.45.0/min/vs' } });
          require(['vs/editor/editor.main'], () => resolve(window.monaco));
        };
        document.head.appendChild(script);
      });
    };

    let inputEditor;

    loadMonaco().then((monaco) => {
      inputEditor = monaco.editor.create(document.getElementById('inputEditor'), {
        theme: 'vs',
        minimap: { enabled: false },
        fontSize: 13,
        lineNumbers: 'on',
        scrollBeyondLastLine: false,
        automaticLayout: true,
        tabSize: 2,
        value: '',
        language: 'json',
      });
    });

    function showStatus(msg, isError) {
      const box = document.getElementById('statusBox');
      const status = document.getElementById('status');
      status.innerText = msg;
      status.className = `p-3 rounded text-sm ${isError ? 'bg-red-50 text-red-700' : 'bg-green-50 text-green-700'}`;
      box.classList.remove('hidden');
    }

    function escapeHtml(str) {
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function showPreview(data) {
      if (!Array.isArray(data) || data.length === 0) return;
      
      const keys = [...new Set(data.flatMap(obj => Object.keys(obj)))];
      const previewData = data.slice(0, 5);
      
      let html = '<thead class="bg-slate-100"><tr>';
      keys.forEach(k => html += `<th class="px-3 py-2 text-left border-b border-slate-200">${escapeHtml(k)}</th>`);
      html += '</tr></thead><tbody>';
      
      previewData.forEach(row => {
        html += '<tr>';
        keys.forEach(k => {
          const val = row[k] !== undefined ? (typeof row[k] === 'object' ? JSON.stringify(row[k]) : row[k]) : '';
          html += `<td class="px-3 py-2 border-b border-slate-100">${escapeHtml(val)}</td>`;
        });
        html += '</tr>';
      });
      
      if (data.length > 5) {
        html += `<tr><td colspan="${keys.length}" class="px-3 py-2 text-slate-500 text-center">... and ${data.length - 5} more rows</td></tr>`;
      }
      html += '</tbody>';
      
      document.getElementById('previewTable').innerHTML = html;
      document.getElementById('preview').classList.remove('hidden');
    }

    document.getElementById('convertBtn').addEventListener('click', () => {
      const input = inputEditor.getValue().trim();
      if (!input) {
        showStatus('❌ Please enter JSON data', true);
        return;
      }

      try {
        const data = JSON.parse(input);
        if (!Array.isArray(data) || data.length === 0) {
          throw new Error('Input must be a non-empty array of objects');
        }

        const includeHeader = document.getElementById('includeHeader').checked;
        
        // Show preview
        showPreview(data);
        
        // Create workbook
        const ws = XLSX.utils.json_to_sheet(data, { skipHeader: !includeHeader });
        const wb = XLSX.utils.book_new();
        XLSX.utils.book_append_sheet(wb, ws, 'Sheet1');
        
        // Download
        XLSX.writeFile(wb, 'data.xlsx');
        
        showStatus(`✅ Downloaded Excel file with ${data.length} rows`, false);
      } catch (e) {
        showStatus('❌ Error: ' + e.message, true);
        document.getElementById('preview').classList.add('hidden');
      }
    });

    document.getElementById('clearBtn').addEventListener('click', () => {
      inputEditor.setValue('');
      document.getElementById('statusBox').classList.add('hidden');
      document.getElementById('preview').classList.add('hidden');
    });

    document.getElementById('sampleBtn').addEventListener('click', () => {
      inputEditor.setValue(`[
  {"name": "John Doe", "age": 30, "city": "New York", "email": "john@example.com"},
  {"name": "Jane Smith", "age": 25, "city": "Los Angeles", "email": "jane@example.com"},
  {"name": "Bob Johnson", "age": 35, "city": "Chicago", "email": "bob@example.com"},
  {"name": "Alice Brown", "age": 28, "city": "Houston", "email": "alice@example.com"}
]`);
    });
  </script>
</JSONToolLayout>
