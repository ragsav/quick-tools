---
import JSONToolLayout from "../../layouts/JSONToolLayout.astro";

const faqItems = [
  { question: "What HTML is supported?", answer: "HTML tables (<table>) are parsed. Each row becomes a JSON object." },
  { question: "How are headers detected?", answer: "Content in <th> elements is used as object keys. If no <th> exists, <td> values from first row are used." },
  { question: "Can I parse multiple tables?", answer: "Yes, all tables in the HTML are converted to separate arrays." },
];

const howItWorks = [
  { title: "Paste HTML", content: "Enter HTML containing table elements." },
  { title: "Parse", content: "The tool finds all <table> elements and extracts data." },
  { title: "Convert", content: "Tables are converted to JSON arrays of objects." },
  { title: "Copy", content: "Copy or download the JSON output." },
];

const useCases = [
  { title: "Web Scraping", description: "Convert scraped HTML tables to JSON data." },
  { title: "Data Extraction", description: "Extract tabular data from web pages." },
  { title: "Report Conversion", description: "Transform HTML reports into JSON format." },
  { title: "API Data Prep", description: "Prepare web data for API consumption." },
];
---

<JSONToolLayout
  title="HTML to JSON Converter - Parse HTML Tables"
  description="Convert HTML tables to JSON format online. Extract data from HTML table elements."
  canonicalPath="/json/html-to-json"
  currentTool="HTML to JSON"
  faqItems={faqItems}
  howItWorks={howItWorks}
  useCases={useCases}
>
  <div class="tool-header">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">HTML to JSON Converter</h1>
    <p class="text-slate-500">Convert HTML tables to JSON format</p>
  </div>

  <div class="bg-slate-50 border border-slate-200 rounded p-6 mb-8">
    <div class="mb-4">
      <label class="block font-medium text-slate-700 mb-1.5 text-sm">HTML Input</label>
      <div id="inputEditor" class="border border-slate-300 rounded" style="height: 220px;"></div>
    </div>

    <div class="flex flex-wrap gap-3 mb-4">
      <button id="convertBtn" class="btn-primary px-6 py-2 font-semibold text-white rounded">Convert to JSON</button>
      <button id="clearBtn" class="px-4 py-2 bg-white border border-slate-300 rounded text-sm hover:bg-slate-50">Clear</button>
      <button id="sampleBtn" class="px-4 py-2 bg-white border border-slate-300 rounded text-sm hover:bg-slate-50">Load Sample</button>
    </div>

    <div id="statusBox" class="mb-4 hidden">
      <div id="status" class="p-3 rounded text-sm"></div>
    </div>

    <div class="mb-4">
      <label class="block font-medium text-slate-700 mb-1.5 text-sm">JSON Output</label>
      <div id="outputEditor" class="border border-slate-300 rounded" style="height: 250px;"></div>
    </div>

    <button id="copyBtn" class="px-4 py-2 bg-white border border-slate-300 rounded text-sm hover:bg-slate-50">📋 Copy Output</button>
  </div>

  <script is:inline>
    const loadMonaco = () => {
      return new Promise((resolve) => {
        if (window.monaco) { resolve(window.monaco); return; }
        const script = document.createElement('script');
        script.src = 'https://cdn.jsdelivr.net/npm/monaco-editor@0.45.0/min/vs/loader.js';
        script.onload = () => {
          require.config({ paths: { vs: 'https://cdn.jsdelivr.net/npm/monaco-editor@0.45.0/min/vs' } });
          require(['vs/editor/editor.main'], () => resolve(window.monaco));
        };
        document.head.appendChild(script);
      });
    };

    let inputEditor, outputEditor;

    loadMonaco().then((monaco) => {
      const editorOptions = {
        theme: 'vs',
        minimap: { enabled: false },
        fontSize: 13,
        lineNumbers: 'on',
        scrollBeyondLastLine: false,
        automaticLayout: true,
        tabSize: 2,
      };

      inputEditor = monaco.editor.create(document.getElementById('inputEditor'), {
        ...editorOptions,
        value: '',
        language: 'html',
      });

      outputEditor = monaco.editor.create(document.getElementById('outputEditor'), {
        ...editorOptions,
        value: '',
        language: 'json',
        readOnly: true,
      });
    });

    function showStatus(msg, isError) {
      const box = document.getElementById('statusBox');
      const status = document.getElementById('status');
      status.innerText = msg;
      status.className = `p-3 rounded text-sm ${isError ? 'bg-red-50 text-red-700' : 'bg-green-50 text-green-700'}`;
      box.classList.remove('hidden');
    }

    function parseHtmlTables(html) {
      const parser = new DOMParser();
      const doc = parser.parseFromString(html, 'text/html');
      const tables = doc.querySelectorAll('table');
      
      if (tables.length === 0) {
        throw new Error('No <table> elements found in the HTML');
      }

      const results = [];

      tables.forEach(table => {
        const rows = table.querySelectorAll('tr');
        if (rows.length === 0) return;

        // Get headers
        let headers = [];
        const headerRow = rows[0];
        const headerCells = headerRow.querySelectorAll('th');
        
        if (headerCells.length > 0) {
          headers = Array.from(headerCells).map(th => th.textContent.trim());
        } else {
          const firstRowCells = headerRow.querySelectorAll('td');
          headers = Array.from(firstRowCells).map(td => td.textContent.trim());
        }

        // Parse data rows
        const startIdx = headerCells.length > 0 ? 1 : 1;
        const data = [];

        for (let i = startIdx; i < rows.length; i++) {
          const cells = rows[i].querySelectorAll('td');
          if (cells.length === 0) continue;
          
          const obj = {};
          headers.forEach((h, idx) => {
            const val = cells[idx] ? cells[idx].textContent.trim() : '';
            // Try to parse numbers
            obj[h] = !isNaN(val) && val !== '' ? Number(val) : val;
          });
          data.push(obj);
        }

        results.push(data);
      });

      return results.length === 1 ? results[0] : results;
    }

    document.getElementById('convertBtn').addEventListener('click', () => {
      const input = inputEditor.getValue().trim();
      if (!input) {
        showStatus('❌ Please enter HTML data', true);
        return;
      }

      try {
        const result = parseHtmlTables(input);
        outputEditor.setValue(JSON.stringify(result, null, 2));
        const count = Array.isArray(result[0]) ? result.length + ' tables' : result.length + ' rows';
        showStatus(`✅ Converted ${count}`, false);
      } catch (e) {
        showStatus('❌ Error: ' + e.message, true);
        outputEditor.setValue('');
      }
    });

    document.getElementById('clearBtn').addEventListener('click', () => {
      inputEditor.setValue('');
      outputEditor.setValue('');
      document.getElementById('statusBox').classList.add('hidden');
    });

    document.getElementById('sampleBtn').addEventListener('click', () => {
      inputEditor.setValue(`<table>
  <tr>
    <th>Name</th>
    <th>Age</th>
    <th>City</th>
  </tr>
  <tr>
    <td>John Doe</td>
    <td>30</td>
    <td>New York</td>
  </tr>
  <tr>
    <td>Jane Smith</td>
    <td>25</td>
    <td>Los Angeles</td>
  </tr>
</table>`);
    });

    document.getElementById('copyBtn').addEventListener('click', () => {
      const output = outputEditor.getValue();
      if (output) {
        navigator.clipboard.writeText(output);
        showStatus('✅ Copied to clipboard!', false);
      }
    });
  </script>
</JSONToolLayout>
