---
import JSONToolLayout from "../../layouts/JSONToolLayout.astro";

const faqItems = [
  { question: "What TypeScript is generated?", answer: "TypeScript interfaces with proper type annotations for all JSON properties." },
  { question: "Are nested objects supported?", answer: "Yes, nested objects generate nested interfaces." },
  { question: "How are arrays handled?", answer: "Arrays generate proper array types with inferred item types." },
];

const howItWorks = [
  { title: "Paste JSON", content: "Enter your JSON object or array." },
  { title: "Configure", content: "Set the root interface name." },
  { title: "Convert", content: "Click Convert to generate TypeScript interfaces." },
  { title: "Copy", content: "Copy the TypeScript code for your project." },
];

const useCases = [
  { title: "API Types", description: "Generate types for API response data." },
  { title: "Config Types", description: "Create types for JSON configuration files." },
  { title: "Data Models", description: "Build TypeScript models from JSON examples." },
  { title: "Type Safety", description: "Add type safety to JSON data handling." },
];
---

<JSONToolLayout
  title="JSON to TypeScript Converter - Generate Interfaces"
  description="Convert JSON to TypeScript interfaces online. Generate type definitions from JSON data."
  canonicalPath="/json/json-to-typescript"
  currentTool="JSON to TypeScript"
  faqItems={faqItems}
  howItWorks={howItWorks}
  useCases={useCases}
>
  <div class="tool-header">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">JSON to TypeScript Converter</h1>
    <p class="text-slate-500">Generate TypeScript interfaces from JSON</p>
  </div>

  <div class="bg-slate-50 border border-slate-200 rounded p-6 mb-8">
    <div class="mb-4">
      <label class="block font-medium text-slate-700 mb-1.5 text-sm">JSON Input</label>
      <div id="inputEditor" class="border border-slate-300 rounded" style="height: 220px;"></div>
    </div>

    <div class="mb-4">
      <label class="block text-sm text-slate-600 mb-1">Root Interface Name</label>
      <input type="text" id="interfaceName" value="RootObject" class="px-3 py-2 border border-slate-300 rounded bg-white text-sm w-48" />
    </div>

    <div class="flex flex-wrap gap-3 mb-4">
      <button id="convertBtn" class="btn-primary px-6 py-2 font-semibold text-white rounded">Convert to TypeScript</button>
      <button id="clearBtn" class="px-4 py-2 bg-white border border-slate-300 rounded text-sm hover:bg-slate-50">Clear</button>
      <button id="sampleBtn" class="px-4 py-2 bg-white border border-slate-300 rounded text-sm hover:bg-slate-50">Load Sample</button>
    </div>

    <div id="statusBox" class="mb-4 hidden">
      <div id="status" class="p-3 rounded text-sm"></div>
    </div>

    <div class="mb-4">
      <label class="block font-medium text-slate-700 mb-1.5 text-sm">TypeScript Output</label>
      <div id="outputEditor" class="border border-slate-300 rounded" style="height: 280px;"></div>
    </div>

    <button id="copyBtn" class="px-4 py-2 bg-white border border-slate-300 rounded text-sm hover:bg-slate-50">📋 Copy Output</button>
  </div>

  <script is:inline>
    const loadMonaco = () => {
      return new Promise((resolve) => {
        if (window.monaco) { resolve(window.monaco); return; }
        const script = document.createElement('script');
        script.src = 'https://cdn.jsdelivr.net/npm/monaco-editor@0.45.0/min/vs/loader.js';
        script.onload = () => {
          require.config({ paths: { vs: 'https://cdn.jsdelivr.net/npm/monaco-editor@0.45.0/min/vs' } });
          require(['vs/editor/editor.main'], () => resolve(window.monaco));
        };
        document.head.appendChild(script);
      });
    };

    let inputEditor, outputEditor;

    loadMonaco().then((monaco) => {
      const editorOptions = {
        theme: 'vs',
        minimap: { enabled: false },
        fontSize: 13,
        lineNumbers: 'on',
        scrollBeyondLastLine: false,
        automaticLayout: true,
        tabSize: 2,
      };

      inputEditor = monaco.editor.create(document.getElementById('inputEditor'), {
        ...editorOptions,
        value: '',
        language: 'json',
      });

      outputEditor = monaco.editor.create(document.getElementById('outputEditor'), {
        ...editorOptions,
        value: '',
        language: 'typescript',
        readOnly: true,
      });
    });

    function showStatus(msg, isError) {
      const box = document.getElementById('statusBox');
      const status = document.getElementById('status');
      status.innerText = msg;
      status.className = `p-3 rounded text-sm ${isError ? 'bg-red-50 text-red-700' : 'bg-green-50 text-green-700'}`;
      box.classList.remove('hidden');
    }

    function capitalize(str) {
      return str.charAt(0).toUpperCase() + str.slice(1);
    }

    function getType(value, key, interfaces) {
      if (value === null) return 'null';
      if (Array.isArray(value)) {
        if (value.length === 0) return 'any[]';
        const itemType = getType(value[0], key, interfaces);
        return `${itemType}[]`;
      }
      if (typeof value === 'object') {
        const interfaceName = capitalize(key);
        generateInterface(value, interfaceName, interfaces);
        return interfaceName;
      }
      if (typeof value === 'string') return 'string';
      if (typeof value === 'number') return 'number';
      if (typeof value === 'boolean') return 'boolean';
      return 'any';
    }

    function generateInterface(obj, name, interfaces) {
      if (interfaces.has(name)) return;
      
      const props = [];
      for (const [key, value] of Object.entries(obj)) {
        const type = getType(value, key, interfaces);
        const safeKey = /^[a-zA-Z_$][a-zA-Z0-9_$]*$/.test(key) ? key : `"${key}"`;
        props.push(`  ${safeKey}: ${type};`);
      }
      
      interfaces.set(name, `interface ${name} {\n${props.join('\n')}\n}`);
    }

    function jsonToTypeScript(data, rootName) {
      const interfaces = new Map();
      
      if (Array.isArray(data)) {
        if (data.length > 0 && typeof data[0] === 'object') {
          generateInterface(data[0], rootName, interfaces);
          return `${Array.from(interfaces.values()).join('\n\n')}\n\ntype ${rootName}Array = ${rootName}[];`;
        }
        return `type ${rootName} = ${getType(data[0], 'item', interfaces)}[];`;
      }
      
      generateInterface(data, rootName, interfaces);
      return Array.from(interfaces.values()).join('\n\n');
    }

    document.getElementById('convertBtn').addEventListener('click', () => {
      const input = inputEditor.getValue().trim();
      if (!input) {
        showStatus('❌ Please enter JSON data', true);
        return;
      }

      try {
        const data = JSON.parse(input);
        const interfaceName = document.getElementById('interfaceName').value.trim() || 'RootObject';
        const typescript = jsonToTypeScript(data, interfaceName);
        outputEditor.setValue(typescript);
        showStatus('✅ Generated TypeScript interfaces', false);
      } catch (e) {
        showStatus('❌ Error: ' + e.message, true);
        outputEditor.setValue('');
      }
    });

    document.getElementById('clearBtn').addEventListener('click', () => {
      inputEditor.setValue('');
      outputEditor.setValue('');
      document.getElementById('statusBox').classList.add('hidden');
    });

    document.getElementById('sampleBtn').addEventListener('click', () => {
      inputEditor.setValue(`{
  "id": 1,
  "name": "John Doe",
  "email": "john@example.com",
  "active": true,
  "address": {
    "street": "123 Main St",
    "city": "New York",
    "zipCode": "10001"
  },
  "roles": ["admin", "user"],
  "metadata": null
}`);
      document.getElementById('interfaceName').value = 'User';
    });

    document.getElementById('copyBtn').addEventListener('click', () => {
      const output = outputEditor.getValue();
      if (output) {
        navigator.clipboard.writeText(output);
        showStatus('✅ Copied to clipboard!', false);
      }
    });
  </script>
</JSONToolLayout>
