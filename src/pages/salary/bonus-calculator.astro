---
import SalaryToolLayout from "../../layouts/SalaryToolLayout.astro";

const faqItems = [
  {
    question: "How is bonus calculated?",
    answer:
      "Bonus = Annual Salary × Bonus Percentage. The net bonus subtracts estimated taxes.",
  },
  {
    question: "What tax rate should I use?",
    answer:
      "Bonus tax rates vary by location. In the US, bonuses are often taxed at about 22-37%.",
  },
  {
    question: "Is this tool free?",
    answer:
      "Yes, this tool is completely free and works directly in your browser.",
  },
];
---

<SalaryToolLayout
  title="Bonus Calculator - Calculate Your Bonus Amount"
  description="Calculate your bonus based on salary percentage or flat amount. See after-tax estimates."
  canonicalPath="/salary/bonus-calculator"
  currentTool="Bonus Calculator"
  faqItems={faqItems}
>
  <div class="tool-header">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">
      Bonus Calculator
    </h1>
    <p class="text-slate-500">
      Calculate your bonus and estimate take-home amount.
    </p>
  </div>

  <div class="bg-slate-50 border border-slate-200 rounded p-6 mb-8">
    <div class="grid md:grid-cols-2 gap-4 mb-6">
      <div>
        <label
          for="salary"
          class="block font-medium text-slate-700 mb-1.5 text-sm"
          >Annual Salary ($)</label
        >
        <input
          type="number"
          id="salary"
          placeholder="60000"
          class="w-full px-4 py-3 border border-slate-300 rounded bg-white text-slate-800 outline-none"
          oninput="calculate()"
        />
      </div>
      <div>
        <label
          for="bonusPercent"
          class="block font-medium text-slate-700 mb-1.5 text-sm"
          >Bonus Percentage (%)</label
        >
        <input
          type="number"
          id="bonusPercent"
          placeholder="10"
          class="w-full px-4 py-3 border border-slate-300 rounded bg-white text-slate-800 outline-none"
          oninput="calculate()"
        />
      </div>
    </div>

    <div class="mb-6">
      <label
        for="taxRate"
        class="block font-medium text-slate-700 mb-1.5 text-sm"
        >Estimated Tax Rate (%)</label
      >
      <input
        type="number"
        id="taxRate"
        value="25"
        class="w-full max-w-xs px-4 py-3 border border-slate-300 rounded bg-white text-slate-800 outline-none"
        oninput="calculate()"
      />
    </div>

    <div class="result-box p-4 bg-white rounded">
      <div class="grid grid-cols-3 gap-4 text-center">
        <div>
          <div class="text-xs text-slate-500 uppercase mb-1">Gross Bonus</div>
          <div class="text-2xl font-bold text-slate-900" id="grossBonus">
            $0
          </div>
        </div>
        <div>
          <div class="text-xs text-slate-500 uppercase mb-1">Est. Taxes</div>
          <div class="text-xl font-bold text-red-500" id="taxes">$0</div>
        </div>
        <div>
          <div class="text-xs text-slate-500 uppercase mb-1">Net Bonus</div>
          <div class="text-2xl font-bold text-green-600" id="netBonus">$0</div>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    function calculate() {
      const salary = parseFloat(document.getElementById("salary").value) || 0;
      const bonusPercent =
        parseFloat(document.getElementById("bonusPercent").value) || 0;
      const taxRate = parseFloat(document.getElementById("taxRate").value) || 0;

      const grossBonus = salary * (bonusPercent / 100);
      const taxes = grossBonus * (taxRate / 100);
      const netBonus = grossBonus - taxes;

      const fmt = (n) =>
        "$" +
        n.toLocaleString(undefined, {
          minimumFractionDigits: 2,
          maximumFractionDigits: 2,
        });

      document.getElementById("grossBonus").innerText = fmt(grossBonus);
      document.getElementById("taxes").innerText = "-" + fmt(taxes);
      document.getElementById("netBonus").innerText = fmt(netBonus);
    }
  </script>
</SalaryToolLayout>
