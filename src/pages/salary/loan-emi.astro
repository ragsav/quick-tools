---
import SalaryToolLayout from "../../layouts/SalaryToolLayout.astro";

const faqItems = [
  {
    question: "What is EMI?",
    answer:
      "EMI (Equated Monthly Installment) is a fixed monthly payment that includes both principal and interest.",
  },
  {
    question: "What affects my EMI?",
    answer:
      "Loan amount, interest rate, and loan term. Longer terms mean lower EMI but more total interest.",
  },
  {
    question: "Is this tool free?",
    answer:
      "Yes, this tool is completely free and works directly in your browser.",
  },
];

const howItWorks = [
  {
    title: "EMI Formula",
    content:
      "EMI = [P × R × (1+R)^N] / [(1+R)^N - 1], where P = principal, R = monthly rate, N = months. Provides fixed payment amount.",
  },
  {
    title: "Monthly Rate Conversion",
    content:
      "Monthly rate = annual rate ÷ 12 ÷ 100. A 7% annual rate becomes 0.00583 monthly rate for the formula.",
  },
  {
    title: "Total Payment",
    content:
      "Total payment = EMI × number of months. This is the total amount you'll pay over the loan's lifetime.",
  },
  {
    title: "Interest Calculate",
    content:
      "Total interest = total payment - principal. Shows how much extra you pay beyond the borrowed amount.",
  },
  {
    title: "Term Trade-offs",
    content:
      "Longer terms = lower EMI but higher total interest. Shorter terms = higher EMI but less total interest paid.",
  },
];

const useCases = [
  {
    title: "Home Loan Planning",
    description:
      "Calculate mortgage payments before buying. Know what monthly payment you can afford and total cost over 15-30 years.",
  },
  {
    title: "Car Loan Comparison",
    description:
      "Compare financing options for vehicles. See how different rates and terms affect your monthly payment.",
  },
  {
    title: "Personal Loan Assessment",
    description:
      "Calculate EMI before borrowing for expenses. Understand the monthly commitment you're taking on.",
  },
  {
    title: "Refinancing Decision",
    description:
      "Compare current loan EMI to refinanced terms. See if lower rate or different term makes sense.",
  },
  {
    title: "Budget Planning",
    description:
      "Understand loan impact on monthly budget. Ensure EMI fits within your income and expenses.",
  },
  {
    title: "Prepayment Analysis",
    description:
      "Calculate how extra payments reduce total interest. Compare loan completion times at different payment levels.",
  },
];
---

<SalaryToolLayout
  title="Loan EMI Calculator - Calculate Monthly Loan Payments"
  description="Calculate your monthly EMI for home loans, car loans, or personal loans. See interest breakdown."
  canonicalPath="/salary/loan-emi"
  currentTool="Loan EMI Calculator"
  faqItems={faqItems}
  howItWorks={howItWorks}
  useCases={useCases}
>
  <div class="tool-header">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">
      Loan EMI Calculator
    </h1>
    <p class="text-slate-500">
      Calculate your Equated Monthly Installment (EMI) for any loan.
    </p>
  </div>

  <div class="bg-slate-50 border border-slate-200 rounded p-6 mb-8">
    <div class="grid md:grid-cols-3 gap-4 mb-6">
      <div>
        <label
          for="principal"
          class="block font-medium text-slate-700 mb-1.5 text-sm"
          >Loan Amount ($)</label
        >
        <input
          type="number"
          id="principal"
          placeholder="200000"
          class="w-full px-4 py-3 border border-slate-300 rounded bg-white text-slate-800 outline-none"
          oninput="calculate()"
        />
      </div>
      <div>
        <label
          for="rate"
          class="block font-medium text-slate-700 mb-1.5 text-sm"
          >Interest Rate (% per year)</label
        >
        <input
          type="number"
          id="rate"
          placeholder="7"
          step="0.1"
          class="w-full px-4 py-3 border border-slate-300 rounded bg-white text-slate-800 outline-none"
          oninput="calculate()"
        />
      </div>
      <div>
        <label
          for="years"
          class="block font-medium text-slate-700 mb-1.5 text-sm"
          >Loan Term (years)</label
        >
        <input
          type="number"
          id="years"
          placeholder="30"
          class="w-full px-4 py-3 border border-slate-300 rounded bg-white text-slate-800 outline-none"
          oninput="calculate()"
        />
      </div>
    </div>

    <div class="result-box p-4 bg-white rounded">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
        <div>
          <div class="text-xs text-slate-500 uppercase mb-1">Monthly EMI</div>
          <div class="text-2xl font-bold text-purple-600" id="emi">$0</div>
        </div>
        <div>
          <div class="text-xs text-slate-500 uppercase mb-1">
            Total Interest
          </div>
          <div class="text-xl font-bold text-red-500" id="totalInterest">
            $0
          </div>
        </div>
        <div>
          <div class="text-xs text-slate-500 uppercase mb-1">Total Payment</div>
          <div class="text-xl font-bold text-slate-900" id="totalPayment">
            $0
          </div>
        </div>
        <div>
          <div class="text-xs text-slate-500 uppercase mb-1">Principal</div>
          <div class="text-xl font-bold text-green-600" id="principalDisplay">
            $0
          </div>
        </div>
      </div>
    </div>
  </div>

  <section class="mt-8 pt-6 border-t border-slate-200">
    <h2 class="text-xl font-semibold text-slate-900 mb-4">EMI Formula</h2>
    <p class="text-slate-600">EMI = [P × R × (1+R)^N] / [(1+R)^N - 1]</p>
    <p class="text-sm text-slate-500 mt-2">
      Where P = Principal, R = Monthly interest rate, N = Number of months
    </p>
  </section>

  <script is:inline>
    function calculate() {
      const principal =
        parseFloat(document.getElementById("principal").value) || 0;
      const annualRate = parseFloat(document.getElementById("rate").value) || 0;
      const years = parseFloat(document.getElementById("years").value) || 0;

      if (principal === 0 || annualRate === 0 || years === 0) {
        document.getElementById("emi").innerText = "$0";
        return;
      }

      const monthlyRate = annualRate / 12 / 100;
      const months = years * 12;

      // EMI Formula
      const emi =
        (principal * monthlyRate * Math.pow(1 + monthlyRate, months)) /
        (Math.pow(1 + monthlyRate, months) - 1);
      const totalPayment = emi * months;
      const totalInterest = totalPayment - principal;

      const fmt = (n) =>
        "$" +
        n.toLocaleString(undefined, {
          minimumFractionDigits: 2,
          maximumFractionDigits: 2,
        });

      document.getElementById("emi").innerText = fmt(emi);
      document.getElementById("totalInterest").innerText = fmt(totalInterest);
      document.getElementById("totalPayment").innerText = fmt(totalPayment);
      document.getElementById("principalDisplay").innerText = fmt(principal);
    }
  </script>
</SalaryToolLayout>
