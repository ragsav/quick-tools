---
import SalaryToolLayout from "../../layouts/SalaryToolLayout.astro";

const faqItems = [
  {
    question: "How is commission calculated?",
    answer:
      "Commission = Total Sales × Commission Rate. You can also add a base salary for total earnings.",
  },
  {
    question: "What are typical commission rates?",
    answer: "Real estate: 5-6%, retail: 1-5%, SaaS sales: 10-20%.",
  },
  {
    question: "Is this tool free?",
    answer:
      "Yes, this tool is completely free and works directly in your browser.",
  },
];

const howItWorks = [
  {
    title: "Commission Calculation",
    content:
      "Commission = total sales × (commission rate ÷ 100). $100,000 in sales at 10% = $10,000 commission.",
  },
  {
    title: "Base Plus Commission",
    content:
      "Total earnings = base salary + commission. $2,000 base + $10,000 commission = $12,000 total.",
  },
  {
    title: "Rate Flexibility",
    content:
      "Different industries use different rates. The tool accepts any percentage for custom commission structures.",
  },
  {
    title: "Sales Target Analysis",
    content:
      "Work backwards: if you need $5,000 commission at 10%, you need $50,000 in sales.",
  },
  {
    title: "Monthly Estimation",
    content:
      "Project annual earnings based on monthly sales. Helps with income forecasting and goal setting.",
  },
];

const useCases = [
  {
    title: "Sales Representative Earnings",
    description:
      "Calculate expected income based on sales pipeline. Forecast monthly and annual commission earnings.",
  },
  {
    title: "Real Estate Agent",
    description:
      "Calculate commission on property sales. A $500,000 home at 3% agent split = $15,000 commission.",
  },
  {
    title: "Job Offer Evaluation",
    description:
      "Compare base + commission offers. Understand what sales level is needed to meet income goals.",
  },
  {
    title: "Quota Planning",
    description:
      "Determine sales targets needed to achieve desired earnings. Reverse-calculate from income goals.",
  },
  {
    title: "Commission Structure Analysis",
    description:
      "Compare different commission structures: higher base/lower commission vs. lower base/higher commission.",
  },
  {
    title: "Affiliate Marketing",
    description:
      "Calculate affiliate earnings at various commission rates and traffic/conversion levels.",
  },
];
---

<SalaryToolLayout
  title="Commission Calculator - Calculate Sales Commission"
  description="Calculate sales commission earnings based on sales amount and commission rate."
  canonicalPath="/salary/commission"
  currentTool="Commission Calculator"
  faqItems={faqItems}
  howItWorks={howItWorks}
  useCases={useCases}
>
  <div class="tool-header">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">
      Commission Calculator
    </h1>
    <p class="text-slate-500">Calculate your commission earnings from sales.</p>
  </div>

  <div class="bg-slate-50 border border-slate-200 rounded p-6 mb-8">
    <div class="grid md:grid-cols-2 gap-4 mb-6">
      <div>
        <label
          for="salesAmount"
          class="block font-medium text-slate-700 mb-1.5 text-sm"
          >Total Sales Amount ($)</label
        >
        <input
          type="number"
          id="salesAmount"
          placeholder="10000"
          class="w-full px-4 py-3 border border-slate-300 rounded bg-white text-slate-800 outline-none"
          oninput="calculate()"
        />
      </div>
      <div>
        <label
          for="commissionRate"
          class="block font-medium text-slate-700 mb-1.5 text-sm"
          >Commission Rate (%)</label
        >
        <input
          type="number"
          id="commissionRate"
          placeholder="10"
          class="w-full px-4 py-3 border border-slate-300 rounded bg-white text-slate-800 outline-none"
          oninput="calculate()"
        />
      </div>
    </div>

    <div class="mb-4">
      <label
        for="baseSalary"
        class="block font-medium text-slate-700 mb-1.5 text-sm"
        >Base Salary (optional, $)</label
      >
      <input
        type="number"
        id="baseSalary"
        placeholder="2000"
        class="w-full max-w-xs px-4 py-3 border border-slate-300 rounded bg-white text-slate-800 outline-none"
        oninput="calculate()"
      />
    </div>

    <div class="result-box p-4 bg-white rounded">
      <div class="grid grid-cols-3 gap-4 text-center">
        <div>
          <div class="text-xs text-slate-500 uppercase mb-1">Commission</div>
          <div class="text-2xl font-bold text-purple-600" id="commission">
            $0
          </div>
        </div>
        <div>
          <div class="text-xs text-slate-500 uppercase mb-1">Base Salary</div>
          <div class="text-xl font-bold text-slate-700" id="base">$0</div>
        </div>
        <div>
          <div class="text-xs text-slate-500 uppercase mb-1">
            Total Earnings
          </div>
          <div class="text-2xl font-bold text-green-600" id="total">$0</div>
        </div>
      </div>
    </div>
  </div>

  <section class="mt-8 pt-6 border-t border-slate-200">
    <h2 class="text-xl font-semibold text-slate-900 mb-4">
      Common Commission Rates
    </h2>
    <div class="grid grid-cols-3 gap-3 text-sm">
      <div class="p-3 bg-white border border-slate-200 rounded text-center">
        <div class="font-medium">Real Estate</div>
        <div class="text-slate-500">5-6%</div>
      </div>
      <div class="p-3 bg-white border border-slate-200 rounded text-center">
        <div class="font-medium">Retail Sales</div>
        <div class="text-slate-500">1-5%</div>
      </div>
      <div class="p-3 bg-white border border-slate-200 rounded text-center">
        <div class="font-medium">SaaS Sales</div>
        <div class="text-slate-500">10-20%</div>
      </div>
    </div>
  </section>

  <script is:inline>
    function calculate() {
      const sales =
        parseFloat(document.getElementById("salesAmount").value) || 0;
      const rate =
        parseFloat(document.getElementById("commissionRate").value) || 0;
      const baseSalary =
        parseFloat(document.getElementById("baseSalary").value) || 0;

      const commission = sales * (rate / 100);
      const total = commission + baseSalary;

      const fmt = (n) =>
        "$" +
        n.toLocaleString(undefined, {
          minimumFractionDigits: 2,
          maximumFractionDigits: 2,
        });

      document.getElementById("commission").innerText = fmt(commission);
      document.getElementById("base").innerText = fmt(baseSalary);
      document.getElementById("total").innerText = fmt(total);
    }
  </script>
</SalaryToolLayout>
