---
import SalaryToolLayout from "../../layouts/SalaryToolLayout.astro";

const faqItems = [
  {
    question: "What is simple interest?",
    answer:
      "Simple interest is calculated only on the original principal, not on accumulated interest.",
  },
  {
    question: "What is the formula?",
    answer: "Interest = Principal × Rate × Time (I = P × R × T).",
  },
  {
    question: "Is this tool free?",
    answer:
      "Yes, this tool is completely free and works directly in your browser.",
  },
];

const howItWorks = [
  {
    title: "Simple Interest Formula",
    content:
      "Interest (I) = Principal (P) × Rate (R) × Time (T). Rate is expressed as a decimal (5% = 0.05), time in years.",
  },
  {
    title: "Rate Conversion",
    content:
      "Annual percentage rate is divided by 100 to get the decimal form. 5% becomes 0.05 for the calculation.",
  },
  {
    title: "Total Amount",
    content:
      "Total = Principal + Interest. This is what you'll have at the end of the period (or owe, for loans).",
  },
  {
    title: "Time Flexibility",
    content:
      "Fractional years work: 0.5 = 6 months, 0.25 = 3 months. Adjust time input to match your actual period.",
  },
  {
    title: "Simple vs. Compound",
    content:
      "Simple interest only calculates on principal. Compound interest calculates on principal + accumulated interest.",
  },
];

const useCases = [
  {
    title: "Short-Term Loans",
    description:
      "Calculate interest on payday loans or short-term borrowing where simple interest is commonly used.",
  },
  {
    title: "Car Loans",
    description:
      "Some auto loans use simple interest. Calculate expected interest costs before committing.",
  },
  {
    title: "Savings Bonds",
    description:
      "Government bonds often pay simple interest. Calculate expected returns on bond investments.",
  },
  {
    title: "Educational Loans",
    description:
      "Student loans often accrue simple interest during school. Understand interest accumulation before graduation.",
  },
  {
    title: "Personal Lending",
    description:
      "Calculate fair interest when lending to or borrowing from friends/family. Keep things transparent.",
  },
  {
    title: "Math & Finance Education",
    description:
      "Learn the fundamental concept of interest before moving to compound interest calculations.",
  },
];
---

<SalaryToolLayout
  title="Simple Interest Calculator - Calculate Interest Easily"
  description="Calculate simple interest on principal amount. Find interest earned or owed over time."
  canonicalPath="/salary/simple-interest"
  currentTool="Simple Interest Calculator"
  faqItems={faqItems}
  howItWorks={howItWorks}
  useCases={useCases}
>
  <div class="tool-header">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">
      Simple Interest Calculator
    </h1>
    <p class="text-slate-500">
      Calculate simple interest on investments or loans.
    </p>
  </div>

  <div class="bg-slate-50 border border-slate-200 rounded p-6 mb-8">
    <div class="grid md:grid-cols-3 gap-4 mb-6">
      <div>
        <label
          for="principal"
          class="block font-medium text-slate-700 mb-1.5 text-sm"
          >Principal Amount ($)</label
        >
        <input
          type="number"
          id="principal"
          placeholder="10000"
          class="w-full px-4 py-3 border border-slate-300 rounded bg-white text-slate-800 outline-none"
          oninput="calculate()"
        />
      </div>
      <div>
        <label
          for="rate"
          class="block font-medium text-slate-700 mb-1.5 text-sm"
          >Annual Interest Rate (%)</label
        >
        <input
          type="number"
          id="rate"
          placeholder="5"
          step="0.1"
          class="w-full px-4 py-3 border border-slate-300 rounded bg-white text-slate-800 outline-none"
          oninput="calculate()"
        />
      </div>
      <div>
        <label
          for="time"
          class="block font-medium text-slate-700 mb-1.5 text-sm"
          >Time Period (years)</label
        >
        <input
          type="number"
          id="time"
          placeholder="3"
          step="0.5"
          class="w-full px-4 py-3 border border-slate-300 rounded bg-white text-slate-800 outline-none"
          oninput="calculate()"
        />
      </div>
    </div>

    <div class="result-box p-4 bg-white rounded">
      <div class="grid grid-cols-3 gap-4 text-center">
        <div>
          <div class="text-xs text-slate-500 uppercase mb-1">Principal</div>
          <div class="text-xl font-bold text-slate-900" id="principalDisplay">
            $0
          </div>
        </div>
        <div>
          <div class="text-xs text-slate-500 uppercase mb-1">
            Interest Earned
          </div>
          <div class="text-2xl font-bold text-purple-600" id="interest">$0</div>
        </div>
        <div>
          <div class="text-xs text-slate-500 uppercase mb-1">Total Amount</div>
          <div class="text-2xl font-bold text-green-600" id="total">$0</div>
        </div>
      </div>
    </div>
  </div>

  <section class="mt-8 pt-6 border-t border-slate-200">
    <h2 class="text-xl font-semibold text-slate-900 mb-4">
      Simple Interest Formula
    </h2>
    <div class="p-4 bg-white border border-slate-200 rounded">
      <p class="font-mono text-lg text-center">I = P × R × T</p>
      <div
        class="mt-3 text-sm text-slate-600 grid grid-cols-3 gap-4 text-center"
      >
        <div><strong>P</strong> = Principal</div>
        <div><strong>R</strong> = Rate (decimal)</div>
        <div><strong>T</strong> = Time (years)</div>
      </div>
    </div>
  </section>

  <script is:inline>
    function calculate() {
      const principal =
        parseFloat(document.getElementById("principal").value) || 0;
      const rate = parseFloat(document.getElementById("rate").value) || 0;
      const time = parseFloat(document.getElementById("time").value) || 0;

      const interest = principal * (rate / 100) * time;
      const total = principal + interest;

      const fmt = (n) =>
        "$" +
        n.toLocaleString(undefined, {
          minimumFractionDigits: 2,
          maximumFractionDigits: 2,
        });

      document.getElementById("principalDisplay").innerText = fmt(principal);
      document.getElementById("interest").innerText = fmt(interest);
      document.getElementById("total").innerText = fmt(total);
    }
  </script>
</SalaryToolLayout>
