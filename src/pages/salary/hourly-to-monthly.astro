---
import SalaryToolLayout from "../../layouts/SalaryToolLayout.astro";

const faqItems = [
  {
    question: "How is annual salary calculated from hourly rate?",
    answer:
      "Annual = Hourly Rate × Hours per Week × Weeks per Year. Standard is 40 hours × 52 weeks.",
  },
  {
    question: "What if I don't work all 52 weeks?",
    answer: "Adjust the 'Weeks per Year' field to account for unpaid time off.",
  },
  {
    question: "Is this tool free?",
    answer:
      "Yes, this tool is completely free and works directly in your browser.",
  },
];

const howItWorks = [
  {
    title: "Weekly Calculation",
    content:
      "Hourly rate × hours per week = weekly pay. At $20/hour for 40 hours, weekly pay is $800.",
  },
  {
    title: "Annual Projection",
    content:
      "Weekly pay × weeks per year = annual salary. $800/week × 52 weeks = $41,600 annually.",
  },
  {
    title: "Monthly Average",
    content:
      "Annual salary ÷ 12 = monthly average. This smooths out months with different numbers of workdays.",
  },
  {
    title: "Daily Rate",
    content:
      "Hourly rate × 8 hours = standard daily rate. Useful for comparing day rates or per-diem work.",
  },
  {
    title: "Adjustable Parameters",
    content:
      "Modify hours per week and weeks per year for part-time schedules or to account for unpaid vacation.",
  },
];

const useCases = [
  {
    title: "Hourly Worker Budgeting",
    description:
      "Project annual income for budgeting, tax planning, and financial goals based on your hourly wage.",
  },
  {
    title: "Job Comparison",
    description:
      "Compare hourly positions to salaried offers. Convert to annual to see the true compensation difference.",
  },
  {
    title: "Loan Applications",
    description:
      "Banks often require annual income. Convert your hourly rate for mortgage or loan applications.",
  },
  {
    title: "Benefits Calculation",
    description:
      "Some benefits are based on annual salary. Know your equivalent salary for 401k limits, insurance eligibility.",
  },
  {
    title: "Raise Impact Assessment",
    description:
      "Calculate annual impact of an hourly raise. A $2/hour raise = $4,160 more annually (at 40hrs/52wks).",
  },
  {
    title: "Contract Negotiations",
    description:
      "Convert hourly rate to salary equivalent when negotiating full-time positions or contractor agreements.",
  },
];
---

<SalaryToolLayout
  title="Hourly to Salary Calculator - Convert Hourly to Annual"
  description="Convert hourly rate to annual salary, monthly, and weekly pay. See your earnings breakdown."
  canonicalPath="/salary/hourly-to-monthly"
  currentTool="Hourly to Monthly"
  faqItems={faqItems}
  howItWorks={howItWorks}
  useCases={useCases}
>
  <div class="tool-header">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">
      Hourly to Salary Converter
    </h1>
    <p class="text-slate-500">
      Convert your hourly rate to annual salary and see all breakdowns.
    </p>
  </div>

  <div class="bg-slate-50 border border-slate-200 rounded p-6 mb-8">
    <div class="grid md:grid-cols-3 gap-4 mb-6">
      <div>
        <label
          for="hourly"
          class="block font-medium text-slate-700 mb-1.5 text-sm"
          >Hourly Rate ($)</label
        >
        <input
          type="number"
          id="hourly"
          placeholder="25"
          class="w-full px-4 py-3 border border-slate-300 rounded bg-white text-slate-800 outline-none"
          oninput="calculate()"
        />
      </div>
      <div>
        <label
          for="hoursPerWeek"
          class="block font-medium text-slate-700 mb-1.5 text-sm"
          >Hours per Week</label
        >
        <input
          type="number"
          id="hoursPerWeek"
          value="40"
          class="w-full px-4 py-3 border border-slate-300 rounded bg-white text-slate-800 outline-none"
          oninput="calculate()"
        />
      </div>
      <div>
        <label
          for="weeksPerYear"
          class="block font-medium text-slate-700 mb-1.5 text-sm"
          >Weeks per Year</label
        >
        <input
          type="number"
          id="weeksPerYear"
          value="52"
          class="w-full px-4 py-3 border border-slate-300 rounded bg-white text-slate-800 outline-none"
          oninput="calculate()"
        />
      </div>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="p-4 bg-white border border-slate-200 rounded text-center">
        <div class="text-xs text-slate-500 uppercase mb-1">Daily (8h)</div>
        <div class="text-2xl font-bold text-purple-600" id="daily">$0</div>
      </div>
      <div class="p-4 bg-white border border-slate-200 rounded text-center">
        <div class="text-xs text-slate-500 uppercase mb-1">Weekly</div>
        <div class="text-2xl font-bold text-purple-600" id="weekly">$0</div>
      </div>
      <div class="p-4 bg-white border border-slate-200 rounded text-center">
        <div class="text-xs text-slate-500 uppercase mb-1">Monthly</div>
        <div class="text-2xl font-bold text-purple-600" id="monthly">$0</div>
      </div>
      <div class="p-4 bg-white border border-slate-200 rounded text-center">
        <div class="text-xs text-slate-500 uppercase mb-1">Annual</div>
        <div class="text-2xl font-bold text-purple-600" id="annual">$0</div>
      </div>
    </div>
  </div>

  <script is:inline>
    function calculate() {
      const hourly = parseFloat(document.getElementById("hourly").value) || 0;
      const hoursPerWeek =
        parseFloat(document.getElementById("hoursPerWeek").value) || 40;
      const weeksPerYear =
        parseFloat(document.getElementById("weeksPerYear").value) || 52;

      const daily = hourly * 8;
      const weekly = hourly * hoursPerWeek;
      const annual = weekly * weeksPerYear;
      const monthly = annual / 12;

      const fmt = (n) =>
        "$" +
        n.toLocaleString(undefined, {
          minimumFractionDigits: 2,
          maximumFractionDigits: 2,
        });

      document.getElementById("daily").innerText = fmt(daily);
      document.getElementById("weekly").innerText = fmt(weekly);
      document.getElementById("monthly").innerText = fmt(monthly);
      document.getElementById("annual").innerText = fmt(annual);
    }
  </script>
</SalaryToolLayout>
