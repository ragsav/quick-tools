---
import SalaryToolLayout from "../../layouts/SalaryToolLayout.astro";

const faqItems = [
  {
    question: "How is hourly rate calculated from salary?",
    answer:
      "Hourly Rate = Annual Salary ÷ (Hours per Week × Weeks per Year). Standard is 2,080 hours/year.",
  },
  {
    question: "Why convert salary to hourly?",
    answer:
      "To compare job offers, understand your true pay rate, or calculate overtime.",
  },
  {
    question: "Is this tool free?",
    answer:
      "Yes, this tool is completely free and works directly in your browser.",
  },
];

const howItWorks = [
  {
    title: "Annual Hours Calculation",
    content:
      "Total work hours = hours per week × weeks per year. Standard full-time is 40 hours × 52 weeks = 2,080 hours annually.",
  },
  {
    title: "Hourly Rate Division",
    content:
      "Annual salary ÷ total hours = hourly rate. A $52,000 salary ÷ 2,080 hours = $25/hour.",
  },
  {
    title: "Daily Rate",
    content:
      "Daily pay assumes an 8-hour workday: hourly rate × 8 = daily rate. Adjust if your workday differs.",
  },
  {
    title: "Weekly and Monthly",
    content:
      "Weekly = annual ÷ weeks worked. Monthly = annual ÷ 12. These provide quick reference for budgeting.",
  },
  {
    title: "Custom Parameters",
    content:
      "Adjust hours per week and weeks per year for part-time work, unpaid leave, or non-standard schedules.",
  },
];

const useCases = [
  {
    title: "Job Offer Comparison",
    description:
      "Compare a salaried position to hourly jobs. Understand true hourly value to make informed career decisions.",
  },
  {
    title: "Overtime Calculation",
    description:
      "Salaried employees need to know hourly rate to calculate overtime when it applies to their position.",
  },
  {
    title: "Freelance Rate Setting",
    description:
      "Convert your salary to hourly to set competitive freelance rates that match your current compensation.",
  },
  {
    title: "Part-Time Transitions",
    description:
      "Calculate pay if transitioning from full-time to part-time while maintaining equivalent hourly compensation.",
  },
  {
    title: "Time Value Assessment",
    description:
      "Understand what your time is worth. Is a 2-hour commute worth the cost when you know your hourly rate?",
  },
  {
    title: "Consulting Rate Benchmarking",
    description:
      "Use your salary-to-hourly conversion as a baseline when setting consulting rates (typically 2-3× hourly).",
  },
];
---

<SalaryToolLayout
  title="Salary to Hourly Calculator - Convert Annual to Hourly Rate"
  description="Convert your annual salary to hourly rate. See how much you earn per hour, day, week, and month."
  canonicalPath="/salary/salary-to-hourly"
  currentTool="Salary to Hourly"
  faqItems={faqItems}
  howItWorks={howItWorks}
  useCases={useCases}
>
  <div class="tool-header">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">
      Salary to Hourly Converter
    </h1>
    <p class="text-slate-500">
      Convert annual salary to hourly rate and see all breakdowns.
    </p>
  </div>

  <div class="bg-slate-50 border border-slate-200 rounded p-6 mb-8">
    <div class="grid md:grid-cols-3 gap-4 mb-6">
      <div>
        <label
          for="salary"
          class="block font-medium text-slate-700 mb-1.5 text-sm"
          >Annual Salary ($)</label
        >
        <input
          type="number"
          id="salary"
          placeholder="50000"
          class="w-full px-4 py-3 border border-slate-300 rounded bg-white text-slate-800 outline-none"
          oninput="calculate()"
        />
      </div>
      <div>
        <label
          for="hoursPerWeek"
          class="block font-medium text-slate-700 mb-1.5 text-sm"
          >Hours per Week</label
        >
        <input
          type="number"
          id="hoursPerWeek"
          value="40"
          class="w-full px-4 py-3 border border-slate-300 rounded bg-white text-slate-800 outline-none"
          oninput="calculate()"
        />
      </div>
      <div>
        <label
          for="weeksPerYear"
          class="block font-medium text-slate-700 mb-1.5 text-sm"
          >Weeks per Year</label
        >
        <input
          type="number"
          id="weeksPerYear"
          value="52"
          class="w-full px-4 py-3 border border-slate-300 rounded bg-white text-slate-800 outline-none"
          oninput="calculate()"
        />
      </div>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="p-4 bg-white border border-slate-200 rounded text-center">
        <div class="text-xs text-slate-500 uppercase mb-1">Hourly</div>
        <div class="text-2xl font-bold text-purple-600" id="hourly">$0</div>
      </div>
      <div class="p-4 bg-white border border-slate-200 rounded text-center">
        <div class="text-xs text-slate-500 uppercase mb-1">Daily (8h)</div>
        <div class="text-2xl font-bold text-purple-600" id="daily">$0</div>
      </div>
      <div class="p-4 bg-white border border-slate-200 rounded text-center">
        <div class="text-xs text-slate-500 uppercase mb-1">Weekly</div>
        <div class="text-2xl font-bold text-purple-600" id="weekly">$0</div>
      </div>
      <div class="p-4 bg-white border border-slate-200 rounded text-center">
        <div class="text-xs text-slate-500 uppercase mb-1">Monthly</div>
        <div class="text-2xl font-bold text-purple-600" id="monthly">$0</div>
      </div>
    </div>
  </div>

  <script is:inline>
    function calculate() {
      const salary = parseFloat(document.getElementById("salary").value) || 0;
      const hoursPerWeek =
        parseFloat(document.getElementById("hoursPerWeek").value) || 40;
      const weeksPerYear =
        parseFloat(document.getElementById("weeksPerYear").value) || 52;

      const hourly = salary / (hoursPerWeek * weeksPerYear);
      const daily = hourly * 8;
      const weekly = salary / weeksPerYear;
      const monthly = salary / 12;

      const fmt = (n) =>
        "$" +
        n.toLocaleString(undefined, {
          minimumFractionDigits: 2,
          maximumFractionDigits: 2,
        });

      document.getElementById("hourly").innerText = fmt(hourly);
      document.getElementById("daily").innerText = fmt(daily);
      document.getElementById("weekly").innerText = fmt(weekly);
      document.getElementById("monthly").innerText = fmt(monthly);
    }
  </script>
</SalaryToolLayout>
