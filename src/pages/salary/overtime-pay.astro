---
import SalaryToolLayout from "../../layouts/SalaryToolLayout.astro";

const faqItems = [
  {
    question: "What is the standard overtime rate?",
    answer:
      "In the US, the federal overtime rate is 1.5× (time and a half) for hours over 40 per week.",
  },
  {
    question: "When is double time paid?",
    answer:
      "Double time (2×) is typically paid for holidays or very long work days, depending on your employer.",
  },
  {
    question: "Is this tool free?",
    answer:
      "Yes, this tool is completely free and works directly in your browser.",
  },
];

const howItWorks = [
  {
    title: "Overtime Rate Calculation",
    content:
      "Overtime hourly rate = regular rate × multiplier. At $20/hour with 1.5× OT, overtime rate is $30/hour.",
  },
  {
    title: "Regular Pay",
    content:
      "Regular pay = regular hourly rate × regular hours worked. Standard is 40 hours at base rate.",
  },
  {
    title: "Overtime Pay",
    content:
      "Overtime pay = overtime rate × overtime hours. Working 10 OT hours at $30/hour = $300 overtime pay.",
  },
  {
    title: "Total Compensation",
    content:
      "Total = regular pay + overtime pay. Regular ($800) + OT ($300) = $1,100 total weekly pay.",
  },
  {
    title: "Multiplier Options",
    content:
      "Common rates: 1.25× (some contracts), 1.5× (federal standard), 2× (holidays/double time).",
  },
];

const useCases = [
  {
    title: "Paycheck Verification",
    description:
      "Verify that your overtime pay is calculated correctly. Ensure you're receiving proper compensation.",
  },
  {
    title: "Extra Income Planning",
    description:
      "Calculate potential earnings from available overtime. Decide if extra hours are worth the time investment.",
  },
  {
    title: "Budgeting with Variable Income",
    description:
      "Project income when overtime varies. Plan for months with high or low overtime availability.",
  },
  {
    title: "Holiday Work Decisions",
    description:
      "Calculate holiday pay at 2× rates. Is working the holiday worth it for your specific situation?",
  },
  {
    title: "Labor Cost Estimation",
    description:
      "Managers can estimate labor costs when scheduling overtime to complete projects.",
  },
  {
    title: "Wage Dispute Resolution",
    description:
      "Calculate expected overtime pay to identify discrepancies in paychecks or timesheets.",
  },
];
---

<SalaryToolLayout
  title="Overtime Pay Calculator - Calculate OT Pay"
  description="Calculate overtime pay based on your hourly rate. Supports 1.5x and 2x overtime rates."
  canonicalPath="/salary/overtime-pay"
  currentTool="Overtime Pay Calculator"
  faqItems={faqItems}
  howItWorks={howItWorks}
  useCases={useCases}
>
  <div class="tool-header">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">
      Overtime Pay Calculator
    </h1>
    <p class="text-slate-500">
      Calculate your overtime earnings based on hours worked.
    </p>
  </div>

  <div class="bg-slate-50 border border-slate-200 rounded p-6 mb-8">
    <div class="grid md:grid-cols-2 gap-4 mb-6">
      <div>
        <label
          for="hourlyRate"
          class="block font-medium text-slate-700 mb-1.5 text-sm"
          >Regular Hourly Rate ($)</label
        >
        <input
          type="number"
          id="hourlyRate"
          placeholder="20"
          class="w-full px-4 py-3 border border-slate-300 rounded bg-white text-slate-800 outline-none"
          oninput="calculate()"
        />
      </div>
      <div>
        <label
          for="otMultiplier"
          class="block font-medium text-slate-700 mb-1.5 text-sm"
          >Overtime Rate</label
        >
        <select
          id="otMultiplier"
          class="w-full px-4 py-3 border border-slate-300 rounded bg-white text-slate-800 outline-none"
          onchange="calculate()"
        >
          <option value="1.5">1.5x (Time and a half)</option>
          <option value="2">2x (Double time)</option>
          <option value="1.25">1.25x</option>
        </select>
      </div>
    </div>

    <div class="grid md:grid-cols-2 gap-4 mb-6">
      <div>
        <label
          for="regularHours"
          class="block font-medium text-slate-700 mb-1.5 text-sm"
          >Regular Hours</label
        >
        <input
          type="number"
          id="regularHours"
          value="40"
          class="w-full px-4 py-3 border border-slate-300 rounded bg-white text-slate-800 outline-none"
          oninput="calculate()"
        />
      </div>
      <div>
        <label
          for="overtimeHours"
          class="block font-medium text-slate-700 mb-1.5 text-sm"
          >Overtime Hours</label
        >
        <input
          type="number"
          id="overtimeHours"
          placeholder="10"
          class="w-full px-4 py-3 border border-slate-300 rounded bg-white text-slate-800 outline-none"
          oninput="calculate()"
        />
      </div>
    </div>

    <div class="result-box p-4 bg-white rounded">
      <div class="grid grid-cols-3 gap-4 text-center">
        <div>
          <div class="text-xs text-slate-500 uppercase mb-1">Regular Pay</div>
          <div class="text-xl font-bold text-slate-900" id="regularPay">$0</div>
        </div>
        <div>
          <div class="text-xs text-slate-500 uppercase mb-1">Overtime Pay</div>
          <div class="text-xl font-bold text-purple-600" id="otPay">$0</div>
        </div>
        <div>
          <div class="text-xs text-slate-500 uppercase mb-1">Total Pay</div>
          <div class="text-xl font-bold text-green-600" id="totalPay">$0</div>
        </div>
      </div>
      <div class="text-center mt-4 text-sm text-slate-500" id="otRate">—</div>
    </div>
  </div>

  <script is:inline>
    function calculate() {
      const hourlyRate =
        parseFloat(document.getElementById("hourlyRate").value) || 0;
      const otMultiplier =
        parseFloat(document.getElementById("otMultiplier").value) || 1.5;
      const regularHours =
        parseFloat(document.getElementById("regularHours").value) || 0;
      const overtimeHours =
        parseFloat(document.getElementById("overtimeHours").value) || 0;

      const regularPay = hourlyRate * regularHours;
      const otRate = hourlyRate * otMultiplier;
      const otPay = otRate * overtimeHours;
      const totalPay = regularPay + otPay;

      const fmt = (n) =>
        "$" +
        n.toLocaleString(undefined, {
          minimumFractionDigits: 2,
          maximumFractionDigits: 2,
        });

      document.getElementById("regularPay").innerText = fmt(regularPay);
      document.getElementById("otPay").innerText = fmt(otPay);
      document.getElementById("totalPay").innerText = fmt(totalPay);
      document.getElementById("otRate").innerText =
        `Overtime rate: ${fmt(otRate)}/hr`;
    }
  </script>
</SalaryToolLayout>
