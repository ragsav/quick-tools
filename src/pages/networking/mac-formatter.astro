---
import NetworkingToolLayout from "../../layouts/NetworkingToolLayout.astro";

const faqItems = [
  {
    question: "What is a MAC address?",
    answer: "A MAC (Media Access Control) address is a unique hardware identifier assigned to network interfaces. It's 48 bits, typically shown as 6 pairs of hexadecimal digits.",
  },
  {
    question: "Why format MAC addresses?",
    answer: "Different systems use different formats: Cisco uses dots (0000.1111.2222), Windows uses hyphens (00-11-22-33-44-55), and Unix uses colons (00:11:22:33:44:55).",
  },
  {
    question: "What's the OUI in a MAC address?",
    answer: "The first 3 bytes (24 bits) are the Organizationally Unique Identifier (OUI), assigned to manufacturers by IEEE.",
  },
];

const howItWorks = [
  {
    title: "Input Parsing",
    content: "The tool accepts MAC addresses in any format with colons, hyphens, dots, or no separators.",
  },
  {
    title: "Validation",
    content: "Checks that the address contains exactly 12 hexadecimal characters (0-9, A-F).",
  },
  {
    title: "Formatting",
    content: "Outputs in multiple formats: colon-separated, hyphen-separated, Cisco dot notation, and plain.",
  },
];

const useCases = [
  {
    title: "Network Configuration",
    description: "Convert MAC addresses to the format required by your network equipment or software.",
  },
  {
    title: "Access Control Lists",
    description: "Format MAC addresses for router ACLs, switch port security, or WiFi whitelists.",
  },
  {
    title: "Documentation",
    description: "Standardize MAC address formats across network documentation and inventory.",
  },
  {
    title: "Scripting",
    description: "Clean and normalize MAC addresses from various sources for automation scripts.",
  },
];
---

<NetworkingToolLayout
  title="MAC Address Formatter - Format MAC Addresses Online"
  description="Free online MAC address formatter. Convert MAC addresses between colon, hyphen, dot, and plain formats."
  canonicalPath="/networking/mac-formatter"
  currentTool="MAC Formatter"
  faqItems={faqItems}
  howItWorks={howItWorks}
  useCases={useCases}
>
  <div class="tool-header">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">
      MAC Address Formatter
    </h1>
    <p class="text-slate-500">Convert MAC addresses between different formats.</p>
  </div>

  <div class="bg-slate-50 border border-slate-200 rounded p-6 mb-8">
    <div class="mb-4">
      <label for="macInput" class="block font-medium text-slate-700 mb-1.5 text-sm">Enter MAC Address</label>
      <input
        type="text"
        id="macInput"
        placeholder="00:1A:2B:3C:4D:5E or 00-1A-2B-3C-4D-5E or 001A.2B3C.4D5E"
        class="w-full px-4 py-3 text-sm border border-slate-300 rounded bg-white text-slate-800 outline-none font-mono"
      />
    </div>

    <div class="flex gap-3 flex-wrap mb-6">
      <button onclick="formatMac()" class="btn-primary px-6 py-2 font-semibold text-white rounded">Format</button>
      <button onclick="clearAll()" class="px-4 py-2 bg-white border border-slate-300 rounded text-sm">Clear</button>
    </div>

    <div id="result" class="hidden">
      <h3 class="font-semibold text-slate-900 mb-3">Formatted MAC Addresses</h3>
      <div class="space-y-3">
        <div class="bg-white border border-slate-200 rounded p-3">
          <div class="flex justify-between items-center">
            <div>
              <div class="text-xs text-slate-500 uppercase tracking-wide mb-1">Colon Separated (Unix/Linux)</div>
              <div id="colonFormat" class="font-mono text-lg text-slate-900">-</div>
            </div>
            <button onclick="copyToClipboard('colonFormat')" class="text-slate-400 hover:text-slate-600 text-sm" title="Copy to clipboard" aria-label="Copy to clipboard">📋</button>
          </div>
        </div>
        
        <div class="bg-white border border-slate-200 rounded p-3">
          <div class="flex justify-between items-center">
            <div>
              <div class="text-xs text-slate-500 uppercase tracking-wide mb-1">Hyphen Separated (Windows)</div>
              <div id="hyphenFormat" class="font-mono text-lg text-slate-900">-</div>
            </div>
            <button onclick="copyToClipboard('hyphenFormat')" class="text-slate-400 hover:text-slate-600 text-sm" title="Copy to clipboard" aria-label="Copy to clipboard">📋</button>
          </div>
        </div>
        
        <div class="bg-white border border-slate-200 rounded p-3">
          <div class="flex justify-between items-center">
            <div>
              <div class="text-xs text-slate-500 uppercase tracking-wide mb-1">Dot Separated (Cisco)</div>
              <div id="dotFormat" class="font-mono text-lg text-slate-900">-</div>
            </div>
            <button onclick="copyToClipboard('dotFormat')" class="text-slate-400 hover:text-slate-600 text-sm" title="Copy to clipboard" aria-label="Copy to clipboard">📋</button>
          </div>
        </div>
        
        <div class="bg-white border border-slate-200 rounded p-3">
          <div class="flex justify-between items-center">
            <div>
              <div class="text-xs text-slate-500 uppercase tracking-wide mb-1">Plain (No Separator)</div>
              <div id="plainFormat" class="font-mono text-lg text-slate-900">-</div>
            </div>
            <button onclick="copyToClipboard('plainFormat')" class="text-slate-400 hover:text-slate-600 text-sm" title="Copy to clipboard" aria-label="Copy to clipboard">📋</button>
          </div>
        </div>

        <div class="grid sm:grid-cols-2 gap-3 pt-2">
          <div class="bg-white border border-slate-200 rounded p-3">
            <div class="text-xs text-slate-500 uppercase tracking-wide mb-1">OUI (First 3 Bytes)</div>
            <div id="ouiPart" class="font-mono text-lg text-slate-900">-</div>
          </div>
          <div class="bg-white border border-slate-200 rounded p-3">
            <div class="text-xs text-slate-500 uppercase tracking-wide mb-1">NIC Specific (Last 3 Bytes)</div>
            <div id="nicPart" class="font-mono text-lg text-slate-900">-</div>
          </div>
        </div>

        <div class="bg-white border border-slate-200 rounded p-3">
          <div class="text-xs text-slate-500 uppercase tracking-wide mb-1">Binary</div>
          <div id="binaryFormat" class="font-mono text-sm text-slate-900 break-all">-</div>
        </div>
      </div>
    </div>

    <div id="error" class="hidden text-red-600 mt-4"></div>
  </div>

  <section class="mt-8 pt-6 border-t border-slate-200">
    <h2 class="text-xl font-semibold text-slate-900 mb-4">About MAC Addresses</h2>
    <p class="text-slate-600">
      A MAC address is a unique identifier assigned to a network interface controller (NIC). 
      It consists of 48 bits, typically displayed as 12 hexadecimal digits. The first half 
      (OUI) identifies the manufacturer, while the second half is assigned by the manufacturer.
    </p>
  </section>

  <script is:inline>
    function parseMac(input) {
      // Remove all separators and convert to uppercase
      const cleaned = input.replace(/[^0-9A-Fa-f]/g, '').toUpperCase();
      
      if (cleaned.length !== 12) {
        return null;
      }
      
      if (!/^[0-9A-F]{12}$/.test(cleaned)) {
        return null;
      }
      
      return cleaned;
    }

    function formatMac() {
      const input = document.getElementById('macInput').value.trim();
      const resultDiv = document.getElementById('result');
      const errorDiv = document.getElementById('error');

      errorDiv.classList.add('hidden');
      resultDiv.classList.add('hidden');

      const mac = parseMac(input);
      
      if (!mac) {
        errorDiv.textContent = 'Invalid MAC address. Enter 12 hexadecimal characters (e.g., 00:1A:2B:3C:4D:5E).';
        errorDiv.classList.remove('hidden');
        return;
      }

      // Split into pairs
      const pairs = mac.match(/.{2}/g);
      
      // Colon format (Unix/Linux): 00:1A:2B:3C:4D:5E
      document.getElementById('colonFormat').textContent = pairs.join(':');
      
      // Hyphen format (Windows): 00-1A-2B-3C-4D-5E
      document.getElementById('hyphenFormat').textContent = pairs.join('-');
      
      // Dot format (Cisco): 001A.2B3C.4D5E
      const quads = mac.match(/.{4}/g);
      document.getElementById('dotFormat').textContent = quads.join('.');
      
      // Plain format
      document.getElementById('plainFormat').textContent = mac;
      
      // OUI and NIC parts
      document.getElementById('ouiPart').textContent = pairs.slice(0, 3).join(':');
      document.getElementById('nicPart').textContent = pairs.slice(3).join(':');
      
      // Binary format
      const binary = mac.split('').map(c => 
        parseInt(c, 16).toString(2).padStart(4, '0')
      ).join('');
      const binaryFormatted = binary.match(/.{8}/g).join(' ');
      document.getElementById('binaryFormat').textContent = binaryFormatted;

      resultDiv.classList.remove('hidden');
    }

    function clearAll() {
      document.getElementById('macInput').value = '';
      document.getElementById('result').classList.add('hidden');
      document.getElementById('error').classList.add('hidden');
    }

    function copyToClipboard(elementId) {
      const text = document.getElementById(elementId).textContent;
      navigator.clipboard.writeText(text);
    }

    document.getElementById('macInput').addEventListener('keypress', (e) => {
      if (e.key === 'Enter') formatMac();
    });
  </script>
</NetworkingToolLayout>
