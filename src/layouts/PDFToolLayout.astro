---
/**
 * PDF Tools Layout
 * Extends ToolLayout with PDF cluster-specific configuration.
 */

import ToolLayout from "./ToolLayout.astro";
import { CONSTANT } from "../constants";

interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  currentTool?: string;
  faqItems?: FAQItem[];
}

const {
  title,
  description,
  canonicalPath,
  currentTool = "",
  faqItems = [],
} = Astro.props;

const cluster = {
  name: "PDF Tools",
  icon: "📄",
  color: "#1c398e",
  url: "/pdf/",
};

const allTools = [
  { name: "PDF Merge", url: "/pdf/pdf-merge" },
  { name: "PDF Split", url: "/pdf/pdf-split" },
  { name: "PDF to Image", url: "/pdf/pdf-to-image" },
];

const relatedTools = allTools
  .filter((tool) => tool.name !== currentTool)
  .slice(0, 4);
---

<ToolLayout
  title={title}
  description={description}
  canonical={`${CONSTANT.CANONICAL_URL}${canonicalPath}`}
  cluster={cluster}
  relatedTools={relatedTools}
  faqItems={faqItems}
>
  <slot />
</ToolLayout>
