---
/**
 * Image Tools Layout
 * Extends ToolLayout with Image cluster-specific configuration.
 */

import ToolLayout from "./ToolLayout.astro";
import { CONSTANT } from "../constants";


interface HowItWorksItem {
  title?: string;
  content: string;
}

interface UseCaseItem {
  title: string;
  description: string;
}

interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  currentTool?: string;
  faqItems?: FAQItem[];
  howItWorks?: HowItWorksItem[];
  useCases?: UseCaseItem[];
}

const {
  title,
  description,
  canonicalPath,
  currentTool = "",
  faqItems = [],

  howItWorks = [],
  useCases = [],
} = Astro.props;

const cluster = {
  name: "Image Tools",
  icon: "🖼️",
  color: "#1c398e",
  url: "/image/",
};

const allTools = [
  // Existing tools
  { name: "Image Compress", url: "/image/image-compress" },
  { name: "Image to PDF", url: "/image/image-to-pdf" },
  // Format Converters
  { name: "PNG to JPG", url: "/image/png-to-jpg" },
  { name: "JPG to PNG", url: "/image/jpg-to-png" },
  { name: "Image to WebP", url: "/image/image-to-webp" },
  { name: "WebP to PNG", url: "/image/webp-to-png" },
  { name: "SVG to PNG", url: "/image/svg-to-png" },
  { name: "HEIC to JPG", url: "/image/heic-to-jpg" },
  { name: "GIF to PNG", url: "/image/gif-to-png" },
  { name: "BMP to PNG", url: "/image/bmp-to-png" },
  { name: "Image to ICO", url: "/image/image-to-ico" },
  // Editing Tools
  { name: "Image Resize", url: "/image/image-resize" },
  { name: "Image Crop", url: "/image/image-crop" },
  { name: "Image Rotate", url: "/image/image-rotate" },
  // Enhancement Tools
  { name: "Image Filters", url: "/image/image-filters" },
  // Utilities
  { name: "Image Metadata", url: "/image/image-metadata" },
  { name: "Color Extractor", url: "/image/color-extractor" },
  { name: "Base64 to Image", url: "/image/base64-to-image" },
  { name: "Image to Base64", url: "/image/image-to-base64" },
];

const relatedTools = allTools
  .filter((tool) => tool.name !== currentTool)
  .slice(0, 4);
---

<ToolLayout
  title={title}
  description={description}
  canonical={`${CONSTANT.CANONICAL_URL}${canonicalPath}`}
  cluster={cluster}
  relatedTools={relatedTools}
  faqItems={faqItems}

  howItWorks={howItWorks}
  useCases={useCases}

>
  <slot />
</ToolLayout>
