---
/**
 * Image Tools Layout
 * Extends ToolLayout with Image cluster-specific configuration.
 */

import ToolLayout from "./ToolLayout.astro";
import { CONSTANT } from "../constants";

interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  currentTool?: string;
  faqItems?: FAQItem[];
}

const {
  title,
  description,
  canonicalPath,
  currentTool = "",
  faqItems = [],
} = Astro.props;

const cluster = {
  name: "Image Tools",
  icon: "🖼️",
  color: "#1c398e",
  url: "/image/",
};

const allTools = [
  { name: "Image Compress", url: "/image/image-compress" },
  { name: "Image to PDF", url: "/image/image-to-pdf" },
];

const relatedTools = allTools
  .filter((tool) => tool.name !== currentTool)
  .slice(0, 4);
---

<ToolLayout
  title={title}
  description={description}
  canonical={`${CONSTANT.CANONICAL_URL}${canonicalPath}`}
  cluster={cluster}
  relatedTools={relatedTools}
  faqItems={faqItems}
>
  <slot />
</ToolLayout>
