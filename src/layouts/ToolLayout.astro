---
/**
 * Base Tool Layout
 *
 * Provides consistent header, footer, styles, and SEO for all tool pages.
 * Cluster-specific layouts extend this with their own colors and related tools.
 */

import { CONSTANT } from "../constants";
import { Image } from "astro:assets";
import logo from "../assets/favicon.svg";
import "../styles/global.css";

interface FAQItem {
  question: string;
  answer: string;
}

interface HowItWorksItem {
  title?: string;
  content: string;
}

interface UseCaseItem {
  title: string;
  description: string;
}

interface Props {
  title: string;
  description: string;
  canonical: string;
  cluster: {
    name: string;
    icon: string;
    color: string;
    url: string;
  };
  relatedTools?: Array<{ name: string; url: string }>;
  faqItems?: FAQItem[];
  howItWorks?: HowItWorksItem[];
  useCases?: UseCaseItem[];
}

const {
  title,
  description,
  canonical,
  cluster,
  relatedTools = [],
  faqItems = [],
  howItWorks = [],
  useCases = [],
} = Astro.props;
---

<!doctype html>
<html lang="en" class="">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Favicons & PWA -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#1e293b" />

    <!-- SEO -->
    <meta name="robots" content="index, follow" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- JSON-LD: WebApplication -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebApplication",
        name: title,
        description: description,
        url: canonical,
        applicationCategory: "UtilityApplication",
        operatingSystem: "Any",
        offers: {
          "@type": "Offer",
          price: "0",
          priceCurrency: "USD",
        },
        aggregateRating: {
          "@type": "AggregateRating",
          ratingValue: "4.8",
          ratingCount: "150",
          bestRating: "5",
          worstRating: "1",
        },
      })}
    />

    <!-- JSON-LD: FAQ Schema (if FAQ items provided) -->
    {
      faqItems.length > 0 && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "FAQPage",
            mainEntity: faqItems.map((item) => ({
              "@type": "Question",
              name: item.question,
              acceptedAnswer: {
                "@type": "Answer",
                text: item.answer,
              },
            })),
          })}
        />
      )
    }

    <!-- JSON-LD: HowTo Schema (if How It Works items provided) -->
    {
      howItWorks.length > 0 && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "HowTo",
            name: `How ${title.split(" - ")[0]} Works`,
            description: description,
            step: howItWorks.map((item, index) => ({
              "@type": "HowToStep",
              position: index + 1,
              name: item.title || `Step ${index + 1}`,
              text: item.content,
            })),
          })}
        />
      )
    }

    <!-- JSON-LD: ItemList Schema (if Use Cases provided) -->
    {
      useCases.length > 0 && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "ItemList",
            name: `Common Use Cases for ${title.split(" - ")[0]}`,
            numberOfItems: useCases.length,
            itemListElement: useCases.map((item, index) => ({
              "@type": "ListItem",
              position: index + 1,
              name: item.title,
              description: item.description,
            })),
          })}
        />
      )
    }

    <!-- Theme initialization (prevents flash) -->
    <script is:inline>
      (function () {
        const theme =
          localStorage.getItem("theme") ||
          (window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light");
        if (theme === "dark") document.documentElement.classList.add("dark");
      })();
    </script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body
    class="font-['Inter',system-ui,sans-serif] bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-slate-100 min-h-screen flex flex-col leading-relaxed transition-colors duration-200"
  >
    <!-- HEADER -->
    <header
      class="bg-blue-900 dark:bg-slate-800 text-white p-4 transition-colors duration-200"
    >
      <div
        class="max-w-4xl mx-auto flex items-center justify-between flex-wrap gap-4"
      >
        <a
          href="/"
          class="flex items-center gap-2 no-underline text-white font-bold text-xl"
        >
          <Image
            src={logo}
            alt="Quick Tools Logo"
            class="w-8 h-8 lg:w-9 lg:h-9"
          />
          <span>Quick Tools</span>
        </a>
        <div class="flex items-center gap-4">
          <nav class="flex items-center gap-2 text-sm">
            <a
              href="/"
              class="text-slate-400 no-underline hover:text-white transition-colors"
              >Home</a
            >
            <span class="text-slate-500">/</span>
            <a
              href={cluster.url}
              class="text-slate-400 no-underline hover:text-white transition-colors"
              >{cluster.icon} {cluster.name}</a
            >
          </nav>
          <button
            type="button"
            class="theme-toggle"
            aria-label="Toggle dark mode"
            onclick="toggleTheme()"
          >
            <svg
              class="sun-icon"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
              ></path>
            </svg>
            <svg
              class="moon-icon"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
              ></path>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <!-- MAIN CONTENT -->
    <main class="flex-1 max-w-4xl w-full mx-auto p-4 py-8">
      <div
        class="bg-white dark:bg-slate-800 rounded border border-slate-200 dark:border-slate-700 shadow-sm p-6 sm:p-8 mb-8 transition-colors duration-200"
        style={`--cluster-color: ${cluster.color}`}
      >
        <slot />
      </div>

      <!-- HOW IT WORKS SECTION -->
      {
        howItWorks.length > 0 && (
          <section class="bg-white dark:bg-slate-800 rounded border border-slate-200 dark:border-slate-700 shadow-sm p-6 sm:p-8 mb-8 transition-colors duration-200">
            <h2 class="text-xl font-semibold text-slate-900 dark:text-slate-100 mb-6 pb-4 border-b border-slate-200 dark:border-slate-700">
              📘 How It Works
            </h2>
            <div class="space-y-6">
              {howItWorks.map((item, index) => (
                <div class="flex gap-4">
                  <div class="flex-shrink-0 w-8 h-8 rounded-full bg-blue-100 dark:bg-blue-900 text-blue-700 dark:text-blue-300 flex items-center justify-center font-semibold text-sm">
                    {index + 1}
                  </div>
                  <div class="flex-1">
                    {item.title && (
                      <h3 class="font-semibold text-slate-800 dark:text-slate-200 mb-2">
                        {item.title}
                      </h3>
                    )}
                    <p class="text-slate-600 dark:text-slate-400 leading-relaxed">
                      {item.content}
                    </p>
                  </div>
                </div>
              ))}
            </div>
          </section>
        )
      }

      <!-- USE CASES SECTION -->
      {
        useCases.length > 0 && (
          <section class="bg-white dark:bg-slate-800 rounded border border-slate-200 dark:border-slate-700 shadow-sm p-6 sm:p-8 mb-8 transition-colors duration-200">
            <h2 class="text-xl font-semibold text-slate-900 dark:text-slate-100 mb-6 pb-4 border-b border-slate-200 dark:border-slate-700">
              💡 Common Use Cases
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              {useCases.map((item) => (
                <div class="p-4 bg-slate-50 dark:bg-slate-700 rounded border border-slate-100 dark:border-slate-600">
                  <h3 class="font-semibold text-slate-800 dark:text-slate-200 mb-2">
                    {item.title}
                  </h3>
                  <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
                    {item.description}
                  </p>
                </div>
              ))}
            </div>
          </section>
        )
      }

      <!-- RELATED TOOLS -->
      {
        relatedTools.length > 0 && (
          <section class="mb-8">
            <h2 class="text-xl font-semibold text-slate-900 dark:text-slate-100 mb-4">
              Related {cluster.name} Tools
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              {relatedTools.map((tool) => (
                <a
                  href={tool.url}
                  class="flex justify-between items-center p-4 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded no-underline text-slate-700 dark:text-slate-300 font-medium hover:border-blue-500 hover:shadow-md transition-all group"
                >
                  <span>{tool.name}</span>
                  <span class="text-slate-400 group-hover:text-blue-500 group-hover:translate-x-1 transition-all">
                    →
                  </span>
                </a>
              ))}
            </div>
          </section>
        )
      }

      <!-- AD SLOT -->
      <div class="min-h-24 mb-8">
        <!-- Adsense code later -->
      </div>
    </main>

    <!-- FOOTER -->
    <footer
      class="bg-slate-800 dark:bg-slate-950 text-slate-400 p-8 mt-auto transition-colors duration-200"
    >
      <div
        class="max-w-4xl mx-auto flex flex-col items-center gap-4 text-center"
      >
        <div class="text-xl font-semibold text-white flex items-center gap-2">
          <Image src={logo} alt="Quick Tools Logo" class="w-6 h-6" />
          <span>Quick Tools</span>
        </div>
        <p class="text-sm">
          © 2024–{new Date().getFullYear()} Quick Tools. Free tools for everyone.
        </p>
        <div class="flex gap-6">
          <a
            href="/"
            class="text-slate-400 no-underline text-sm hover:text-white transition-colors"
            >All Tools</a
          >
          <a
            href="/about"
            class="text-slate-400 no-underline text-sm hover:text-white transition-colors"
            >About</a
          >
          <a
            href="/privacy"
            class="text-slate-400 no-underline text-sm hover:text-white transition-colors"
            >Privacy</a
          >
        </div>
      </div>
    </footer>

    <!-- Minimal custom styles for cluster-color CSS variable usage -->
    <style is:global>
      .tool-header {
        margin-bottom: 1.5rem;
        padding-bottom: 1.5rem;
        border-bottom: 2px solid var(--cluster-color, #1c398e);
      }

      .result-box {
        border: 2px solid var(--cluster-color, #1c398e);
      }

      .btn-primary {
        background-color: var(--cluster-color, #1c398e);
      }

      .btn-primary:hover {
        box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
      }

      input:focus,
      select:focus,
      textarea:focus {
        border-color: var(--cluster-color, #1c398e);
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
      }

      /* ===== DARK MODE OVERRIDES FOR SLOTTED TOOL CONTENT ===== */

      /* Headings */
      .dark .text-slate-900 {
        color: #f1f5f9 !important;
      }

      /* Secondary headings */
      .dark .text-slate-700 {
        color: #cbd5e1 !important;
      }

      /* Body text */
      .dark .text-slate-600 {
        color: #94a3b8 !important;
      }

      /* Muted text */
      .dark .text-slate-500 {
        color: #94a3b8 !important;
      }

      /* Form container backgrounds */
      .dark .bg-slate-50 {
        background-color: #334155 !important;
      }

      /* Input and result box backgrounds */
      .dark .bg-white:not(header *):not(footer *) {
        background-color: #1e293b !important;
      }

      /* Borders */
      .dark .border-slate-200 {
        border-color: #475569 !important;
      }

      .dark .border-slate-300 {
        border-color: #475569 !important;
      }

      /* Form inputs */
      .dark input,
      .dark select,
      .dark textarea {
        background-color: #1e293b !important;
        color: #f1f5f9 !important;
        border-color: #475569 !important;
      }

      .dark input::placeholder,
      .dark textarea::placeholder {
        color: #64748b !important;
      }

      /* Result box in dark mode */
      .dark .result-box {
        background-color: #1e293b !important;
      }

      /* Lists */
      .dark ul,
      .dark ol {
        color: #94a3b8;
      }
    </style>

    <!-- Theme toggle script -->
    <script is:inline>
      function toggleTheme() {
        const html = document.documentElement;
        const isDark = html.classList.toggle("dark");
        localStorage.setItem("theme", isDark ? "dark" : "light");
      }
    </script>
  </body>
</html>
